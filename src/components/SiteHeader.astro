---
/**
 * SiteHeader — persistent top header. Rendered globally by Base.astro,
 * lives inside the .site-chrome wrapper.
 *
 * Desktop (≥1025px):
 *   [Logo] [BAR EAT BOWL GAME EVENTS VIP SUITE]   [Reserve] [Plan] [☰]
 * Mobile (≤1024px):
 *   [Logo]                                                          [☰]
 *
 * Active-page indicator: 1px Glow underline below the active link only —
 * NOT applied on hover. Per locked decision (Phase 1 build spec round).
 *
 * MORE dropdown was retired 2026-05-05. The hamburger ☰ now appears at
 * ALL viewports and opens the same NavDrawer mobile uses — one drawer
 * surface for the long tail (Coupon / Waitlist / Leagues / Rewards /
 * Gift Cards / FAQ / Find Us / Careers / Upcoming Events). Drawer's
 * 3-section accordion (Experience / Visit / Info) earns the categorization
 * that the 260px-wide dropdown couldn't.
 *
 * Background: light translucent scrim + backdrop blur. One static recipe
 * that has to read on hero video, on Midnight Indigo solids, and on the
 * Indigo Deep footer — same pattern as the hamburger button.
 */
import NavToggle from "./NavToggle.astro";
import { PLAN_EVENT_URL } from "../lib/links";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

interface NavItem { href: string; label: string }

// Inline nav: 7 items. Menu added 2026-05-05 — the /menu/* pages (cocktails,
// taps, food) shipped earlier today are otherwise only reachable from /bar
// and /eat editorial CTAs, which makes them invisible to direct/search
// traffic. Slot between Eat and Bowl groups it with the F&B pillars
// (the user thinking about food/drinks finds the menu in the same cluster).
// VIP Suite stays at the right end as the natural events→suite pairing.
// The drawer (opened via the ☰ at the right of the header) carries the
// secondary utility surfaces.
const navItems: NavItem[] = [
  { href: "/bar/",       label: "Bar"       },
  { href: "/eat/",       label: "Eat"       },
  { href: "/menu/",      label: "Menu"      },
  { href: "/bowl/",      label: "Bowl"      },
  { href: "/game/",      label: "Game"      },
  { href: "/events/",    label: "Events"    },
  { href: "/vip-suite/", label: "VIP Suite" },
];

// Active match: exact path OR any sub-path under it. Deep match matters
// for /menu/ — the inline MENU item should stay highlighted on
// /menu/cocktails, /menu/taps, /menu/food. Other pillars don't have
// sub-pages today, so the subpath branch is a no-op for them.
const isActive = (href: string) => {
  const trimmed = href.replace(/\/$/, "");
  return currentPath === trimmed || currentPath.startsWith(trimmed + "/");
};
---
<header class="site-header" data-site-header>
  {/* Left group: logo + (desktop) inline nav */}
  <div class="header-left">
    <a class="site-logo" href="/" aria-label="Twisted Pin home">
      <picture>
        <source type="image/webp" srcset="/logo/twisted-pin-horizontal-white.webp" />
        <img
          src="/logo/twisted-pin-horizontal-white.png"
          alt="Twisted Pin"
          width="360"
          height="154"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class={isActive(item.href) ? "active" : ""}
              aria-current={isActive(item.href) ? "page" : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {/* Right group: (desktop) two CTAs + hamburger; (mobile) hamburger only.
      The hamburger sits to the right of the CTAs at desktop, opens the
      shared NavDrawer (the same surface mobile uses). Replaces the
      previous MORE ▼ dropdown — see header docstring for rationale. */}
  <div class="header-right">
    <div class="site-cta-cluster">
      <a class="btn btn-solid" href="/reserve/">Reserve a lane</a>
      <a class="btn btn-outline" href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event</a>
    </div>
    <NavToggle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* Vertical padding tightened 10→2 (2026-05-11) when logo bumped +40%.
       The logo itself now fills the band that used to have ~10px of empty
       blur on each side; band total height stays at ~original mobile
       height (~61px) instead of growing with the logo. */
    padding: 2px 22px;
    /* Light scrim so the header reads on video, on Midnight Indigo, and on
       Indigo Deep without ever feeling like a heavy clubhouse band. */
    background: rgba(14, 10, 31, 0.40);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
  }
  @media (min-width: 1025px) {
    .site-header { padding: 2px 18px; }
  }
  @media (min-width: 1180px) {
    .site-header { padding: 2px 28px; }
  }
  @media (min-width: 1440px) {
    .site-header { padding: 2px 40px; }
  }

  .header-left,
  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  @media (min-width: 1025px) {
    .header-left { gap: 16px; }
    .header-right { gap: 8px; }
  }
  @media (min-width: 1180px) {
    .header-left { gap: 24px; }
    .header-right { gap: 12px; }
  }
  @media (min-width: 1280px) {
    .header-left { gap: 28px; }
    .header-right { gap: 16px; }
  }
  @media (min-width: 1440px) {
    .header-left { gap: 32px; }
  }

  /* ---------- logo ---------- */
  /* Width-driven, stepped per tier (2026-08-23). A flex-shrink valve was
     tried and rejected: a flex item's min-content CONTRIBUTION to its
     parent group is its width, not its min-width, so the shrink never
     engaged through the nested flex — deterministic stepping is the only
     reliable mechanism. Aspect 360:154 → width = height × 2.34. */
  .site-logo {
    line-height: 0;
    display: inline-flex;
    flex: 0 0 auto;
    width: 133px;      /* ≈57px tall — mobile */
    filter: drop-shadow(0 1px 6px rgba(14, 10, 31, 0.5));
  }
  .site-logo picture {
    display: block;
    width: 100%;
  }
  .site-logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 1025px) {
    .site-logo { width: 104px; }   /* ≈45px tall — every px goes to the nav */
  }
  @media (min-width: 1180px) {
    .site-logo { width: 159px; }   /* ≈68px tall — compact desktop */
  }
  @media (min-width: 1280px) {
    .site-logo { width: 182px; }   /* 78px tall — the approved desktop size */
  }

  /* ---------- inline nav (desktop only) ---------- */
  .site-nav { display: none; }
  @media (min-width: 1025px) { .site-nav { display: block; } }

  .site-nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* Inline nav-link styling. white-space: nowrap is load-bearing: without
     it flexbox resolves any header overflow by silently wrapping the
     widest label ("VIP SUITE") to two lines — which is exactly what was
     happening at every viewport below ~1470px until 2026-08-23. With
     nowrap, an overflow is visible and honest, and the logo's shrink
     valve is the sanctioned release instead. */
  .site-nav > ul > li > a {
    display: inline-block;
    position: relative;
    padding: 10px 6px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--warm-mid);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 150ms ease-out;
  }
  .site-nav > ul > li > a:hover { color: var(--glow); }

  /* Active-page underline — applies ONLY to the current page, never on
     hover. Per locked decision. The ::after sits 4px below the text,
     padded to the link's text edges (matches the link's horizontal padding). */
  .site-nav > ul > li > a.active { color: var(--warm-white); }
  .site-nav > ul > li > a.active::after {
    content: "";
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 4px;
    height: 1px;
    background: var(--glow);
  }

  /* ---------- CTA cluster (desktop only) ---------- */
  .site-cta-cluster {
    display: none;
    align-items: center;
    gap: 6px;
  }
  @media (min-width: 1025px) {
    .site-cta-cluster { display: inline-flex; }
  }
  .site-cta-cluster .btn { padding: 12px 12px; font-size: 12px; }

  /* ---------- width tiers (2026-08-23 retune of the 2026-08-03 pass) ----------
     KEEP LAST in this style block — equal-specificity overrides win by
     source order only (the /pricing dead-CSS lesson from 2026-08-03).

     Each tier's recipe was MEASURED (headless Chrome, single-line nowrap
     natural width) to fit at its own min-width — the 2026-08-03 tiers
     didn't: the 14px recipe needed 1398px but fired at 1280px, so on any
     1920px laptop at Windows 150% scale (= exactly 1280 CSS px) the nav
     collided with the Reserve CTA; flexbox hid smaller overflows at every
     width below ~1470px by wrapping VIP SUITE to two lines. Natural
     single-line widths of the recipes below:
       x-compact (base above) ≈1005px → tier 1025–1179 (44px logo, rare tablets)
       compact 13px nav       ≈1147px → tier 1180–1279 (68px logo, iPads land.)
       squeeze 13px nav/CTA   ≈1250px → tier 1280–1439 ← 1920@150% laptops
       mid 14px nav/15px CTA  ≈1398px → tier 1440–1535
       wide 15px nav          ≈1467px → tier ≥1536     ← 1920@125%, big monitors
     If a nav item or CTA is ever added/renamed, re-measure before trusting
     these boundaries (scripts pattern: headless Chrome, compare last nav
     link's right edge to the CTA cluster's left edge — container boxes lie). */
  @media (min-width: 1180px) {
    .site-nav > ul { gap: 3px; }
    .site-nav > ul > li > a {
      padding: 10px 8px;
      letter-spacing: 0.12em;
    }
    .site-nav > ul > li > a.active::after { left: 8px; right: 8px; }
    .site-cta-cluster { gap: 8px; }
    .site-cta-cluster .btn { padding: 12px 14px; }
  }
  @media (min-width: 1280px) {
    .site-nav > ul { gap: 4px; }
    .site-nav > ul > li > a {
      padding: 10px 10px;
      letter-spacing: 0.16em;
    }
    /* Underline tracks the link's horizontal padding. */
    .site-nav > ul > li > a.active::after { left: 10px; right: 10px; }
    .site-cta-cluster .btn { padding: 13px 20px; font-size: 13px; }
  }
  @media (min-width: 1440px) {
    .site-nav > ul > li > a {
      font-size: 14px;
      padding: 10px 12px;
    }
    .site-nav > ul > li > a.active::after { left: 12px; right: 12px; }
    .site-cta-cluster .btn { padding: 15px 26px; font-size: 15px; }
    .site-cta-cluster { gap: 10px; }
  }
  /* Full-width monitors: room is abundant — let the nav read at real
     desktop scale (first pass at 14px was imperceptible next to 13px;
     Jon: "not noticing a big difference"). */
  @media (min-width: 1536px) {
    .site-nav > ul > li > a {
      font-size: 15px;
      padding: 10px 14px;
    }
    .site-nav > ul > li > a.active::after { left: 14px; right: 14px; }
    .site-nav > ul { gap: 6px; }
  }
</style>
