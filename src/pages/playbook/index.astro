    margin-top: 22px; max-width: 34ch; font-size: 13px;
    line-height: 1.6; color: var(--warm-dim);
  }
  .pb-notyou { margin-top: 18px; }
  .pb-notyou button, .pb-linkbtn {
    background: none; border: none; padding: 6px 4px;
    font-family: var(--font-ui); font-size: 12.5px;
    color: var(--warm-dim); text-decoration: underline;
