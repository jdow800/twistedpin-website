---
export const prerender = false;

/**
 * /playbook — the internal Twisted Pin Playbook + Guidebook.
 *
 * NOT a marketing page. This is what new teammates read during onboarding.
 * noindex + robots Disallow + sitemap-excluded + isStaffPage (no analytics).
 *
 * ── FLOW ────────────────────────────────────────────────────────────────
 *   cover + password  →  "who are we talking to?"  →  hub
 *                                                      ├─ The Playbook  (read + sign)
 *                                                      └─ The Guidebook (reference, unsigned)
 *
 * The gate is checked SERVER-SIDE in this frontmatter (prerender = false), so
 * an unauthenticated request never receives a word of either book. A
 * client-side gate would ship the whole thing in View Source.
 *
 * ── WHY TWO DIFFERENT READING MODELS ────────────────────────────────────
 * The Playbook is PAGED — one chapter per screen, one button forward. Every
 * chapter in the source doc ends with a "Next CTA", the short-line pacing is
 * the voice, and paging makes "did they reach the end?" a real signal instead
 * of a scroll position. The Guidebook opens on its CONTENTS instead: nobody
 * reads a policy reference front to back, they arrive with a question.
 *
 * Both share a contents drawer (Jon's wife's feedback, 2026-07-20: "a table of
 * contents like sidebar situation would be good, so that things could easily
 * be re-referenced"). Drawer on phones, persistent sidebar ≥1025px.
 *
 * ── SIGNATURE ───────────────────────────────────────────────────────────
 * Only the Playbook is signed. The name typed at the door PRE-FILLS the
 * signature but never auto-submits it — an acknowledgment has to be an act
 * taken after reading, or it's just a login with extra steps.
 *
 * ── PHOTOGRAPHY (not yet supplied) ──────────────────────────────────────
 * Every Part One chapter carries an `imageNote` in chapters.ts describing the
 * shot it wants. When Jon picks photos, drop them in `/public/playbook/` named
 * `<chapter-id>.avif` and render above `.pb-title`; the layout already leaves
 * room. Deliberately shipping text-only rather than with stock filler.
 */

import Base from '../../layouts/Base.astro';
import { CHAPTERS } from '../../content/playbook/chapters';
import { GUIDEBOOK } from '../../content/playbook/guidebook';
import { SEARCH_ALIASES } from '../../content/playbook/search-aliases';
import {
  PLAYBOOK_COOKIE,
  PLAYBOOK_WHO_COOKIE,
  verifyToken,
  verifyWhoToken,
} from '../../lib/playbook-auth';

const authed = await verifyToken(Astro.cookies.get(PLAYBOOK_COOKIE)?.value);
const who = authed
  ? await verifyWhoToken(Astro.cookies.get(PLAYBOOK_WHO_COOKIE)?.value)
  : null;

const params = Astro.url.searchParams;
const badPassword = params.get('e') === '1';
const badName = params.get('n') === '1';
const nameStoreFailed = params.get('n') === '2';

/** cover + chapters + sign + done */
const PB_PAGES = CHAPTERS.length + 3;
/**
 * Greeting name. Uppercases ONLY the first character — deliberately not
 * title-case. Naive title-casing corrupts real names ("McDonald" → "Mcdonald",
 * "O'Brien" → "O'brien"), and mangling someone's own name to tidy a greeting
 * is a worse outcome than a lowercase "george".
 *
 * This is display-only. The STORED name stays exactly as typed — it's their
 * signature, and we don't edit those. Most phones send it capitalized anyway
 * (autocapitalize="words" on the input), so this only catches desktop typing.
 */
const rawFirst = who?.name?.split(' ')[0] ?? '';
const firstName = rawFirst ? rawFirst[0].toUpperCase() + rawFirst.slice(1) : '';

/**
 * "Walls of text" mitigation (Jon + wife's feedback, 2026-07-20).
 *
 * The irony of this book is that it's written almost entirely in short lines —
 * and that's exactly WHY it can read as a wall. Twenty single-line paragraphs
 * at identical size, weight, and spacing produce a uniform grey block; the eye
 * gets no landmark and the page reads as undifferentiated. The fix isn't to
 * cut words (Part One is locked, and the pacing is the voice) — it's to give
 * the page a visual hierarchy it currently lacks.
 *
 * Three moves, all typographic, none of which touch a single word:
 *
 *  1. BEATS get more air. A line under ~52 characters is a rhetorical beat,
 *     not a paragraph, so it gets extra breathing room. This is what turns a
 *     list of equal lines into cadence.
 *  2. The chapter's OPENING line is set as a lede — larger and lighter. Every
 *     page now has one obvious entry point instead of twenty equal ones.
 *  3. A diamond marks the story→principle turn, replacing a plain rule.
 *
 * Real photography (see the header note) is the fourth move and the biggest,
 * but Jon hasn't picked images yet and stock filler would be worse than none.
 */
const BEAT_MAX_CHARS = 52;
const isBeat = (s: string) => s.length <= BEAT_MAX_CHARS;

/* ────────────────────────────────────────────────────────────────────────
   CHAPTER PHOTOGRAPHY (Jon's picks, 2026-07-20)
   Encoded by scripts/build-playbook-images.mjs to /public/playbook/<name>-{w}.
   One photo → full-width 3:2 hero; two+ → a two-up gallery; 'timeline' → the
   captioned Our Story arc. Every photo is lazy and lives above the fold of a
   `hidden` page, so nothing here competes with first paint. The CSS frame
   (aspect-ratio + object-fit:cover) enforces the crop, so the small sources
   that couldn't upscale to the larger width still render uniformly. */
const PB_IMG = '/playbook';
const pbWidths = (kind: 'single' | 'gallery' | 'timeline'): number[] =>
  kind === 'single' ? [640, 1280] : kind === 'timeline' ? [520, 1040] : [440, 880];
const pbSrcset = (name: string, ext: string, widths: number[]): string =>
  widths.map((w) => `${PB_IMG}/${name}-${w}.${ext} ${w}w`).join(', ');

/* ────────────────────────────────────────────────────────────────────────
   SEARCH
   ────────────────────────────────────────────────────────────────────────
   Built because paging BROKE BROWSER FIND. Every chapter that isn't open is
   `hidden`, so Ctrl-F / "Find on page" can't see it — fine for Part One (read
   once, front to back) but a real defect in a reference book, where someone
   arrives at 6am with a question and no idea which chapter holds the answer.

   Deliberately NOT an LLM. This is employment policy — PTO accrual, at-will
   employment, harassment reporting, workers' comp. A model that paraphrases
   those will eventually tell an hourly teammate they get 40 hours of PTO when
   they accrue closer to 12. So search FINDS the passage and we render the
   book's own words verbatim; nothing here ever writes policy prose.

   The index is built here at request time (the page is already server-rendered)
   and serialized into the page, so filtering is instant and offline-safe. */

interface SearchEntry {
  book: 'pb' | 'gb';
  /** Page index to open. */
  page: number;
  /** DOM id of the section to scroll to. */
  anchor: string;
  chapter: string;
  section: string;
  /** Lowercased haystack: chapter + section titles + body. NO synonyms — see
   *  search-aliases.ts for why smearing them over the corpus was wrong. */
  hay: string;
  /** Colloquial phrasings that should land here (search-aliases.ts). Matched
   *  against the QUERY and weighted above any text match. */
  aliases: string[];
  /** Short preview shown under the result. */
  snippet: string;
}

function pbText(blocks: (typeof CHAPTERS)[number]['sections'][number]['blocks']): string {
  return blocks
    .map((b) => (typeof b === 'string' ? b : 'q' in b ? b.q : b.h))
    .join(' ');
}

function gbText(blocks: (typeof GUIDEBOOK)[number]['sections'][number]['blocks']): string {
  return blocks
    .map((b) => {
      if (typeof b === 'string') return b;
      if ('h' in b) return b.h;
      if ('note' in b) return b.note;
      if ('list' in b) return b.list.join(' ');
      if ('callout' in b) return b.callout.join(' ');
      return [...b.table.head, ...b.table.rows.flat()].join(' ');
    })
    .join(' ');
}

const SEARCH: SearchEntry[] = [];

CHAPTERS.forEach((ch, ci) => {
  ch.sections.forEach((sec, si) => {
    const body = pbText(sec.blocks);
    const title = sec.title && sec.title !== ch.title ? sec.title : '';
    SEARCH.push({
      book: 'pb',
      page: ci + 1,
      anchor: `s-pb-${ci}-${si}`,
      chapter: ch.title,
      section: title,
      hay: `${ch.title} ${title} ${body}`.toLowerCase(),
      aliases: SEARCH_ALIASES[title] ?? [],
      snippet: body.slice(0, 150),
    });
  });
});

GUIDEBOOK.forEach((ch, ci) => {
  ch.sections.forEach((sec, si) => {
    const body = gbText(sec.blocks);
    const title = sec.title ?? '';
    SEARCH.push({
      book: 'gb',
      page: ci,
      anchor: `s-gb-${ci}-${si}`,
      chapter: ch.title,
      section: title,
      hay: `${ch.title} ${ch.blurb} ${title} ${body}`.toLowerCase(),
      aliases: SEARCH_ALIASES[title] ?? [],
      snippet: body.slice(0, 150),
    });
  });
});

// Surface alias keys that don't match any section title — a typo here would
// otherwise fail silently, leaving a dead alias nobody notices.
const MATCHED = new Set(SEARCH.map((e) => e.section).filter(Boolean));
const ORPHANS = Object.keys(SEARCH_ALIASES).filter((k) => !MATCHED.has(k));
if (ORPHANS.length) {
  console.warn('[playbook/search] aliases with no matching section:', ORPHANS.join(', '));
}
---

<Base
  title="The Twisted Pin Playbook"
  description="Internal culture book for Twisted Pin teammates."
  hideStickyCTA={true}
  hideHeader={true}
  hidePromo={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  {/* ═══════════════════════ 1. GATE ═══════════════════════ */}
  {!authed && (
    <main class="pb-gate">
      <img class="pb-gate-logo" src="/logo/twisted-pin-horizontal-glow.png"
           alt="Twisted Pin" width="260" height="70" />
      <p class="pb-gate-kicker">2026 Playbook</p>
      <h1 class="pb-gate-title">Because Every Lane Has a Story.</h1>
      <form class="pb-gate-form" method="POST" action="/api/playbook-auth/">
        <label class="pb-gate-label" for="pb-pw">Team password</label>
        <input id="pb-pw" name="password" type="password" autocomplete="current-password"
               autocapitalize="off" autocorrect="off" spellcheck="false" required
               aria-describedby={badPassword ? 'pb-gate-err' : undefined} />
        {badPassword && (
          <p class="pb-gate-err" id="pb-gate-err" role="alert">
            That's not it. Check with your manager and try again.
          </p>
        )}
        <button type="submit">Begin Your Story</button>
      </form>
      <p class="pb-gate-help">
        Every teammate gets this password on their first day. If you don't have
        it, ask a manager — we'd rather answer a question than have you wonder.
      </p>
    </main>
  )}

  {/* ═══════════════════════ 2. WHO ═══════════════════════ */}
  {authed && !who && (
    <main class="pb-gate">
      <img class="pb-gate-logo" src="/logo/twisted-pin-horizontal-glow.png"
           alt="Twisted Pin" width="260" height="70" />
      <h1 class="pb-gate-title pb-who-title">Before we start — who are we talking to?</h1>
      <form class="pb-gate-form" method="POST" action="/api/playbook-who/">
        <label class="pb-gate-label" for="pb-name">Your name</label>
        <input id="pb-name" name="name" type="text" autocomplete="name"
               autocapitalize="words" required placeholder="First and last"
               aria-describedby={badName || nameStoreFailed ? 'pb-name-err' : undefined} />
        {badName && (
          <p class="pb-gate-err" id="pb-name-err" role="alert">
            We just need a first and last name.
          </p>
        )}
        {nameStoreFailed && (
          <p class="pb-gate-err" id="pb-name-err" role="alert">
            Something went wrong on our end. Try again, or grab a manager.
          </p>
        )}
        <button type="submit">That's me</button>
      </form>
      <p class="pb-gate-help">
        We ask so we know you've had a chance to read this — and so we can stop
        calling you "teammate" for the next twenty minutes.
      </p>
    </main>
  )}

  {/* ═══════════════════════ 3. THE BOOKS ═══════════════════════ */}
  {authed && who && (
    <main class="pb" data-pb-pages={PB_PAGES} data-gb-pages={GUIDEBOOK.length} data-sid={who.sid}>

      {/* ── top chrome: shared by both readers ── */}
      <div class="pb-bar" data-bar hidden>
        <button class="pb-bar-btn" type="button" data-toc-open aria-expanded="false">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          Contents
        </button>
        <button class="pb-bar-btn pb-bar-home" type="button" data-go-hub>Home</button>
      </div>
      <div class="pb-rail" aria-hidden="true"><span class="pb-rail-fill"></span></div>

      {/* ── contents drawer / sidebar ── */}
      <div class="pb-toc-scrim" data-toc-scrim hidden></div>
      <nav class="pb-toc" data-toc hidden aria-label="Contents">
        <div class="pb-toc-head">
          <span class="pb-toc-title" data-toc-book>Contents</span>
          <button class="pb-toc-close" type="button" data-toc-close aria-label="Close contents">✕</button>
        </div>

        {/* Search. Covers BOTH books regardless of which one you're in — a
            teammate looking for "call off" shouldn't have to know it lives in
            the Guidebook. */}
        <div class="pb-search">
          <input type="search" id="pb-search-input" placeholder="Search both books…"
                 autocomplete="off" autocapitalize="off" spellcheck="false"
                 aria-label="Search the Playbook and Guidebook" />
        </div>
        <div class="pb-results" data-results hidden>
          <p class="pb-results-empty" data-results-empty hidden>
            Nothing matched that. Try a different word — or just ask a manager.
            We'd rather answer a question than have you wonder.
          </p>
          <ul class="pb-results-list" data-results-list></ul>
        </div>

        <script is:inline type="application/json" data-search-index set:html={JSON.stringify(SEARCH)}></script>
        <ol class="pb-toc-list" data-toc-list-pb>
          {CHAPTERS.map((ch, i) => (
            <li><button type="button" data-jump="pb" data-index={i + 1}>{ch.title}</button></li>
          ))}
          <li><button type="button" data-jump="pb" data-index={CHAPTERS.length + 1}>Sign the Playbook</button></li>
        </ol>
        <ol class="pb-toc-list" data-toc-list-gb hidden>
          {GUIDEBOOK.map((ch, i) => (
            <li>
              <button type="button" data-jump="gb" data-index={i}>
                {ch.title}
                <span class="pb-toc-blurb">{ch.blurb}</span>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      {/* ── 3a. HUB ── */}
      <section class="pb-view pb-hub is-active" data-view="hub">
        <img class="pb-hub-logo" src="/logo/twisted-pin-horizontal-glow.png"
             alt="Twisted Pin" width="220" height="59" />
        <p class="pb-hub-hi">Welcome{firstName ? `, ${firstName}` : ''}.</p>
        <h1 class="pb-hub-title">Two halves. One story.</h1>

        <button class="pb-card" type="button" data-open-book="pb">
          <span class="pb-card-eyebrow">Part One</span>
          <span class="pb-card-title">The Playbook</span>
          <span class="pb-card-desc">
            Who we are, how we think, and the moments that made us. Read it once,
            end to end, then sign at the bottom.
          </span>
          <span class="pb-card-meta" data-pb-status>Start reading →</span>
        </button>

        <button class="pb-card pb-card--alt" type="button" data-open-book="gb">
          <span class="pb-card-eyebrow">Part Two</span>
          <span class="pb-card-title">The Guidebook</span>
          <span class="pb-card-desc">
            How we work. Scheduling, time off, uniforms, pay, safety, and perks.
            No signature needed — come back whenever a question comes up.
          </span>
          <span class="pb-card-meta">Browse the contents →</span>
        </button>

        <p class="pb-hub-foot">
          If you can't find an answer in either one, ask.
          We'd rather answer a question than have you wonder.
        </p>

        {/* "Not you?" — the shared front-desk case. Quiet by design: the
            teammate it's for is looking for it, and everyone else should not
            be nudged toward clearing their own progress. */}
        <form class="pb-notyou" method="POST" action="/api/playbook-who-reset/">
          <button type="submit">
            Not {firstName || 'you'}? Switch teammate
          </button>
        </form>
      </section>

      {/* ── 3b. THE PLAYBOOK (paged) ── */}
      <section class="pb-view" data-view="pb" hidden>
        {/* cover */}
        <article class="pb-page is-active" data-pb-page="0">
          <img class="pb-cover-logo" src="/logo/twisted-pin-horizontal-glow.png"
               alt="Twisted Pin" width="300" height="81" />
          <p class="pb-cover-year">Part One</p>
          <h1 class="pb-cover-line">Because Every Lane Has a Story.</h1>
          <button class="pb-next pb-next--cover" type="button" data-next>
            <span class="pb-arrow" aria-hidden="true">↓</span>
            Begin Your Story
          </button>
        </article>

        {CHAPTERS.map((ch, i) => (
          <article class="pb-page" data-pb-page={i + 1} data-chapter={ch.id} hidden>
            <div class="pb-body">
              {ch.photos && ch.photos.length > 0 && (() => {
                const single = ch.photos.length === 1;
                const kind = single ? 'single' : ch.photoLayout === 'timeline' ? 'timeline' : 'gallery';
                const widths = pbWidths(kind);
                const sizes = single
                  ? '(min-width: 1025px) 544px, calc(100vw - 48px)'
                  : '(min-width: 1025px) 250px, 45vw';
                return (
                  <div class={`pb-photos pb-photos--${kind}`}>
                    {ch.photos.map((ph) => (
                      <figure class="pb-photo">
                        <picture>
                          <source type="image/avif" srcset={pbSrcset(ph.name, 'avif', widths)} sizes={sizes} />
                          <source type="image/webp" srcset={pbSrcset(ph.name, 'webp', widths)} sizes={sizes} />
                          <img src={`${PB_IMG}/${ph.name}-${widths[0]}.jpg`}
                               srcset={pbSrcset(ph.name, 'jpg', widths)} sizes={sizes}
                               alt={ph.alt} loading="lazy" decoding="async" />
                        </picture>
                        {kind === 'timeline' && ph.caption && (
                          <figcaption class="pb-photo-cap">{ph.caption}</figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                );
              })()}
              <p class="pb-count">
                <span>{String(i + 1).padStart(2, '0')}</span> / {CHAPTERS.length}
              </p>
              <h2 class="pb-title">{ch.title}</h2>
              {ch.sections.map((sec, si) => (
                <div class={`pb-section${si > 0 ? ' pb-section--sub' : ''}`} id={`s-pb-${i}-${si}`}>
                  {sec.eyebrow && <p class="pb-eyebrow">{sec.eyebrow}</p>}
                  {sec.title && sec.title !== ch.title && (
                    <h3 class="pb-subtitle">{sec.title}</h3>
                  )}
                  {sec.blocks.map((b, bi) =>
                    typeof b === 'string' ? (
                      <p
                        class:list={[
                          'pb-p',
                          { 'pb-p--lede': si === 0 && bi === 0 },
                          { 'pb-p--beat': isBeat(b) },
                        ]}
                      >{b}</p>
                    )
                    : 'q' in b ? <p class="pb-quote">{b.q}</p>
                    : <p class="pb-h">{b.h}</p>
                  )}
                </div>
              ))}
            </div>
            <button class="pb-next" type="button" data-next>
              {ch.nextLabel ?? 'Continue'}
              <span class="pb-arrow" aria-hidden="true">→</span>
            </button>
          </article>
        ))}

        {/* signature */}
        <article class="pb-page pb-ack" data-pb-page={CHAPTERS.length + 1} hidden>
          <div class="pb-body">
            <h2 class="pb-title">One Signature.</h2>
            <p class="pb-p">You've read the whole thing. Thank you for that.</p>
            <p class="pb-p">
              Sign below so we know you've had the chance to read it — and so you
              know where to find it when a question comes up.
            </p>

            <form class="pb-ack-form" id="pb-ack-form" novalidate>
              <label class="pb-ack-label" for="ack-name">Your full name</label>
              <input id="ack-name" name="name" type="text" autocomplete="name" required
                     placeholder="First and last" value={who.name} />
              {/* The pre-filled name is the one real risk on a shared device.
                  Editing the field alone would sign under a fresh name but keep
                  the previous teammate's reading session, so the escape hatch
                  here resets identity properly rather than just retyping. */}
              <p class="pb-ack-hint">
                Signing as <b>{who.name}</b>.
                <button type="button" class="pb-linkbtn" data-not-you>Not you?</button>
              </p>

              {/* Honeypot — hidden from humans, filled by naive bots. */}
              <div class="pb-hp" aria-hidden="true">
                <label for="ack-website">Website</label>
                <input id="ack-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <label class="pb-check">
                <input id="ack-agree" name="agree" type="checkbox" required />
                <span>
                  I've read the Twisted Pin Playbook. I understand that if I'm
                  ever unsure about something, I should ask.
                </span>
              </label>

              <button type="submit" id="pb-ack-submit">Sign the Playbook</button>
              <p class="pb-ack-msg" id="pb-ack-msg" role="status" aria-live="polite"></p>
            </form>
          </div>
        </article>

        {/* confirmation */}
        <article class="pb-page pb-done" data-pb-page={CHAPTERS.length + 2} hidden>
          <p class="pb-done-mark" aria-hidden="true">✓</p>
          <h2 class="pb-title">Welcome to the Fam.</h2>
          <p class="pb-p" id="pb-done-name"></p>
          <p class="pb-p pb-done-sub">Every lane has a story. Thank you for becoming part of ours.</p>
          <p class="pb-p pb-done-sub">Now go be part of someone else's.</p>
          <button class="pb-next" type="button" data-open-book="gb">
            Have a look at the Guidebook
            <span class="pb-arrow" aria-hidden="true">→</span>
          </button>
        </article>
      </section>

      {/* ── 3c. THE GUIDEBOOK (contents-first) ── */}
      <section class="pb-view" data-view="gb" hidden>
        <article class="pb-gb-page is-active" data-gb-page="-1">
          <div class="pb-body">
            <p class="pb-part">Part Two</p>
            <h2 class="pb-title">The Guidebook</h2>
            <p class="pb-p pb-gb-lede">
              How we work. Pick what you need — you're not expected to read this
              front to back.
            </p>
            <ol class="pb-gb-index">
              {GUIDEBOOK.map((ch, i) => (
                <li>
                  <button type="button" data-jump="gb" data-index={i}>
                    <span class="pb-gb-index-n">{String(i + 1).padStart(2, '0')}</span>
                    <span>
                      <span class="pb-gb-index-t">{ch.title}</span>
                      <span class="pb-gb-index-b">{ch.blurb}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </article>

        {GUIDEBOOK.map((ch, i) => (
          <article class="pb-gb-page" data-gb-page={i} hidden>
            <div class="pb-body">
              <p class="pb-part">Part Two — The Guidebook</p>
              <h2 class="pb-title">{ch.title}</h2>
              {ch.sections.map((sec, si) => (
                <div class="pb-section pb-section--gb" id={`s-gb-${i}-${si}`}>
                  {sec.title && <h3 class="pb-subtitle">{sec.title}</h3>}
                  {sec.blocks.map((b) => {
                    if (typeof b === 'string') {
                      return <p class:list={['pb-p', { 'pb-p--beat': isBeat(b) }]}>{b}</p>;
                    }
                    if ('h' in b) return <p class="pb-h">{b.h}</p>;
                    if ('note' in b) return <p class="pb-note">{b.note}</p>;
                    if ('list' in b) return (
                      <ul class="pb-list">{b.list.map((li) => <li>{li}</li>)}</ul>
                    );
                    if ('callout' in b) return (
                      <div class="pb-callout">{b.callout.map((c) => <p>{c}</p>)}</div>
                    );
                    return (
                      <div class="pb-table-wrap">
                        <table class="pb-table">
                          <thead><tr>{b.table.head.map((h) => <th>{h}</th>)}</tr></thead>
                          <tbody>
                            {b.table.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}
                          </tbody>
                        </table>
                      </div>
                    );
                  })}
                </div>
              ))}
              <div class="pb-gb-nav">
                {i > 0 && (
                  <button class="pb-gb-navbtn" type="button" data-jump="gb" data-index={i - 1}>
                    ← {GUIDEBOOK[i - 1].title}
                  </button>
                )}
                {i < GUIDEBOOK.length - 1 && (
                  <button class="pb-gb-navbtn pb-gb-navbtn--next" type="button"
                          data-jump="gb" data-index={i + 1}>
                    {GUIDEBOOK[i + 1].title} →
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>
  )}
</Base>

<style>
  /* ============================================================
     Playbook — full-bleed reading experience.
     The writing is the design. Almost no chrome on purpose.
     ============================================================ */

  /* ---------- gate + who ---------- */
  .pb-gate {
