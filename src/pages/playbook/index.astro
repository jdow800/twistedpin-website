  /* ---------- search ---------- */
  .pb-search { padding: 12px 14px 8px; }
  .pb-search input {
    width: 100%;
    /* 16px minimum, always — below it iOS zooms on focus and never returns,
       and this input is the first thing a hurried teammate taps. */
    font-size: 16px; font-family: var(--font-ui);
    padding: 11px 12px; border-radius: var(--radius-button);
    border: 1px solid rgba(244, 239, 227, 0.18);
    background: #171327; color: var(--warm-white);
    -webkit-appearance: none; appearance: none;
