  }

  .pb-toc-list { list-style: none; margin: 0; padding: 8px 0; }
  .pb-toc-list[hidden] { display: none; }
  .pb-toc-list button {
    display: block; width: 100%; text-align: left;
    padding: 12px 16px; min-height: 44px;
    font-family: var(--font-ui); font-size: 14px; line-height: 1.35;
