  :global(.pb-results-list) { list-style: none; margin: 0; padding: 0; }
  :global(.pb-results-list li) { margin: 0; padding: 0; }
  :global(.pb-results-list button) {
    display: block; width: 100%; text-align: left;
    padding: 12px 16px; min-height: 44px;
    background: transparent; border: none; cursor: pointer;
    border-left: 2px solid transparent;
    border-bottom: 1px solid rgba(244, 239, 227, 0.07);
    font-family: var(--font-ui);
  }
  :global(.pb-results-list button:hover) {
    background: rgba(244, 239, 227, 0.04); border-left-color: var(--glow);
  }
  :global(.pb-res-book) {
    display: block; font-size: 9.5px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--glow); margin: 0 0 4px; line-height: 1.2;
  }
  :global(.pb-res-title) {
    display: block; font-weight: 700; font-size: 14px; line-height: 1.3;
    color: var(--warm-white); margin: 0 0 4px;
  }
  :global(.pb-res-where) {
    display: block; font-size: 11px; line-height: 1.3;
    color: var(--warm-dim); margin: 0 0 4px;
