  .pb-search input::placeholder { color: var(--warm-dim); }
  /* ⚠️ THESE MUST BE :global().
     Search results are built with document.createElement at runtime, and
     Astro scopes styles by stamping a data-astro-cid-* attribute onto elements
     AT BUILD TIME. Runtime-created nodes never get that attribute, so scoped
     rules silently don't match them — the spans fell back to display:inline at
     inherited size, and every result rendered as one run-on line of big
     centered text ("GuidebookWork SchedulesShowing Up for Success — ...").
     The class names are unique enough that going global costs nothing.
     If you ever restyle a result, check it in the browser, not just the file. */
  .pb-results { padding: 4px 0 10px; }
  .pb-results[hidden] { display: none; }
  :global(.pb-results-empty) {
    padding: 10px 16px 14px; font-size: 13px; line-height: 1.55;
