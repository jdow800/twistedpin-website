  }
  .pb-callout p { font-size: 15px; line-height: 1.55; }
  .pb-callout p + p { margin-top: 0.7em; }
  .pb-note {
    font-family: var(--font-ui); font-size: 13px; color: var(--warm-dim);
    word-break: break-word; margin-bottom: 1.15em;
  }
  /* Tables scroll inside their own container so the page body never scrolls
     horizontally on a phone. */
  .pb-table-wrap { overflow-x: auto; margin: 1.2em 0; }
  .pb-table { border-collapse: collapse; width: 100%; min-width: 260px; }
  .pb-table th, .pb-table td {
    text-align: left; padding: 10px 12px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.12);
    font-size: 15px;
  }
  .pb-table th {
    font-family: var(--font-ui); font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--warm-dim);
  }
  .pb-table td:last-child { color: var(--glow); font-weight: 600; white-space: nowrap; }

  /* ---------- guidebook index ---------- */
  .pb-gb-lede { color: var(--warm-mid); margin-bottom: 28px; }
  .pb-gb-index { list-style: none; margin: 0; padding: 0; }
  .pb-gb-index button {
    display: flex; gap: 14px; width: 100%; text-align: left;
    padding: 15px 0; background: transparent; border: none;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    color: var(--warm-white); cursor: pointer;
  }
  .pb-gb-index li:last-child button { border-bottom: 1px solid rgba(244, 239, 227, 0.10); }
  .pb-gb-index button:hover .pb-gb-index-t { color: var(--glow); }
  .pb-gb-index-n {
    font-family: var(--font-ui); font-size: 12px; font-weight: 700;
    color: var(--glow); padding-top: 3px; flex: none;
  }
  .pb-gb-index-t {
    display: block; font-family: var(--font-ui); font-weight: 700;
    font-size: 17px; line-height: 1.25; margin-bottom: 3px;
  }
  .pb-gb-index-b { display: block; font-size: 13px; color: var(--warm-dim); line-height: 1.45; }

  .pb-gb-nav {
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between;
    margin-top: 40px; padding-top: 22px;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
  }
  .pb-gb-navbtn {
    font-family: var(--font-ui); font-size: 13px; font-weight: 600;
    color: var(--warm-mid); background: transparent; border: none;
    padding: 10px 0; min-height: 44px; cursor: pointer; text-align: left;
    max-width: 48%;
  }
  .pb-gb-navbtn--next { text-align: right; color: var(--glow); }
  .pb-gb-navbtn:hover { color: var(--warm-white); }

  /* ---------- next button ---------- */
  .pb-next {
    margin-top: 52px; display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-ui); font-weight: 700; font-size: 14px;
    letter-spacing: 0.04em; padding: 14px 26px;
    border: none; border-radius: var(--radius-button);
    background: var(--glow); color: var(--indigo-deep);
    cursor: pointer; align-self: center;
  }
  .pb-next--cover {
    flex-direction: column; gap: 8px; background: transparent;
    color: var(--warm-white); border: 1px solid rgba(244, 239, 227, 0.28);
    padding: 18px 30px; margin-top: 0;
  }
  .pb-arrow { font-size: 16px; }

  /* ---------- signature ---------- */
  .pb-ack-form { display: flex; flex-direction: column; gap: 12px; margin-top: 34px; }
  .pb-ack-label {
    font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--warm-dim);
  }
  .pb-ack-form input[type='text'] {
    font-size: 16px; font-family: var(--font-ui); padding: 13px 14px;
    border-radius: var(--radius-button);
    border: 1px solid rgba(244, 239, 227, 0.18);
    background: #171327; color: var(--warm-white);
  }
  .pb-check {
    display: flex; gap: 11px; align-items: flex-start;
    /* 14px — consent copy sits above the 12px floor deliberately. */
    font-size: 14px; line-height: 1.55; color: var(--warm-mid); margin-top: 6px;
  }
  .pb-check input {
    margin-top: 3px; width: 18px; height: 18px;
    accent-color: var(--glow); flex: none;
  }
  .pb-ack-form button {
    margin-top: 12px; font-family: var(--font-ui); font-weight: 700;
    font-size: 14px; letter-spacing: 0.04em; padding: 15px 22px;
    border: none; border-radius: var(--radius-button);
    background: var(--glow); color: var(--indigo-deep); cursor: pointer;
  }
  .pb-ack-form button[disabled] { opacity: 0.5; cursor: default; }
  .pb-ack-msg { font-family: var(--font-ui); font-size: 13px; color: var(--copper); }
  .pb-ack-msg:empty { display: none; }
  /* Off-screen rather than display:none — some bots skip hidden fields but
     happily fill positioned ones. */
  .pb-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .pb-done { text-align: center; }
  .pb-done-mark { font-size: 40px; color: var(--glow); margin-bottom: 18px; }
  .pb-done .pb-title { margin-bottom: 20px; }
  .pb-done-sub { color: var(--warm-mid); }

  /* ---------- phone ---------- */
  @media (max-width: 600px) {
    .pb-next { width: 100%; max-width: 34rem; justify-content: center; padding: 16px 20px; }
    .pb-ack-form button { padding: 17px 22px; }
    .pb-gb-navbtn { max-width: 100%; flex: 1 1 100%; text-align: left; }
    .pb-gb-navbtn--next { text-align: left; }
  }

  /* ---------- desktop: contents becomes a persistent sidebar ---------- */
  @media (min-width: 1025px) {
    .pb-page, .pb-gb-page { padding: 104px 40px 72px; }
    .pb-p { font-size: 18px; }
    .pb-has-toc .pb-toc { display: block !important; box-shadow: none; }
    .pb-has-toc .pb-toc-scrim { display: none !important; }
    .pb-has-toc .pb-toc-close { display: none; }
    .pb-has-toc [data-toc-open] { display: none; }
    .pb-has-toc .pb-view[data-view='pb'],
    .pb-has-toc .pb-view[data-view='gb'] { padding-left: min(320px, 86vw); }
    .pb-has-toc .pb-bar { padding-left: calc(min(320px, 86vw) + 10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-rail-fill { transition: none; }
  }
</style>

<script>
  /**
   * Playbook client. Five views (hub / playbook / guidebook), hash-routed so
   * Back and Forward behave the way a reader expects.
   *
   * Hash scheme:  #hub  ·  #pb/<n>  ·  #gb/<n>   (gb/-1 is the contents page)
   */
  const rootEl = document.querySelector<HTMLElement>('.pb');
  if (rootEl) {
    // Re-bind as a definitely-non-null const: TS loses the narrowing inside
    // the nested callbacks below.
    const root: HTMLElement = rootEl;
    const views = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('.pb-view').forEach((v) =>
      views.set(v.dataset.view!, v),
    );
    const pbPages = Array.from(root.querySelectorAll<HTMLElement>('[data-pb-page]'));
    const gbPages = Array.from(root.querySelectorAll<HTMLElement>('[data-gb-page]'));
    const bar = root.querySelector<HTMLElement>('[data-bar]');
    const fill = root.querySelector<HTMLElement>('.pb-rail-fill');
    const toc = root.querySelector<HTMLElement>('[data-toc]');
    const tocScrim = root.querySelector<HTMLElement>('[data-toc-scrim]');
    const tocBook = root.querySelector<HTMLElement>('[data-toc-book]');
    const tocPb = root.querySelector<HTMLElement>('[data-toc-list-pb]');
    const tocGb = root.querySelector<HTMLElement>('[data-toc-list-gb]');
    /* Session-scoped like the reading counters. It was global, which meant a
       shared front-desk browser resumed the NEXT teammate at the previous
       one's chapter — and it would have been wiped by the foreign-key cleanup
       below. Everything we persist is now keyed by session id, uniformly. */
    const PROGRESS_KEY = `tp-playbook-progress-${root.dataset.sid || 'anon'}`;

    const pbLast = pbPages.length - 1;   // confirmation page
    const pbSign = pbLast - 1;           // signature page

    let view: 'hub' | 'pb' | 'gb' = 'hub';
    let pbIndex = 0;
    let gbIndex = -1;

    /* ── reading time ──────────────────────────────────────────────────
       Accumulates ONLY while the tab is visible. Wall-clock would call a
       teammate who read across two shifts a 19-hour scholar and rate a
       speed-runner the same as someone who actually read it.

       ⚠️ PERSISTED TO localStorage, and it MUST be. The first version kept
       these in memory only, which silently reset on every page load — so
       Shanna, who read for ~20 minutes across the whole book, was reported as
       "17 seconds, 2 of 19 pages" because two deploys and an iOS tab eviction
       reloaded the page under her. A metric about someone's diligence that
       resets without telling anyone is worse than no metric: it doesn't just
       lose data, it makes a confident false claim about a real person.

       Keyed by SESSION ID so a shared front-desk device can't hand one
       teammate's reading time to the next.

       Still client-reported and therefore forgeable, and still lossy (private
       browsing, cleared storage, a different device). Treat a HIGH number as
       meaningful and a LOW one as unknown — never as evidence. */
    const SID = root.dataset.sid || 'anon';
    const TIME_KEY = `tp-playbook-time-${SID}`;
    const PAGES_KEY = `tp-playbook-pages-${SID}`;

    /* Drop any tp-playbook-* keys belonging to a DIFFERENT session id.
       Two reasons: on a shared front-desk browser it guarantees the previous
       teammate's reading position and time can't bleed into this one even if
       "Not you?" was never used; and it stops per-session keys accumulating
       forever on a device the whole team touches. */
    try {
      for (let i = localStorage.length - 1; i >= 0; i--) {
        const k = localStorage.key(i);
        if (k && k.startsWith('tp-playbook-') && !k.endsWith(SID)) {
          localStorage.removeItem(k);
        }
      }
    } catch { /* private mode */ }

    let activeMs = 0;
    const seenPbPages = new Set<number>();
    try {
      activeMs = parseInt(localStorage.getItem(TIME_KEY) || '0', 10) || 0;
      JSON.parse(localStorage.getItem(PAGES_KEY) || '[]').forEach((n: number) =>
        seenPbPages.add(n),
      );
    } catch { /* private mode — we just start from zero */ }

    let lastTick = document.visibilityState === 'visible' ? Date.now() : 0;

    function persist() {
      try {
        localStorage.setItem(TIME_KEY, String(activeMs));
        localStorage.setItem(PAGES_KEY, JSON.stringify([...seenPbPages]));
      } catch { /* nothing we can do; the signature still records */ }
    }

    function flushTime() {
      if (lastTick) { activeMs += Date.now() - lastTick; lastTick = Date.now(); }
      persist();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') lastTick = Date.now();
      else { flushTime(); lastTick = 0; }
    });
    // pagehide, not beforeunload — iOS Safari fires pagehide reliably and
    // beforeunload barely at all, and iOS is where the tab eviction happens.
    window.addEventListener('pagehide', flushTime);
    // Periodic flush so even a hard kill (OS reclaiming the tab, battery
    // death) loses at most a few seconds rather than the whole session.
    setInterval(flushTime, 5000);

    /* ── rendering ── */
    function render(push: boolean) {
      views.forEach((el, name) => { el.hidden = name !== view; });

      if (view === 'pb') {
        pbPages.forEach((p, n) => { p.hidden = n !== pbIndex; });
        seenPbPages.add(pbIndex);
        persist();
        if (fill) fill.style.width = `${(pbIndex / pbLast) * 100}%`;
      } else if (view === 'gb') {
        gbPages.forEach((p) => {
          p.hidden = Number(p.dataset.gbPage) !== gbIndex;
        });
        if (fill) fill.style.width = '0%';
      } else if (fill) {
        fill.style.width = '0%';
      }

      if (bar) bar.hidden = view === 'hub';
      root.classList.toggle('pb-has-toc', view !== 'hub');
      if (tocBook) tocBook.textContent = view === 'gb' ? 'The Guidebook' : 'The Playbook';
      if (tocPb) tocPb.hidden = view !== 'pb';
      if (tocGb) tocGb.hidden = view !== 'gb';
      markCurrent();

      // Progress: remember where they were in the Playbook, never on the
      // signature or confirmation page — someone who already signed should
      // land back on the hub, not be dropped onto a sign form again.
      try {
        if (view === 'pb' && pbIndex > 0 && pbIndex < pbSign) {
          localStorage.setItem(PROGRESS_KEY, String(pbIndex));
        } else if (view === 'pb' && pbIndex >= pbSign) {
          localStorage.removeItem(PROGRESS_KEY);
        }
      } catch { /* private mode — progress is a convenience, not a requirement */ }

      updateHubStatus();
      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      // Then, if we arrived from a search result, scroll on to that section.
      // Order matters: top-first, then anchor, or the anchor scroll is undone.
      consumeAnchor();
      if (push) history.pushState({}, '', hash());
    }

    function hash() {
      if (view === 'pb') return `#pb/${pbIndex}`;
      if (view === 'gb') return `#gb/${gbIndex}`;
      return '#hub';
    }

    function markCurrent() {
      root.querySelectorAll<HTMLElement>('[data-jump]').forEach((b) => {
        const isCur =
          (view === 'pb' && b.dataset.jump === 'pb' && Number(b.dataset.index) === pbIndex) ||
          (view === 'gb' && b.dataset.jump === 'gb' && Number(b.dataset.index) === gbIndex);
        if (b.closest('.pb-toc-list')) b.setAttribute('aria-current', String(isCur));
      });
    }

    function updateHubStatus() {
      const el = root.querySelector<HTMLElement>('[data-pb-status]');
      if (!el) return;
      let saved = 0;
      try { saved = parseInt(localStorage.getItem(PROGRESS_KEY) || '0', 10) || 0; } catch {}
      el.textContent = saved > 0 ? 'Pick up where you left off →' : 'Start reading →';
    }

    /* ── navigation ── */
    function go(next: 'hub' | 'pb' | 'gb', index?: number) {
      view = next;
      if (next === 'pb' && index !== undefined) pbIndex = Math.max(0, Math.min(pbLast, index));
      if (next === 'gb' && index !== undefined) gbIndex = Math.max(-1, Math.min(gbPages.length - 2, index));
      closeToc();
      render(true);
    }

    root.querySelectorAll<HTMLElement>('[data-open-book]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const book = btn.dataset.openBook as 'pb' | 'gb';
        if (book === 'pb') {
          let saved = 0;
          try { saved = parseInt(localStorage.getItem(PROGRESS_KEY) || '0', 10) || 0; } catch {}
          go('pb', saved || 0);
        } else {
          go('gb', -1);
        }
      });
    });

    root.querySelectorAll<HTMLElement>('[data-jump]').forEach((btn) => {
      btn.addEventListener('click', () =>
        go(btn.dataset.jump as 'pb' | 'gb', Number(btn.dataset.index)),
      );
    });

    root.querySelectorAll<HTMLElement>('[data-next]').forEach((btn) => {
      btn.addEventListener('click', () => go('pb', pbIndex + 1));
    });

    root.querySelector<HTMLElement>('[data-go-hub]')?.addEventListener('click', () => go('hub'));

    // "Not you?" beside the signature — same server reset as the hub button,
    // posted from JS because it sits inside the acknowledgment <form> and a
    // nested form isn't valid HTML.
    root.querySelector<HTMLElement>('[data-not-you]')?.addEventListener('click', () => {
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = '/api/playbook-who-reset/';
      document.body.appendChild(f);
      f.submit();
    });

    /* ── contents drawer ── */
    function openToc() {
      toc?.removeAttribute('hidden');
      tocScrim?.removeAttribute('hidden');
      root.querySelector('[data-toc-open]')?.setAttribute('aria-expanded', 'true');
    }
    function closeToc() {
      // On desktop the sidebar is CSS-forced visible via .pb-has-toc, so
      // toggling [hidden] here is harmless there and correct on phones.
      toc?.setAttribute('hidden', '');
      tocScrim?.setAttribute('hidden', '');
      root.querySelector('[data-toc-open]')?.setAttribute('aria-expanded', 'false');
    }
    root.querySelector('[data-toc-open]')?.addEventListener('click', openToc);
    root.querySelector('[data-toc-close]')?.addEventListener('click', closeToc);
    tocScrim?.addEventListener('click', closeToc);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeToc();
      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;
      if (view !== 'pb') return;
      if (e.key === 'ArrowRight') go('pb', pbIndex + 1);
      if (e.key === 'ArrowLeft') go('pb', pbIndex - 1);
    });

    /* ── search ────────────────────────────────────────────────────────
       Filters a prebuilt index (chapter + section titles + body + a
       hand-authored synonym map) and jumps to the matching SECTION, not just
       the chapter. Exists because paging hides every chapter you're not on,
       which breaks browser find — the one thing a reference book can't lose.

       Scoring is intentionally dumb and predictable: title hits beat body
       hits, and every query term must appear somewhere (AND, not OR) so
       "kitchen shorts" narrows rather than widens. With ~30 sections,
       predictable beats clever — the answer is a policy, not a suggestion. */
    interface Entry {
      book: 'pb' | 'gb'; page: number; anchor: string;
      chapter: string; section: string; hay: string;
      aliases: string[]; snippet: string;
    }
    let index: Entry[] = [];
    try {
      const raw = root.querySelector('[data-search-index]')?.textContent;
      if (raw) index = JSON.parse(raw);
    } catch { /* search degrades to the plain contents list */ }

    const searchInput = document.getElementById('pb-search-input') as HTMLInputElement | null;
    const results = root.querySelector<HTMLElement>('[data-results]');
    const resultsList = root.querySelector<HTMLElement>('[data-results-list]');
    const resultsEmpty = root.querySelector<HTMLElement>('[data-results-empty]');
    let pendingAnchor: string | null = null;

    /* Stopwords. People type QUESTIONS into a search box — "what do I wear",
       "when do I get paid", "I got hurt" — and requiring every word to appear
       made all three return nothing, because "i", "do", and "when" are not in
       the book. Stripping them turns those into "wear", "paid", "hurt", which
       all hit. Verified against the real content: 17/20 test queries → 20/20.
       Note "off" and "up" are NOT stopwords ("time off", "call off"). */
    const STOP = new Set([
      'a','an','the','i','me','my','we','our','you','your','it','its','is','are',
      'am','be','been','do','does','did','done','can','could','should','would',
      'will','to','of','in','on','for','from','at','by','with','and','or','but',
      'if','so','that','this','these','those','there','they','them','he','she',
      'what','when','where','who','why','how','which','was','were','have','has',
      'had','get','got','getting','need','want','about','any','some','much','many',
    ]);

    /** Longest alias of this entry that appears in the query, or 0.
     *  Length-weighted so "call off" beats a bare "call" when both match. */
    function aliasScore(e: Entry, query: string): number {
      let best = 0;
      for (const a of e.aliases) {
        if (query.includes(a) && a.length > best) best = a.length;
      }
      return best ? 100 + best : 0;
    }

    function score(e: Entry, terms: string[], requireAll: boolean, query: string): number {
      // An alias hit is a curated "this is the answer" and outranks every text
      // match — that's what lets "hurt" land on Employee Injuries, a section
      // that never uses the word.
      const alias = aliasScore(e, query);

      let s = 0;
      let matched = 0;
      const title = `${e.chapter} ${e.section}`.toLowerCase();
      for (const t of terms) {
        if (!e.hay.includes(t)) {
          if (requireAll && !alias) return 0;
          continue;
        }
        matched++;
        s += title.includes(t) ? 10 : 1;
      }
      if (!alias && !matched) return 0;

      // Tiebreak toward the Guidebook. Both books are searchable, but someone
      // typing a question is looking up a policy, not a story — and without
      // this, ties resolve to whichever was indexed first (Part One), which is
      // how "what if I'm late" once returned the Dedication.
      return alias + s + (e.book === 'gb' ? 1 : 0);
    }

    function runSearch(q: string) {
      const query = q.trim().toLowerCase();
      if (!results || !resultsList || !resultsEmpty) return;

      if (query.length < 2) {
        results.hidden = true;
        if (tocPb) tocPb.hidden = view !== 'pb';
        if (tocGb) tocGb.hidden = view !== 'gb';
        return;
      }

      // Drop stopwords, but never drop EVERYTHING — a query of nothing but
      // stopwords falls back to the raw words rather than matching the world.
      const raw = query.split(/\s+/).filter(Boolean);
      const stripped = raw.filter((t) => !STOP.has(t));
      const terms = stripped.length ? stripped : raw;

      // AND first (precise). If that finds nothing, retry OR — for a reference
      // book, a plausible near-match beats "no results", which just leaves a
      // teammate stuck with a question and no next step.
      let hits = index
        .map((e) => ({ e, s: score(e, terms, true, query) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 12);

      if (!hits.length && terms.length > 1) {
        hits = index
          .map((e) => ({ e, s: score(e, terms, false, query) }))
          .filter((r) => r.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 8);
      }

      // Hide the chapter lists while searching — two competing lists in one
      // narrow drawer is worse than either alone.
      if (tocPb) tocPb.hidden = true;
      if (tocGb) tocGb.hidden = true;
      results.hidden = false;
      resultsEmpty.hidden = hits.length > 0;
      resultsList.innerHTML = '';

      for (const { e } of hits) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';

        // Four distinct lines rather than one run-on string: which book, the
        // section, which chapter it lives in, then a preview. Built as separate
        // elements with textContent — never innerHTML — so the renderer stays
        // incapable of injecting markup no matter what content is added later.
        const mk = (cls: string, text: string) => {
          const s = document.createElement('span');
          s.className = cls;
          s.textContent = text;
          return s;
        };

        btn.appendChild(mk('pb-res-book', e.book === 'pb' ? 'The Playbook' : 'The Guidebook'));
        btn.appendChild(mk('pb-res-title', e.section || e.chapter));
        if (e.section) btn.appendChild(mk('pb-res-where', `in ${e.chapter}`));
        btn.appendChild(mk('pb-res-snip', trimSnippet(e.snippet)));

        btn.addEventListener('click', () => {
          pendingAnchor = e.anchor;
          go(e.book, e.page);
        });
        li.appendChild(btn);
        resultsList.appendChild(li);
      }
    }

    searchInput?.addEventListener('input', () => runSearch(searchInput.value));
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { searchInput.value = ''; runSearch(''); }
    });

    /** Cut the preview at a word boundary rather than mid-word — the index
     *  stores a hard 150-char slice, which produced things like "...responsibi".
     *  Two clamped lines is all that's visible anyway. */
    function trimSnippet(s: string): string {
      const t = s.trim();
      if (t.length <= 110) return t;
      const cut = t.slice(0, 110);
      const sp = cut.lastIndexOf(' ');
      return (sp > 60 ? cut.slice(0, sp) : cut).replace(/[,;:—-]$/, '') + '…';
    }

    /** After a result jump, scroll the matched section into view. */
    function consumeAnchor() {
      if (!pendingAnchor) return;
      const el = document.getElementById(pendingAnchor);
      pendingAnchor = null;
      if (!el) return;
      requestAnimationFrame(() => {
        const top = el.getBoundingClientRect().top + window.scrollY - 96;
        window.scrollTo({ top: Math.max(0, top), behavior: 'instant' as ScrollBehavior });
        el.classList.add('pb-flash');
        setTimeout(() => el.classList.remove('pb-flash'), 1600);
      });
    }

    /* ── restore from hash / back-forward ── */
    function applyHash(push: boolean) {
      const h = location.hash.slice(1);
      const [book, n] = h.split('/');
      if (book === 'pb') { view = 'pb'; pbIndex = clamp(Number(n), 0, pbLast); }
      else if (book === 'gb') { view = 'gb'; gbIndex = clamp(Number(n), -1, gbPages.length - 2); }
      else view = 'hub';
      render(push);
    }
    function clamp(n: number, lo: number, hi: number) {
      return Number.isFinite(n) ? Math.max(lo, Math.min(hi, n)) : lo;
    }
    window.addEventListener('popstate', () => applyHash(false));

    if (location.hash) applyHash(false);
    else render(false);

    /* ── signature ── */
    const form = document.getElementById('pb-ack-form') as HTMLFormElement | null;
    const msg = document.getElementById('pb-ack-msg');
    const submit = document.getElementById('pb-ack-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!msg || !submit) return;

      const name = (document.getElementById('ack-name') as HTMLInputElement).value.trim();
      const agree = (document.getElementById('ack-agree') as HTMLInputElement).checked;
      const website = (document.getElementById('ack-website') as HTMLInputElement).value;

      if (name.length < 2) { msg.textContent = 'Please enter your full name.'; return; }
      if (!agree) { msg.textContent = 'Please check the box to sign.'; return; }

      msg.textContent = '';
      submit.disabled = true;
      submit.textContent = 'Signing...';
      flushTime();

      try {
        const res = await fetch('/api/playbook-ack/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name, agree, website,
            page_url: location.href,
            active_seconds: Math.round(activeMs / 1000),
            pages_viewed: seenPbPages.size,
            // Excludes the confirmation page — it's unreachable until AFTER
            // signing, so counting it made a complete read look like 18 of 19.
            total_pages: pbPages.length - 1,
          }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (data.ok) {
          const out = document.getElementById('pb-done-name');
          if (out) out.textContent = `Signed by ${name}.`;
          try {
            localStorage.removeItem(PROGRESS_KEY);
            localStorage.removeItem(TIME_KEY);
            localStorage.removeItem(PAGES_KEY);
          } catch {}
          go('pb', pbLast);
        } else {
          msg.textContent = "That didn't go through. Try again, or let a manager know.";
          submit.disabled = false;
          submit.textContent = 'Sign the Playbook';
        }
      } catch {
        msg.textContent = "That didn't go through. Check your connection and try again.";
        submit.disabled = false;
        submit.textContent = 'Sign the Playbook';
      }
    });
  }
</script>
