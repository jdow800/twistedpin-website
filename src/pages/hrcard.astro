---
/**
 * /hrcard — texted-offer landing page: "pick your free fun."
 *
 * Sibling of /1hr + /bday — same SMS-offer detail-page pattern. The text
 * blast carries a one-line hook + this short link; the offer choices and
 * restrictions live here so we don't burn SMS characters on fine print.
 *
 * Offer: pick ONE — a free $30 arcade card, OR a free hour of bowling for
 * up to 5 players (shoes excluded) on a traditional lane. Walk-in only
 * (can't be reserved). Pre-loaded on the guest's account; they log in to
 * the front-desk kiosk with their phone number and pick during the visit
 * (same kiosk redemption as /1hr + /bday — no "claim" step).
 *
 * The page PRESENTS the two options; it is deliberately NOT a picker — the
 * choice is made in person. Copy pass 2026-07-29 (Jon), mirroring /bday:
 * "pick one below" and "Choose one" both implied an on-page action and sent
 * guests hunting for buttons that don't exist. Now "here are your two
 * options" / "Your two options", led by "Nothing to claim here". Keep the
 * H1 "Pick your free fun." — it matches the SMS hook; changing one without
 * the other creates a scent mismatch.
 *
 * Voice: "free" is fine (the ban is on cheap/discount/off/deals). The
 * bowling option is TRADITIONAL lanes only (never the VIP suite).
 *
 * Indexability: noindex,follow (same as /1hr /bday /sms). Excluded from
 * sitemap.xml via the offer-slug filter in astro.config.mjs.
 *
 * Expiry is NOT hardcoded — each blast carries its own date, so the page
 * tells the reader to check their text rather than going stale.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";

// Real venue facts — mirrors src/lib/schema.ts (PHONE_DISPLAY / address).
const PHONE_DISPLAY = "(815) 782-7790";
const PHONE_TEL = "+18157827790";
const ADDRESS = "15610 Joliet Rd, Plainfield, IL 60544";
const MAPS_URL = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent("Twisted Pin, 15610 Joliet Rd, Plainfield, IL 60544");
---
<Base
  title="Pick Your Free Fun | Twisted Pin"
  description="Your Twisted Pin text offer: pick one — a free $30 arcade card, or a free hour of bowling for up to 5 on our traditional lanes. Walk-in only. It's already on your account — log in at the front-desk kiosk to redeem."
  ogImage="/og/og-game.jpg"
  ogImageAlt="The arcade at Twisted Pin in Plainfield, IL"
>
  {/* noindex,follow — texted campaign URL, never indexed. Same pattern
      as /1hr + /bday. Excluded from sitemap too (astro.config.mjs filter). */}
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <section class="t2-hero" data-hero aria-labelledby="offer-h1">
    <div class="t2-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Your Twisted Pin Text Offer</p>
      <h1 class="t-display t2-hero-headline hero-fade" id="offer-h1" data-delay-ms="120">
        Pick your free&nbsp;fun.
      </h1>
      <p class="t2-hero-sub hero-fade" data-delay-ms="320">
        Our treat — here are your two options. You'll pick the one you
        want at the front desk.
      </p>
    </div>
  </section>

  <section class="t2-section" aria-labelledby="offer-details-h2">
    <div class="t2-section-inner offer-inner">

      {/* Expiry callout — first thing, because it's the one detail that
          changes per blast and the one people forget. */}
      <p class="offer-expiry">
        <strong>Expires soon —</strong> check the text we sent you for the
        exact date.
      </p>

      <p class="offer-redeem">
        <strong>Nothing to claim here</strong> — it's already on your account.
        Come in, log in at the front-desk kiosk with your phone number, and
        tell us which one you want.
      </p>

      <h2 class="t-eyebrow" id="offer-details-h2">Your two options</h2>

      <div class="offer-choices">
        <div class="offer-choice">
          <p class="offer-choice-amt">$30</p>
          <p class="offer-choice-name">arcade card</p>
          <p class="offer-choice-note">
            Free, loaded, and ready for the game floor.
          </p>
        </div>

        <p class="offer-or" aria-hidden="true">— or —</p>

        <div class="offer-choice">
          <p class="offer-choice-amt">1 hr</p>
          <p class="offer-choice-name">of bowling</p>
          <p class="offer-choice-note">
            Free hour on a traditional lane, up to 5 players. Shoes not
            included.
          </p>
        </div>
      </div>

      <p class="offer-fineprint">
        Pick one, not both. One per guest. Walk-in only — this offer can't
        be reserved or booked ahead. Can't be combined with other offers.
        The free hour is on a traditional lane only — not the VIP suite,
        leagues, or events. See <a href="/pricing/">walk-in pricing</a> for
        everything beyond your free fun, or <a href="/game/">more on the
        arcade here</a>.
      </p>
    </div>
  </section>

  <section class="t2-section offer-where" aria-labelledby="offer-where-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">Where to find us</p>
      <h2 class="t-display offer-where-title" id="offer-where-h2">
        Just walk in.
      </h2>
      <p class="t2-section-body">
        Twisted Pin · {ADDRESS}
      </p>
      <p class="offer-actions">
        <a class="offer-btn" href={MAPS_URL} target="_blank" rel="noopener">Get directions</a>
        <a class="offer-btn offer-btn-alt" href={`tel:${PHONE_TEL}`}>Call {PHONE_DISPLAY}</a>
      </p>
    </div>
  </section>

  <SnapFooter />
</Base>

<style>
  /* ============================================================
     /hrcard — texted "pick your free fun" offer. Shares the
     /1hr + /bday vocabulary (expiry callout, redeem line, choose-one
     cards, fine print, where-to-find-us, action buttons).
     ============================================================ */

  .offer-inner { max-width: 600px; }

  /* Expiry callout — glow left-border, sits above everything. */
  .offer-expiry {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--warm-white);
    margin: 0 0 28px;
    padding: 14px 18px;
    background: rgba(244, 239, 227, 0.05);
    border-left: 2px solid var(--glow);
    border-radius: 0 8px 8px 0;
  }
  .offer-expiry strong { color: var(--glow); }

  /* "Nothing to claim here" answers the do-I-click-something question up
     front — lift it out of the body grey so it reads first. */
  .offer-redeem strong { color: var(--warm-white); }

  .offer-redeem {
    margin: 0 0 8px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
  }

  /* Two-option "choose one" layout — option cards with an OR divider. */
  .offer-choices { margin-top: 14px; }

  .offer-choice {
    padding: 20px 20px 18px;
    border: 1px solid rgba(244, 239, 227, 0.14);
    border-radius: var(--radius-surface, 12px);
    background: rgba(244, 239, 227, 0.03);
  }
  .offer-choice-amt {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 40px;
    line-height: 1;
    color: var(--glow);
    margin: 0;
  }
  .offer-choice-name {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 20px;
    color: var(--warm-white);
    margin: 4px 0 8px;
  }
  .offer-choice-note {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--warm-mid);
    margin: 0;
  }
  .offer-or {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-dim);
    text-align: center;
    margin: 14px 0;
  }

  .offer-fineprint {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid rgba(244, 239, 227, 0.08);
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--warm-dim);
  }
  .offer-fineprint a {
    color: var(--glow);
    text-decoration: none;
  }
  .offer-fineprint a:hover { text-decoration: underline; }

  /* "Where to find us" block */
  .offer-where-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin: 10px 0 16px;
  }
  @media (min-width: 1025px) {
    .offer-where-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .offer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .offer-btn {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 7px;
    background: var(--glow);
    color: #0E0A1F;
    border: 1px solid var(--glow);
  }
  .offer-btn-alt {
    background: var(--indigo-deep, #0E0A1F);
    color: var(--warm-white);
    border: 1px solid rgba(244, 239, 227, 0.45);
  }
</style>
