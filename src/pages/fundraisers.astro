---
/**
 * /fundraisers — Fundraiser program landing page.
 *
 * Captures the `fundraiser venue` / `bowling fundraiser` keyword cluster
 * flagged in Context/seo.md as opportunity-not-yet-captured. Replaces the
 * earlier plan to redirect /fundraiser/ → /events/#fundraiser — the
 * mechanics here are operationally specific enough to warrant a
 * dedicated URL with full SEO chrome:
 *   - Thursdays 5–9pm only (recurring window)
 *   - Traditional lanes only — NOT the VIP suite
 *   - Customers must mention the fundraiser at check-in
 *   - 50% of bowling, shoe, AND front-desk arcade-card spend back to host (not just bowling;
 *     kiosk cards can't be tagged, so they never count)
 *   - Optional bonus arcade promotion at booking
 *
 * Voice rules applied (per Context/voice.md):
 *   - Drop the live-site "FUN!" / "FUNdraisers" / all-caps section
 *     register — confident-and-specific, not corporate-cheerful
 *   - "private" hard-banned — VIP suite is for "booked group events,"
 *     fundraisers run "on the traditional lanes"
 *   - Specifics > adjectives — Thursdays 5–9pm, 50% of bowling/shoe/arcade,
 *     all ages, 28-tap self-serve wall
 *
 * Same skeleton as /events (rule of seven — .pillar-* CSS hoist is
 * deeply overdue at this point):
 *   - Hero: typography-led title section (no image)
 *   - Two long-scroll editorial sections (image + copy, alternating)
 *   - Closing CTA band → Zite (matches /events conversion-moment pattern)
 *   - SnapFooter
 *
 * TODOs (non-blocking):
 *   - Section photos reuse events-bg + stage-game homepage shots.
 *     Distinct fundraiser-energy photography (a real fundraiser night,
 *     a check-presentation moment, a school group's logo on the LED
 *     wall) would land harder. Flagged in Context/media-needs.md.
 *   - Real success-story content ("X organizations raised $Y last year")
 *     would convert hard but not in scope until ops gives numbers.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, BUSINESS_ENTITY_ID } from "../lib/schema";

import { PLAN_EVENT_URL } from "../lib/links";
import { ICON_PATHS } from "../lib/icons";

// JSON-LD: Service offered by the venue. provider → #business links
// the program to the canonical entity. No specific Event schema since
// fundraisers are scheduled per-organization, not venue-published.
//
// `offers` removed 2026-05-17 — fundraisers aren't a purchasable SKU
// (no price, no inventory). They're a partnership. Schema.org Offer
// requires price/priceCurrency/priceSpecification to validate, and the
// 50% revenue-share is a rate, not a price. The revenue-share detail
// is captured in the Service description above and the on-page copy.
const PAGE_URL = `${BUSINESS_URL}/fundraisers/`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${BUSINESS_URL}/#fundraiser-program`,
  name: "Fundraiser Program",
  url: PAGE_URL,
  description:
    "Twisted Pin returns 50% of supporters' bowling, shoe rental, and front-desk arcade-card spend to host organizations. Thursday nights 5–9pm. Schools, churches, sports teams, charities, community groups in Plainfield, IL and surrounding Will County.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  serviceType: "Fundraiser hosting",
  areaServed: {
    "@type": "Place",
    name: "Plainfield, IL and surrounding Will County",
  },
};

// Visible HTML and FAQ schema share the same answers (same pattern as
// /corporate-events). Facts mirror Avery's KB fundraiser block (Section 7)
// so the page and her replies never disagree: arcade cards count only at
// the front desk, food and bar never count, checks go to the organization.
const fundraiserFaqs = [
  {
    q: "How does a bowling fundraiser at Twisted Pin work?",
    answer: "We host, you promote. Pick an open Thursday and spread the word. Every supporter who bowls between 5pm and 9pm and tells the front desk they’re there for your organization sends 50% of their bowling, shoe rental and front-desk arcade cards back to your cause. The more people you get through the door, the more you raise.",
  },
  {
    q: "What does it cost to host?",
    answer: "Nothing. No setup fee, no deposit, no minimum turnout and nothing to reserve. You don’t even give us a headcount.",
  },
  {
    q: "What counts toward the 50%?",
    answer: "Bowling, shoe rental and arcade cards bought at the front desk. Cards from the self-serve arcade kiosks can’t be tagged to a fundraiser, and food, drinks and the bar don’t count.",
  },
  {
    q: "How do supporters make sure their spend counts?",
    answer: "They say your organization’s name at the front desk, for bowling and for arcade cards. Fundraisers run walk-in on our traditional lanes alongside the regular Thursday crowd, first come, first served. Think restaurant spirit night: only the people who name you are counted.",
  },
  {
    q: "How much can we raise?",
    answer: "It comes down to turnout. Every supporter who names you sends half their bowling, shoes and front-desk arcade cards your way. Organizations find one to three Thursdays a year works best, and a few strong nights add up to thousands.",
  },
  {
    q: "Can we hold a raffle or 50/50?",
    answer: "Yes, as long as the fundraiser has a tax ID. Tell us ahead of time and we’ll set out a table; one rep on site all night helps. Draw winners after the event and announce them online, because the families who came at 5pm are long gone by 9pm.",
  },
  {
    q: "When and how do we get paid?",
    answer: "We mail a check the week after your event, usually in the mail by the following Monday. It’s made out to the organization, never an individual, so we’ll need the exact payee name, your tax ID (EIN) and a mailing address first.",
  },
  {
    q: "Which Thursdays are open?",
    answer: "Fundraisers run Thursdays only, 5pm to 9pm, one organization per night. We skip holidays and school days off. Tell us the month you’re eyeing and we’ll send back the open Thursdays.",
  },
  {
    q: "How do we get the word out?",
    answer: "That part’s yours, and we make it easy. Every booked fundraiser gets a free event page with a shareable invitation link. Supporters can RSVP so you know who’s coming, and lanes stay first come, first served.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: fundraiserFaqs.map((f) => ({
    "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---
<Base
  title="Bowling Fundraisers in Plainfield, IL | Twisted Pin"
  description="Bowling fundraisers, Thursdays 5–9pm: 50% of your supporters' bowling, shoes and front-desk arcade cards back to your cause. Plainfield, IL."
  lcpPreloadHref="/snap/summer-pass-poster.avif"
  lcpPreloadMedia="(max-width: 1024px)"
>

  {/* ============================================================
      HERO — typography-led title section (no image)
      ============================================================ */}
  <section class="fundraiser-hero" data-hero aria-labelledby="fundraiser-hero-h1">
    <div class="fundraiser-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Fundraisers</p>
      <h1 class="t-display fundraiser-hero-headline hero-fade" id="fundraiser-hero-h1" data-delay-ms="120">
        Bowling makes a great&nbsp;fundraiser.
      </h1>
      <p class="fundraiser-hero-sub hero-fade" data-delay-ms="320">
        50% of eligible bowling, shoe, and front-desk arcade-card sales — back to your cause.
      </p>
    </div>
  </section>

  {/* ============================================================
      HOW IT WORKS — image left, copy right
      ============================================================ */}
  <section class="fundraiser-section" aria-labelledby="fundraiser-how-h2">
    <div class="fundraiser-section-grid">
      <div class="fundraiser-section-frame">
        {/* How It Works video — Summer Pin Pass clip (Thursday-night
            group energy on the traditional lanes). Lazy-loaded via
            data-section-video. (Updated 2026-05-15 from a stub
            events-bg still photo to the summer-pass video.)
            LCP optimization (2026-05-17): direct poster= + preload via
            Base.astro lcpPreloadHref; bounded media queries on sources.
            Same recipe as /events first section. */}
        <video
          class="fundraiser-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          poster="/snap/summer-pass-poster.avif"
          aria-label="A fundraiser group bowling at Twisted Pin in Plainfield, IL"
        >
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="fundraiser-section-copy">
        <p class="t-eyebrow">How It Works</p>
        <h2 class="t-display fundraiser-section-title" id="fundraiser-how-h2">
          Thursdays, 5–9pm. We host. You promote.
        </h2>
        <p class="fundraiser-section-aside">(no setup fee, no minimums)</p>

        <p class="fundraiser-section-body">
          Tell your supporters when and where. They show up, mention
          they're there for your fundraiser, and pay regular price. We
          send <strong>50% of their bowling, shoe, and front-desk arcade-card spend</strong>
          back to your organization. The more people you get through the
          door, the more you raise.
        </p>

        <p class="fundraiser-section-body">
          Fundraisers run on the traditional lanes, walk-in, alongside our
          regular Thursday crowd — no lanes are held, no headcount needed.
          One organization per Thursday.
        </p>

        <ul class="fundraiser-section-list">
          <li>Pick an open Thursday, 5pm to 9pm</li>
          <li>Promote it to your supporters</li>
          <li>Supporters bowl, eat, drink, play arcade</li>
          <li>They say your organization's name at the front desk — for bowling and arcade cards</li>
          <li>Arcade cards count only when bought at the front desk, not the kiosks</li>
          <li>50% of bowling, shoe, and front-desk arcade-card revenue comes back to your org</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============================================================
      WHY BOWLING FUNDRAISERS WORK — image RIGHT, copy LEFT (alternation)
      ============================================================ */}
  <section class="fundraiser-section fundraiser-section--reverse" aria-labelledby="fundraiser-why-h2">
    <div class="fundraiser-section-grid">
      <div class="fundraiser-section-frame">
        {/* Why Bowling Fundraisers Work — arcade video (same as /game
            first-section "One more time" clip). Bowling + arcade =
            engagement-driven revenue for the fundraiser. Lazy-loaded
            via data-section-video. (Updated 2026-05-15 from a stub
            stage-game still photo to the arcade video.) */}
        <video
          class="fundraiser-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          data-poster="/snap/arcade-poster.avif"
          aria-label="Arcade and bowling at Twisted Pin — fundraiser revenue lanes"
        >
          <source media="(max-width: 480px)" data-src="/snap/arcade-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/arcade-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/arcade-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/arcade-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="fundraiser-section-copy">
        <p class="t-eyebrow">Why Bowling</p>
        <h2 class="t-display fundraiser-section-title" id="fundraiser-why-h2">
          All ages, weather-proof, high&#8209;capacity.
        </h2>
        <p class="fundraiser-section-aside">(food, fun, and funds)</p>

        <p class="fundraiser-section-body">
          Bowling is one of the few group activities that works for
          grandparents and grade-schoolers in the same lane. No skill
          required, no rainout backup plan, no early-November cancel risk.
        </p>

        <p class="fundraiser-section-body">
          The kitchen, bar, and 28-tap self-serve wall are open to your
          supporters all night — they make an evening of it instead of
          a quick game. Bigger evenings mean more raised.
        </p>

        <p class="fundraiser-section-body">
          Want to raise more on top of the 50%? Run your own
          <strong>50/50 or raffle</strong>. Tell us ahead of time and
          we'll set out a table.
        </p>

        <ul class="fundraiser-section-list">
          <li>All ages, all skill levels</li>
          <li>Indoors — no rain, snow, or heat-cancel risk</li>
          <li>Full kitchen + 28-tap self-serve wall</li>
          <li>Arcade open all night</li>
          <li>Schools, churches, sports teams, charities, community groups</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ — reuses the global .t2-faq accordion (same as /corporate-events)
      ============================================================ */}
  <section class="fundraiser-faq" aria-labelledby="fundraiser-faq-h2">
    <div class="fundraiser-faq-inner">
      <p class="t-eyebrow">Questions</p>
      <h2 class="t-display fundraiser-faq-title" id="fundraiser-faq-h2">Fundraiser FAQs.</h2>
      <div class="t2-faq">
        {fundraiserFaqs.map((item) => (
          <details class="t2-faq-item">
            <summary class="t2-faq-q">
              <h3 class="t2-faq-q-text">{item.q}</h3>
              <svg class="t2-faq-chevron" viewBox="0 0 24 24" width="18" height="18"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" set:html={ICON_PATHS["chevron-down"]} />
            </summary>
            <div class="t2-faq-a"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      CLOSING CTA BAND — single dominant "Plan a fundraiser" → Zite.
      Same lifted-indigo treatment as /events for the conversion moment.
      ============================================================ */}
  <section class="fundraiser-cta" aria-labelledby="fundraiser-cta-h2">
    <div class="fundraiser-cta-inner">
      <p class="t-eyebrow">Plan Your Fundraiser</p>
      <h2 class="t-display fundraiser-cta-title" id="fundraiser-cta-h2">
        Pick a Thursday. We'll set it up.
      </h2>
      <p class="fundraiser-cta-body">
        Quick form. Tour the venue, see what's involved, lock in your date.
      </p>
      <a class="btn btn-solid fundraiser-cta-btn" href={PLAN_EVENT_URL} target="_blank" rel="noopener">
        Plan a fundraiser
      </a>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Fundraisers", path: "/fundraisers/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /fundraisers — same pillar skeleton as /events. .fundraiser-*
     mirrors .events-* / .bar-* / .eat-* / .vip-* / .game-* / .bowl-* —
     rule of seven. .pillar-* CSS hoist is deeply overdue (flagged in
     Context/launch-checklist.md tech debt).
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .fundraiser-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(320px, 42vh, 420px);
    padding: calc(var(--header-height) + 28px) 22px 24px;
  }
  @media (min-width: 1025px) {
    .fundraiser-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .fundraiser-hero-copy {
    max-width: 760px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .fundraiser-hero-copy { text-align: center; }
    .fundraiser-hero-sub { margin-left: auto; margin-right: auto; }
  }

  .fundraiser-hero-headline {
    color: var(--warm-white);
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .fundraiser-hero-headline { font-size: clamp(56px, 6vw, 88px); }
  }

  .fundraiser-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 34em;
  }
  @media (min-width: 1025px) {
    .fundraiser-hero-sub { margin-top: 22px; font-size: 19px; max-width: 38em; }
  }

  /* .hero-fade hoisted to global.css (2026-05-08 LCP fix). */

  /* ============================================================
     section pattern (mirrors .events-section etc.)
     ============================================================ */
  .fundraiser-section {
    background: transparent;
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
    .fundraiser-section { padding: 24px 64px; }
  }

  .fundraiser-section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 1025px) {
    .fundraiser-section-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
  }

  .fundraiser-section--reverse .fundraiser-section-frame {
    order: 0;
  }
  @media (min-width: 1025px) {
    .fundraiser-section--reverse .fundraiser-section-frame { order: 2; }
  }

  .fundraiser-section-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 9 / 16;
    background: rgba(244, 239, 227, 0.04);
    max-height: min(640px, calc(70vh - 80px));
    width: 100%;
    align-self: start;
  }
  @media (min-width: 1025px) {
    .fundraiser-section-frame {
      aspect-ratio: 9 / 16;
      max-width: 480px;
      justify-self: center;
    }
  }

  .fundraiser-section-frame picture,
  .fundraiser-section-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fundraiser-section-copy {
    color: var(--warm-white);
    max-width: 56ch;
  }

  .fundraiser-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7vw, 40px);
    letter-spacing: -0.005em;
    line-height: 1.0;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .fundraiser-section-title { font-size: clamp(36px, 4.5vw, 56px); }
  }

  .fundraiser-section-aside {
    margin-top: 6px;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 14px;
    color: var(--warm-mid);
  }
  @media (min-width: 1025px) {
    .fundraiser-section-aside { font-size: 16px; }
  }

  .fundraiser-section-body {
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    color: #ece6d6;
  }
  @media (min-width: 1025px) {
    .fundraiser-section-body { font-size: 17px; line-height: 1.6; }
  }

  .fundraiser-section-list {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: grid;
    gap: 10px;
  }
  .fundraiser-section-list li {
    position: relative;
    padding-left: 22px;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.5;
    color: #ece6d6;
  }
  .fundraiser-section-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 1px;
    background: var(--glow);
  }
  @media (min-width: 1025px) {
    .fundraiser-section-list li { font-size: 15.5px; }
  }

  /* ============================================================
     FAQ — reuses the global .t2-faq* accordion (see global.css);
     only the section wrapper + heading are page-local.
     ============================================================ */
  .fundraiser-faq {
    background: transparent;
    padding: 48px 22px 8px;
  }
  @media (min-width: 1025px) {
    .fundraiser-faq { padding: 72px 64px 24px; }
  }

  .fundraiser-faq-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .fundraiser-faq-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7vw, 40px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .fundraiser-faq-title { font-size: clamp(36px, 3.6vw, 48px); }
  }

  .fundraiser-faq .t2-faq { margin-top: 20px; }

  /* ============================================================
     CLOSING CTA — same recipe as /events for visual rhythm
     ============================================================ */
  .fundraiser-cta {
    background: var(--indigo-lift);
    padding: 56px 22px;
    margin-top: 32px;
    text-align: center;
  }
  @media (min-width: 1025px) {
    .fundraiser-cta { padding: 96px 64px; margin-top: 64px; }
  }

  .fundraiser-cta-inner {
    max-width: 720px;
    margin: 0 auto;
    color: var(--warm-white);
  }

  .fundraiser-cta-title {
    color: var(--warm-white);
    font-size: clamp(32px, 9vw, 56px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .fundraiser-cta-title { font-size: clamp(48px, 5.5vw, 80px); }
  }

  .fundraiser-cta-body {
    margin: 18px auto 28px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 36em;
  }
  @media (min-width: 1025px) {
    .fundraiser-cta-body { font-size: 19px; margin-bottom: 36px; }
  }

  .fundraiser-cta-btn {
    display: inline-block;
  }
  /* Desktop hero dead-air fix (2026-08-03 sweep — approved on
     /vip-suite): the typography hero pinned min-height 55vh/640px
     around ~300px of copy; flex-centered slack rendered as voids above
     the eyebrow and below the sub. Content + padding define height now.
     KEEP LAST (source-order cascade; the /pricing dead-CSS lesson). */
  @media (min-width: 1025px) {
    .fundraiser-hero {
      min-height: 0;
      padding: calc(var(--header-height) + 56px) 64px 40px;
    }
    .fundraiser-section { padding-top: 32px; }
  }
</style>
