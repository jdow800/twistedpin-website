---
/**
 * /why-us/shorewood-il/ — Service-area page (Shorewood, IL).
 *
 * 2026-09-14: Shorewood is an owner-priority audience. Recent Ads outcomes
 * are sparse; do not describe this town as a proven profitability winner.
 *
 * Distance and route confirmed by ops 2026-05-08:
 *   - ~6 miles, Route 59 or I-55
 *   - No drive-time claim (not user-confirmed; mileage carries)
 *
 * Skeleton: shared .svc-* layer in global.css. Distinct copy,
 * standard skeleton (Hero / Drive / Group Events / Bar / CTA).
 */
import Base from "../../layouts/Base.astro";
import SnapFooter from "../../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import {
  BUSINESS_URL,
  BUSINESS_ENTITY_ID,
  PLACE_ID,
  STREET,
  LOCALITY,
} from "../../lib/schema";

const ROLLER_URL = "/reserve/";
import { PLAN_EVENT_URL } from "../../lib/links";
const MAPS_DIR_HREF = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${STREET}, ${LOCALITY}`,
)}&destination_place_id=${PLACE_ID}`;

const PAGE_URL = `${BUSINESS_URL}/why-us/shorewood-il/`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${BUSINESS_URL}/#service-shorewood`,
  name: "Twisted Pin — Bowling, Bar & Event Venue Near Shorewood, IL",
  url: PAGE_URL,
  description:
    "Twisted Pin is six miles north of Shorewood up Route 59 for group outings in Plainfield. A craft cocktail program curated by America's Top Mixologist, a 28-tap self-serve beer & wine wall, 17 traditional lanes, and a 6-lane VIP suite for groups up to 80. Plainfield, IL.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  areaServed: {
    "@type": "City",
    name: "Shorewood",
    sameAs: "https://en.wikipedia.org/wiki/Shorewood,_Illinois",
    containedInPlace: { "@type": "AdministrativeArea", name: "Illinois" },
  },
};
---
<Base
  title="Bowling & Group Events Near Shorewood, IL | Twisted Pin"
  description="Bring your Shorewood group to Twisted Pin in Plainfield, IL. Bowling, a 6-lane VIP suite for up to 80, in-house catering, craft cocktails and 28 self-serve taps."
>

  <section class="svc-hero" data-hero aria-labelledby="svc-hero-h1">
    <div class="svc-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Shorewood</p>
      <h1 class="t-display svc-hero-headline hero-fade" id="svc-hero-h1" data-delay-ms="120">
        Six&nbsp;miles north of&nbsp;Shorewood. The&nbsp;next town&nbsp;over.
      </h1>
      <p class="svc-hero-sub hero-fade" data-delay-ms="320">
        A celebration with friends or a thank-you for the whole team.
        Twisted Pin in Plainfield brings together bowling, craft cocktails,
        a 28-tap self-serve wall, and a 6-lane VIP suite for up to 80.
      </p>
    </div>
  </section>

  {/* Drive ---------------------------------------------------- */}
  <section class="svc-section" aria-labelledby="svc-drive-h2">
    <div class="svc-section-grid">
      <div class="svc-section-frame">
        <picture>
          <source type="image/webp" srcset="/snap/events-bg-540.webp 540w, /snap/events-bg-900.webp 900w" sizes="(min-width: 1025px) 480px, 90vw" />
          <img class="svc-section-img"
            src="/snap/events-bg-540.jpg"
            srcset="/snap/events-bg-540.jpg 540w, /snap/events-bg-900.jpg 900w"
            sizes="(min-width: 1025px) 480px, 90vw"
            alt="A group enjoying a night out at Twisted Pin in Plainfield, IL"
            width="540" height="960" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="svc-section-copy">
        <p class="t-eyebrow">Drive</p>
        <h2 class="t-display svc-section-title" id="svc-drive-h2">
          Six miles up Route 59. Or I-55.
        </h2>
        <p class="svc-section-aside">(15610 Joliet Rd, Plainfield)</p>

        <p class="svc-section-body">
          Six miles up Route 59 from Shorewood, or hop on I-55 if
          you're already heading that way. Free parking out front
          either way.
        </p>

        <p class="svc-section-body">
          If your usual Shorewood Friday-night spots are starting to
          run together, six miles is a short reset.
        </p>

        <ul class="svc-section-list">
          <li>~6 miles north of Shorewood</li>
          <li>Route 59 or I-55 — your call</li>
          <li>Free parking out front</li>
        </ul>

        <a class="btn btn-outline" href={MAPS_DIR_HREF} target="_blank" rel="noopener">
          Get directions
        </a>
      </div>
    </div>
  </section>

  {/* Group Events --------------------------------------------- */}
  <section class="svc-section svc-section--reverse" aria-labelledby="svc-vip-h2">
    <div class="svc-section-grid">
      <div class="svc-section-frame">
        <picture>
          <source type="image/webp" srcset="/snap/vip-energy-540.webp 540w, /snap/vip-energy-900.webp 900w" sizes="(min-width: 1025px) 480px, 90vw" />
          <img class="svc-section-img"
            src="/snap/vip-energy-540.jpg"
            srcset="/snap/vip-energy-540.jpg 540w, /snap/vip-energy-900.jpg 900w"
            sizes="(min-width: 1025px) 480px, 90vw"
            alt="The 6-lane VIP suite at Twisted Pin — set apart from the traditional lanes"
            width="540" height="960" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="svc-section-copy">
        <p class="t-eyebrow">Group Events</p>
        <h2 class="t-display svc-section-title" id="svc-vip-h2">
          Bring the whole crew. Up to 80.
        </h2>
        <p class="svc-section-aside">(staff appreciation, adult birthdays, and company parties)</p>

        <p class="svc-section-body">
          Six miles is the kind of distance where you bring the whole
          crew. <a href="/vip-suite/">The suite</a> holds up to 80, with AV hookups for slideshows
          and walk-in music, <a href="/eat/">in-house catering from the kitchen</a>, and bar
          billing on a tab or drink tickets — your call.
        </p>

        <p class="svc-section-body">
          Planning <a href="/corporate-events/">staff appreciation or a company outing</a>
          for a Shorewood team? Start with your date and headcount.
          The semi-private suite is set apart from the traditional lanes
          by a wall, with room for <a href="/holiday-parties/">holiday parties</a>
          and other celebrations too.
        </p>

        <ul class="svc-section-list">
          <li>6-lane semi-private VIP suite</li>
          <li>Capacity to 80 in the suite — or up to 200 for full-venue buyouts</li>
          <li>In-house catering + AV hookups</li>
          <li>Bar tab or drink tickets — your call</li>
          <li>Set apart by a wall from the traditional lanes</li>
        </ul>

        <a class="btn btn-outline" href={PLAN_EVENT_URL} target="_blank" rel="noopener">
          Plan an event
        </a>
      </div>
    </div>
  </section>

  {/* Bar ------------------------------------------------------- */}
  <section class="svc-section" aria-labelledby="svc-bar-h2">
    <div class="svc-section-grid">
      <div class="svc-section-frame">
        <picture>
          <source type="image/webp" srcset="/snap/bar-cocktails-540.webp 540w, /snap/bar-cocktails-900.webp 900w" sizes="(min-width: 1025px) 480px, 90vw" />
          <img class="svc-section-img"
            src="/snap/bar-cocktails-540.jpg"
            srcset="/snap/bar-cocktails-540.jpg 540w, /snap/bar-cocktails-900.jpg 900w"
            sizes="(min-width: 1025px) 480px, 90vw"
            alt="A copper cocktail shaker mid-pour at Twisted Pin's bar"
            width="540" height="960" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="svc-section-copy">
        <p class="t-eyebrow">The Bar</p>
        <h2 class="t-display svc-section-title" id="svc-bar-h2">
          America's Top Mixologist. Six miles up Route 59.
        </h2>
        <p class="svc-section-aside">(plus 28 self-serve beer &amp; wine taps)</p>

        <p class="svc-section-body">
          Keep the celebration in one place. Our <a href="/bar/">cocktail
          program is curated by Brian Van Flandern, <em>America’s Top Mixologist</em></a>,
          alongside a <a href="/menu/taps/">28-tap self-serve beer &amp; wine wall</a>.
          Pair drinks with <a href="/eat/">food from the kitchen</a> and bowling,
          whether you’re out with a few friends or celebrating with the team.
        </p>

        <a class="btn btn-outline" href="/menu/cocktails/">View the cocktail menu</a>
      </div>
    </div>
  </section>

  {/* Closing CTA band ----------------------------------------- */}
  <section class="svc-cta" aria-labelledby="svc-cta-h2">
    <div class="svc-cta-inner">
      <p class="t-eyebrow">Worth the Drive</p>
      <h2 class="t-display svc-cta-title" id="svc-cta-h2">
        Six miles. We'll save you a lane.
      </h2>
      <p class="svc-cta-body">
        Reserve a lane for a night with friends, or plan a company outing
        or celebration for your Shorewood group.
      </p>
      <div class="svc-cta-row">
        <a class="btn btn-solid" href={ROLLER_URL} target="_blank" rel="noopener">Reserve a lane</a>
        <a class="btn btn-outline" href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event</a>
      </div>
      <p class="svc-cta-more">
        More: <a href="/vip-suite/">the VIP suite</a> · <a href="/menu/taps/">the 28-tap self-serve wall</a> · <a href="/events/">group events</a> · <a href="/fundraisers/">fundraisers</a>
      </p>
      <p class="svc-cta-nap">
        Twisted Pin · 15610 Joliet Rd, Plainfield, IL 60544 · 6 miles north of Shorewood
      </p>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Shorewood", path: "/why-us/shorewood-il/" },
  ]} />
</Base>
