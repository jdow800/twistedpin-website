---
/**
 * /1hr — texted-offer landing page: "Free hour of bowling for up to 5."
 *
 * First of a family of lightweight "SMS offer detail" pages. The text
 * blast carries a one-line hook + this short link; the restrictions and
 * details live here so we don't burn SMS characters on fine print.
 *
 * Indexability: noindex,follow (same mechanism as /sms /terms /privacy).
 * This is a campaign URL we hand out by text, not a page we want ranking
 * in search — but follow lets link equity flow to the real pages it
 * cross-links (pricing, bowl). Also excluded from sitemap.xml via the
 * filter in astro.config.mjs so GSC never flags a "submitted URL marked
 * noindex" warning.
 *
 * Expiry is deliberately NOT hardcoded here — each blast can carry a
 * different date, so the page tells the reader to check their text for
 * the exact date rather than going stale the day a campaign ends.
 *
 * Voice: "free" is fine (the ban is on cheap/discount/value/deals). The
 * offer is on TRADITIONAL lanes — never the VIP suite. Walk-in only, so
 * no reservation link (the global sticky CTA still offers regular paid
 * lane reservations, which is a separate thing from this free hour).
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";

// Real venue facts — mirrors src/lib/schema.ts (PHONE_DISPLAY / address).
const PHONE_DISPLAY = "(815) 782-7790";
const PHONE_TEL = "+18157827790";
const ADDRESS = "15610 Joliet Rd, Plainfield, IL 60544";
const MAPS_URL = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent("Twisted Pin, 15610 Joliet Rd, Plainfield, IL 60544");
---
<Base
  title="Free Hour of Bowling for up to 5 | Twisted Pin"
  description="Your Twisted Pin text offer: a free hour of bowling for up to 5 on our traditional lanes. Walk-in only. Check your text for the expiration date."
  ogImage="/og/og-bowl.jpg"
  ogImageAlt="Bowling at Twisted Pin in Plainfield, IL"
>
  {/* noindex,follow — texted campaign URL, never indexed. Same pattern
      as /sms. Excluded from sitemap too (astro.config.mjs filter). */}
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <section class="t2-hero" data-hero aria-labelledby="offer-h1">
    <div class="t2-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Your Twisted Pin Text Offer</p>
      <h1 class="t-display t2-hero-headline hero-fade" id="offer-h1" data-delay-ms="120">
        Free hour of bowling. Up&nbsp;to&nbsp;5.
      </h1>
      <p class="t2-hero-sub hero-fade" data-delay-ms="320">
        One free hour on a traditional lane for your whole group — up to
        five bowlers. Just walk in — and log in to the kiosk at the front
        desk with your phone number!
      </p>
    </div>
  </section>

  <section class="t2-section" aria-labelledby="offer-details-h2">
    <div class="t2-section-inner offer-inner">

      {/* Expiry callout — first thing, because it's the one detail that
          changes per blast and the one people forget. */}
      <p class="offer-expiry">
        <strong>Expires soon —</strong> check the text we sent you for the
        exact date.
      </p>

      <h2 class="t-eyebrow" id="offer-details-h2" style="font-size:11px;">The details</h2>

      <ul class="offer-facts">
        <li>One <strong>free hour of bowling</strong> on a traditional lane.</li>
        <li>Covers your group — <strong>up to 5 bowlers</strong> on the lane.</li>
        <li><strong>Shoes not included.</strong> Grab lane shoes at the front desk.</li>
        <li><strong>Walk-in only.</strong> This one can't be reserved or booked ahead.</li>
        <li>Subject to open-lane availability when you arrive.</li>
      </ul>

      <p class="offer-fineprint">
        Traditional lanes only — not the VIP suite, leagues, or events.
        One offer per group, per visit. Can't be combined with other offers.
        See <a href="/pricing/">walk-in pricing</a> for everything beyond
        the free hour, or <a href="/bowl/">more on bowling here</a>.
      </p>
    </div>
  </section>

  <section class="t2-section offer-where" aria-labelledby="offer-where-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">Where to find us</p>
      <h2 class="t-display offer-where-title" id="offer-where-h2">
        Just walk in.
      </h2>
      <p class="t2-section-body">
        Twisted Pin · {ADDRESS}
      </p>
      <p class="offer-actions">
        <a class="offer-btn" href={MAPS_URL} target="_blank" rel="noopener">Get directions</a>
        <a class="offer-btn offer-btn-alt" href={`tel:${PHONE_TEL}`}>Call {PHONE_DISPLAY}</a>
      </p>
    </div>
  </section>

  <SnapFooter />
</Base>

<style>
  /* ============================================================
     /1hr — texted-offer detail page. Lightweight; leans on the
     shared .t2-* hero/section vocabulary. Only the offer-specific
     bits (expiry callout, fact list, action buttons) are scoped
     here. Same glow-border callout recipe as /sms .legal-preamble.
     ============================================================ */

  .offer-inner { max-width: 600px; }

  /* Expiry callout — glow left-border, sits above the fact list. */
  .offer-expiry {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--warm-white);
    margin: 0 0 28px;
    padding: 14px 18px;
    background: rgba(244, 239, 227, 0.05);
    border-left: 2px solid var(--glow);
    border-radius: 0 8px 8px 0;
  }
  .offer-expiry strong { color: var(--glow); }

  .offer-facts {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .offer-facts li {
    position: relative;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    color: var(--warm-mid);
    padding: 12px 0 12px 26px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
  }
  .offer-facts li:last-child { border-bottom: 0; }
  .offer-facts li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 19px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glow);
  }
  .offer-facts strong { color: var(--warm-white); font-weight: 700; }

  .offer-fineprint {
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid rgba(244, 239, 227, 0.08);
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--warm-dim);
  }
  .offer-fineprint a {
    color: var(--glow);
    text-decoration: none;
  }
  .offer-fineprint a:hover { text-decoration: underline; }

  /* "Where to find us" block */
  .offer-where-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin: 10px 0 16px;
  }
  @media (min-width: 1025px) {
    .offer-where-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .offer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .offer-btn {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 7px;
    background: var(--glow);
    color: #0E0A1F;
    border: 1px solid var(--glow);
  }
  .offer-btn-alt {
    background: var(--indigo-deep, #0E0A1F);
    color: var(--warm-white);
    border: 1px solid rgba(244, 239, 227, 0.45);
  }
</style>
