---
/**
 * Company holiday-party planning at the existing year-round URL.
 * The seasonal nav and promo schedule remain in their shared sources.
 * Inquiries use PLAN_EVENT_URL; space, party time, catering and bar
 * arrangements are confirmed during event planning.
 * Existing suite and catering videos keep their canonical VideoObject
 * entries on /vip-suite and /events; this page reuses the media only.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, BUSINESS_ENTITY_ID, STREET, LOCALITY, REGION } from "../lib/schema";

import { PLAN_EVENT_URL } from "../lib/links";
import { ICON_PATHS } from "../lib/icons";

const PAGE_URL = `${BUSINESS_URL}/holiday-parties/`;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${BUSINESS_URL}/#holiday-parties`,
  name: "Company Holiday Parties",
  url: PAGE_URL,
  description:
    "Company holiday parties, staff appreciation events and end-of-year celebrations at Twisted Pin in Plainfield, IL. In-house catering, craft cocktails and a semi-private six-lane VIP suite for up to 80 guests, or a full-venue buyout for up to 200. Holiday gatherings for friends, families and community groups are also welcome.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  serviceType: "Holiday party hosting",
  areaServed: ["Plainfield, IL", "Romeoville, IL", "Shorewood, IL", "Naperville, IL", "Joliet, IL", "Bolingbrook, IL"].map((name) => ({ "@type": "City", name })),
};

// One answer source keeps the visible FAQ and structured data aligned.
const faqs = [
  {
    q: "How far in advance should we book a holiday party?",
    answer: "For December parties, reach out by October if you can. Share your preferred date and any alternatives so the team can check availability. Weeknight or January celebrations are worth asking about, too.",
  },
  {
    q: "How many people can you host?",
    answer: "Up to 80 guests in the semi-private six-lane VIP suite, or up to 200 with a full-venue buyout. Share your headcount so the event team can confirm the right space and setup for your party.",
  },
  {
    q: "What does a company holiday party cost?",
    answer: "Your quote depends on the date, party length, headcount, space, catering and bar arrangements. Select Plan My Holiday Party and share your details so the event team can put together your quote.",
  },
  {
    q: "Can you handle catering and dietary needs?",
    answer: "Yes, we offer in-house catering. Include any menu preferences, allergies or dietary needs in your inquiry so the event team can discuss the available options with you before booking.",
  },
  {
    q: "How does the bar work for a company party?",
    answer: "Ask about a bar tab or drink tickets for your group. The event team will confirm the drinks and billing arrangements with your quote. Our bar includes a 28-tap self-serve beer and wine wall and a craft cocktail menu.",
  },
  {
    q: "Can we book the whole VIP suite?",
    answer: "For the whole suite, ask to reserve all six lanes for your group. We’ll confirm availability and specify your reserved space, party time and setup arrangements. The suite is semi-private and set apart from the traditional lanes.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---
<Base
  title="Company Holiday Party Venue in Plainfield, IL | Twisted Pin"
  description="Plan a company holiday party in Plainfield, IL with VIP bowling, in-house catering and craft cocktails. Up to 80 in the suite; up to 200 for a buyout."
  ogImage="/og/og-events.jpg"
  ogImageAlt="In-house catering buffet at Twisted Pin in Plainfield, IL"
  lcpPreloadHref="/snap/vip-lanes-poster.avif"
>

  {/* ============================================================
      HERO — typography-led title section (no image)
      ============================================================ */}
  <section class="holiday-hero" data-hero aria-labelledby="holiday-hero-h1">
    <div class="holiday-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Company Holiday Parties · Plainfield, IL</p>
      <h1 class="t-display holiday-hero-headline hero-fade" id="holiday-hero-h1" data-delay-ms="120">
        Holiday parties they actually&nbsp;remember.
      </h1>
      <p class="holiday-hero-sub hero-fade" data-delay-ms="320">
        Bring the team to Twisted Pin for a company Christmas party,
        staff appreciation night or end-of-year celebration. Bowling,
        in-house catering and craft cocktails make a night of it.
      </p>
      <div class="holiday-hero-actions">
        <a class="btn btn-solid" href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan My Holiday Party</a>
      </div>
    </div>
  </section>

  {/* ============================================================
      THE ROOM — image left, copy right (desktop)

      LCP optimization (matches /corporate-events + /vip-suite recipe):
        - poster=/snap/vip-lanes-poster.avif (direct, AVIF Q50)
        - lcpPreloadHref="/snap/vip-lanes-poster.avif" in Base frontmatter
        - Bounded media on every <source>: ≤480 → 540w, ≥481 → 1080w
        - data-src (lazy promotion via sectionVideo() motion module)
      Video bytes stay deferred until IntersectionObserver promotes
      the section; only the poster takes the LCP fast path.
      ============================================================ */}
  <section class="holiday-section" aria-labelledby="holiday-room-h2">
    <div class="holiday-section-grid">
      <div class="holiday-section-frame">
        <video
          class="holiday-section-video"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          poster="/snap/vip-lanes-poster.avif"
          aria-label="The six-lane VIP suite at Twisted Pin, with bowling lanes, couch seating and an LED video wall"
        >
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="holiday-section-copy">
        <p class="t-eyebrow">The Room</p>
        <h2 class="t-display holiday-section-title" id="holiday-room-h2">
          Your team. A six-lane VIP suite.
        </h2>
        <p class="holiday-section-body">
          Bowling for the competitive ones. Couch seating for the catch-up
          crowd. The <a href="/vip-suite/">VIP suite</a> sits behind a wall,
          set apart from the traditional lanes.
        </p>
        <ul class="holiday-section-list">
          <li>Up to 80 guests in the semi-private VIP suite</li>
          <li>Up to 200 guests with a full-venue buyout</li>
          <li>LED video wall and AV options for toasts or a year-in-review reel</li>
        </ul>
        <p class="holiday-section-body">
          Ask about reserving all six lanes for your team. Your event plan
          confirms the space, party time and setup arrangements included.
        </p>
        <p class="holiday-section-body holiday-region">
          Planning from <a href="/why-us/romeoville-il/">Romeoville</a>,
          <a href="/why-us/shorewood-il/">Shorewood</a>,
          <a href="/why-us/naperville-il/">Naperville</a>,
          <a href="/why-us/joliet-il/">Joliet</a> or
          <a href="/why-us/bolingbrook-il/">Bolingbrook</a>?
          We’re at {STREET} in {LOCALITY}, {REGION}, with free on-site parking.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================
      THE FOOD & BAR — image RIGHT, copy LEFT (alternation)

      Second section sits below the mobile fold so the poster is NOT
      an LCP candidate — data-poster (lazy) is correct here. Bounded
      media on sources is defense-in-depth against the v.load()
      doubled-fetch issue.
      ============================================================ */}
  <section class="holiday-section holiday-section--reverse" aria-labelledby="holiday-food-h2">
    <div class="holiday-section-grid">
      <div class="holiday-section-frame">
        <video
          class="holiday-section-video"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          data-poster="/snap/buffet-poster.avif"
          aria-label="In-house catering at Twisted Pin, with a buffet of food in chafing dishes"
        >
          <source media="(max-width: 480px)" data-src="/snap/buffet-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/buffet-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/buffet-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/buffet-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="holiday-section-copy">
        <p class="t-eyebrow">The Food &amp; Bar</p>
        <h2 class="t-display holiday-section-title" id="holiday-food-h2">
          Holiday catering. Cocktails worth a toast.
        </h2>
        <p class="holiday-section-body">
          <a href="/eat/">In-house catering</a>, scaled to your group.
          Tell us about menu preferences and dietary needs when you inquire
          so the team can confirm what works for your party.
        </p>
        <p class="holiday-section-body">
          Choose from the <a href="/menu/taps/">28-tap self-serve beer &amp;
          wine wall</a> and <a href="/menu/cocktails/">craft cocktails</a>
          from the program curated by Brian Van Flandern,
          <em>America’s Top Mixologist</em> (Food Network).
        </p>
        <p class="holiday-section-body">
          Ask about a bar tab or drink tickets, and confirm the arrangements
          with your event quote.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================
      WHAT WE HOST — orienting band. Lighter register than the
      closing CTA so it reads as context, not conversion.
      ============================================================ */}
  <section class="holiday-context" aria-labelledby="holiday-context-h2">
    <div class="holiday-context-inner">
      <p class="t-eyebrow">What We Host</p>
      <h2 class="t-display holiday-context-title" id="holiday-context-h2">
        Company holiday parties. Staff appreciation.
      </h2>
      <p class="holiday-context-body">
        Thank the team, bring clients together or celebrate the end of a busy
        year. We also host holiday gatherings for friends, families and
        community groups.
      </p>
      <p class="holiday-context-body">
        Planning something else? Explore <a href="/corporate-events/">year-round
        company events</a> or <a href="/new-years-eve/">New Year’s Eve parties</a>.
      </p>
    </div>
  </section>

  {/* ============================================================
      FAQ — practical planning answers. Reuses the global .t2-faq*
      accordion and the same answer text in FAQPage JSON-LD.
      Sits above the closing CTA so the inquiry button stays the last
      beat on the page — same convention as /corporate-events.
      ============================================================ */}
  <section class="holiday-faq" aria-labelledby="holiday-faq-h2">
    <div class="holiday-faq-inner">
      <p class="t-eyebrow">Questions</p>
      <h2 class="t-display holiday-faq-title" id="holiday-faq-h2">
        Holiday party FAQs.
      </h2>
      <div class="t2-faq">
        {faqs.map((item) => (
          <details class="t2-faq-item">
            <summary class="t2-faq-q">
              <h3 class="t2-faq-q-text">{item.q}</h3>
              <svg
                class="t2-faq-chevron"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICON_PATHS["chevron-down"]}
              />
            </summary>
            <div class="t2-faq-a"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
      CLOSING CTA BAND — urgency as headline (rare; earned because
      the constraint is real — December genuinely books fast).
      Same lifted-indigo treatment as /corporate-events for the
      conversion-moment family visual consistency.
      ============================================================ */}
  <section class="holiday-cta" aria-labelledby="holiday-cta-h2">
    <div class="holiday-cta-inner">
      <p class="t-eyebrow">Start with your date and headcount</p>
      <h2 class="t-display holiday-cta-title" id="holiday-cta-h2">
        December books fast.
      </h2>
      <p class="holiday-cta-body">
        Share your preferred date, approximate headcount and occasion.
        Our event team will check availability, help with catering and bar
        arrangements, and provide a quote for your party.
      </p>
      <a class="btn btn-solid holiday-cta-btn" href={PLAN_EVENT_URL} target="_blank" rel="noopener">
        Plan My Holiday Party
      </a>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Events", path: "/events/" },
    { name: "Holiday Parties", path: "/holiday-parties/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /holiday-parties — same pillar skeleton as /corporate-events
     /events /vip-suite /fundraisers. Class names .holiday-* mirror
     .corp-* / .events-* / .vip-* / .fundraiser-* — rule of ten,
     .pillar-* CSS hoist deeply overdue. Numbers match the family
     byte-for-byte where applicable.
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .holiday-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 0;
    padding: calc(var(--header-height) + 24px) 22px 28px;
  }
  @media (min-width: 1025px) {
    .holiday-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .holiday-hero-copy {
    max-width: 760px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .holiday-hero-copy { text-align: center; }
    .holiday-hero-sub { margin-left: auto; margin-right: auto; }
  }

  .holiday-hero-headline {
    color: var(--warm-white);
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .holiday-hero-headline { font-size: clamp(56px, 6vw, 88px); }
  }

  .holiday-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 34em;
  }
  @media (min-width: 1025px) {
    .holiday-hero-sub { margin-top: 22px; font-size: 19px; max-width: 38em; }
  }

  .holiday-hero-actions { margin-top: 24px; }
  .holiday-hero-actions .btn,
  .holiday-cta-btn {
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  /* ============================================================
     section pattern (same shape as .corp-section etc.)
     ============================================================ */
  .holiday-section {
    background: transparent;
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
    .holiday-section { padding: 24px 64px; }
  }

  .holiday-section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 1025px) {
    .holiday-section-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 64px;
    }
    .holiday-section--reverse .holiday-section-grid > .holiday-section-frame {
      order: 2;
    }
  }

  .holiday-section-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1025px) {
    .holiday-section-frame { aspect-ratio: 3 / 4; max-height: 640px; }
  }

  .holiday-section-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .holiday-section-copy {
    color: var(--warm-white);
    max-width: 36em;
  }

  .holiday-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .holiday-section-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .holiday-section-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
  }
  @media (min-width: 1025px) {
    .holiday-section-body { font-size: 17.5px; line-height: 1.65; }
  }

  .holiday-section-body strong {
    color: var(--warm-white);
    font-weight: 700;
  }

  .holiday-section-body a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 200ms ease;
  }
  .holiday-section-body a:hover {
    text-decoration-color: var(--glow);
  }

  .holiday-section-list {
    margin-top: 22px;
    padding-left: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--warm-white);
  }
  .holiday-section-list li {
    padding: 8px 0 8px 22px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
    position: relative;
  }
  .holiday-section-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glow);
    opacity: 0.85;
  }

  /* ============================================================
     WHAT WE HOST context band — orientation, not conversion.
     ============================================================ */
  .holiday-context {
    background: transparent;
    padding: 48px 22px 8px;
  }
  @media (min-width: 1025px) {
    .holiday-context { padding: 72px 64px 24px; }
  }

  .holiday-context-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    color: var(--warm-white);
  }

  .holiday-context-title {
    color: var(--warm-white);
    font-size: clamp(28px, 6.5vw, 38px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .holiday-context-title { font-size: clamp(36px, 3.6vw, 48px); }
  }

  .holiday-context-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
    max-width: 38em;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 1025px) {
    .holiday-context-body { font-size: 17.5px; }
  }

  .holiday-context-body a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 200ms ease;
  }
  .holiday-context-body a:hover {
    text-decoration-color: var(--glow);
  }

  /* ============================================================
     FAQ — reuses the global .t2-faq* accordion; wrapper + heading
     page-local (mirrors /corporate-events .corp-faq numbers).
     ============================================================ */
  .holiday-faq {
    background: transparent;
    padding: 48px 22px 8px;
  }
  @media (min-width: 1025px) {
    .holiday-faq { padding: 72px 64px 24px; }
  }

  .holiday-faq-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .holiday-faq-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7vw, 40px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .holiday-faq-title { font-size: clamp(36px, 3.6vw, 48px); }
  }

  .holiday-faq .t2-faq { margin-top: 20px; }

  /* ============================================================
     CLOSING CTA BAND — matches /corporate-events .corp-cta numbers.
     ============================================================ */
  .holiday-cta {
    background: rgba(26, 21, 48, 0.92);
    border-top: 1px solid rgba(244, 239, 227, 0.06);
    padding: 72px 22px 88px;
    margin-top: 32px;
  }
  @media (min-width: 1025px) {
    .holiday-cta { padding: 112px 64px 128px; margin-top: 48px; }
  }

  .holiday-cta-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--warm-white);
  }

  .holiday-cta-title {
    color: var(--warm-white);
    font-size: clamp(36px, 9vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .holiday-cta-title { font-size: clamp(56px, 5vw, 72px); }
  }

  .holiday-cta-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    color: var(--warm-mid);
    max-width: 32em;
    margin-left: auto;
    margin-right: auto;
  }
  @media (min-width: 1025px) {
    .holiday-cta-body { font-size: 19px; }
  }

  .holiday-cta-btn {
    margin-top: 32px;
    padding: 16px 32px;
    font-size: 14px;
    letter-spacing: 0.16em;
  }
  @media (min-width: 1025px) {
    .holiday-cta-btn { padding: 18px 40px; font-size: 15px; }
  }
  /* Desktop size pass (2026-08-03 batch, Jon-approved): the section list
     is read-to-decide spec copy at 13px while the section body runs
     ~17.5px on desktop. 15.5px matches the fundraisers / why-us pattern.
     KEEP LAST in this style block: equal-specificity overrides win by
     source order only (the /pricing dead-CSS lesson). Mobile unchanged. */
  @media (min-width: 1025px) {
    .holiday-section-list { font-size: 15.5px; }
  }
  /* Desktop hero dead-air fix (2026-08-03 sweep — approved on
     /vip-suite): the typography hero pinned min-height 55vh/640px
     around ~300px of copy; flex-centered slack rendered as voids above
     the eyebrow and below the sub. Content + padding define height now.
     KEEP LAST (source-order cascade; the /pricing dead-CSS lesson). */
  @media (min-width: 1025px) {
    .holiday-hero {
      min-height: 0;
      padding: calc(var(--header-height) + 56px) 64px 40px;
    }
    .holiday-section { padding-top: 32px; }
  }
</style>
