---
export const prerender = false;
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SnapFooter from '../components/snap/SnapFooter.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import { MAPS_VENUE_URL } from '../lib/schema';
import { PLAN_EVENT_URL } from '../lib/links';
import { DAYS } from '../data/hours';
import { SHOE_RENTAL_LABEL } from '../data/pricing';
import snapshot from '../data/live-hours.json';
import { pricingForDate, pricingToday, pricingDay, movePricingDate, validPricingDate, pricingDateLabel, upcomingPennyExclusions, holidayPricingDates } from '../lib/pricing-date';

// Request-time rendering keeps selected dates, event cutoffs and Today correct.
// No booking/API mutation; Google data remains the existing daily snapshot.
Astro.response.headers.set('Cache-Control', 'no-store');
const now = new Date();
const today = pricingToday(now);
const requested = Astro.url.searchParams.get('date');
const legacyDay = Astro.url.searchParams.get('day')?.toLowerCase();
const legacyOffset = DAYS.find(d => d.key === legacyDay)
  ? Array.from({ length: 7 }, (_, i) => i).find(i => pricingDay(movePricingDate(today, i)) === legacyDay) : undefined;
const invalidRequest = requested !== null && (!validPricingDate(requested) || requested < today);
const date = requested && !invalidRequest ? requested : legacyOffset !== undefined ? movePricingDate(today, legacyOffset) : today;
const view = pricingForDate(date, now, snapshot);
const monday = movePricingDate(date, -((new Date(`${date}T12:00:00Z`).getUTCDay() + 6) % 7));
const week = DAYS.map((d, i) => ({ ...d, date: movePricingDate(monday, i) }));
const exclusions = upcomingPennyExclusions(now);
const holidayDates = holidayPricingDates(now);
const penny = (await getCollection('specials')).find(s => s.id === 'penny-a-pin' && !s.data.draft);
const selectedInstant = new Date(`${date}T18:00:00Z`);
const pennyActive = penny && (!penny.data.showFrom || selectedInstant >= penny.data.showFrom) && (!penny.data.showUntil || selectedInstant <= penny.data.showUntil);
const ordinary = view.kind === 'ordinary';
const event = view.event;
---
<Base title="Walk-in Bowling Prices in Plainfield, IL | Twisted Pin" description="Choose your visit date for Twisted Pin's walk-in lane rates, holiday hours and Penny a Pin availability. Online reservations use separate package pricing.">
  <section class="pricing-hero" data-hero aria-labelledby="pricing-hero-h1">
    <div class="pricing-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Pricing</p>
      <h1 class="t-display pricing-hero-headline hero-fade" id="pricing-hero-h1" data-delay-ms="120">Walk-in pricing.</h1>
      <p class="pricing-hero-sub hero-fade" data-delay-ms="320">Pick your date. See your rates.</p>
    </div>
  </section>
  <section class="pricing-calendar" aria-labelledby="pricing-calendar-h2" data-pricing-date={date} data-pricing-kind={view.kind}>
    <h2 id="pricing-calendar-h2" class="visually-hidden">Hourly rates for your visit</h2>
    <form action="/pricing/" method="get" class="pricing-date-form">
      <label for="pricing-date">When are you coming?</label>
      <div class="pricing-date-controls">
        <input id="pricing-date" name="date" type="date" required min={today} value={date} />
        <button type="submit" class="btn btn-outline">See rates</button>
      </div>
    </form>
    {invalidRequest && <p class="pricing-date-error" role="status">Choose today or a future date. Showing today's rates.</p>}
    <nav class="today-pills" aria-label="Days in the selected week">
      {week.map(d => d.date < today ? (
        <span class="today-pill past-day" aria-label={`${pricingDateLabel(d.date)}, past date`}><span class="today-pill-label">{d.abbr3}</span><span class="pricing-pill-date">{Number(d.date.slice(-2))}</span></span>
      ) : (
        <a class="today-pill" href={`/pricing/?date=${d.date}`} aria-label={pricingDateLabel(d.date)} aria-current={d.date === date ? 'date' : undefined} data-is-today={d.date === today ? '' : null}>
          <span class="today-pill-label">{d.abbr3}</span><span class="pricing-pill-date">{Number(d.date.slice(-2))}</span>
        </a>
      ))}
    </nav>
    <article class="today-view" aria-hidden="false">
      <header class="today-header">
        {date === today && <p class="today-pill-today-wrap"><span class="today-pill-today">Today</span></p>}
        <p class="pricing-selected-date">{view.label}</p>
        {ordinary && <p class="today-hours">Open {view.hours}</p>}
        {view.kind === 'closed' && <p class="today-day-name">Closed</p>}
      </header>
      {view.kind === 'event' && event && (
        <div class="pricing-event" data-event-id={event.id}>
          <h3>{event.id === 'jingle_bowl_2026' ? 'Jingle Bowl reservations only.' : "New Year's Eve bowling is by reservation only."}</h3>
          <p>{event.admission === 'event_reservations_only'
            ? 'Closed for regular visits on this date. Jingle Bowl reservations still take place; your confirmation has your booked time.'
            : "Regular walk-in lane pricing does not apply on this date. See the New Year's Eve page for party details."}</p>
          {event.public_url && <a class="btn btn-outline" href={event.public_url}>View {event.name} &rarr;</a>}
        </div>
      )}
      {view.kind === 'closed' && <p class="pricing-policy-note">No regular walk-in bowling or ordinary online lane reservations on this date.</p>}
      {view.kind === 'unknown' && <p class="pricing-policy-note">Please <a href={MAPS_VENUE_URL} target="_blank" rel="noopener">check Google</a> or contact the team to confirm this date.</p>}
      {ordinary && <>
        {view.holiday && <p class="pricing-policy-badge">Holiday hourly rates &middot; all open hours</p>}
        {view.day === 'wed' && (view.pennyExcluded ? (
          <div class="today-special" data-penny="excluded"><p class="today-special-name">Penny a Pin is not offered on this date.</p><p class="today-special-body">The hourly lane rates below apply.</p></div>
        ) : pennyActive && !view.pennyScheduleReviewed ? (
          <div class="today-special" data-penny="unconfirmed"><p class="today-special-name">Penny a Pin normally runs Wednesdays.</p><p class="today-special-body">School-break and holiday exclusions for this date are not yet confirmed. Check with the team before visiting.</p></div>
        ) : pennyActive && (
          <div class="today-special" data-penny="regular"><p class="today-special-name">{penny.data.name}</p><p class="today-special-tagline">{penny.data.tagline}</p><p class="today-special-body">Traditional lanes only. <a href="#penny-a-pin">See school-break exclusions.</a></p></div>
        ))}
        <table class="today-table" data-cols="3">
          <caption class="visually-hidden">Walk-in rates per lane, per hour for {view.label}</caption>
          <thead><tr><th class="today-th-time" scope="col">Time</th><th class="today-th-tier" scope="col"><span class="today-th-name">Traditional</span></th><th class="today-th-tier" scope="col"><span class="today-th-name">VIP suite</span></th></tr></thead>
          <tbody>{view.rows.map(row => <tr><td class="today-td-time">{row.label.replace(' next day', '')}{row.label.endsWith(' next day') && <span class="pricing-next-day">next day</span>}</td><td class="today-td-rate"><span class="today-rate-num">${row.traditional}</span><span class="today-rate-unit">/hr</span></td><td class="today-td-rate"><span class="today-rate-num">${row.suite}</span><span class="today-rate-unit">/hr</span></td></tr>)}</tbody>
        </table>
        <p class="today-shoe-line">Per lane, per hour. Shoe rental <span class="today-shoe-price">{SHOE_RENTAL_LABEL}</span>.</p>
        {view.twoHoursOnly && <p class="pricing-policy-note" data-two-hours>Online lane reservations are two hours only on this date. Walk-in bowling uses the hourly rates above.</p>}
        <p class="pricing-policy-note">Online reservations use separate package pricing. <a href="/reserve/">Choose your date in booking &rarr;</a></p>
        <div class="today-quick-actions"><a class="btn btn-outline" href="/waitlist/">Check the waitlist &rarr;</a><a class="btn btn-outline" href="/coupon/">Get the coupon &rarr;</a></div>
      </>}
      {view.note && <p class="today-holiday-note">{view.note} <a href={MAPS_VENUE_URL} target="_blank" rel="noopener">View on Google &rarr;</a></p>}
    </article>
    {holidayDates.length > 0 && <details class="pricing-exceptions"><summary>Upcoming holiday-rate dates</summary><p>Holiday hourly rates apply throughout open hours on these dates. Select a date to see prices. Standard weekends keep their regular rates; reserved events have their own packages.</p><ul>{holidayDates.map(d => <li><a href={`/pricing/?date=${d}`}>{pricingDateLabel(d, true)}{`, ${d.slice(0, 4)}`}</a></li>)}</ul></details>}
  </section>
  <section class="pricing-seo" id="penny-a-pin" aria-labelledby="penny-h2">
    <div class="pricing-seo-inner">
      <h2 id="penny-h2" class="t-display pricing-seo-headline">Penny a Pin Wednesdays.</h2>
      <p class="pricing-seo-body">Traditional lanes only. Your score is your game price: bowl 103, pay $1.03. Shoe rental is separate. Penny a Pin is not offered during the school-break dates listed below.</p>
      {exclusions.length > 0 ? <><p class="pricing-seo-body">Not offered on:</p><ul class="pricing-exclusion-dates">{exclusions.map(d => <li><a href={`/pricing/?date=${d}`}>{pricingDateLabel(d)}</a></li>)}</ul></> : <p class="pricing-seo-body">Choose your visit date above and check with the team for any upcoming school-break or holiday changes.</p>}
    </div>
  </section>
  <section class="pricing-seo" aria-labelledby="pricing-seo-h2">
    <div class="pricing-seo-inner">
      <h2 id="pricing-seo-h2" class="t-display pricing-seo-headline">How pricing works.</h2>
      <p class="pricing-seo-body">Walk-in bowling is priced by the lane, by the hour. Choose your visit date above for hourly rates, planned school-break hours and any reserved-event exceptions. Lane availability can vary.</p>
      <p class="pricing-seo-body">Online lane reservations use package pricing. During the main school breaks, ordinary online lane reservations are two hours only; that requirement appears when you select an affected date. The reservation page shows current packages and availability.</p>
      <p class="pricing-seo-body">For a suite event, party or corporate gathering, <a href={PLAN_EVENT_URL} target="_blank" rel="noopener">plan an event with our team &rarr;</a>. For lanes, leagues and the bowling experience, see <a href="/bowl/">bowling at Twisted Pin</a>.</p>
      <p class="pricing-seo-body pricing-seo-meta">Twisted Pin &middot; 15610 Joliet Rd, Plainfield, IL 60544</p>
    </div>
  </section>
  <SnapFooter />
  <BreadcrumbSchema crumbs={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]} />
</Base>
<script>
  // Preserve old Wednesday SMS/ad links. Exact date queries always win.
  const url = new URL(location.href);
  const day = url.hash.slice(1).toLowerCase();
  if (!url.searchParams.has('date') && !url.searchParams.has('day') && ['mon','tue','wed','thu','fri','sat','sun'].includes(day)) {
    url.hash = ''; url.searchParams.set('day', day); location.replace(url.href);
  }
</script>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  .pricing-hero {
    padding: 120px 24px 48px;
    color: var(--warm-white);
    text-align: center;
  }
  @media (min-width: 1025px) {
    .pricing-hero {
      padding: 160px 64px 64px;
    }
  }
  .pricing-hero-copy {
    max-width: 720px;
    margin: 0 auto;
  }
  .pricing-hero-headline {
    margin: 8px 0 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 11vw, 80px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--warm-white);
  }
  .pricing-hero-sub {
    font-family: var(--font-body);
    font-size: clamp(15px, 4vw, 18px);
    line-height: 1.5;
    color: rgba(255, 252, 245, 0.78);
    margin: 0;
  }

  /* ============================================================
     CALENDAR — transparent on page bg, no boxing
     ============================================================ */
  .pricing-calendar {
    /* No background — let the body's Indigo Deep + Pin Tilt
       watermark show through. Explicit direction 2026-05-06. */
    padding: 24px;
    max-width: 760px;
    margin: 0 auto 64px;
  }
  /* (Desktop calendar overrides live at the BOTTOM of this style block —
     they must come after the base rules below or equal-specificity
     cascade order silently defeats them; that exact bug shipped in
     rounds 1–2 of the 2026-08-03 desktop pass.) */

  /* Day pills — segmented control */
  .today-pills {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin: 0 auto 28px;
    width: 100%;
    max-width: 480px;
    padding: 4px;
    background: rgba(255, 252, 245, 0.05);
    border: 1px solid rgba(255, 252, 245, 0.10);
    border-radius: 999px;
  }
  .today-pill {
    appearance: none;
    background: transparent;
    border: 0;
    color: rgba(255, 252, 245, 0.65);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.10em;
    padding: 12px 0 10px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .today-pill:hover { color: var(--warm-white); }
  .today-pill[aria-pressed="true"] {
    background: var(--glow);
    color: var(--indigo-deep);
  }
  .today-pill-label { display: block; line-height: 1; }
  .today-pill-dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: transparent;
    margin: 4px auto 0;
  }
  .today-pill[data-is-today] .today-pill-dot { background: var(--glow); }
  .today-pill[data-is-today][aria-pressed="true"] .today-pill-dot {
    background: var(--indigo-deep);
  }

  /* Per-day view — only one visible */
  .today-view { display: none; }
  .today-view[aria-hidden="false"] { display: block; }

  .today-header {
    text-align: center;
    margin-bottom: 20px;
  }
  /* TODAY pill stacks ABOVE the day name (per user direction) —
     not inline. Renders only when this view is the current day. */
  .today-pill-today-wrap {
    margin: 0 0 10px;
  }
  .today-pill-today {
    display: inline-block;
    background: var(--glow);
    color: var(--indigo-deep);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    line-height: 1;
  }
  .today-day-name {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 10vw, 60px);
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--warm-white);
  }
  .today-hours {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    color: rgba(255, 252, 245, 0.78);
    line-height: 1.3;
  }
  .today-hours-caveat a {
    color: inherit;
    border-bottom: 1px solid rgba(255, 252, 245, 0.3);
    text-decoration: none;
  }
  .today-hours-caveat a:hover {
    color: var(--glow);
    border-bottom-color: var(--glow);
  }

  /* Specials callout */
  .today-specials {
    margin: 16px 0;
    display: grid;
    gap: 10px;
  }
  .today-special {
    border: 1px solid rgba(159, 245, 202, 0.42);
    background: rgba(159, 245, 202, 0.06);
    border-radius: 12px;
    padding: 14px 16px;
  }
  /* "Wed Special" eyebrow above the name — quieter than the name,
     matches the t-eyebrow recipe but tinted Glow at lower opacity
     to live within the Glow-bordered card without competing. */
  .today-special-eyebrow {
    margin: 0 0 6px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(159, 245, 202, 0.7);
    line-height: 1;
  }
  .today-special-head {
    margin: 0 0 4px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .today-special-mark { color: var(--glow); font-size: 14px; line-height: 1; }
  .today-special-name {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--glow);
  }
  /* Hours displayed inline with the special name — answers
     "what hours is this special available?" without forcing a
     second copy line. Lower-emphasis than the name. */
  .today-special-hours {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
    color: rgba(255, 252, 245, 0.7);
  }
  .today-special-tagline {
    margin: 0 0 6px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.45;
    color: var(--warm-white);
  }
  .today-special-body {
    margin: 0;
    font-family: var(--font-body);
    /* Bumped 12 -> 14 (2026-05-24 readability sweep). This is body
       text inside the special callout — was sitting below the
       comfort floor for secondary content. */
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 252, 245, 0.65);
  }

  /* Pricing table — fixed layout so columns don't auto-size to
     content. Without this, narrow viewports squeeze "VIP SUITE"
     to two lines and stretch "ALL OPEN HOURS" past its column. */
  .today-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 12px;
    table-layout: fixed;
  }
  /* 2-column (Mon-Thu): equal Trad / Suite columns */
  .today-table[data-cols="2"] th,
  .today-table[data-cols="2"] td {
    width: 50%;
  }
  /* 3-column (Fri/Sat/Sun): TIME 34% / Trad 33% / Suite 33%.
     TIME wide enough that "12 PM – 7 PM" doesn't wrap; Trad/Suite
     wide enough that TRADITIONAL header (the longest of the three
     labels) fits without spilling into the next column. Header
     font + tracking dialed back to 13px / 0.08em as part of the
     same fit pass. */
  .today-table[data-cols="3"] th:nth-child(1),
  .today-table[data-cols="3"] td:nth-child(1) {
    width: 34%;
  }
  .today-table[data-cols="3"] th:nth-child(2),
  .today-table[data-cols="3"] td:nth-child(2),
  .today-table[data-cols="3"] th:nth-child(3),
  .today-table[data-cols="3"] td:nth-child(3) {
    width: 33%;
  }
  .today-table th {
    padding: 10px 6px;
    text-align: right;
    border-bottom: 1px solid rgba(255, 252, 245, 0.10);
    vertical-align: top;
  }
  .today-th-time {
    text-align: left;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-white);
    line-height: 1.1;
  }
  /* Tier headers stack a name + capacity sub-line. The sub-line
     replaces the prior single combined "Traditional up to 5 …"
     footnote — capacity is a property of the tier, not the day. */
  .today-th-tier {
    text-align: right;
  }
  .today-th-name {
    display: block;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-white);
    line-height: 1.1;
  }
  .today-th-cap {
    display: block;
    margin-top: 4px;
    font-family: var(--font-body);
    font-weight: 400;
    /* Bumped 12 -> 13 (2026-05-24 readability sweep). Sub-line under
       the TRAD / VIP SUITE column header carrying capacity info
       ("up to 5 per lane") — informational text deserves to be
       legible, not footnote-tier. */
    font-size: 13px;
    color: rgba(255, 252, 245, 0.6);
    text-transform: none;
    letter-spacing: 0;
  }
  .today-table td {
    padding: 18px 6px;
    border-bottom: 1px solid rgba(255, 252, 245, 0.06);
    text-align: right;
    vertical-align: middle;
  }
  .today-table tr:last-child td { border-bottom: 0; }
  .today-td-time {
    text-align: left;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(255, 252, 245, 0.78);
    /* Force single line — without this, the dash + space inside
       "11 AM – 4 PM" gives the browser a wrap opportunity that
       fires inconsistently depending on column width. */
    white-space: nowrap;
  }
  .today-rate-num {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 36px);
    color: var(--glow);
    line-height: 1;
  }
  .today-rate-unit {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255, 252, 245, 0.6);
    margin-left: 3px;
  }
  .today-rate-special {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--glow);
    line-height: 1.2;
    display: inline-block;
  }

  /* Shoe rental — the only universal-day footnote left after
     capacity moved into per-tier column headers. Bumped size
     from prior compressed footnote since it's now the only
     line of fine print and earns the legibility. $5.95
     gets the Glow accent (matches the price-number color). */
  .today-shoe-line {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255, 252, 245, 0.78);
    text-align: center;
  }
  .today-shoe-price {
    color: var(--glow);
    font-weight: 700;
  }

  /* Two quick-action pills — global, sits between the per-day
     views and the holiday note. Both outlined to keep them
     deliberate (Reserve is the global primary CTA elsewhere;
     these are "before you commit" hand-offs).
     Equal-width sizing: flex-basis 200px lets them share the
     row evenly when there's room (≥420px container) and stack
     full-width when there isn't. Either way they render at
     the same width — no asymmetric look from longer button
     labels. Capped at 460px max so they don't sprawl on desktop. */
  .today-quick-actions {
    margin: 24px auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 460px;
  }
  .today-quick-actions .btn {
    flex: 1 1 200px;
    min-width: 0;
    text-align: center;
    padding: 11px 22px;
    font-size: 12px;
    letter-spacing: 0.14em;
  }

  /* Holiday note — global, applies to every day, sits below all views. */
  .today-holiday-note {
    margin: 24px auto 0;
    max-width: 480px;
    font-family: var(--font-body);
    font-style: italic;
    /* Bumped 12 -> 13 (2026-05-24 readability sweep). Italic fine
       print at the bottom of each day view. Still subordinate
       (italic + low opacity color), now legible at arm's length. */
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 252, 245, 0.55);
    text-align: center;
    padding-top: 20px;
