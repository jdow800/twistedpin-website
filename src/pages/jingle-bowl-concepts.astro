---
import Base from '../layouts/Base.astro';
import EventDateHandoffPreview from '../components/tprs/EventDateHandoffPreview';
import MobileEntrancePreview from '../components/jingle/MobileEntrancePreview.astro';
export const prerender = false;
const workingSessions = [
  ['1:45–3:15 PM', '6', '2', '1:15 PM'],
  ['2:00–3:30 PM', '6', '2', '1:30 PM'],
  ['2:30–4:00 PM', '5', '2', '2:00 PM'],
  ['3:30–5:00 PM', '6', '2', '3:00 PM'],
  ['3:45–5:15 PM', '6', '2', '3:15 PM'],
];
---
<Base title="Jingle Bowl — creative review" description="Password-protected Jingle Bowl mobile campaign review." hideHeader hideNavDrawer hideStickyCTA hidePromo>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="review-shell">
    <header class="review-head"><img src="/logo/twisted-pin-horizontal-white.webp" width="180" height="77" alt="Twisted Pin"/><span>CREATIVE REVIEW · 02</span><a href="/jingle-bowl/">Open landing page ↗</a></header>
    <section class="intro"><p class="eyebrow">DECEMBER 6, 2026 / THE HOLIDAY CAMPAIGN</p><h1>A LITTLE<br/><em>CHRISTMAS CHAOS.</em></h1><p class="lede">One unmistakable event. A homepage moment worth noticing. A clear path from “let’s bowl” to Jingle Bowl.</p><div class="review-links"><a href="#homepage">Homepage options ↓</a><a href="#artwork">Campaign graphics ↓</a><a href="#booking">Booking handoff ↓</a><a href="/review/jingle-calendar/?month=2026-12">Upcoming Events ↗</a></div></section>
    <section id="homepage" class="chapter">
      <div class="section-top"><div><p class="eyebrow">01 / THE MOBILE HOMEPAGE</p><h2>MAKE AN ENTRANCE.</h2></div><p>Your hero video keeps playing. The holiday promo briefly makes room for a little Christmas mischief, right beneath the logo and menu.</p></div>
      <MobileEntrancePreview />
    </section>
    <section id="artwork" class="chapter">
      <div class="section-top"><div><p class="eyebrow">02 / THE CAMPAIGN</p><h2>ONE LOOK.<br/>EVERYWHERE.</h2></div><p>Artwork uses the confirmed event name and date. The approved lane prices and reservation times appear on the event page.</p></div>
      <div class="art-grid"><figure><a href="/jingle-bowl/jingle-square.png" download><img src="/jingle-bowl/jingle-square.webp" width="1254" height="1254" loading="lazy" alt="Square Jingle Bowl campaign graphic" /></a><figcaption><strong>Square / social post</strong><a href="/jingle-bowl/jingle-square.png" download>Download PNG ↓</a></figcaption></figure><figure class="wide-art"><a href="/jingle-bowl/jingle-wide.png" download><img src="/jingle-bowl/jingle-wide.webp" width="1200" height="630" loading="lazy" alt="Landscape Jingle Bowl campaign graphic" /></a><figcaption><strong>Landscape / event & share image</strong><a href="/jingle-bowl/jingle-wide.png" download>Download PNG ↓</a></figcaption><div class="art-note"><p class="eyebrow">IN REAL HTML, TOO</p><h3>THE DATE NEVER<br/>LIVES ONLY IN A PICTURE.</h3><p>The landing page and Upcoming Events carry searchable, accessible event details. The graphic gives them a recognizable campaign identity.</p></div></figure></div>
    </section>
    <section id="booking" class="chapter booking-chapter"><div class="section-top"><div><p class="eyebrow">03 / BOOKING</p><h2>RIGHT DATE.<br/>RIGHT EXPERIENCE.</h2></div><p>Try December 6 in this isolated demo. Guests get a clear Jingle Bowl handoff and can still choose another date.</p></div><EventDateHandoffPreview protectedPreview={true} client:visible /><div class="build-note"><strong>Booking setup is still being verified.</strong> This demonstration makes no API or payment requests. The approved pricing setup includes a 10% Online Booking Fee and applicable tax; production catalog and checkout totals still need verification.</div></section>
    <section class="chapter working-plan"><p class="eyebrow">04 / OWNER REVIEW · APPROVED SCHEDULE</p><h2>39 RESERVATIONS.<br/>ONE BIG AFTERNOON.</h2><p>The approved schedule includes 39 reservations across five 90-minute starts, with booking available until 30 minutes before each start when lanes remain.</p><div class="table-scroll"><table><thead><tr><th>Bowling</th><th>Traditional</th><th>VIP</th><th>Book by</th></tr></thead><tbody>{workingSessions.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody><tfoot><tr><th>Total reservations</th><td>29</td><td>10</td><td>39 total</td></tr></tfoot></table></div><p class="small-note">All times Central on Sunday, December 6. These are reservations across multiple starts, not physical lane counts. Jingle Bowl activities end at 5:15pm. Clear your lane, seats and belongings at your reserved end time; the arcade or an available waiting area is open to your group afterward only until 5:30pm, when the venue closes and all guests must depart. Opening and Santa visit times remain to be confirmed.</p></section>
    <footer><p>Password-protected concept review · Approved schedule, packages and pricing setup; live booking verification pending.</p><a href="/jingle-bowl/">See the landing page ↗</a></footer>
  </div>
</Base>
<style>
  :global(html:has(.review-shell)){scrollbar-gutter:auto}
  .review-shell{max-width:1440px;margin:auto;padding:0 48px;color:var(--warm-white)}.review-head{min-height:110px;display:flex;align-items:center;gap:28px;border-bottom:1px solid #ffffff20}.review-head img{width:150px;height:auto}.review-head span{font:600 10px var(--font-ui);letter-spacing:.16em;color:var(--warm-dim);margin-left:auto}.review-head a,.review-links a{font:700 12px var(--font-ui);color:var(--glow);text-decoration:none}.intro{padding:70px 0 65px}.eyebrow{font:700 11px var(--font-ui);letter-spacing:.15em;color:var(--glow);margin-bottom:22px}h1,h2,h3{font-family:var(--font-display);font-weight:900;letter-spacing:-.02em}h1{font-size:clamp(60px,8vw,115px);line-height:.9}h1 em{font-style:normal;-webkit-text-stroke:1px var(--warm-white);color:transparent}.lede{font:400 18px/1.7 var(--font-body);max-width:640px;margin:30px 0;color:var(--warm-mid)}.review-links{display:flex;flex-wrap:wrap;gap:26px}.chapter{padding:64px 0;border-top:1px solid #ffffff25;scroll-margin-top:24px}.section-top{display:flex;justify-content:space-between;gap:48px;align-items:end;margin-bottom:36px}.section-top h2{font-size:64px;line-height:.95}.section-top>p{max-width:405px;font:400 15px/1.8 var(--font-body);color:var(--warm-mid)}.small-note{max-width:900px;font:400 12px/1.8 var(--font-ui);color:var(--warm-dim)}
  .art-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:36px}.art-grid img{width:100%;height:auto;display:block;border-radius:5px}.art-grid figcaption{display:flex;justify-content:space-between;gap:12px;margin-top:16px;font:600 12px/1.6 var(--font-ui)}.art-grid figcaption a{color:var(--glow);text-decoration:none}.art-note{border-top:1px solid #ffffff25;margin-top:36px;padding-top:30px}.art-note h3{font-size:42px;line-height:1}.art-note p:not(.eyebrow){font:400 14px/1.7 var(--font-body);color:var(--warm-mid);margin-top:18px}.build-note{margin-top:24px;border-left:2px solid var(--glow);padding:6px 22px;font:400 13px/1.8 var(--font-body);color:var(--warm-mid)}.build-note strong{display:block;color:var(--warm-white);font:700 12px var(--font-ui);margin-bottom:8px}.working-plan h2{font-size:clamp(44px,5vw,64px);line-height:.95}.working-plan>p:not(.eyebrow){max-width:790px;font:400 14px/1.8 var(--font-body);color:var(--warm-mid);margin:24px 0}.table-scroll{overflow-x:auto;margin:30px 0}table{width:100%;border-collapse:collapse;text-align:left;font:600 13px var(--font-ui)}th,td{padding:18px 15px;border-bottom:1px solid #ffffff25}thead{color:var(--glow)}tfoot{background:#ffffff08}th:first-child,td:first-child{padding-left:0}footer{border-top:1px solid #ffffff25;padding:36px 0 64px;display:flex;justify-content:space-between;gap:24px;font:600 12px/1.8 var(--font-ui);color:var(--warm-dim)}footer a{color:var(--glow);white-space:nowrap}
  @media(max-width:750px){.review-shell{padding:0 20px}.review-head{min-height:85px;gap:16px}.review-head img{width:105px}.review-head span{display:none}.review-head a{margin-left:auto;font-size:11px}.intro{padding:42px 0}.intro h1{font-size:clamp(48px,15vw,61px)}.lede{font-size:15px}.review-links{gap:18px}.review-links a{font-size:11px}.chapter{padding:42px 0}.section-top{display:block}.section-top h2{font-size:51px}.section-top>p{margin-top:22px;font-size:14px}.art-grid{grid-template-columns:1fr;gap:34px}.art-note{display:none}table{font-size:11px}th,td{padding:15px 8px}footer{display:block}footer a{display:block;margin-top:18px}}
</style>
