---
import Base from '../layouts/Base.astro';
import EventDateHandoffPreview from '../components/tprs/EventDateHandoffPreview';
export const prerender = false;
const workingSessions = [
  ['1:45–3:15 PM', '6', '2', '1:15 PM'],
  ['2:00–3:30 PM', '6', '2', '1:30 PM'],
  ['2:30–4:00 PM', '5', '2', '2:00 PM'],
  ['3:30–5:00 PM', '6', '2', '3:00 PM'],
  ['3:45–5:15 PM', '6', '2', '3:15 PM'],
];
---
<Base title="Jingle Bowl — creative review" description="Local Jingle Bowl campaign review." hideHeader hideNavDrawer hideStickyCTA hidePromo>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="review-shell">
    <header class="review-head"><img src="/logo/twisted-pin-horizontal-white.webp" width="180" height="77" alt="Twisted Pin"/><span>CREATIVE REVIEW · 01</span><a href="/jingle-bowl/">Open landing page ↗</a></header>
    <section class="intro"><p class="eyebrow">DECEMBER 6, 2026 / THE HOLIDAY CAMPAIGN</p><h1>A LITTLE<br/><em>CHRISTMAS CHAOS.</em></h1><p class="lede">One unmistakable event. A homepage moment worth noticing. A clear path from “let’s bowl” to Jingle Bowl.</p><div class="review-links"><a href="#homepage">Homepage options ↓</a><a href="#artwork">Campaign graphics ↓</a><a href="#booking">Booking handoff ↓</a><a href="/review/jingle-calendar/?month=2026-12">Upcoming Events ↗</a></div></section>
    <section id="homepage" class="chapter">
      <div class="section-top"><div><p class="eyebrow">01 / HOMEPAGE</p><h2>MAKE AN ENTRANCE.</h2></div><p>Keep the current homepage identity. Give Jingle Bowl its own seasonal feature just after the opening.</p></div>
      <div class="options" role="group" aria-label="Homepage visual treatment"><button data-option="feature" aria-pressed="true">01 · The feature <small>Recommended</small></button><button data-option="ornament" aria-pressed="false">02 · The ornament <small>A little motion</small></button><button data-option="santa" aria-pressed="false">03 · Santa’s entrance <small>The playful one</small></button></div>
      <div class="site-frame" data-mode="feature">
        <div class="frame-nav"><img src="/logo/twisted-pin-horizontal-white.webp" width="130" height="55" alt="Twisted Pin"/><span>HOMEPAGE PLACEMENT PREVIEW</span><a href="/jingle-bowl/">Jingle Bowl ↗</a></div>
        <div class="existing-hero"><div><p>PLAINFIELD’S PREMIER NIGHT OUT.</p><h3>BUILT FOR ADULTS.<br/><span>FINE, BRING THE KIDS.</span></h3><p>Bowling optional.</p></div></div>
        <div class="campaign-feature">
          <div class="feature-copy"><p class="eyebrow">SUNDAY, DECEMBER 6</p><h3>SANTA’S<br/>TAKING OVER.</h3><p>Jingle Bowl is back at Twisted Pin.<br/>Make a little holiday noise.</p><a class="action" href="/jingle-bowl/">Explore Jingle Bowl <span>↗</span></a></div>
          <img class="feature-art" src="/jingle-bowl/jingle-square.webp" width="1254" height="1254" loading="lazy" alt="Jingle Bowl! Bowl with Santa. Sunday, December 6, 2026 at Twisted Pin in Plainfield." />
          <div class="ornament-track" aria-hidden="true"><svg class="ornament" viewBox="0 0 160 190"><defs><radialGradient id="ball"><stop stop-color="#428575"/><stop offset=".52" stop-color="#155347"/><stop offset="1" stop-color="#06231f"/></radialGradient></defs><path d="M80 1v22" stroke="#d8b572" stroke-width="3"/><rect x="66" y="23" width="28" height="17" rx="3" fill="#d8b572"/><circle cx="80" cy="108" r="70" fill="url(#ball)" stroke="#c6a864" stroke-width="2"/><ellipse cx="59" cy="73" rx="15" ry="9" fill="#88c6ad" opacity=".25" transform="rotate(-35 59 73)"/><g fill="#031611" stroke="#397c68"><circle cx="90" cy="83" r="8"/><circle cx="110" cy="96" r="8"/><circle cx="88" cy="109" r="8"/></g></svg></div>
          <div class="santa-track" aria-hidden="true"><img src="/jingle-bowl/santa-entrance.webp" width="600" height="600" alt="" loading="lazy"/></div>
        </div>
      </div>
      <div class="option-note"><p data-option-description>The strongest everyday version: a full-width campaign feature with the poster and a clear event link. It works immediately, with no motion required.</p><button class="replay" hidden>Replay entrance ↻</button></div>
      <p class="small-note">Motion is contained in the feature, plays only on request in this review, and respects reduced-motion settings. A production version would play once after the main content loads. No extra floating overlay.</p>
    </section>
    <section id="artwork" class="chapter">
      <div class="section-top"><div><p class="eyebrow">02 / THE CAMPAIGN</p><h2>ONE LOOK.<br/>EVERYWHERE.</h2></div><p>Artwork uses the confirmed event name and date. Package prices and session times can follow once approved.</p></div>
      <div class="art-grid"><figure><a href="/jingle-bowl/jingle-square.png" download><img src="/jingle-bowl/jingle-square.webp" width="1254" height="1254" loading="lazy" alt="Square Jingle Bowl campaign graphic" /></a><figcaption><strong>Square / social post</strong><a href="/jingle-bowl/jingle-square.png" download>Download PNG ↓</a></figcaption></figure><figure class="wide-art"><a href="/jingle-bowl/jingle-wide.png" download><img src="/jingle-bowl/jingle-wide.webp" width="1200" height="630" loading="lazy" alt="Landscape Jingle Bowl campaign graphic" /></a><figcaption><strong>Landscape / event & share image</strong><a href="/jingle-bowl/jingle-wide.png" download>Download PNG ↓</a></figcaption><div class="art-note"><p class="eyebrow">IN REAL HTML, TOO</p><h3>THE DATE NEVER<br/>LIVES ONLY IN A PICTURE.</h3><p>The landing page and Upcoming Events carry searchable, accessible event details. The graphic gives them a recognizable campaign identity.</p></div></figure></div>
    </section>
    <section id="booking" class="chapter booking-chapter"><div class="section-top"><div><p class="eyebrow">03 / BOOKING</p><h2>RIGHT DATE.<br/>RIGHT EXPERIENCE.</h2></div><p>Try December 6 in this isolated demo. Guests get a clear Jingle Bowl handoff and can still choose another date.</p></div><EventDateHandoffPreview protectedPreview={true} client:visible /><div class="build-note"><strong>Booking implementation still required.</strong> This demonstration makes no API or payment requests. Launch needs approved sessions and package details, enforcement across all booking channels, and a lane allocation for each start.</div></section>
    <section class="chapter working-plan"><p class="eyebrow">04 / OWNER REVIEW · PREFERRED PLAN</p><h2>39 RESERVATIONS.<br/>ONE BIG AFTERNOON.</h2><p>Jon’s current preference: the 39-reservation schedule, with booking available until 30 minutes before each start when lanes remain. Both are working assumptions pending final confirmation.</p><div class="table-scroll"><table><thead><tr><th>Bowling</th><th>Traditional</th><th>VIP</th><th>Book by</th></tr></thead><tbody>{workingSessions.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody><tfoot><tr><th>Total reservations</th><td>29</td><td>10</td><td>39 total</td></tr></tfoot></table></div><p class="small-note">All times Central on Sunday, December 6. These are reservations across multiple starts, not physical lane counts. Remaining availability must be checked live. Final opening/closing, prices, food workflow and Santa timing still need confirmation.</p></section>
    <footer><p>Password-protected concept review · Proposed operational details remain subject to approval.</p><a href="/jingle-bowl/">See the landing page ↗</a></footer>
  </div>
</Base>
<style>
  /* A dedicated row gives the moving character its own space, never over date/CTA. */
  .site-frame[data-mode='santa'] .santa-track{position:relative;inset:auto;grid-column:1/-1;height:150px;background:#21192f;border-top:1px solid #ffffff15}
  .site-frame[data-mode='santa'] .santa-track img{width:145px;height:145px;bottom:0;left:calc(100% - 165px)}
  .working-plan h2{font-size:clamp(44px,5vw,64px);line-height:.95}.working-plan>p:not(.eyebrow){max-width:790px;font:400 14px/1.8 var(--font-body);color:var(--warm-mid);margin:24px 0}.table-scroll{overflow-x:auto;margin:30px 0}table{width:100%;border-collapse:collapse;text-align:left;font:600 13px var(--font-ui)}th,td{padding:18px 15px;border-bottom:1px solid #ffffff25}thead{color:var(--glow)}tfoot{background:#ffffff08}th:first-child,td:first-child{padding-left:0}@media(max-width:750px){table{font-size:11px}th,td{padding:15px 8px}}
  .review-shell{max-width:1440px;margin:auto;padding:0 48px;color:var(--warm-white)}.review-head{min-height:110px;display:flex;align-items:center;gap:28px;border-bottom:1px solid #ffffff20}.review-head img{width:150px;height:auto}.review-head span{font:600 10px var(--font-ui);letter-spacing:.16em;color:var(--warm-dim);margin-left:auto}.review-head a,.review-links a{font:700 12px var(--font-ui);color:var(--glow);text-decoration:none}.intro{padding:90px 0 76px}.eyebrow{font:700 11px var(--font-ui);letter-spacing:.15em;color:var(--glow);margin-bottom:22px}h1,h2,h3{font-family:var(--font-display);font-weight:900;letter-spacing:-.02em}h1{font-size:clamp(60px,8vw,115px);line-height:.9}h1 em{font-style:normal;color:var(--warm-white);-webkit-text-stroke:1px var(--warm-white);color:transparent}.lede{font:400 18px/1.7 var(--font-body);max-width:640px;margin:30px 0;color:var(--warm-mid)}.review-links{display:flex;flex-wrap:wrap;gap:26px}.chapter{padding:64px 0;border-top:1px solid #ffffff25;scroll-margin-top:24px}.section-top{display:flex;justify-content:space-between;gap:48px;align-items:end;margin-bottom:36px}.section-top h2{font-size:64px;line-height:.95}.section-top>p{max-width:405px;font:400 15px/1.8 var(--font-body);color:var(--warm-mid)}.options{display:flex;gap:10px;margin-bottom:22px}.options button{flex:1;padding:18px 20px;background:#1b1630;border:1px solid #ffffff25;border-radius:7px;color:var(--warm-white);font:700 13px var(--font-ui);text-align:left;cursor:pointer}.options small{display:block;font-size:10px;font-weight:600;color:var(--warm-dim);margin-top:7px}.options button[aria-pressed=true]{border-color:var(--glow);background:#14352f}.options button[aria-pressed=true] small{color:var(--glow)}.site-frame{border:1px solid #ffffff25;border-radius:10px;overflow:hidden;background:#0e0a1f}.frame-nav{min-height:72px;padding:12px 26px;display:flex;gap:24px;align-items:center}.frame-nav img{width:110px;height:auto}.frame-nav span{font:600 9px var(--font-ui);letter-spacing:.12em;color:var(--warm-dim);margin-left:auto}.frame-nav a{font:700 11px var(--font-ui);color:var(--glow);text-decoration:none}.existing-hero{min-height:280px;display:flex;align-items:center;padding:40px 50px;background:linear-gradient(90deg,#0e0a1fe8,#0e0a1f30),url('/hero/hero-desktop-poster.webp') center 54%/cover}.existing-hero h3{font-size:56px;line-height:1}.existing-hero h3 span{color:#e0cdb4}.existing-hero p{font:600 10px var(--font-ui);letter-spacing:.1em;margin:14px 0}.campaign-feature{position:relative;isolation:isolate;display:grid;grid-template-columns:1fr 1fr;overflow:hidden;min-height:490px;background:#171126}.feature-copy{padding:60px 48px;z-index:1}.feature-copy h3{font-size:clamp(50px,5.8vw,82px);line-height:.9}.feature-copy>p:not(.eyebrow){font:400 15px/1.7 var(--font-body);color:var(--warm-mid);margin:22px 0}.feature-art{display:block;width:100%;height:100%;object-fit:cover}.action{display:inline-flex;gap:40px;align-items:center;padding:17px 20px;border-radius:7px;background:var(--glow);color:#0e0a1f;text-decoration:none;font:700 12px var(--font-ui)}.action span{font-size:20px}.ornament-track,.santa-track{display:none;position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:2}.ornament{width:130px;position:absolute;right:45%;top:10px;transform-origin:50% 0}.santa-track img{position:absolute;width:240px;height:240px;object-fit:contain;bottom:0;left:calc(100% - 250px)}[data-mode=ornament] .ornament-track,[data-mode=santa] .santa-track{display:block}[data-mode=ornament].playing .ornament{animation:ornament-swing 3s ease-in-out both}[data-mode=santa].playing .santa-track img{animation:santa-run 3s ease-out both}.option-note{display:flex;align-items:center;gap:24px;justify-content:space-between;padding:20px 0}.option-note p{max-width:800px;font:400 14px/1.75 var(--font-body);color:var(--warm-mid)}.replay{white-space:nowrap;border:1px solid var(--glow);border-radius:7px;background:none;color:var(--glow);padding:12px;font:700 11px var(--font-ui);cursor:pointer}.small-note{max-width:900px;font:400 11px/1.8 var(--font-ui);color:var(--warm-dim)}.art-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:36px}.art-grid img{width:100%;height:auto;display:block;border-radius:5px}.art-grid figcaption{display:flex;justify-content:space-between;gap:12px;margin-top:16px;font:600 11px/1.6 var(--font-ui)}.art-grid figcaption a{color:var(--glow);text-decoration:none}.art-note{border-top:1px solid #ffffff25;margin-top:36px;padding-top:30px}.art-note h3{font-size:42px;line-height:1}.art-note p:not(.eyebrow){font:400 14px/1.7 var(--font-body);color:var(--warm-mid);margin-top:18px}.build-note{margin-top:24px;border-left:2px solid var(--glow);padding:6px 22px;font:400 13px/1.8 var(--font-body);color:var(--warm-mid)}.build-note strong{display:block;color:var(--warm-white);font:700 12px var(--font-ui);margin-bottom:8px}footer{border-top:1px solid #ffffff25;padding:36px 0 64px;display:flex;justify-content:space-between;gap:24px;font:600 11px/1.8 var(--font-ui);color:var(--warm-dim)}footer a{color:var(--glow);white-space:nowrap}@keyframes ornament-swing{0%{transform:rotate(32deg) translateY(-120px)}35%{transform:rotate(-18deg)}65%{transform:rotate(9deg)}85%{transform:rotate(-4deg)}100%{transform:rotate(0)}}@keyframes santa-run{0%{transform:translateX(-1100px) rotate(-10deg)}60%{transform:translateX(-120px) rotate(6deg)}80%{transform:translateX(16px) rotate(-4deg)}100%{transform:translateX(0) rotate(0)}}@media(prefers-reduced-motion:reduce){.playing .ornament,.playing .santa-track img{animation:none!important}}@media(max-width:750px){.review-shell{padding:0 20px}.review-head{min-height:85px;gap:16px}.review-head img{width:105px}.review-head span{display:none}.review-head a{margin-left:auto;font-size:10px}.intro{padding:55px 0}.intro h1{font-size:61px}.lede{font-size:15px}.review-links{gap:18px}.review-links a{font-size:10px}.chapter{padding:42px 0}.section-top{display:block}.section-top h2{font-size:51px}.section-top>p{margin-top:22px;font-size:14px}.options{flex-direction:column;gap:7px}.options button{padding:13px 16px;display:flex;align-items:center;justify-content:space-between;font-size:11px}.options small{margin-top:0}.frame-nav{padding:8px 15px;min-height:54px}.frame-nav img{width:90px}.frame-nav span{display:none}.frame-nav a{margin-left:auto;font-size:9px}.existing-hero{min-height:230px;padding:30px 22px}.existing-hero h3{font-size:36px}.existing-hero p{font-size:8px}.campaign-feature{grid-template-columns:1fr}.feature-copy{padding:38px 26px 42px}.feature-copy h3{font-size:59px}.feature-copy .eyebrow{font-size:9px}.feature-copy>p:not(.eyebrow){font-size:13px}.feature-art{aspect-ratio:1;height:auto}.ornament{right:12px;top:6px;width:80px}.santa-track img{width:180px;height:180px;left:calc(100% - 185px)}.option-note{align-items:start;flex-direction:column;gap:12px}.option-note p{font-size:12px}.art-grid{grid-template-columns:1fr;gap:34px}.art-note{display:none}.art-grid figcaption{font-size:10px}footer{display:block}footer a{display:block;margin-top:18px}}
</style>
<script>
  const frame = document.querySelector<HTMLElement>('.site-frame');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-option]');
  const description = document.querySelector<HTMLElement>('[data-option-description]');
  const replay = document.querySelector<HTMLButtonElement>('.replay');
  const descriptions: Record<string,string> = {
    feature: 'The strongest everyday version: a full-width campaign feature with the poster and a clear event link. It works immediately, with no motion required.',
    ornament: 'A bowling-ball ornament settles into the feature with one brief swing. The headline, date and event link stay still and immediately readable.',
    santa: 'Santa makes a quick entrance along the artwork area and settles into place. This shows the motion concept; a true running character would need dedicated animation frames.'
  };
  function play(){if(!frame)return;frame.classList.remove('playing');requestAnimationFrame(()=>requestAnimationFrame(()=>frame.classList.add('playing')));}
  buttons.forEach(button=>button.addEventListener('click',()=>{const mode=button.dataset.option!;buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));if(frame)frame.dataset.mode=mode;if(description)description.textContent=descriptions[mode];if(replay)replay.hidden=mode==='feature';if(mode!=='feature')play();}));
  replay?.addEventListener('click',play);
</script>
