---
/**
 * /menu/taps — dedicated tap list page.
 *
 * Extracted from /bar's #tap-list section (2026-05-05) so the bar
 * pillar page stays focused on editorial. Tap list is reference content;
 * lives at its own URL.
 *
 * Layout: typography-led hero (no image) + the list-led tap rows
 * (different visual rhythm than the cocktail card grid — beer lists are
 * scannable text with tap-number anchors).
 *
 * Data: build-time fetch from Untappd Business via getTapList(). Daily
 * 4am cron keeps it fresh.
 */
import Base from "../../layouts/Base.astro";
import SnapFooter from "../../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { getTapList } from "../../lib/untappd-taps";
import {
  BUSINESS_URL,
  BUSINESS_ENTITY_ID,
  MENU_TAPS_ID,
} from "../../lib/schema";
// Build-time URL imports — Vite resolves to the hashed /_astro/files/*.woff2
// paths so the preload tags below match the URLs @fontsource's @font-face
// will request (no double-fetch). Two fonts because the typography hero has
// two LCP candidates: H1 in Barlow (var(--font-display)) and subhead in
// Roboto Slab (var(--font-body)). Preloading just one was whack-a-mole —
// fixing the H1 promoted the subhead to LCP.
import barlowCond900Woff2 from "@fontsource/barlow-condensed/files/barlow-condensed-latin-900-normal.woff2?url";
import robotoSlab400Woff2 from "@fontsource/roboto-slab/files/roboto-slab-latin-400-normal.woff2?url";

const tapList = await getTapList();

// Guard against silent thin-content deploy: see /menu/cocktails for the
// pattern. If Untappd returns EMPTY (build-time fetch failure), noindex.
const isMenuEmpty = tapList.sections.length === 0;

// JSON-LD: Menu → MenuSection → MenuItem. Tap-list MenuItems pack
// brewery + location + style + ABV into the description (Schema.org
// has no beer-specific subtype; description is the cleanest place).
const PAGE_URL = `${BUSINESS_URL}/menu/taps/`;
const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  "@id": MENU_TAPS_ID,
  name: "Tap List",
  url: PAGE_URL,
  inLanguage: "en-US",
  provider: { "@id": BUSINESS_ENTITY_ID },
  hasMenuSection: tapList.sections.map((section) => ({
    "@type": "MenuSection",
    name: section.name,
    hasMenuItem: section.taps.map((tap) => {
      // ABV is intentionally NOT in description — Schema.org has no
      // beer-specific subtype, and `MenuItem.nutrition.servingSize` is
      // for pour size, not alcohol content. ABV stays in display copy
      // (the visible row on /menu/taps); schema doesn't need to
      // duplicate it. Revisit with `additionalProperty` only when a
      // frontend feature (e.g. "filter by ABV") actually needs it.
      const descParts = [
        tap.brewery,
        tap.breweryLocation,
        tap.style,
      ].filter(Boolean);
      const item: Record<string, unknown> = {
        "@type": "MenuItem",
        name: tap.name,
      };
      if (descParts.length > 0) item.description = descParts.join(" · ");
      if (tap.labelImage) item.image = tap.labelImage;
      return item;
    }),
  })),
};

// dateModified: today() — honest because Untappd cron pulls real tap
// rotation data daily at 4am. Tap wall genuinely rotates (kegs blow,
// new beers come on). Stage 7 (2026-05-18) — see schema.ts
// webPageSchema docstring for the "what counts as honest" rationale.
const dateModified = new Date().toISOString().split("T")[0];
---
<Base
  title="What's On Tap in Plainfield, IL | Twisted Pin"
  description="The 28-tap self-serve wall at Twisted Pin — beer, cider, hard seltzer, and wine on tap. Synced from Untappd, refreshed daily. Plainfield, IL."
  dateModified={dateModified}
  lcpPreloadHref="/snap/beerwall-poster.avif"
  lcpPreloadMedia="(max-width: 1024px)"
>
  {/* Head additions, three concerns combined into the single slot:
      - Preload critical hero fonts — typography hero has TWO LCP candidates
        on mobile: H1 in Barlow Condensed 900 (var(--font-display)) and
        subhead in Roboto Slab 400 (var(--font-body)). Without preloading,
        both chain through HTML → CSS parse → @font-face → woff2; on cold
        edge cache that's ~1.3-2.3s of font-swap latency for whichever font
        loads last, and Chrome registers the final swap as LCP. Preloading
        both kicks fetches off in parallel with HTML parse. The two fonts
        are the only ones visible in the first viewport that aren't already
        rendered with system fallbacks acceptable. Page-scoped pending
        re-baseline; will promote to Base.astro globally if it lands the
        win without regressing the homepage video LCP.
      - Conditional noindex when Untappd fetch returned EMPTY (Stage 1
        indexability hygiene — guards against silent thin-content deploys)
      - Preconnect to labels.untappd.com (28 beer/cider/seltzer thumbnails
        load from there; first 3-4 rows are in the initial viewport on
        mobile so the handshake matters) + DNS-prefetch wine-searcher.com
        (4 wine labels below the fold; DNS-only suffices). */}
  <Fragment slot="head">
    <link
      rel="preload"
      href={barlowCond900Woff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={robotoSlab400Woff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {isMenuEmpty && <meta name="robots" content="noindex,follow" />}
    <link rel="preconnect" href="https://labels.untappd.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.wine-searcher.com" />
  </Fragment>

  {/* Mobile-only hero image (2026-05-24) — the tap-wall photo becomes the
      LCP candidate on mobile, replacing the text subhead which was
      Chrome-attributed LCP with a ~2.4s font-swap/render-delay ceiling
      we couldn't crack via preloads or font swaps. Image-LCP mirrors
      the proven /es/bowl recipe (97/2.3s). Hidden on desktop ≥1025px
      because desktop already scores well without it and the typography
      hero reads cleaner without the photo. Reuses the existing
      beerwall-poster.avif asset (already in production, immutable-cached,
      72 KB) so zero new asset work + the preload above hits the edge
      cache that's been warm since the homepage tap-wall section deployed. */}
  <section class="menu-hero-image" aria-hidden="true">
    <img
      src="/snap/beerwall-poster.avif"
      alt=""
      width="1080"
      height="1920"
      fetchpriority="high"
      decoding="async"
    />
  </section>

  <section class="menu-hero" data-hero aria-labelledby="menu-h1">
    <p class="t-eyebrow hero-fade" data-delay-ms="0">On Tap Right Now</p>
    <h1 class="t-display menu-hero-headline hero-fade" id="menu-h1" data-delay-ms="120">
      28 Self-Serve Taps
    </h1>
    <p class="menu-hero-sub hero-fade" data-delay-ms="320">
      What's pouring at the wall — beer, cider, hard seltzer, wine.
      Synced from Untappd. Twisted Pin, Plainfield IL.
    </p>
  </section>

  {tapList.sections.length > 0 && (
    <section class="tap-list" id="tap-list" aria-labelledby="tap-list-h2">
      <div class="tap-list-inner">
        {tapList.sections.map((section, sectIdx) => (
          <div class="tap-section">
            <h2 class="tap-section-name">
              {section.name} <span class="tap-section-count">· {section.taps.length}</span>
            </h2>
            <ul class="tap-rows" role="list">
              {section.taps.map((tap, tapIdx) => (
                <li class="tap-row">
                  <div class="tap-label-frame">
                    {tap.labelImage && (
                      <img
                        class="tap-label"
                        src={tap.labelImage}
                        alt=""
                        width="48"
                        height="48"
                        loading={sectIdx === 0 && tapIdx < 3 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    )}
                  </div>
                  <span class="tap-number">{tap.tapNumber}</span>
                  <div class="tap-content">
                    <div class="tap-line-1">
                      <span class="tap-name">{tap.name}</span>
                      {tap.abv && <span class="tap-abv">{tap.abv}%</span>}
                    </div>
                    <div class="tap-line-2">
                      {[tap.brewery, tap.breweryLocation, tap.style]
                        .filter(Boolean)
                        .join(' · ')}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="menu-seo" aria-labelledby="menu-seo-h2">
    <div class="menu-seo-inner">
      <h2 class="menu-seo-title" id="menu-seo-h2">About the tap wall</h2>
      <p>
        Twisted Pin runs a 28-tap self-serve beer wall — the only one in
        the immediate Plainfield area. Grab a card at the bar, pour your
        own, and pay by the ounce. The card system means you can try a
        few sips of something new without committing to a full pint, and
        you don't have to flag down a bartender for a refill.
      </p>
      <p>
        The rotation leans Illinois craft — Werk Force (Plainfield),
        Solemn Oath (Naperville), Phase Three (Lake Zurich), Brothership
        (Mokena), Pollyanna (Lemont), Old Irving and Revolution (Chicago),
        Pipeworks (Chicago), Sketchbook (Evanston) — alongside familiar
        macros, a hard cider, hard seltzer, a non-alcoholic IPA from
        Go Brewing, and four wines on tap. Tap list synced from Untappd
        and refreshed daily.
      </p>
      <p>
        Find us at 15610 Joliet Rd, Plainfield, IL.
      </p>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(menuSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Bar", path: "/bar/" },
    { name: "Tap List", path: "/menu/taps/" },
  ]} />
</Base>

<style>
  /* ============================================================
     Mobile-only hero image — full-width tap-wall photo above the
     typography hero. Becomes the LCP candidate on mobile (image
     bigger than any text element), bypasses the text-LCP /
     font-swap ceiling we couldn't crack with preloads.

     Container fixed-height (220px) + object-fit: cover means the
     image's source aspect ratio doesn't matter — the asset crops
     to fill. Sits flush below the persistent header (no top
     padding) for full-bleed visual impact.

     Hidden on desktop: the menu page reads cleaner without the
     photo at wider viewports, and desktop already scores well
     without an image LCP candidate.
     ============================================================ */
  .menu-hero-image {
    display: block;
    width: 100%;
    height: 220px;
    margin-top: var(--header-height);
    overflow: hidden;
    background: var(--indigo-deep);
  }
  .menu-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (min-width: 1025px) {
    .menu-hero-image { display: none; }
  }

  /* ============================================================
     Menu page hero — shared shape across /menu/* pages.
     ============================================================ */
  .menu-hero {
    padding: calc(var(--header-height) + 32px) 22px 24px;
    color: var(--warm-white);
    max-width: 1280px;
    margin: 0 auto;
  }
  /* On mobile, the hero image above absorbs the header-clearance
     padding — so the typography hero doesn't need to push down past
     the header again. Tightens the visual stack. */
  @media (max-width: 1024px) {
    .menu-hero {
      padding-top: 24px;
    }
  }
  @media (min-width: 1025px) {
    .menu-hero {
      padding: calc(var(--header-height) + 56px) 64px 32px;
    }
  }

  .menu-hero-headline {
    color: var(--warm-white);
    font-size: clamp(36px, 9vw, 56px);
    letter-spacing: -0.005em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .menu-hero-headline { font-size: clamp(56px, 6vw, 84px); }
  }

  .menu-hero-sub {
    margin-top: 14px;
    /* font-family reverted (2026-05-24) — briefly swapped to Barlow 900
       to bypass the subhead font-swap LCP issue, but the image hero
       above now carries LCP duty so the subhead can return to its
       original slab serif. Roboto Slab preload retained in head as
       belt-and-suspenders for FCP / CLS-avoidance. */
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--warm-mid);
    max-width: 36em;
  }
  @media (min-width: 1025px) {
    .menu-hero-sub { font-size: 17px; max-width: 42em; }
  }

  /* .hero-fade hoisted to global.css (2026-05-08 LCP fix). */

  /* ============================================================
     TAP LIST — list-led rows. Moved here from /bar 2026-05-05.
     ============================================================ */
  .tap-list {
    background: transparent;
    padding: 24px 22px 72px;
  }
  @media (min-width: 1025px) {
    .tap-list { padding: 32px 64px 120px; }
  }

  .tap-list-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .tap-section + .tap-section {
    margin-top: 40px;
  }
  @media (min-width: 1025px) {
    .tap-section + .tap-section { margin-top: 56px; }
  }

  .tap-section-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(20px, 5vw, 26px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--warm-white);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.14);
  }
  @media (min-width: 1025px) {
    .tap-section-name {
      font-size: 28px;
      margin-bottom: 20px;
      padding-bottom: 14px;
    }
  }

  .tap-section-count {
    color: var(--warm-dim);
    font-weight: 700;
  }

  .tap-rows {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1025px) {
    .tap-rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }

  .tap-row {
    display: grid;
    grid-template-columns: 40px 32px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(244, 239, 227, 0.06);
    align-items: center;
  }
  @media (min-width: 1025px) {
    .tap-row {
      grid-template-columns: 48px 40px 1fr;
      padding: 14px 0;
      gap: 14px;
    }
  }

  .tap-label-frame {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    overflow: hidden;
    background: rgba(244, 239, 227, 0.04);
  }
  @media (min-width: 1025px) {
    .tap-label-frame { width: 48px; height: 48px; }
  }

  .tap-label {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tap-number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 22px;
    color: var(--glow);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1025px) {
    .tap-number { font-size: 26px; }
  }

  .tap-content {
    min-width: 0;
  }

  .tap-line-1 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .tap-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--warm-white);
    line-height: 1.2;
  }
  @media (min-width: 1025px) {
    .tap-name { font-size: 17px; }
  }

  .tap-abv {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--warm-mid);
    white-space: nowrap;
    flex-shrink: 0;
  }
  @media (min-width: 1025px) {
    .tap-abv { font-size: 12px; }
  }

  .tap-line-2 {
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.4;
    color: var(--warm-dim);
  }
  @media (min-width: 1025px) {
    .tap-line-2 { font-size: 13px; }
  }

  /* ============================================================
     SEO copy block — see /menu/cocktails for shape rationale.
     ============================================================ */
  .menu-seo {
    background: transparent;
    padding: 24px 22px 56px;
  }
  @media (min-width: 1025px) {
    .menu-seo { padding: 32px 64px 96px; }
  }

  .menu-seo-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .menu-seo-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--warm-white);
    margin: 0 0 14px;
  }
  @media (min-width: 1025px) {
    .menu-seo-title { font-size: 22px; margin-bottom: 18px; }
  }

  .menu-seo p {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--warm-dim);
  }
  .menu-seo p:last-child { margin-bottom: 0; }
  @media (min-width: 1025px) {
    .menu-seo p { font-size: 15px; line-height: 1.65; }
  }
</style>
