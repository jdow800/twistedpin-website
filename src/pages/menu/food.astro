---
/**
 * /menu/food — dedicated food menu page.
 *
 * Extracted from /eat's #menu section (2026-05-05) so the food pillar
 * stays editorial-focused. Reference content lives at its own URL.
 *
 * Layout: typography-led hero (no image) + the food card grid (mirrors
 * the cocktail menu's card rhythm).
 *
 * Data: build-time fetch from GoTab via getFood(). Daily 4am cron
 * keeps it fresh.
 */
import Base from "../../layouts/Base.astro";
import SnapFooter from "../../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import MenuPillNav from "../../components/MenuPillNav.astro";
import { getFood } from "../../lib/gotab-food";
import {
  BUSINESS_URL,
  BUSINESS_ENTITY_ID,
  MENU_FOOD_ID,
} from "../../lib/schema";
import { cdnImage } from "../../lib/cdn-image";

const foodMenu = await getFood();

// Guard against silent thin-content deploy: see /menu/cocktails for the
// pattern. If GoTab returns EMPTY (build-time fetch failure), noindex.
const isMenuEmpty = foodMenu.categories.length === 0;

// Pill-rail wayfinding: slugify GoTab category name for in-page anchors.
// Same slug applied as the id on each .food-category below.
function slugify(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
}
const pills = foodMenu.categories.map((cat) => ({
  id: `cat-${slugify(cat.name)}`,
  name: cat.name,
}));

// Map GoTab's free-form `tags: string[]` to Schema.org's RestrictedDiet
// enumeration. Best-effort match against known patterns — silently skips
// tags that don't map (`go:staff favorite`, etc). If GoTab returns no
// dietary tags the field is simply omitted from the MenuItem.
//
// Schema.org RestrictedDiet:
// https://schema.org/RestrictedDiet
const DIET_MAP: Array<{ pattern: RegExp; url: string }> = [
  { pattern: /\bvegan\b/i,                            url: "https://schema.org/VeganDiet" },
  { pattern: /\bvegetarian\b/i,                       url: "https://schema.org/VegetarianDiet" },
  { pattern: /\b(gluten[- ]?free|gf)\b/i,             url: "https://schema.org/GlutenFreeDiet" },
  { pattern: /\bhalal\b/i,                            url: "https://schema.org/HalalDiet" },
  { pattern: /\bkosher\b/i,                           url: "https://schema.org/KosherDiet" },
  { pattern: /\blow[- ]?fat\b/i,                      url: "https://schema.org/LowFatDiet" },
  { pattern: /\blow[- ]?(cal|calorie)\b/i,            url: "https://schema.org/LowCalorieDiet" },
];

function suitableForDiet(tags: string[] | undefined): string[] {
  if (!tags || tags.length === 0) return [];
  const out: string[] = [];
  for (const tag of tags) {
    for (const { pattern, url } of DIET_MAP) {
      if (pattern.test(tag) && !out.includes(url)) out.push(url);
    }
  }
  return out;
}

// JSON-LD: Menu → MenuSection → MenuItem. /eat's hasMenu URL points
// at this page; the @id below is the canonical entity reference.
const PAGE_URL = `${BUSINESS_URL}/menu/food/`;
const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  "@id": MENU_FOOD_ID,
  name: "Food Menu",
  url: PAGE_URL,
  inLanguage: "en-US",
  provider: { "@id": BUSINESS_ENTITY_ID },
  hasMenuSection: foodMenu.categories.map((cat) => ({
    "@type": "MenuSection",
    name: cat.name.trim(),
    hasMenuItem: cat.items.map((it) => {
      const item: Record<string, unknown> = {
        "@type": "MenuItem",
        name: it.name,
      };
      if (it.description) item.description = it.description;
      if (it.imageUrlLg || it.imageUrl) item.image = it.imageUrlLg ?? it.imageUrl;
      const diets = suitableForDiet(it.tags);
      if (diets.length > 0) item.suitableForDiet = diets;
      return item;
    }),
  })),
};

// dateModified: today() — honest because GoTab cron pulls real food
// menu data daily at 4am. Stage 7 (2026-05-18) — see schema.ts
// webPageSchema docstring for the "what counts as honest" rationale.
const dateModified = new Date().toISOString().split("T")[0];
---
<Base
  title="Food Menu in Plainfield, IL | Twisted Pin"
  description="The food menu at Twisted Pin — real plates built to share. Starters, handhelds, pizza, salads, and desserts. Plainfield, IL."
  dateModified={dateModified}
>
  {/* Head additions: conditional noindex on EMPTY (Stage 1) + desktop
      preconnect to img.gotab.io for pass-through food photography. Same
      pattern as /menu/cocktails — see that file for full rationale. */}
  <Fragment slot="head">
    {isMenuEmpty && <meta name="robots" content="noindex,follow" />}
    <link rel="preconnect" href="https://img.gotab.io" crossorigin media="(min-width: 1025px)" />
  </Fragment>

  <section class="menu-hero" data-hero aria-labelledby="menu-h1">
    <p class="t-eyebrow hero-fade" data-delay-ms="0">The Kitchen</p>
    <h1 class="t-display menu-hero-headline hero-fade" id="menu-h1" data-delay-ms="120">
      Food
    </h1>
    <p class="menu-hero-sub hero-fade" data-delay-ms="320">
      Real plates, built to share. Starters, handhelds,
      pizza, salads, and desserts. Twisted Pin, Plainfield, IL.
    </p>
  </section>

  {foodMenu.categories.length > 0 && (
    <section class="food-menu" id="menu" aria-labelledby="food-menu-h2">
      <div class="food-menu-inner">
        {pills.length > 1 && (
          <MenuPillNav pills={pills} label="Food menu sections" />
        )}
        {foodMenu.categories.map((cat, catIdx) => (
          <div class="food-category" id={`cat-${slugify(cat.name)}`}>
            <h2 class="food-category-name">{cat.name}</h2>
            <ul class="food-grid" role="list">
              {cat.items.map((it, idx) => {
                /* Click-to-expand modal on every food card (rolled out
                   2026-05-24 after the Garlic Parmesan Flatbread
                   prototype confirmed UX + pricing direction). Clarity
                   data showed 5.85% dead-click rate on food cards;
                   users were actively trying to click for detail. The
                   modal serves description (untruncated), large image,
                   price (real GoTab displayPrice — refreshed daily by
                   the existing 4am cron), and dietary tags.

                   Pricing positioning intentionally broken from the
                   2026-05-05 captive-audience-pricing rule — owner
                   call after seeing the visual: "Go ahead — be scared
                   off by our pricing." */
                const expandableProps = {
                  'data-expandable': '',
                  'data-item-name': it.name,
                  'data-item-description': it.description,
                  'data-item-image': it.imageUrlLg ?? it.imageUrl ?? '',
                  'data-item-tags': it.tags.join(','),
                  'data-item-price': it.price,
                  'role': 'button',
                  'tabindex': '0',
                  'aria-label': `${it.name} — view details`,
                };
                return (
                <li class="food-card food-card--expandable" {...expandableProps}>
                  {it.imageUrl ? (
                    <div class="food-card-frame">
                      {/* Per-device image strategy (2026-05-14):
                          Desktop loads GoTab's native JPEG directly to
                          preserve source fidelity. Vercel AVIF re-encode
                          at q85 was visibly softening food photography
                          on retina displays — texture detail (fries,
                          sesame seeds, sauce drips) gets smoothed by AVIF
                          even at high quality settings. Mobile keeps
                          Vercel AVIF for speed. See cocktails.astro for
                          full rationale. */}
                      <picture>
                        {it.imageUrlLg && (
                          <source media="(min-width: 1025px)" srcset={it.imageUrlLg} />
                        )}
                        <img
                          src={cdnImage(it.imageUrl, 480, 70)}
                          srcset={`${cdnImage(it.imageUrl, 320, 70)} 320w, ${cdnImage(it.imageUrl, 480, 70)} 480w`}
                          sizes="(min-width: 700px) 30vw, 46vw"
                          alt={it.name}
                          width="480"
                          height="480"
                          loading={catIdx === 0 && idx < 4 ? "eager" : "lazy"}
                          fetchpriority={catIdx === 0 && idx === 0 ? "high" : "auto"}
                          decoding="async"
                        />
                      </picture>
                      {it.isStaffFavorite && (
                        <span class="food-card-badge">Staff Pick</span>
                      )}
                    </div>
                  ) : (
                    <div class="food-card-frame food-card-frame--empty" aria-hidden="true">
                      {it.isStaffFavorite && (
                        <span class="food-card-badge">Staff Pick</span>
                      )}
                    </div>
                  )}
                  <div class="food-card-body">
                    <h3 class="food-card-name">{it.name}</h3>
                    {it.description && (
                      <p class="food-card-description">{it.description}</p>
                    )}
                  </div>
                </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="menu-seo" aria-labelledby="menu-seo-h2">
    <div class="menu-seo-inner">
      <h2 class="menu-seo-title" id="menu-seo-h2">About the kitchen</h2>
      <p>
        The kitchen at Twisted Pin runs a menu of plates built to share —
        starters and snack platters for the table, handhelds (sliders,
        burgers, tacos, and fried chicken sandwiches), pizza and flatbreads,
        salads, a kids menu, and house-made desserts. Pairs deliberately
        with the cocktail program — a few of the bar's signatures were
        specced for plates on this menu, and a few of the snacks were
        specced for the bar.
      </p>
      <p>
        Find us at 15610 Joliet Rd, Plainfield, IL — minutes from
        Naperville, Bolingbrook, and Romeoville.
      </p>
    </div>
  </section>

  {/* Menu item detail modal — prototype on Garlic Parmesan Flatbread
      only (2026-05-24). Native HTML <dialog> gives us ESC + focus trap
      + backdrop for free. Modal body is populated dynamically from the
      clicked card's data-* attributes by menu-item-modal.client.ts. */}
  <dialog id="menu-item-dialog" class="menu-dialog" aria-labelledby="menu-dialog-name">
    <button type="button" class="menu-dialog-close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none" />
      </svg>
    </button>
    <div class="menu-dialog-image-wrap">
      <img class="menu-dialog-image" alt="" />
    </div>
    <div class="menu-dialog-body">
      <div class="menu-dialog-header">
        <h3 id="menu-dialog-name" class="menu-dialog-name"></h3>
        {/* Pricing visibility is a brand-positioning call — currently
            populated only on cards that pass data-item-price (prototype
            scope: one item). Hidden via :empty when absent. */}
        <span class="menu-dialog-price"></span>
      </div>
      <p class="menu-dialog-description"></p>
      <div class="menu-dialog-tags" role="list"></div>
    </div>
  </dialog>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(menuSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Eat", path: "/eat/" },
    { name: "Food", path: "/menu/food/" },
  ]} />

  <script>
    import { initMenuItemModal } from "../../scripts/menu-item-modal.client.ts";
    initMenuItemModal();
  </script>
</Base>

<style>
  /* ============================================================
     Menu page hero — shared shape across /menu/* pages.
     ============================================================ */
  .menu-hero {
    padding: calc(var(--header-height) + 32px) 22px 24px;
    color: var(--warm-white);
    max-width: 1280px;
    margin: 0 auto;
  }
  @media (min-width: 1025px) {
    .menu-hero {
      padding: calc(var(--header-height) + 56px) 64px 32px;
    }
  }

  .menu-hero-headline {
    color: var(--warm-white);
    font-size: clamp(36px, 9vw, 56px);
    letter-spacing: -0.005em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .menu-hero-headline { font-size: clamp(56px, 6vw, 84px); }
  }

  .menu-hero-sub {
    margin-top: 14px;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--warm-mid);
    max-width: 36em;
  }
  @media (min-width: 1025px) {
    .menu-hero-sub { font-size: 17px; max-width: 42em; }
  }

  /* .hero-fade hoisted to global.css (2026-05-08 LCP fix). */

  /* ============================================================
     FOOD MENU — same compact grid as cocktails. Moved here from
     /eat 2026-05-05.
     ============================================================ */
  .food-menu {
    background: transparent;
    padding: 24px 22px 72px;
  }
  @media (min-width: 1025px) {
    .food-menu { padding: 32px 64px 120px; }
  }

  .food-menu-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .food-category + .food-category {
    margin-top: 56px;
  }
  @media (min-width: 1025px) {
    .food-category + .food-category { margin-top: 88px; }
  }

  /* Anchor-jump offset so pill-nav clicks land below the sticky
     SiteHeader + MenuPillNav (combined ~120px mobile / ~140px desktop). */
  .food-category {
    scroll-margin-top: 120px;
  }
  @media (min-width: 1025px) {
    .food-category { scroll-margin-top: 140px; }
  }

  .food-category-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(20px, 5vw, 26px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--warm-white);
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.14);
  }
  @media (min-width: 1025px) {
    .food-category-name {
      font-size: 32px;
      margin-bottom: 28px;
      padding-bottom: 16px;
    }
  }

  .food-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 12px;
  }
  @media (min-width: 700px) {
    .food-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }
  @media (min-width: 1025px) {
    .food-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  .food-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .food-card-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 1 / 1;
    background: rgba(244, 239, 227, 0.04);
  }

  .food-card-frame--empty {
    background:
      linear-gradient(135deg, rgba(244, 239, 227, 0.04), rgba(244, 239, 227, 0.02));
  }

  .food-card-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .food-card-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--indigo-deep);
    background: var(--glow);
    padding: 5px 9px;
    border-radius: 4px;
    line-height: 1;
  }

  .food-card-body {
    padding: 0 2px;
  }

  .food-card-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--warm-white);
    margin: 0 0 4px;
    line-height: 1.1;
  }
  @media (min-width: 700px) {
    .food-card-name { font-size: 17px; }
  }
  @media (min-width: 1025px) {
    .food-card-name { font-size: 18px; }
  }

  .food-card-description {
    margin: 0;
    font-family: var(--font-body);
    /* Bumped 12.5 -> 14 mobile, 13.5 -> 15 desktop (2026-05-24,
       same pass as the tap-row text bumps). Was below the comfort
       floor for body-tier secondary text. 3-line clamp preserved
       so card heights stay close to original — only ~6px taller
       per card from the larger line-height. */
    font-size: 14px;
    line-height: 1.4;
    color: var(--warm-dim);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 1025px) {
    .food-card-description { font-size: 15px; }
  }

  /* ============================================================
     SEO copy block — see /menu/cocktails for shape rationale.
     ============================================================ */
  .menu-seo {
    background: transparent;
    padding: 24px 22px 56px;
  }
  @media (min-width: 1025px) {
    .menu-seo { padding: 32px 64px 96px; }
  }

  .menu-seo-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .menu-seo-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--warm-white);
    margin: 0 0 14px;
  }
  @media (min-width: 1025px) {
    .menu-seo-title { font-size: 22px; margin-bottom: 18px; }
  }

  .menu-seo p {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--warm-dim);
  }
  .menu-seo p:last-child { margin-bottom: 0; }
  @media (min-width: 1025px) {
    .menu-seo p { font-size: 15px; line-height: 1.65; }
  }

  /* ============================================================
     MENU ITEM DETAIL MODAL — prototype on Garlic Parmesan Flatbread
     (2026-05-24). Native HTML <dialog> element styling. Cards with
     .food-card--expandable get hover affordance + cursor pointer.
     Click opens the dialog via menu-item-modal.client.ts.
     ============================================================ */

  /* Affordance on the expandable card — slight lift + shadow on hover,
     cursor pointer always. Subtle enough that it doesn't visually
     stand out from non-expandable cards, but enough that the tap
     intent is rewarded with feedback. */
  .food-card--expandable {
    cursor: pointer;
    transition: transform 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .food-card--expandable:hover {
    transform: translateY(-2px);
  }
  .food-card--expandable .food-card-frame {
    transition: box-shadow 180ms;
  }
  .food-card--expandable:hover .food-card-frame {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  }
  .food-card--expandable:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Dialog reset — strip the browser's native dialog styling so we
     can rebuild from scratch in the brand vocabulary. */
  dialog.menu-dialog {
    padding: 0;
    border: 1px solid rgba(244, 239, 227, 0.14);
    background: var(--indigo-deep);
    color: var(--warm-white);
    border-radius: 16px;
    overflow: hidden;
    max-width: min(92vw, 480px);
    max-height: 90vh;
    width: 100%;
    /* Centering for desktop. Native <dialog> + showModal() positions
       the element with `inset: 0` by default; pairing with `margin: auto`
       centers it both axes. Mobile media query below overrides this
       with margin-top: auto for the bottom-sheet anchor. */
    inset: 0;
    margin: auto;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45),
                0 8px 16px rgba(0, 0, 0, 0.30);
  }
  dialog.menu-dialog::backdrop {
    background: rgba(14, 10, 31, 0.78);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }

  /* Mobile: nearly fullscreen sheet anchored to bottom feels more
     native on a phone than a centered card. Rounded top corners +
     no bottom radius/border = "bottom sheet" register. */
  @media (max-width: 600px) {
    dialog.menu-dialog {
      max-width: 100vw;
      width: 100vw;
      max-height: 92vh;
      margin: 0;
      margin-top: auto;
      border-radius: 20px 20px 0 0;
      border-bottom: none;
    }
  }

  .menu-dialog-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 10, 31, 0.85);
    border: 1px solid rgba(244, 239, 227, 0.18);
    border-radius: 50%;
    color: var(--warm-white);
    cursor: pointer;
    z-index: 2;
    padding: 0;
    transition: background 150ms, transform 150ms;
  }
  .menu-dialog-close:hover {
    background: rgba(14, 10, 31, 0.95);
    transform: scale(1.08);
  }
  .menu-dialog-close:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 2px;
  }

  .menu-dialog-image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: rgba(244, 239, 227, 0.04);
    overflow: hidden;
    /* Image is also a tap-to-close target (see modal script). Pointer
       cursor + slight active-state press feedback signals the
       affordance without being noisy. */
    cursor: pointer;
    transition: filter 150ms;
  }
  .menu-dialog-image-wrap:active {
    filter: brightness(0.85);
  }
  @media (max-width: 600px) {
    .menu-dialog-image-wrap {
      aspect-ratio: 1 / 1; /* taller image on mobile sheet */
    }
  }
  .menu-dialog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .menu-dialog-body {
    padding: 22px 24px 26px;
    overflow-y: auto;
  }
  @media (min-width: 1025px) {
    .menu-dialog-body { padding: 26px 28px 30px; }
  }

  /* Name + price share a flex row so price sits right-aligned next to
     the name (classic menu-row pattern). Baseline alignment keeps the
     two typographically anchored to the same line even though they're
     different fonts/weights. */
  .menu-dialog-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
  }

  .menu-dialog-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(22px, 6vw, 28px);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--warm-white);
    margin: 0;
    line-height: 1.05;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Price — restrained typography vs the name. Same weight as the name
     so it doesn't compete, but smaller + warm-mid color so it sits as
     informational rather than promotional. :empty hides the element
     entirely when the card didn't pass data-item-price. */
  .menu-dialog-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(20px, 5.5vw, 24px);
    color: var(--warm-mid);
    line-height: 1.05;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .menu-dialog-price:empty { display: none; }

  .menu-dialog-description {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    color: var(--warm-mid);
    margin: 0 0 16px;
  }
  .menu-dialog-description:empty { display: none; }

  .menu-dialog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .menu-dialog-tags:empty { display: none; }

  .menu-dialog-tag {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 10.5px;
