---
/**
 * /invite-designs — INTERNAL design-review gallery (2026-08-22).
 *
 * The six-direction fan-out for the TPRS invitation product's guest page,
 * published here so Jon can share one twistedpin.com link with Shanna & co.
 * for outside reactions. Unindexed the standard four ways (per-page noindex
 * below, robots.txt Disallow, sitemap filter in astro.config.mjs, X-Robots-Tag
 * header in vercel.json) and orphaned — nothing links here.
 *
 * Deliberately STANDALONE (no Base.astro): a review tool wants no site
 * chrome, and skipping Base also means no GA4/Clarity/Meta ever loads.
 * The six design files are static HTML in public/invite-designs/, iframed
 * same-origin. Delete this page + that folder when the theme system ships.
 */
const designs = [
  { file: "a-letterpress-ceremony.html", name: "Letterpress Ceremony", occ: "Adult 40th", line: "An engraved invitation card — cream stock, double-rule frame, the Pin as a crest, RSVP as an enclosed reply card." },
  { file: "b-eight-oclock-cover.html", name: "Eight O’Clock Cover", occ: "Adult 40th", line: "A nightlife-magazine cover — real cocktail photography full-bleed, wordmark as masthead, dark editorial column below." },
  { file: "c-confetti-strike.html", name: "Confetti Strike", occ: "Kids birthday", line: "Gig-poster-loud kids party — marquee ticker, taped polaroid (future: upload your own kid's photo), ADMIT-ALL ticket, RSVP as a scorecard." },
  { file: "d-type-brutalist.html", name: "The Answered Poster", occ: "Adult 40th", line: "Pure type, zero images — the low-key option for hosts who want quiet." },
  { file: "e-morning-light.html", name: "Morning Light", occ: "Baby shower, 1pm", line: "The palette flipped to daylight — indigo as ink on cream. Covers showers and daytime events." },
  { file: "f-one-night-only.html", name: "One Night Only", occ: "Adult 40th", line: "A show poster with a tear-off ADMIT ONE reply stub — the guest of honor as the headline act." },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Invitation designs — internal review</title>
  <style>
    :root {
      --bg: #0E0A1F; --panel: #17122C; --line: rgba(245,241,232,0.14);
      --ink: #F5F1E8; --muted: rgba(245,241,232,0.6); --glow: #4EECC4; --copper: #D88B5C;
    }
    * { box-sizing: border-box; margin: 0; }
    body {
      background: var(--bg); color: var(--ink);
      font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
      display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden;
    }
    header { padding: 12px 14px 0; flex: 0 0 auto; }
    header h1 { font-size: 15px; font-weight: 700; }
    header p { font-size: 12px; color: var(--muted); margin-top: 2px; }
    nav {
      display: flex; gap: 8px; overflow-x: auto; padding: 10px 14px;
      flex: 0 0 auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    nav::-webkit-scrollbar { display: none; }
    nav button {
      flex: 0 0 auto; padding: 8px 14px; border-radius: 999px; cursor: pointer;
      border: 1px solid var(--line); background: var(--panel); color: var(--ink);
      font-size: 13px; font-weight: 600; white-space: nowrap;
    }
    nav button.on { background: var(--glow); color: var(--bg); border-color: var(--glow); }
    .meta { padding: 0 14px 10px; flex: 0 0 auto; }
    .meta .occ {
      display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--copper); margin-bottom: 3px;
    }
    .meta .line { font-size: 12.5px; color: var(--muted); line-height: 1.45; max-width: 60ch; }
    .stage {
      flex: 1 1 auto; min-height: 0; display: flex; justify-content: center;
      padding: 0 0 8px; background: #080614;
    }
    .frame { width: min(430px, 100%); height: 100%; border: 0; background: #fff; }
    @media (min-width: 700px) {
      .stage { padding: 14px 0 18px; }
      .frame {
        width: 400px; border-radius: 24px; border: 1px solid var(--line);
        box-shadow: 0 24px 70px rgba(0,0,0,0.6);
      }
    }
    button:focus-visible { outline: 2px solid var(--glow); outline-offset: 2px; }
  </style>
</head>
<body>
  <header>
    <h1>Invitation designs — pick favorites, note gripes</h1>
    <p>Each tab is a full working sample of the guest invitation page. Scroll inside the phone. Text Jon your reactions.</p>
  </header>
  <nav id="tabs" role="tablist">
    {designs.map((d, i) => (
      <button role="tab" data-i={i} data-file={`/invite-designs/${d.file}`} data-occ={d.occ} data-line={d.line}>
        {i + 1}. {d.name}
      </button>
    ))}
  </nav>
  <div class="meta"><span class="occ" id="occ"></span><div class="line" id="line"></div></div>
  <div class="stage"><iframe class="frame" id="frame" title="Design preview"></iframe></div>
  <script>
    const tabs = Array.from(document.querySelectorAll("nav button"));
    const frame = document.getElementById("frame");
    const occ = document.getElementById("occ");
    const line = document.getElementById("line");
    function show(i) {
      const b = tabs[i];
      frame.src = b.dataset.file;
      occ.textContent = b.dataset.occ;
      line.textContent = b.dataset.line;
      tabs.forEach((t, j) => t.classList.toggle("on", i === j));
    }
    tabs.forEach((b, i) => b.addEventListener("click", () => show(i)));
    show(0);
  </script>
</body>
</html>
