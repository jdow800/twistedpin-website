---
/**
 * /mixology-experience/ — landing page for "An Evening with America's Top
 * Mixologist," a one-night ticketed cocktail experience hosted by Brian Van
 * Flandern (Tuesday, July 28, 2026, 7 PM; 20 seats; $119/person).
 *
 * This is the SOCIAL / QR TARGET — the link Jon drops in posts + prints on
 * in-house QR codes. It's indexed (public marketing). The booking CTA points
 * at /reserve/mixology/ (the TPRS booking page — noindexed but deliberately
 * linked, same convention as /new-years-eve → /reserve/nye).
 *
 * Section order (per Jon 2026-07-03): Hero → The Details → Your Host →
 * The Experience → closing CTA → SnapFooter.
 *
 * HERO — mobile and desktop are SEPARATE treatments (CLAUDE.md working pref:
 * "vertical video hero on mobile; hero photograph on desktop — never stretch
 * the vertical video to fit desktop"). Mobile = the full-bleed vertical
 * cocktails video (Jon: "mobile is fine"). Desktop = a split: copy on the left,
 * Brian's portrait (mixology-host-*, from Context/pictures/F2_P4.jpg) on the
 * right. The stretched-vertical-video desktop hero was the "rough on desktop"
 * bug this fixes.
 *
 * BRAND COMPLIANCE (load-bearing — see CLAUDE.md):
 *   - NO Per Se / Thomas Keller / Michelin three-star framing ANYWHERE.
 *   - "America's Top Mixologist" (Food Network) is the lead credential.
 *   - Brian CURATED our program (consultant) and is HOSTING this event.
 *   - Not a "cocktail class." "Closed to the public / ticket-holders only,"
 *     never "private." No discount vocabulary.
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, eventSchema } from "../lib/schema";

// The TPRS booking page (the $119 per-seat product, calendar seeded 7/28).
const BOOK_URL = "/reserve/mixology/";

// JSON-LD: Event. Dates + price pulled from the events content collection so
// /mixology-experience and /upcoming-events read from the same source of truth.
const PAGE_URL = `${BUSINESS_URL}/mixology-experience/`;
const entry = await getEntry("events", "2026-07-28-mixology-experience");
const jsonLd = entry
  ? {
      "@context": "https://schema.org",
      ...eventSchema({
        name: entry.data.title,
        start: entry.data.start,
        end: entry.data.end,
        description: entry.body?.trim(),
        image: `${BUSINESS_URL}/og/og-bar.jpg`,
        url: PAGE_URL,
        offers: entry.data.lowPrice
          ? {
              "@type": "AggregateOffer",
              priceCurrency: "USD",
              lowPrice: entry.data.lowPrice,
              ...(entry.data.highPrice && { highPrice: entry.data.highPrice }),
              ...(entry.data.validFrom && {
                validFrom: entry.data.validFrom.toISOString(),
              }),
              availability: "https://schema.org/InStock",
              url: PAGE_URL,
              validThrough: entry.data.start.toISOString(),
            }
          : undefined,
      }),
    }
  : null;
---
<Base
  title="An Evening with America's Top Mixologist | Twisted Pin"
  description="One night only — Tuesday, July 28 at Twisted Pin in Plainfield. A hands-on mixology experience hosted by Brian Van Flandern, America's Top Mixologist. 20 seats, $119 a person."
  ogImage="/og/og-bar.jpg"
  ogImageAlt="Craft cocktails at Twisted Pin in Plainfield, IL"
  lcpPreloadHref="/snap/cocktails-hero-poster.avif"
  lcpPreloadMedia="(max-width: 1024px)"
>
  {/* ============================================================
      HERO — mobile: vertical video · desktop: split (copy + Brian)
      ============================================================ */}
  <section class="mix-hero" data-hero aria-labelledby="mix-hero-h1">
    <video
      class="mix-hero-video"
      preload="none"
      muted
      autoplay
      loop
      playsinline
      poster="/snap/cocktails-hero-poster.avif"
      aria-hidden="true"
    >
      <source media="(max-width: 480px)" src="/snap/cocktails-hero-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
      <source media="(max-width: 480px)" src="/snap/cocktails-hero-mobile-h264-540.mp4" type="video/mp4" />
      <source media="(min-width: 481px)" src="/snap/cocktails-hero-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
      <source media="(min-width: 481px)" src="/snap/cocktails-hero-mobile-h264-1080.mp4" type="video/mp4" />
    </video>

    {/* Desktop-only split panel — Brian's portrait. media-gated so mobile
        (where it's display:none) never fetches the big source. */}
    <picture class="mix-hero-photo">
      <source type="image/avif" media="(min-width: 1025px)" srcset="/snap/mixology-host-1280.avif" />
      <source type="image/webp" media="(min-width: 1025px)" srcset="/snap/mixology-host-1280.webp" />
      <img
        src="/snap/mixology-host-540.jpg"
        alt="Brian Van Flandern, America's Top Mixologist, at the Twisted Pin bar"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="mix-hero-scrim" aria-hidden="true"></div>

    <div class="mix-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Tuesday, July 28 · One Night Only</p>
      <h1 class="t-display mix-hero-headline" id="mix-hero-h1">
        <span class="hero-fade" data-delay-ms="120">An Evening with</span>
        <span class="hero-fade" data-delay-ms="280">America's Top Mixologist</span>
      </h1>
      <p class="mix-hero-sub hero-fade" data-delay-ms="380">
        A hands-on mixology experience with Brian Van Flandern — learn the craft,
        build your own cocktail, and go head-to-head for the title.
      </p>
    </div>
  </section>

  {/* ============================================================
      THE DETAILS — facts (leads, per Jon)
      ============================================================ */}
  <section class="mix-section mix-details" aria-labelledby="mix-details-h2">
    <div class="mix-section-inner">
      <p class="t-eyebrow">The Details</p>
      <h2 class="t-display mix-section-title" id="mix-details-h2">
        One night. Twenty seats.
      </h2>

      <dl class="mix-facts">
        <div class="mix-fact"><dt>Host</dt><dd>Brian Van Flandern — America's Top Mixologist</dd></div>
        <div class="mix-fact"><dt>When</dt><dd>Tuesday, July 28 · 7:00 PM</dd></div>
        <div class="mix-fact"><dt>How long</dt><dd>Plan for about two hours</dd></div>
        <div class="mix-fact"><dt>Price</dt><dd>$119 per person</dd></div>
        <div class="mix-fact"><dt>Seats</dt><dd>Only 20 — first come, first served</dd></div>
        <div class="mix-fact"><dt>Access</dt><dd>Ticket-holders only — Twisted Pin is closed to the public that evening</dd></div>
        <div class="mix-fact"><dt>Includes</dt><dd>Instruction, all cocktail materials, and the grazing board</dd></div>
        <div class="mix-fact"><dt>Ages</dt><dd>21+ · valid ID required</dd></div>
        <div class="mix-fact"><dt>Refunds</dt><dd>Only with 10+ days' notice, or if we can resell your seat</dd></div>
        <div class="mix-fact"><dt>Where</dt><dd>Twisted Pin · Plainfield, IL</dd></div>
      </dl>

      <div class="mix-details-cta">
        <a class="btn btn-solid" href={BOOK_URL}>Reserve your seat</a>
      </div>
    </div>
  </section>

  {/* ============================================================
      YOUR HOST — Brian (photo shows on mobile; on desktop he's in the hero)
      ============================================================ */}
  <section class="mix-section mix-host" aria-labelledby="mix-host-h2">
    <div class="mix-section-inner">
      <p class="t-eyebrow">Your Host</p>
      <h2 class="t-display mix-section-title" id="mix-host-h2">
        Brian Van Flandern.
      </h2>

      <picture class="mix-host-photo">
        <source type="image/avif" srcset="/snap/mixology-host-540.avif 540w, /snap/mixology-host-900.avif 900w" sizes="(min-width: 1025px) 0px, 92vw" />
        <source type="image/webp" srcset="/snap/mixology-host-540.webp 540w, /snap/mixology-host-900.webp 900w" sizes="(min-width: 1025px) 0px, 92vw" />
        <img
          src="/snap/mixology-host-540.jpg"
          alt="Brian Van Flandern, America's Top Mixologist, behind the bar at Twisted Pin"
          loading="lazy"
          decoding="async"
        />
      </picture>

      {/* ⚠️ DELIBERATE brand-ban EXCEPTION. Per Se / Thomas Keller /
          three-Michelin-star framing is retired SITE-WIDE (CLAUDE.md), but Jon
          (owner) explicitly authorized it 2026-07-03 for THIS event page only —
          the Michelin-via-Per-Se distinction is Brian's headline draw for the
          experience. Do NOT strip this in a brand-compliance sweep, and do NOT
          copy this framing to any other page or to the checkout product copy. */}
      <p class="mix-section-body">
        Brian is the only mixologist ever tied to a three-Michelin-star
        distinction — earned for the cocktail program he created to open Thomas
        Keller's Per Se. That kind of recognition almost always goes to chefs and
        restaurants; he's the rare exception who earned it from behind the bar.
      </p>

      <p class="mix-section-body">
        Named America's Top Mixologist by Food Network, his cocktails have been
        served in more than 40 countries. He's the one who curated the program
        behind our bar — and for one night, he's behind it with you.
      </p>

      <ul class="mix-section-list">
        <li>Opened the bar program at Thomas Keller's three-Michelin-star Per Se</li>
        <li>Food Network's "America's Top Mixologist"</li>
        <li>Featured on Bar Rescue, Barefoot Contessa, and Property Brothers</li>
        <li>Cocktail programs built for restaurants, hotels, and resorts worldwide</li>
        <li>Curated the craft cocktail program at Twisted Pin</li>
      </ul>
    </div>
  </section>

  {/* ============================================================
      THE EXPERIENCE — what the night is
      ============================================================ */}
  <section class="mix-section mix-experience" aria-labelledby="mix-exp-h2">
    <div class="mix-section-inner">
      <p class="t-eyebrow">The Experience</p>
      <h2 class="t-display mix-section-title" id="mix-exp-h2">
        Not a class. A jam session.
      </h2>

      <p class="mix-section-body">
        Spend the evening learning the art and science of a balanced cocktail
        from the mixologist who curated our bar program — then put it to work.
        You'll build an original drink of your own, in teams, from a spread of
        premium spirits, fresh juice, herbs, bitters, and garnishes, with our
        team pouring alongside you the whole way.
      </p>

      <p class="mix-section-body">
        Then the friendly part gets competitive: your creations go in front of
        Brian to be judged on the night. The winning team takes home their own
        shaker sets — everyone else walks out having made something they didn't
        know they could.
      </p>

      <ul class="mix-section-list">
        <li>Hands-on instruction from America's Top Mixologist</li>
        <li>Build your own signature cocktail in a team competition</li>
        <li>Premium spirits, fresh juices, herbs, bitters, and garnishes</li>
        <li>A curated charcuterie grazing board out all evening</li>
        <li>Winning team takes home a set of cocktail shakers</li>
      </ul>
    </div>
  </section>

  {/* ============================================================
      CLOSING CTA BAND
      ============================================================ */}
  <section class="mix-cta" aria-labelledby="mix-cta-h2">
    <div class="mix-cta-inner">
      <h2 class="t-display mix-cta-title" id="mix-cta-h2">
        Twenty people get to say they were there.
      </h2>
      <p class="mix-cta-body">
        Once the seats are gone, they're gone — this one doesn't come around
        often. Grab yours before it sells out.
      </p>
      <div class="mix-cta-actions">
        <a class="btn btn-solid" href={BOOK_URL}>Reserve your seat</a>
      </div>
    </div>
  </section>

  <SnapFooter />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "An Evening with America's Top Mixologist", path: "/mixology-experience/" },
  ]} />
</Base>

<style>
  /* ============================================================
     HERO — mobile: full-bleed vertical video · desktop: split
     ============================================================ */
  .mix-hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: var(--indigo-deep);
  }
  .mix-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Hidden on mobile — the video is the mobile hero. */
  .mix-hero-photo {
    display: none;
  }
  .mix-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(14, 10, 31, 0.4) 0%,
      rgba(14, 10, 31, 0.1) 35%,
      rgba(14, 10, 31, 0.6) 75%,
      rgba(14, 10, 31, 0.88) 100%
    );
  }
  .mix-hero-copy {
    position: relative;
    z-index: 2;
    padding: 0 24px 96px;
    color: var(--warm-white);
    max-width: 820px;
  }
  .mix-hero-headline {
    font-size: clamp(36px, 10vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.015em;
    margin: 8px 0 18px;
    color: var(--warm-white);
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .mix-hero-headline span {
    display: block;
  }
  .mix-hero-sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 4vw, 22px);
    line-height: 1.4;
    color: rgba(255, 252, 245, 0.9);
    margin: 0;
    max-width: 30em;
  }

  /* Desktop: two-column split. Copy on solid indigo (left), Brian's
     portrait fills the right cell — no more stretched vertical video. */
  @media (min-width: 1025px) {
    .mix-hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
      min-height: clamp(560px, 82vh, 760px);
      margin-top: var(--header-height);
    }
    .mix-hero-video,
    .mix-hero-scrim {
      display: none;
    }
    .mix-hero-photo {
      display: block;
      position: relative;
      grid-column: 2;
      grid-row: 1;
      height: 100%;
      overflow: hidden;
    }
    .mix-hero-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 26%;
      display: block;
    }
    .mix-hero-copy {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      max-width: none;
      padding: 0 clamp(40px, 5vw, 80px);
    }
  }

  /* ============================================================
     EDITORIAL SECTIONS
     ============================================================ */
  .mix-section {
    padding: 78px 24px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .mix-section {
      padding: 104px 64px;
    }
  }
  .mix-section-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .mix-section-title {
    font-size: clamp(28px, 7vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.005em;
    margin: 8px 0 28px;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .mix-section-body {
    font-family: var(--font-body);
    font-size: clamp(16px, 4vw, 18px);
    line-height: 1.6;
    color: rgba(255, 252, 245, 0.88);
    margin: 0 0 20px;
  }
  .mix-section-list {
    margin: 28px 0 0;
    padding: 0 0 0 20px;
    color: rgba(255, 252, 245, 0.82);
    font-family: var(--font-body);
    font-size: clamp(15px, 3.8vw, 17px);
    line-height: 1.55;
  }
  .mix-section-list li + li {
    margin-top: 8px;
  }

  /* ============================================================
     DETAILS — facts card
     ============================================================ */
  .mix-facts {
    margin: 8px 0 0;
    padding: 0;
    border-top: 1px solid rgba(255, 252, 245, 0.14);
  }
  .mix-fact {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 252, 245, 0.14);
  }
  .mix-fact dt {
    flex: 0 0 34%;
    max-width: 130px;
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-mid, rgba(255, 252, 245, 0.6));
    padding-top: 2px;
  }
  .mix-fact dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(15px, 3.8vw, 17px);
    line-height: 1.45;
    color: rgba(255, 252, 245, 0.92);
  }
  .mix-details-cta {
    margin-top: 32px;
  }

  /* ============================================================
     HOST — portrait (mobile only; desktop shows Brian in the hero)
     ============================================================ */
  .mix-host-photo {
    display: block;
    margin: 0 0 24px;
    max-width: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 252, 245, 0.12);
  }
  .mix-host-photo img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 1025px) {
    .mix-host-photo {
      display: none;
    }
  }

  /* ============================================================
     CLOSING CTA BAND
     ============================================================ */
  .mix-cta {
    background: var(--indigo-deep);
    padding: 80px 24px;
    text-align: center;
  }
  @media (min-width: 1025px) {
    .mix-cta {
      padding: 120px 64px;
    }
  }
  .mix-cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .mix-cta-title {
    font-size: clamp(28px, 7vw, 44px);
    line-height: 1.05;
    color: var(--warm-white);
    margin: 0 0 16px;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .mix-cta-body {
    font-family: var(--font-body);
    font-size: clamp(15px, 3.8vw, 17px);
    line-height: 1.55;
    color: rgba(255, 252, 245, 0.85);
    margin: 0 0 32px;
  }
  .mix-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
