---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import NyeOpening from "../components/NyeOpening.astro";
import { NYE_OPEN_CTA, NYE_OPENING_REMINDER } from "../config/nye-opening";
import { BUSINESS_URL, PHONE_TEL, PHONE_DISPLAY, eventSchema, videoObjectSchema } from "../lib/schema";
import { NYE_VIDEO } from "../data/videos";
const PAGE_URL = `${BUSINESS_URL}/new-years-eve/`;
const nyeEntry = await getEntry("events", "2026-12-31-new-years-eve");
// A known opening date does not establish InStock. Booking owns availability.
const nyeJsonLd = nyeEntry ? { "@context": "https://schema.org", ...eventSchema({
  name: nyeEntry.data.title, start: nyeEntry.data.start, end: nyeEntry.data.end,
  description: nyeEntry.body?.trim(), image: `${BUSINESS_URL}/snap/nye-poster.avif`, url: PAGE_URL,
}) } : null;
// Verified October21 against production pricing/scheduling for126/124.
const sessions = [
  { start: "11am", end: "12:30pm", duration: "90 minutes", traditional: "109.95", vip: "129.95" },
  { start: "1pm", end: "2:30pm", duration: "90 minutes", traditional: "139.95", vip: "159.95" },
  { start: "3pm", end: "4:30pm", duration: "90 minutes", traditional: "149.95", vip: "199.95" },
  { start: "5pm", end: "7pm", duration: "2 hours", traditional: "189.95", vip: "229.95" },
  { start: "7:30pm", end: "9:30pm", duration: "2 hours", traditional: "199.95", vip: "239.95" },
  { start: "10pm", end: "12:30am", duration: "2½ hours", traditional: "219.95", vip: "259.95", midnight: true },
];
---
<Base title="New Year's Eve 2026 in Plainfield | Twisted Pin"
  description="Plan New Year's Eve 2026 at Twisted Pin in Plainfield. Traditional and VIP bowling parties with pizza, soda and shoes. Celebrate earlier or ring in 2027."
  ogImage="/og/og-nye-2026.jpg" ogImageAlt="New Year's Eve 2026 at Twisted Pin in Plainfield, with a mirrorball above the bowling lanes"
  lcpPreloadHref="/snap/nye-poster.avif"
  hideStickyCTA={true} hidePromo={true}
  reservationAction={{ ...NYE_OPEN_CTA, openingNotice: NYE_OPENING_REMINDER }}>
  <div class="nye-page">
    <section class="nye-hero" data-hero aria-labelledby="nye-title">
      <video class="nye-hero-video" preload="none" muted autoplay loop playsinline poster="/snap/nye-poster.avif" aria-hidden="true">
        <source media="(max-width: 480px)" src="/snap/nye-mobile-av1-540.mp4" type="video/mp4; codecs=av01.0.05M.08" />
        <source media="(max-width: 480px)" src="/snap/nye-mobile-h264-540.mp4" type="video/mp4" />
        <source media="(min-width: 481px)" src="/snap/nye-mobile-av1-1080.mp4" type="video/mp4; codecs=av01.0.05M.08" />
        <source media="(min-width: 481px)" src="/snap/nye-mobile-h264-1080.mp4" type="video/mp4" />
      </video>
      <div class="nye-hero-scrim" aria-hidden="true"></div>
      <div class="nye-hero-inner">
        <div class="nye-hero-copy">
          <p class="nye-eyebrow">Thursday, December 31, 2026 · Plainfield, IL</p>
          <h1 id="nye-title">New Year's Eve.<br />Done right.</h1>
          <p class="nye-hero-sub">Bowling, pizza and your people. Celebrate earlier or ring in 2027.</p>
        </div>
        <div class="nye-opening-wrap"><NyeOpening /><a class="btn btn-solid nye-primary" href={NYE_OPEN_CTA.href} data-nye-booking-cta data-nye-after-opening hidden>{NYE_OPEN_CTA.label}</a></div>
      </div>
    </section>
    <section class="nye-section nye-included" aria-labelledby="nye-included-title">
      <div class="nye-inner">
        <p class="nye-eyebrow">Included with every lane</p><h2 id="nye-included-title">The party comes with it.</h2>
        <ul class="nye-inclusions">
          <li><strong>Bowling + shoes</strong><span>For your party time</span></li>
          <li><strong>1 large pizza</strong><span>Choose at checkout</span></li>
          <li><strong>1 pitcher of soda</strong><span>Choose at checkout</span></li>
          <li><strong>Party favors</strong><span>For the guests included in your reservation.</span></li>
        </ul>
        <p class="nye-food-example"><strong>Two lanes? Two pizzas and two pitchers.</strong> Choose each separately or keep them the same.</p>
      </div>
    </section>
    <section class="nye-section nye-rooms" aria-labelledby="nye-rooms-title">
      <div class="nye-inner">
        <p class="nye-eyebrow">Same party essentials. Two ways to bowl.</p><h2 id="nye-rooms-title">Traditional or VIP?</h2>
        <div class="nye-room-grid">
          <article class="nye-room-card">
            <picture><source srcset="/snap/tile-trad-540.avif" type="image/avif" /><img src="/snap/tile-trad-540.webp" alt="Traditional bowling lanes at Twisted Pin" width="540" height="304" loading="lazy" /></picture>
            <div class="nye-room-copy"><h3>Traditional lanes</h3><p class="nye-capacity"><strong>5</strong><span><span class="nye-capacity-label">People total</span><span class="nye-capacity-limit">Maximum per lane</span></span></p><p>Our traditional lanes, with all the NYE essentials included.</p><p class="nye-from" data-nye-open-only hidden>From <strong>${sessions[0].traditional}</strong> / lane</p></div>
          </article>
          <article class="nye-room-card">
            <picture><source srcset="/snap/tile-vip-540.avif" type="image/avif" /><img src="/snap/tile-vip-540.webp" alt="Couch seating in the VIP bowling suite at Twisted Pin" width="540" height="304" loading="lazy" /></picture>
            <div class="nye-room-copy"><h3>VIP suite lanes</h3><p class="nye-capacity"><strong>6</strong><span><span class="nye-capacity-label">People total</span><span class="nye-capacity-limit">Maximum per lane</span></span></p><p>Couch seating in our semi-private VIP suite, set apart from the traditional lanes.</p><p class="nye-from" data-nye-open-only hidden>From <strong>${sessions[0].vip}</strong> / lane</p></div>
          </article>
        </div>
        <aside class="nye-attendance" aria-labelledby="nye-attendance-title">
          <h3 id="nye-attendance-title">Spectators count. Everyone counts.</h3>
          <p>Every person attending must be included in a <strong>paid lane reservation</strong>, whether bowling, watching or just hanging out.</p>
          <p>Extra attendees beyond your paid lane capacity will not be admitted.</p>
          <p class="nye-attendance-example"><strong>5 bowlers + 4 spectators = 9 people. Book 2 lanes.</strong></p>
        </aside>
        <p class="nye-room-note">VIP reservations may share the suite with other groups unless your booking reserves the whole suite for the same party time.</p>
        <p class="nye-secondary" data-nye-open-only hidden>Starting prices are for the 11am party, before tax and the online booking fee.</p>
      </div>
    </section>
    <section class="nye-section nye-times-section" id="nye-times" aria-labelledby="nye-times-title" data-nye-open-only hidden>
      <div class="nye-inner nye-times-inner">
        <p class="nye-eyebrow">December 31 · Six party times</p><h2 id="nye-times-title">Find your party time.</h2>
        <p class="nye-lede">Compare party times and lane types. Every price below is <strong>per lane</strong>.</p>
        <div class="nye-times"><table aria-describedby="nye-price-note">
          <caption class="nye-sr-only">New Year's Eve 2026 party times and prices per lane</caption>
          <thead><tr><th scope="col">Party time</th><th scope="col">Traditional</th><th scope="col">VIP suite</th></tr></thead>
          <tbody>{sessions.map((session) => (<tr class:list={{ "nye-midnight-row": session.midnight }}>
            <th scope="row"><span class="nye-time-range">{session.start}<span class="nye-time-end"> – {session.end}</span></span><span class="nye-duration">{session.duration}{session.midnight ? " · Midnight toast" : ""}</span></th><td>${session.traditional}</td><td>${session.vip}</td>
          </tr>))}</tbody>
        </table></div>
        <p id="nye-price-note" class="nye-secondary">Tax and the online booking fee are added at checkout. All times are Central. The 10pm party ends January 1, 2027.</p>
        <div class="nye-toast"><strong>Here for midnight? Choose 10pm.</strong><p>Only the 10pm–12:30am party includes the midnight toast: champagne for guests 21 and over, or sparkling cider. Earlier parties end before midnight.</p></div>
        <a class="btn btn-solid nye-primary" href={NYE_OPEN_CTA.href} data-nye-booking-cta data-nye-open-only hidden>{NYE_OPEN_CTA.label}</a>
      </div>
    </section>
    <section class="nye-section nye-extras" aria-labelledby="nye-extras-title">
      <div class="nye-inner nye-extras-inner">
        <div><p class="nye-eyebrow">Keep the good night going</p><h2 id="nye-extras-title">Make it your kind of party.</h2></div>
        <div><p>Pick an optional <strong>arcade card at checkout</strong>. At the venue, explore our <a href="/bar/">cocktail bar and 28-tap self-serve beer &amp; wine wall</a>.</p><p class="nye-secondary">Arcade cards, cocktails and additional food and drinks are separate from your lane package.</p></div>
      </div>
    </section>
    <section class="nye-section nye-faq" aria-labelledby="nye-faq-title">
      <div class="nye-inner nye-times-inner">
        <p class="nye-eyebrow">A few things to know</p><h2 id="nye-faq-title">Before the confetti.</h2>
        <details><summary>How many lanes should we book?</summary><p>Each Traditional lane allows a maximum of <strong>5 people total</strong>; each VIP lane allows <strong>6</strong>. Every person attending must be included in a paid lane reservation, including anyone watching or just hanging out. Extra attendees beyond your paid lane capacity will not be admitted.</p><p><strong>Example: 5 bowlers + 4 spectators = 9 people. Book 2 lanes.</strong></p></details>
        <details><summary>How do we choose our pizza and soda?</summary><p>Choose one pizza and one pitcher of soda for each lane during checkout. Pick from the listed options; every pizza already includes cheese. Food substitutions aren't available for NYE packages.</p><p>You can review and edit your choices before paying. Need a correction afterward? Reply to your confirmation email or email <a href="mailto:contactus@twistedpin.com">contactus@twistedpin.com</a>.</p></details>
        <details><summary>Can we bowl near friends who book separately?</summary><p>Choose the <strong>same party time and lane type</strong>. At checkout, enter the full name on the other group's reservation in the optional bowl-near request.</p><p>We'll do our best, but requests aren't guaranteed. Traditional and VIP groups are in separate areas, and groups booked at different times cannot bowl together.</p></details>
        <details><summary>When should we arrive, and what should we bring?</summary><p>Arrive about <strong>5 minutes before your party time</strong>. Your lanes shut off at the end of that time.</p><p>For check-in, the cardholder must be present with the card used to book and their driver's license. Outside food, drinks and party décor aren't permitted.</p></details>
        <details><summary>What if our plans change?</summary><p>NYE reservations are non-refundable. Contact us <strong>14 days or more before your party</strong> for a gift certificate for the reservation amount, less the service fee. Later cancellations forfeit payment.</p></details>
      </div>
    </section>
    <section class="nye-section nye-closing" aria-labelledby="nye-closing-title">
      <div class="nye-inner"><p class="nye-eyebrow">Your crew. Your countdown.</p><h2 id="nye-closing-title">Make December 31 a plan.</h2><p>15610 Joliet Rd, Plainfield, IL · Free on-site parking.</p><a class="btn btn-solid nye-primary" href={NYE_OPEN_CTA.href} data-nye-booking-cta data-nye-after-opening hidden>{NYE_OPEN_CTA.label}</a><p class="nye-secondary nye-closing-opening" data-nye-opening-reminder>{NYE_OPENING_REMINDER}</p><a class="nye-contact" href={`tel:${PHONE_TEL}`}>Questions? {PHONE_DISPLAY}</a></div>
    </section>
  </div>
  <aside class="nye-mobile-bar" aria-label="New Year's Eve reservations"><span data-nye-opening-reminder>{NYE_OPENING_REMINDER}</span><a class="btn btn-solid" href={NYE_OPEN_CTA.href} data-nye-booking-cta data-nye-after-opening hidden>{NYE_OPEN_CTA.label}</a></aside>
  <SnapFooter />
  {nyeJsonLd && <script type="application/ld+json" set:html={JSON.stringify(nyeJsonLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(videoObjectSchema(NYE_VIDEO))} />
  <BreadcrumbSchema crumbs={[{ name: "Home", path: "/" }, { name: "New Year's Eve", path: "/new-years-eve/" }]} />
</Base>
<script>
  // The mobile action returns after the hero scrolls away, avoiding adjacent
  // identical buttons in the first viewport. No-JS retains the useful bar.
  const hero = document.querySelector('.nye-hero');
  const bar = document.querySelector<HTMLElement>('.nye-mobile-bar');
  if (hero && bar && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => { bar.hidden = entry.isIntersecting; }).observe(hero);
  }
</script>
<style>
  .nye-page { background: #100b23; color: var(--warm-white); }
  .nye-page [hidden] { display: none !important; }
  .nye-page h1, .nye-page h2 { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; line-height: .98; letter-spacing: -.015em; }
  .nye-page h2 { font-size: clamp(34px, 8vw, 54px); margin: 10px 0 24px; }
  .nye-page p { margin: 0 0 16px; }
  .nye-page a:not(.btn) { text-underline-offset: 4px; }
  .nye-eyebrow { font: 700 12px/1.5 var(--font-ui); letter-spacing: .12em; text-transform: uppercase; color: var(--warm-white); }
  .nye-hero { position: relative; isolation: isolate; overflow: hidden; }
  .nye-hero-video, .nye-hero-scrim { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nye-hero-video { object-fit: cover; }
  .nye-hero-scrim { background: linear-gradient(180deg, rgba(14,10,31,.28), rgba(14,10,31,.68) 34%, #100b23 100%); }
  .nye-hero-inner { position: relative; max-width: 1200px; margin: auto; padding: 170px 20px 40px; }
  .nye-hero h1 { font-size: clamp(46px, 12vw, 92px); margin: 10px 0 18px; }
  .nye-hero-sub { max-width: 30em; font: 400 18px/1.5 var(--font-body); }
  .nye-opening-wrap { max-width: 400px; margin-top: 28px; }
  .nye-primary { display: inline-flex; justify-content: center; align-items: center; min-height: 52px; font-size: 14px; text-align: center; letter-spacing: 0; }
  .nye-opening-wrap .nye-primary { width: 100%; margin-top: 12px; }
  .nye-page .btn-solid:hover, .nye-mobile-bar .btn-solid:hover { background: #78f3d5; color: #100b23; border-color: #78f3d5; }
  .nye-page .btn-solid:focus-visible, .nye-mobile-bar .btn-solid:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .nye-section { padding: 48px 20px; }
  .nye-inner { max-width: 1040px; margin: auto; }
  .nye-included { padding-top: 28px; }
  .nye-inclusions { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 14px; margin: 26px 0; padding: 0; }
  .nye-inclusions li { padding-top: 12px; border-top: 2px solid #4eecc4; }
  .nye-inclusions strong { display: block; font: 700 16px/1.4 var(--font-ui); }
  .nye-inclusions span { display: block; margin-top: 6px; font: 400 14px/1.5 var(--font-ui); color: #cbc5db; }
  .nye-food-example { max-width: 680px; font-size: 16px; }
  .nye-room-grid { display: grid; gap: 18px; }
  .nye-room-card { border: 1px solid #514562; border-radius: 10px; overflow: hidden; background: #1c1434; }
  .nye-room-card picture { display: block; height: 166px; }
  .nye-room-card img { width: 100%; height: 100%; object-fit: cover; }
  .nye-room-copy { padding: 22px; }
  .nye-room-copy h3 { font: 700 24px/1.2 var(--font-ui); margin: 0 0 12px; }
  .nye-room-copy p { font-size: 16px; }
  .nye-room-copy .nye-capacity { display: flex; align-items: center; gap: 14px; padding: 15px 16px; margin: 18px 0; background: #4eecc4; color: #100b23; border-radius: 6px; font-family: var(--font-ui); }
  .nye-capacity > strong { flex: 0 0 auto; font: 900 72px/.9 var(--font-display); }
  .nye-capacity-label, .nye-capacity-limit { display: block; }
  .nye-capacity-label { font: 800 17px/1.25 var(--font-ui); text-transform: uppercase; }
  .nye-capacity-limit { margin-top: 5px; font: 700 14px/1.35 var(--font-ui); }
  .nye-room-copy .nye-from { margin: 20px 0 0; font-family: var(--font-ui); }
  .nye-from strong { font-size: 24px; }
  .nye-attendance { margin-top: 24px; padding: 22px; border: 2px solid #4eecc4; border-radius: 10px; background: #1a2733; }
  .nye-attendance h3 { margin: 0 0 16px; color: #4eecc4; font: 900 clamp(30px, 6vw, 38px)/1.05 var(--font-display); text-transform: uppercase; }
  .nye-attendance p { max-width: 820px; font: 400 16px/1.6 var(--font-ui); }
  .nye-attendance .nye-attendance-example { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid #4b7a73; }
  .nye-room-note { margin-top: 22px !important; color: #cbc5db; font: 400 14px/1.6 var(--font-ui); }
  .nye-secondary { color: #cbc5db; font: 400 14px/1.6 var(--font-ui); }
  .nye-times-section { background: #1a1036; scroll-margin-top: 90px; }
  .nye-times-inner { max-width: 800px; }
  .nye-lede { font-size: 17px; }
  .nye-times { margin: 26px 0 18px; }
  .nye-times table { width: 100%; border-collapse: collapse; font: 500 16px/1.45 var(--font-ui); font-variant-numeric: tabular-nums; }
  .nye-times th, .nye-times td { padding: 17px 6px; border-bottom: 1px solid #514562; text-align: right; vertical-align: top; }
  .nye-times th:first-child { text-align: left; padding-left: 0; }
  .nye-times th:last-child, .nye-times td:last-child { padding-right: 0; }
  .nye-times thead th { font-size: 14px; }
  .nye-times td { white-space: nowrap; font-weight: 700; }
  .nye-time-end { display: block; }
  .nye-duration { display: block; font-size: 12px; font-weight: 500; color: #cbc5db; margin-top: 5px; }
  .nye-midnight-row { background: rgba(78,236,196,.06); }
  .nye-midnight-row .nye-duration { color: #4eecc4; max-width: 110px; }
  .nye-toast { border-left: 3px solid #4eecc4; padding: 4px 0 4px 18px; margin: 28px 0; font-size: 16px; }
  .nye-toast > strong { font-family: var(--font-ui); }
  .nye-toast p { margin: 8px 0 0; }
  .nye-times-section .nye-primary { width: 100%; }
  .nye-extras { border-bottom: 1px solid #352946; }
  .nye-extras p { font-size: 17px; }
  .nye-extras .nye-secondary { font-size: 14px; }
  .nye-faq details { border-top: 1px solid #514562; padding: 0; }
  .nye-faq details:last-child { border-bottom: 1px solid #514562; }
  .nye-faq summary { cursor: pointer; padding: 20px 26px 20px 0; font: 700 17px/1.5 var(--font-ui); }
  .nye-faq details p { font-size: 16px; padding-right: 10px; }
  .nye-closing { text-align: center; background: #200f53; padding-bottom: 70px; }
  .nye-closing .nye-primary { margin: 10px 0 16px; }
  .nye-closing .nye-closing-opening { color: #4eecc4; font-weight: 700; font-size: 20px; }
  .nye-contact { display: inline-block; padding: 12px; font: 600 16px/1.5 var(--font-ui); }
  .nye-mobile-bar { position: fixed; z-index: 30; bottom: 0; left: 0; right: 0; display: grid; gap: 6px; padding: 9px 16px calc(10px + env(safe-area-inset-bottom, 0px)); background: #100b23; border-top: 1px solid #514562; }
  .nye-mobile-bar[hidden], .nye-mobile-bar [hidden] { display: none !important; }
  .nye-mobile-bar span { font: 700 14px/1.5 var(--font-ui); text-align: center; color: #e3ddef; }
  .nye-mobile-bar .btn { min-height: 48px; display: flex; align-items: center; justify-content: center; font-size: 14px; letter-spacing: 0; }
  .nye-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  :global(body:has(.nye-page)) { padding-bottom: calc(100px + env(safe-area-inset-bottom, 0px)); }
  @media (prefers-reduced-motion: reduce) { .nye-hero-video { display: none; } .nye-hero { background: url('/snap/nye-poster.avif') center top / cover; } }
  @media (min-width: 640px) {
    .nye-section { padding: 64px 32px; }
    .nye-inclusions { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .nye-room-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .nye-room-card picture { height: 210px; }
    .nye-time-end { display: inline; }
    .nye-duration { font-size: 14px; }
    .nye-midnight-row .nye-duration { max-width: none; }
    .nye-times th, .nye-times td { padding: 20px 14px; }
    .nye-times thead th { font-size: 16px; }
  }
  @media (min-width: 1025px) {
    .nye-hero-scrim { background: linear-gradient(90deg, rgba(14,10,31,.88), rgba(14,10,31,.38)), linear-gradient(0deg, #100b23, transparent 50%); }
    .nye-hero-inner { min-height: 700px; padding: 160px 48px 80px; display: grid; grid-template-columns: minmax(0,1fr) 370px; gap: 60px; align-items: center; }
    .nye-opening-wrap { margin: 0; }
    .nye-hero h1 { font-size: clamp(70px, 6vw, 92px); }
    .nye-extras-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .nye-mobile-bar { display: none; }
    :global(body:has(.nye-page)) { padding-bottom: 0; }
  }
</style>
