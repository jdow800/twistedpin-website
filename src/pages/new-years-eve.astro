---
/**
 * 2026 NYE package preview. Jon confirmed all six party times September 14.
 * Per-lane prices verified against the public TPRS quote endpoint that day.
 * The event collection owns the calendar dates. Do not claim sales are open:
 * the booking page follows live availability, and the longer evening booking
 * durations still require a backend correction before launch. See the handoff.
 */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, eventSchema, videoObjectSchema } from "../lib/schema";
import { NYE_VIDEO } from "../data/videos";
import { PLAN_EVENT_URL } from "../lib/links";

const BOOK_NYE_URL = "/reserve/nye/";
const PAGE_URL = `${BUSINESS_URL}/new-years-eve/`;
const nyeVideoSchema = videoObjectSchema(NYE_VIDEO);
const nyeEntry = await getEntry("events", "2026-12-31-new-years-eve");
// No Offer until the real opening date and sale availability are confirmed.
// An invented validFrom/InStock assertion is not a substitute for that check.
const nyeJsonLd = nyeEntry ? {
  "@context": "https://schema.org",
  ...eventSchema({
    name: nyeEntry.data.title,
    start: nyeEntry.data.start,
    end: nyeEntry.data.end,
    description: nyeEntry.body?.trim(),
    image: `${BUSINESS_URL}/snap/nye-poster.avif`,
    url: PAGE_URL,
  }),
} : null;

// Base prices per lane, before the online booking fee and tax. Keep aligned
// with codes 126 (traditional) and 124 (VIP), including time-based price rules.
const sessions = [
  { time: "11am–12:30pm", traditional: "109.95", vip: "129.95" },
  { time: "1–2:30pm", traditional: "139.95", vip: "159.95" },
  { time: "3–4:30pm", traditional: "149.95", vip: "199.95" },
  { time: "5–7pm", traditional: "189.95", vip: "229.95" },
  { time: "7:30–9:30pm", traditional: "199.95", vip: "239.95" },
  { time: "10pm–12:30am", traditional: "219.95", vip: "259.95" },
];
---
<Base
  title="New Year's Eve 2026 in Plainfield | Twisted Pin"
  description="Plan New Year's Eve 2026 in Plainfield. Compare six bowling party times with pizza and soda included, plus a midnight toast with the 10pm party."
  ogImage="/og/og-vip-suite.jpg"
  ogImageAlt="The VIP suite lanes at Twisted Pin in Plainfield, IL"
  lcpPreloadHref="/snap/nye-poster.avif"
  lcpPreloadMedia="(max-width: 1024px)"
>

  <section class="nye-hero" data-hero aria-labelledby="nye-hero-h1">
    <video
      class="nye-hero-video"
      preload="none"
      muted
      autoplay
      loop
      playsinline
      poster="/snap/nye-poster.avif"
      aria-hidden="true"
    >
      {/* Bounded media queries (2026-05-17) — same pattern as homepage
          hero / events first section. Source ordering already prefers
          540 on phones, but explicit upper bound on 1080 sources is
          defense-in-depth against browser probe behavior during load. */}
      <source media="(max-width: 480px)" src="/snap/nye-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
      <source media="(max-width: 480px)" src="/snap/nye-mobile-h264-540.mp4" type="video/mp4" />
      <source media="(min-width: 481px)" src="/snap/nye-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
      <source media="(min-width: 481px)" src="/snap/nye-mobile-h264-1080.mp4" type="video/mp4" />
    </video>

    <div class="nye-hero-scrim" aria-hidden="true"></div>

    <div class="nye-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">December 31, 2026 · Plainfield, IL</p>
      <h1 class="t-display nye-hero-headline" id="nye-hero-h1">
        <span class="hero-fade" data-delay-ms="120">New Year's Eve.</span>
        <span class="hero-fade" data-delay-ms="280">Done right.</span>
      </h1>
      <p class="nye-hero-sub hero-fade" data-delay-ms="380">
        Pizza, bowling, cocktails, and your kind of countdown. Pick an afternoon party or stay through midnight with the 10pm crew.
      </p>
    </div>
  </section>

  <section class="nye-section nye-packages" aria-labelledby="nye-packages-h2">
    <div class="nye-section-inner">
      <p class="t-eyebrow">The Packages</p>
      <h2 class="t-display nye-section-title" id="nye-packages-h2">Pick your New Year's Eve party time.</h2>
      <p class="nye-section-body">
        Every lane includes unlimited bowling for your selected party time,
        shoe rental, one large pizza, one pitcher of soda, and party favors.
        Traditional lanes start at $109.95; VIP suite lanes start at $129.95.
        Prices are per lane and vary by party time.
      </p>
      <ul class="nye-section-list">
        <li><strong>Traditional lanes:</strong> up to 5 guests per lane.</li>
        <li><strong>VIP suite lanes:</strong> up to 6 guests per lane, with couch seating.</li>
        <li>Count everyone in your group, including guests who aren't bowling.</li>
      </ul>

      <div class="nye-times">
        <table aria-describedby="nye-price-note">
          <caption>December 31, 2026 · price per lane</caption>
          <thead>
            <tr><th scope="col">Party time</th><th scope="col">Traditional</th><th scope="col">VIP suite</th></tr>
          </thead>
          <tbody>
            {sessions.map((session) => (
              <tr>
                <th scope="row">{session.time}</th>
                <td>${session.traditional}</td>
                <td>${session.vip}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="nye-price-note" id="nye-price-note">
        Prices above are before tax and the online booking fee. All times are
        local to Plainfield. The 10pm party ends at 12:30am on January 1, 2027.
      </p>
      <p class="nye-section-body">
        <strong>Here for midnight?</strong> Choose the 10pm–12:30am party.
        That party includes the midnight toast: champagne for guests 21 and over,
        or sparkling cider. The earlier parties finish before midnight.
      </p>
      <p class="nye-section-body">
        Choose your pizza and soda during booking. Two lanes include two pizzas
        and two pitchers, with a separate choice for each lane. Matching orders
        are fine. Let us know if you're hoping to bowl near another group.
      </p>
      <div class="nye-packages-cta">
        <a class="btn btn-solid" href={BOOK_NYE_URL}>Check NYE availability</a>
      </div>
    </div>
  </section>

  <section class="nye-section nye-night" aria-labelledby="nye-night-h2">
    <div class="nye-section-inner">
      <p class="t-eyebrow">The Room &amp; The Bar</p>
      <h2 class="t-display nye-section-title" id="nye-night-h2">Make it a VIP night.</h2>
      <p class="nye-section-body">
        The six-lane semi-private VIP suite sits apart from the traditional lanes.
        NYE reservations are sold by the lane for the party time you choose.
        Reserve all six VIP lanes for your group to have the suite's lanes together;
        smaller reservations may share the suite with other groups.
      </p>
      <p class="nye-section-body">
        Beyond the drinks included with your package, explore cocktails curated by
        Brian Van Flandern, named America's Top Mixologist by Food Network, and
        our 28-tap self-serve wall with beer, wine, cider, and non-alcoholic options.
        Additional food and drinks are available to purchase.
      </p>
    </div>
  </section>

  <section class="nye-cta" aria-labelledby="nye-cta-h2">
    <div class="nye-cta-inner">
      <h2 class="t-display nye-cta-title" id="nye-cta-h2">Your crew. Your countdown.</h2>
      <p class="nye-cta-body">
        Join us at 15610 Joliet Road in Plainfield, IL, with free on-site parking.
        Check the booking page for availability. Questions about your group?
        Our event team can help.
      </p>
      <div class="nye-cta-actions">
        <a class="btn btn-solid" href={BOOK_NYE_URL}>Check NYE availability</a>
        <a class="btn btn-outline" href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event</a>
      </div>
    </div>
  </section>

  <SnapFooter />
  {nyeJsonLd && <script type="application/ld+json" set:html={JSON.stringify(nyeJsonLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(nyeVideoSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "New Year's Eve", path: "/new-years-eve/" },
  ]} />
</Base>

<style>
  /* ============================================================
     HERO
     ============================================================ */
  .nye-hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .nye-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .nye-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(14, 10, 31, 0.35) 0%,
      rgba(14, 10, 31, 0.05) 35%,
      rgba(14, 10, 31, 0.55) 75%,
      rgba(14, 10, 31, 0.85) 100%
    );
  }
  .nye-hero-copy {
    position: relative;
    z-index: 2;
    padding: 0 24px 96px;
    color: var(--warm-white);
    max-width: 800px;
  }
  @media (min-width: 1025px) {
    .nye-hero-copy {
      padding: 0 64px 120px;
    }
  }
  .nye-hero-headline {
    font-size: clamp(40px, 12vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.015em;
    margin: 8px 0 18px;
    color: var(--warm-white);
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .nye-hero-headline span {
    display: block;
  }
  .nye-hero-sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 4vw, 22px);
    line-height: 1.4;
    color: rgba(255, 252, 245, 0.9);
    margin: 0;
    max-width: 28em;
  }

  /* ============================================================
     EDITORIAL SECTION
     ============================================================ */
  .nye-section {
    padding: 80px 24px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .nye-section {
      padding: 120px 64px;
    }
  }
  .nye-section-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .nye-section-title {
    font-size: clamp(28px, 7vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.005em;
    margin: 8px 0 28px;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .nye-section-body {
    font-family: var(--font-body);
    font-size: clamp(16px, 4vw, 18px);
    line-height: 1.6;
    color: rgba(255, 252, 245, 0.88);
    margin: 0 0 20px;
  }
  .nye-section-list {
    margin: 28px 0 0;
    padding: 0 0 0 20px;
    color: rgba(255, 252, 245, 0.82);
    font-family: var(--font-body);
    font-size: clamp(15px, 3.8vw, 17px);
    line-height: 1.55;
  }
  .nye-section-list li + li {
    margin-top: 8px;
  }
  .nye-night { padding-top: 0; }
  .nye-times { margin: 32px 0 20px; }
  .nye-times table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: clamp(13px, 3.5vw, 16px);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .nye-times caption {
    text-align: left;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .nye-times th, .nye-times td {
    padding: 14px 8px;
    border-bottom: 1px solid rgba(255, 252, 245, 0.2);
    text-align: right;
  }
  .nye-times th:first-child {
    width: 40%;
    padding-left: 0;
    text-align: left;
  }
  .nye-times th:last-child, .nye-times td:last-child { padding-right: 0; }
  .nye-times td { white-space: nowrap; }
  .nye-price-note {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 252, 245, 0.82);
    margin: 0 0 24px;
  }
  .nye-packages-cta {
    margin-top: 32px;
  }

  /* ============================================================
     CLOSING CTA BAND
     ============================================================ */
  .nye-cta {
    background: var(--indigo-deep);
    padding: 80px 24px;
    text-align: center;
  }
  @media (min-width: 1025px) {
    .nye-cta {
      padding: 120px 64px;
    }
  }
  .nye-cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .nye-cta-title {
    font-size: clamp(28px, 7vw, 44px);
    line-height: 1.05;
    color: var(--warm-white);
    margin: 0 0 16px;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-weight: 900;
  }
  .nye-cta-body {
    font-family: var(--font-body);
    font-size: clamp(15px, 3.8vw, 17px);
    line-height: 1.55;
    color: rgba(255, 252, 245, 0.85);
    margin: 0 0 32px;
  }
  .nye-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
