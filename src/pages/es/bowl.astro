---
/**
 * Bowling visit planning: reservations, walk-in pricing, directions and
 * related nights/parties. English and Spanish pages stay aligned.
 * Reuses existing footage and the event collection's recurrence rules;
 * no independent event schedule or duplicate VideoObject markup.
 * The legacy /bowling redirect and reciprocal hreflang links stay intact.
 */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SnapFooter from "../../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { localBusinessBase, BUSINESS_URL, STREET, LOCALITY, REGION, PLACE_ID } from "../../lib/schema";
import { expandOccurrences, monthHorizon } from "../../lib/recurrence";

const BOOKING_URL = "/reserve/";
const PAGE_URL = `${BUSINESS_URL}/es/bowl/`;
const DESCRIPTION = "Reserva boliche en Plainfield, IL. Elige pistas tradicionales o la suite VIP, consulta precios y horarios, y disfruta cerveza artesanal, cocteles y comida.";
const MAPS_DIR_HREF = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent(`${STREET}, ${LOCALITY}, ${REGION}`) + "&destination_place_id=" + PLACE_ID;

const now = new Date();
// Same approved season cutoff as the existing English bowling page.
const KIDS_OFF_SEASON = now >= new Date("2026-08-15T00:00:00-05:00");
// Match the calendar's four-month horizon and its handling of dark dates,
// in-progress nights and ended seasons. The daily rebuild refreshes this.
const horizonEnd = monthHorizon(now, 4)[3].end;
const scheduledTags = new Set((await getCollection("events"))
  .filter((event) => !event.data.draft && expandOccurrences(event.data, now, horizonEnd).length > 0)
  .flatMap((event) => event.data.tags));
const featuredNights = [scheduledTags.has("karaoke") ? "karaoke" : null, scheduledTags.has("music-bingo") ? "Singo (bingo musical)" : null].filter((name): name is string => name !== null);

const bowlingAlleySchema = {
  ...(await localBusinessBase({
    url: PAGE_URL,
    image: `${BUSINESS_URL}/og/og-bowl.jpg`,
    description: DESCRIPTION,
  })),
  "@type": "BowlingAlley",
  inLanguage: "es-US",
};
---
<Base
  title="Boliche en Plainfield, IL — Twisted Pin"
  description={DESCRIPTION}
  ogImage="/og/og-bowl.jpg"
  ogImageAlt="Personas jugando boliche en las pistas tradicionales bajo la pantalla LED de Twisted Pin"
  lcpPreloadHref="/snap/summer-pass-poster.avif"
>
  {/* hreflang triplet — declares both language variants AND x-default
      fallback for Google's language-targeting algorithm. Identical on
      both /bowl and /es/bowl (Google requires reciprocal declarations
      OR Search Console flags the pair as broken). x-default → English
      because the site is primarily English; Spanish is a documented
      audience-segment overlay. */}
  <Fragment slot="head">
    <link rel="alternate" hreflang="en-US" href={`${BUSINESS_URL}/bowl/`} />
    <link rel="alternate" hreflang="es-US" href={`${BUSINESS_URL}/es/bowl/`} />
    <link rel="alternate" hreflang="x-default" href={`${BUSINESS_URL}/bowl/`} />
  </Fragment>

  {/* ============================================================
      HERO — typography-led title section (no image)
      ============================================================ */}
  <section class="bowl-hero" data-hero aria-labelledby="bowl-hero-h1">
    <div class="bowl-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Twisted Pin</p>
      <h1 class="t-display bowl-hero-headline hero-fade" id="bowl-hero-h1" data-delay-ms="120">
        Boliche en Plainfield,&nbsp;IL.
      </h1>
      <p class="bowl-hero-sub hero-fade" data-delay-ms="240">
        17 pistas tradicionales + una suite VIP de 6 pistas. Puedes venir sin reservación; las pistas están sujetas a disponibilidad.
      </p>
      <div class="bowl-hero-actions">
        <a class="btn btn-solid" href={BOOKING_URL} target="_blank" rel="noopener">Reservar una pista</a>
        <a class="btn btn-outline" href="/pricing/">Precios y horarios</a>
      </div>
      <p class="bowl-hero-location">
        <span>{STREET} · {LOCALITY}, {REGION}</span>
        <a href={MAPS_DIR_HREF} target="_blank" rel="noopener">Cómo llegar</a>
      </p>
    </div>
  </section>

  {/* ============================================================
      PISTAS TRADICIONALES — image left, copy right
      Matches /bowl section 1. Same video assets, same LCP recipe.
      ============================================================ */}
  <section class="bowl-section" aria-labelledby="bowl-traditional-h2">
    <div class="bowl-section-grid">
      <div class="bowl-section-frame">
        <video
          class="bowl-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          poster="/snap/summer-pass-poster.avif"
          aria-label="Bolear en las pistas tradicionales en Twisted Pin"
        >
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="bowl-section-copy">
        <p class="t-eyebrow">Pistas Tradicionales</p>
        <h2 class="t-display bowl-section-title" id="bowl-traditional-h2">
          17 pistas. Llega o reserva.
        </h2>

        <p class="bowl-section-body">
          Una cita, una salida con la familia o unas partidas con amigos.
          Reserva en línea para elegir entre los horarios disponibles.
          También puedes venir sin reservación durante el horario de
          apertura, sujeto a disponibilidad de pistas.
        </p>
        <p class="bowl-section-body">
          Rampas cuando los niños las necesiten. Coctel en la mano cuando no.
        </p>
        <ul class="bowl-section-list">
          <li>17 pistas tradicionales</li>
          <li>Hasta 5 jugadores por pista</li>
          <li>Rampas disponibles</li>
          <li>Renta de zapatos en el mostrador</li>
        </ul>
        <p class="bowl-section-body">
          Consulta los <a href="/pricing/">precios sin reservación y los
          horarios</a>. El precio de tu reservación aparece al elegir
          la fecha y las pistas.
        </p>

        <a class="btn btn-solid bowl-cta-inline" href={BOOKING_URL} target="_blank" rel="noopener">
          Reservar una pista
        </a>

        <div class="bowl-cross-links">
          <a href="/leagues/" id="leagues">
            <strong>Ligas</strong> &middot; ligas mixtas semanales, casuales + competitivas
          </a>
          <a href="/free-kids-bowling/">
            <strong>Boliche gratis para niños en verano</strong> &middot; {KIDS_OFF_SEASON ? "regresa en verano de 2027 — la lista de espera está abierta" : "2 juegos/día, lunes a viernes de 11am a 4pm, del 1 de junio al 14 de agosto"}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      SUITE VIP PREVIEW — image RIGHT, copy LEFT (alternation)
      ============================================================ */}
  <section class="bowl-section bowl-section--reverse" aria-labelledby="bowl-vip-h2">
    <div class="bowl-section-grid">
      <div class="bowl-section-frame">
        <video
          class="bowl-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          data-poster="/snap/vip-lanes-poster.avif"
          aria-label="La suite VIP de 6 pistas en Twisted Pin"
        >
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="bowl-section-copy">
        <p class="t-eyebrow">La Suite VIP</p>
        <h2 class="t-display bowl-section-title" id="bowl-vip-h2">
          Dos pistas, cuatro o las seis.
        </h2>
        <p class="bowl-section-body">
          La suite VIP semi-privada está detrás de una pared, separada de las
          pistas tradicionales. Elige dos, cuatro o seis pistas para jugar
          con tu grupo. Los sillones dejan espacio para seguir la plática.
        </p>
        <ul class="bowl-section-list">
          <li>Pistas VIP reservadas en pares: 2, 4 o 6</li>
          <li>Hasta 6 jugadores por pista en reservaciones en línea</li>
          <li>Sillones junto a las pistas</li>
          <li>Pantalla LED y opciones de audio y video</li>
        </ul>
        <p class="bowl-section-body">
          ¿Planeas un evento? La suite completa recibe hasta 80 invitados.
          Nuestro equipo de eventos confirma el espacio reservado, la
          duración de la fiesta y el montaje.
        </p>
        <a class="btn btn-outline bowl-cta-inline" href="/vip-suite/">Ver la suite</a>
      </div>
    </div>
  </section>

  <div class="bowl-next">
    <div class="bowl-next-grid">
      <section class="bowl-next-section" aria-labelledby="bowl-night-h2">
        <p class="t-eyebrow">La Noche Sigue</p>
        <h2 class="t-display bowl-section-title" id="bowl-night-h2">Haz de esto tu plan para la noche.</h2>
        <p class="bowl-section-body">
          Quédate a probar <a href="/menu/food/">la comida de nuestra cocina</a>,
          explora cervezas artesanales, vinos y sidras en el <a href="/menu/taps/">muro
          de 28 grifos de autoservicio</a>, o pide <a href="/menu/cocktails/">cocteles</a>
          del programa curado por Brian Van Flandern,
          <em>Top Mixólogo de Estados Unidos</em> (Food Network).
        </p>
        <p class="bowl-section-body bowl-calendar-copy">
          ¿Te quedas un rato más? Consulta el <a href="/upcoming-events/">calendario
          de eventos</a>{featuredNights.length ? ` para ver las próximas fechas de ${featuredNights.join(" y ")}` : " para ver qué hay programado"}.
          Confirma las fechas antes de venir.
        </p>
      </section>
      <section class="bowl-next-section" aria-labelledby="bowl-parties-h2">
        <p class="t-eyebrow">Cumpleaños y Fiestas de Empresa</p>
        <h2 class="t-display bowl-section-title" id="bowl-parties-h2">¿Tienes algo que celebrar?</h2>
        <p class="bowl-section-body">
          Para un cumpleaños de adulto o una fiesta de empresa, elige la
          ocasión. Nuestro equipo de eventos te ayudará a planear el espacio,
          la comida y las bebidas, y coordinará tu reservación.
        </p>
        <div class="bowl-party-links">
          <a href="/adult-birthday-parties/">Cumpleaños de adultos y fechas especiales →</a>
          <a href="/corporate-events/">Fiestas y salidas de empresa →</a>
          <a href="/reserve/birthdays/">Reserva un cumpleaños infantil en línea →</a>
        </div>
      </section>
    </div>
  </div>

  {/* ============================================================
      Correction-link footer — production-side QA loop.
      Real users surface real translation problems faster than any
      pre-ship review pass. Small, unobtrusive, mailto so anyone can
      reply without an account. Flagged in spanish-localization.md
      as the v1 quality-mitigation mechanism.
      ============================================================ */}
  <section class="es-correction-band" aria-label="Correcciones de traducción">
    <div class="es-correction-inner">
      <p>
        ¿Encontraste un error en la traducción?
        <a href="mailto:contactus@twistedpin.com?subject=Correcci%C3%B3n%20de%20traducci%C3%B3n%20%2Fes%2Fbowl%2F&body=P%C3%A1gina%3A%20%2Fes%2Fbowl%2F%0AError%3A%20%0ASugerencia%3A%20">
          Avísanos
        </a>
        &middot;
        <a href="/bowl/" hreflang="en-US">Ver en inglés</a>
      </p>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(bowlingAlleySchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Inicio", path: "/" },
    { name: "Boliche", path: "/es/bowl/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /es/bowl — mirrors /bowl styles exactly. Class names .bowl-*
     are scoped by Astro per-file hashing so they don't collide
     with the English page's identically-named classes. CSS hoist
     to .pillar-* utilities remains overdue (flagged across the
     pillar family).
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .bowl-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 0;
    padding: calc(var(--header-height) + 24px) 22px 28px;
  }
  @media (min-width: 1025px) {
    .bowl-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .bowl-hero-copy {
    max-width: 760px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .bowl-hero-copy { text-align: center; }
    .bowl-hero-sub { margin-left: auto; margin-right: auto; }
  }

  .bowl-hero-headline {
    color: var(--warm-white);
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .bowl-hero-headline { font-size: clamp(56px, 6vw, 88px); }
  }

  .bowl-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 34em;
  }
  @media (min-width: 1025px) {
    .bowl-hero-sub { margin-top: 22px; font-size: 19px; max-width: 38em; }
  }

  /* ---------- editorial sections ---------- */
  .bowl-section {
    background: transparent;
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
    .bowl-section { padding: 24px 64px; }
  }

  .bowl-section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 1025px) {
    .bowl-section-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 64px;
    }
    .bowl-section--reverse .bowl-section-grid > .bowl-section-frame {
      order: 2;
    }
  }

  .bowl-section-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1025px) {
    .bowl-section-frame { aspect-ratio: 3 / 4; max-height: 640px; }
  }

  .bowl-section-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .bowl-section-copy {
    color: var(--warm-white);
    max-width: 36em;
  }

  .bowl-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .bowl-section-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .bowl-section-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
  }
  @media (min-width: 1025px) {
    .bowl-section-body { font-size: 17.5px; line-height: 1.65; }
  }

  .bowl-section-list {
    margin-top: 22px;
    padding-left: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--warm-white);
  }
  .bowl-section-list li {
    padding: 8px 0 8px 22px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
    position: relative;
  }
  .bowl-section-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glow);
    opacity: 0.85;
  }

  .bowl-cta-inline {
    margin-top: 28px;
  }

  /* ---------- cross-links (Ligas / Boliche gratis para niños) ---------- */
  .bowl-cross-links {
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bowl-cross-links a {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--warm-mid);
    transition: color 150ms ease-out;
  }
  .bowl-cross-links a:hover { color: var(--glow); }
  .bowl-cross-links a strong {
    color: var(--warm-white);
    font-weight: 700;
  }

  /* ---------- correction-link band (Spanish-page-specific) ---------- */
  .es-correction-band {
    padding: 24px 22px 32px;
    text-align: center;
  }
  @media (min-width: 1025px) {
    .es-correction-band { padding: 32px 64px 48px; }
  }

  .es-correction-inner p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--warm-dim);
  }
  .es-correction-inner a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
    margin: 0 2px;
    transition: text-decoration-color 200ms ease;
  }
  .es-correction-inner a:hover {
    text-decoration-color: var(--glow);
  }
  /* Desktop size pass (2026-08-03 batch, Jon-approved): the section list
     is read-to-decide spec copy at 13px while the section body runs
     ~17.5px on desktop. 15.5px matches the fundraisers / why-us pattern.
     KEEP LAST in this style block: equal-specificity overrides win by
     source order only (the /pricing dead-CSS lesson). Mobile unchanged. */
  @media (min-width: 1025px) {
    .bowl-section-list { font-size: 15.5px; }
  }
  /* Desktop hero dead-air fix (2026-08-03 sweep — approved on
     /vip-suite): the typography hero pinned min-height 55vh/640px
     around ~300px of copy; flex-centered slack rendered as voids above
     the eyebrow and below the sub. Content + padding define height now.
     KEEP LAST (source-order cascade; the /pricing dead-CSS lesson). */
  @media (min-width: 1025px) {
    .bowl-hero {
      min-height: 0;
      padding: calc(var(--header-height) + 56px) 64px 40px;
    }
    .bowl-section { padding-top: 32px; }
  }

  /* Visit controls stay compact and can wrap on narrow phones. */
  .bowl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 440px;
    margin-top: 24px;
  }
  .bowl-hero-actions .btn {
    flex: 1 1 145px;
    min-height: 48px;
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }
  .bowl-hero-location {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--warm-mid);
  }
  .bowl-hero-location a,
  .bowl-section-body a,
  .bowl-party-links a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
  }
  .bowl-hero-location a:hover,
  .bowl-section-body a:hover,
  .bowl-party-links a:hover { text-decoration-color: var(--glow); }
  .bowl-next { padding: 48px 22px 32px; }
  .bowl-next-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .bowl-next-section {
    min-width: 0;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    padding-top: 28px;
  }
  .bowl-party-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
  }
  @media (min-width: 1025px) {
    .bowl-hero-actions { margin-left: auto; margin-right: auto; }
    .bowl-hero-location { justify-content: center; font-size: 15px; }
    .bowl-next { padding: 64px 64px 48px; }
    .bowl-next-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; }
    .bowl-party-links { font-size: 17.5px; }
  }
</style>
