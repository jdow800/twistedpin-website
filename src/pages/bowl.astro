---
/**
 * Bowling visit planning: reservations, walk-in pricing, directions and
 * related nights/parties. English and Spanish pages stay aligned.
 * Reuses existing footage and the event collection's recurrence rules;
 * no independent event schedule or duplicate VideoObject markup.
 * The legacy /bowling redirect and reciprocal hreflang links stay intact.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { localBusinessBase, BUSINESS_URL, STREET, LOCALITY, REGION, PLACE_ID } from "../lib/schema";
import { expandOccurrences, monthHorizon } from "../lib/recurrence";

const BOOKING_URL = "/reserve/";
const PAGE_URL = `${BUSINESS_URL}/bowl/`;
const DESCRIPTION = "Reserve bowling in Plainfield, IL. Choose traditional lanes or the VIP suite, check prices and hours, and stay for craft beer, cocktails and food.";
const MAPS_DIR_HREF = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent(`${STREET}, ${LOCALITY}, ${REGION}`) + "&destination_place_id=" + PLACE_ID;

const now = new Date();
// Same approved season cutoff as the existing English bowling page.
const KIDS_OFF_SEASON = now >= new Date("2026-08-15T00:00:00-05:00");
// Match the calendar's four-month horizon and its handling of dark dates,
// in-progress nights and ended seasons. The daily rebuild refreshes this.
const horizonEnd = monthHorizon(now, 4)[3].end;
const scheduledTags = new Set((await getCollection("events"))
  .filter((event) => !event.data.draft && expandOccurrences(event.data, now, horizonEnd).length > 0)
  .flatMap((event) => event.data.tags));
const featuredNights = [scheduledTags.has("karaoke") ? "karaoke" : null, scheduledTags.has("music-bingo") ? "Singo music bingo" : null].filter((name): name is string => name !== null);

const bowlingAlleySchema = {
  ...(await localBusinessBase({
    url: PAGE_URL,
    image: `${BUSINESS_URL}/og/og-bowl.jpg`,
    description: DESCRIPTION,
  })),
  "@type": "BowlingAlley",
  inLanguage: "en-US",
};
---
<Base
  title="Bowling in Plainfield, IL — Twisted Pin"
  description={DESCRIPTION}
  ogImage="/og/og-bowl.jpg"
  ogImageAlt="Guests bowling on the traditional lanes beneath the LED video wall at Twisted Pin"
  lcpPreloadHref="/snap/summer-pass-poster.avif"
>
  {/* hreflang triplet — reciprocal to /es/bowl. Both pages MUST declare
      the same triplet pointing at both URLs + x-default; Google flags
      the pair as broken in Search Console if a declaration is one-way.
      x-default → English because the site is primarily English; Spanish
      is the documented audience-segment overlay (seo.md:44 — 68 clicks
      already on Spanish queries with zero targeting). Added 2026-05-18
      with the /es/bowl Phase 1 build. */}
  <Fragment slot="head">
    <link rel="alternate" hreflang="en-US" href={`${BUSINESS_URL}/bowl/`} />
    <link rel="alternate" hreflang="es-US" href={`${BUSINESS_URL}/es/bowl/`} />
    <link rel="alternate" hreflang="x-default" href={`${BUSINESS_URL}/bowl/`} />
  </Fragment>

  {/* ============================================================
      HERO — typography-led title section (no image)
      ============================================================ */}
  <section class="bowl-hero" data-hero aria-labelledby="bowl-hero-h1">
    <div class="bowl-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Twisted Pin</p>
      <h1 class="t-display bowl-hero-headline hero-fade" id="bowl-hero-h1" data-delay-ms="120">
        Bowling in Plainfield,&nbsp;IL.
      </h1>
      <p class="bowl-hero-sub hero-fade" data-delay-ms="240">
        17 traditional lanes + a 6-lane VIP suite. Walk-ins welcome; lane availability varies.
      </p>
      <div class="bowl-hero-actions">
        <a class="btn btn-solid" href={BOOKING_URL} target="_blank" rel="noopener">Reserve a lane</a>
        <a class="btn btn-outline" href="/pricing/">Pricing &amp; Hours</a>
      </div>
      <p class="bowl-hero-location">
        <span>{STREET} · {LOCALITY}, {REGION}</span>
        <a href={MAPS_DIR_HREF} target="_blank" rel="noopener">Get directions</a>
      </p>
    </div>
  </section>

  {/* ============================================================
      TRADITIONAL LANES — image left, copy right
      ============================================================ */}
  <section class="bowl-section" aria-labelledby="bowl-traditional-h2">
    <div class="bowl-section-grid">
      <div class="bowl-section-frame">
        {/* Traditional Lanes video — Summer Pin Pass clip.
            LCP optimization (2026-05-17): direct poster= + preload via
            Base.astro lcpPreloadHref; bounded media queries on sources.
            Same recipe as /events first section. */}
        <video
          class="bowl-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          poster="/snap/summer-pass-poster.avif"
          aria-label="Bowling on the traditional lanes at Twisted Pin"
        >
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/summer-pass-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/summer-pass-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="bowl-section-copy">
        <p class="t-eyebrow">Traditional Lanes</p>
        <h2 class="t-display bowl-section-title" id="bowl-traditional-h2">
          17 lanes. Walk in or reserve.
        </h2>

        <p class="bowl-section-body">
          Date night, family outing or a few frames with friends. Reserve
          online to choose from the available times. Walk-ins are welcome
          during open hours, with lanes subject to availability.
        </p>
        <p class="bowl-section-body">
          Bumpers when the kids need them. Cocktail in hand when they don’t.
        </p>
        <ul class="bowl-section-list">
          <li>17 traditional lanes</li>
          <li>Up to 5 players per lane</li>
          <li>Bumpers available</li>
          <li>Shoe rental at the counter</li>
        </ul>
        <p class="bowl-section-body">
          See <a href="/pricing/">walk-in prices and hours</a>. Reservation
          pricing is shown when you choose your date and lanes.
        </p>

        <a class="btn btn-solid bowl-cta-inline" href={BOOKING_URL} target="_blank" rel="noopener">
          Reserve a lane
        </a>

        {/* Cross-links: Leagues + summer free-kids program (live at
            /free-kids-bowling/ — restored 2026-05-07 after the venue
            launched the program). */}
        <div class="bowl-cross-links">
          <a href="/leagues/" id="leagues">
            <strong>Leagues</strong> &middot; weekly mixed leagues, casual + competitive
          </a>
          <a href="/free-kids-bowling/">
            <strong>Free summer kids bowling</strong> &middot; {KIDS_OFF_SEASON ? "back summer 2027 — the waitlist is open" : "2 games/day, weekdays 11–4, June 1–August 14"}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
      VIP SUITE PREVIEW — image RIGHT, copy LEFT (alternation).
      Funnels suite-curious users to the full /vip-suite page.
      ============================================================ */}
  <section class="bowl-section bowl-section--reverse" aria-labelledby="bowl-vip-h2">
    <div class="bowl-section-grid">
      <div class="bowl-section-frame">
        {/* VIP Suite Preview — uses the same vip-lanes video as the
            first section on /vip-suite. Reinforces the suite as a
            distinct space; click-through goes to the full pillar.
            Lazy-loaded via data-section-video. */}
        <video
          class="bowl-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          data-poster="/snap/vip-lanes-poster.avif"
          aria-label="The 6-lane VIP suite at Twisted Pin"
        >
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="bowl-section-copy">
        <p class="t-eyebrow">The VIP Suite</p>
        <h2 class="t-display bowl-section-title" id="bowl-vip-h2">
          Two lanes, four or all six.
        </h2>
        <p class="bowl-section-body">
          The semi-private VIP suite sits behind a wall, set apart from the
          traditional lanes. Choose two, four or six lanes for bowling with
          your group. Couch seating keeps everyone in the conversation.
        </p>
        <ul class="bowl-section-list">
          <li>VIP lanes reserved in pairs: 2, 4 or 6</li>
          <li>Up to 6 bowlers per lane for online reservations</li>
          <li>Couch seating alongside the lanes</li>
          <li>LED video wall and AV options</li>
        </ul>
        <p class="bowl-section-body">
          Planning an event? The full suite accommodates up to 80 guests.
          Our event team confirms your reserved space, party time and setup.
        </p>
        <a class="btn btn-outline bowl-cta-inline" href="/vip-suite/">See the suite</a>
      </div>
    </div>
  </section>

  <div class="bowl-next">
    <div class="bowl-next-grid">
      <section class="bowl-next-section" aria-labelledby="bowl-night-h2">
        <p class="t-eyebrow">More to the Night</p>
        <h2 class="t-display bowl-section-title" id="bowl-night-h2">Make a night of it.</h2>
        <p class="bowl-section-body">
          Stay for <a href="/menu/food/">food from the kitchen</a>, explore
          craft beer, wine and cider on the <a href="/menu/taps/">28-tap
          self-serve wall</a>, or order <a href="/menu/cocktails/">craft
          cocktails</a> from the program curated by Brian Van Flandern,
          <em>America’s Top Mixologist</em> (Food Network).
        </p>
        <p class="bowl-section-body bowl-calendar-copy">
          Staying a little longer? Check the <a href="/upcoming-events/">events
          calendar</a>{featuredNights.length ? ` for upcoming ${featuredNights.join(" and ")} nights` : " for upcoming nights and special events"}.
          Confirm the dates before you head over.
        </p>
      </section>
      <section class="bowl-next-section" aria-labelledby="bowl-parties-h2">
        <p class="t-eyebrow">Birthdays &amp; Company Parties</p>
        <h2 class="t-display bowl-section-title" id="bowl-parties-h2">Got something to celebrate?</h2>
        <p class="bowl-section-body">
          For adult birthdays and company parties, choose your occasion
          below. Our event team will help plan the space, catering and
          drinks, then arrange your booking.
        </p>
        <div class="bowl-party-links">
          <a href="/adult-birthday-parties/">Adult &amp; milestone birthdays →</a>
          <a href="/corporate-events/">Company parties &amp; team outings →</a>
          <a href="/reserve/birthdays/">Book a kids’ birthday online →</a>
        </div>
      </section>
    </div>
  </div>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(bowlingAlleySchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Bowl", path: "/bowl/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /bowl — same pillar skeleton as the others. Rule of FIVE
     hit; .pillar-* CSS hoist now seriously overdue (flagged in
     Context/launch-checklist.md tech debt — every pillar after
     this hoist saves ~150 lines).
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .bowl-hero {
    position: relative;
    display: flex;
    align-items: center;
    /* Match t2-hero — see /bar.astro for rationale. */
    min-height: 0;
    padding: calc(var(--header-height) + 24px) 22px 28px;
  }
  @media (min-width: 1025px) {
    .bowl-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .bowl-hero-copy {
    max-width: 760px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .bowl-hero-copy { text-align: center; }
    .bowl-hero-sub { margin-left: auto; margin-right: auto; }
  }

  .bowl-hero-headline {
    color: var(--warm-white);
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .bowl-hero-headline { font-size: clamp(56px, 6vw, 88px); }
  }

  .bowl-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 34em;
  }
  @media (min-width: 1025px) {
    .bowl-hero-sub { margin-top: 22px; font-size: 19px; max-width: 38em; }
  }

  /* .hero-fade hoisted to global.css (2026-05-08 LCP fix). */

  /* ---------- editorial sections ---------- */
  .bowl-section {
    background: transparent;
    /* Tightened — see /bar.astro for rationale. */
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
    .bowl-section { padding: 24px 64px; }
  }

  .bowl-section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 1025px) {
    .bowl-section-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 64px;
    }
    .bowl-section--reverse .bowl-section-grid > .bowl-section-frame {
      order: 2;
    }
  }

  .bowl-section-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1025px) {
    .bowl-section-frame { aspect-ratio: 3 / 4; max-height: 640px; }
  }

  .bowl-section-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .bowl-section-copy {
    color: var(--warm-white);
    max-width: 36em;
  }

  .bowl-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .bowl-section-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .bowl-section-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
  }
  @media (min-width: 1025px) {
    .bowl-section-body { font-size: 17.5px; line-height: 1.65; }
  }

  .bowl-section-list {
    margin-top: 22px;
    padding-left: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--warm-white);
  }
  .bowl-section-list li {
    padding: 8px 0 8px 22px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
    position: relative;
  }
  .bowl-section-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glow);
    opacity: 0.85;
  }

  .bowl-cta-inline {
    margin-top: 28px;
  }

  /* ---------- cross-links (Leagues / Free Kids) ---------- */
  .bowl-cross-links {
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bowl-cross-links a {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--warm-mid);
    transition: color 150ms ease-out;
  }
  .bowl-cross-links a:hover { color: var(--glow); }
  .bowl-cross-links a strong {
    color: var(--warm-white);
    font-weight: 700;
    /* Inline with body text — same font-family inheritance, lifts
       the lead word visually so the link reads "[Word] · description". */
  }
  /* Desktop size pass (2026-08-03 batch, Jon-approved): the section list
     is read-to-decide spec copy at 13px while the section body runs
     ~17.5px on desktop. 15.5px matches the fundraisers / why-us pattern.
     KEEP LAST in this style block: equal-specificity overrides win by
     source order only (the /pricing dead-CSS lesson). Mobile unchanged. */
  @media (min-width: 1025px) {
    .bowl-section-list { font-size: 15.5px; }
  }
  /* Desktop hero dead-air fix (2026-08-03 sweep — approved on
     /vip-suite): the typography hero pinned min-height 55vh/640px
     around ~300px of copy; flex-centered slack rendered as voids above
     the eyebrow and below the sub. Content + padding define height now.
     KEEP LAST (source-order cascade; the /pricing dead-CSS lesson). */
  @media (min-width: 1025px) {
    .bowl-hero {
      min-height: 0;
      padding: calc(var(--header-height) + 56px) 64px 40px;
    }
    .bowl-section { padding-top: 32px; }
  }

  /* Visit controls stay compact and can wrap on narrow phones. */
  .bowl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    max-width: 440px;
    margin-top: 24px;
  }
  .bowl-hero-actions .btn {
    flex: 1 1 145px;
    min-height: 48px;
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }
  .bowl-hero-location {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 16px;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--warm-mid);
  }
  .bowl-hero-location a,
  .bowl-section-body a,
  .bowl-party-links a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
  }
  .bowl-hero-location a:hover,
  .bowl-section-body a:hover,
  .bowl-party-links a:hover { text-decoration-color: var(--glow); }
  .bowl-next { padding: 48px 22px 32px; }
  .bowl-next-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .bowl-next-section {
    min-width: 0;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    padding-top: 28px;
  }
  .bowl-party-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 24px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
  }
  @media (min-width: 1025px) {
    .bowl-hero-actions { margin-left: auto; margin-right: auto; }
    .bowl-hero-location { justify-content: center; font-size: 15px; }
    .bowl-next { padding: 64px 64px 48px; }
    .bowl-next-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; }
    .bowl-party-links { font-size: 17.5px; }
  }
</style>
