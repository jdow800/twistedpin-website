---
/** Public transition page. Keep current rewards until the catalog cutover.
 * At launch: remove the two legacy hour rewards, promote the $50 panel,
 * and update public/llms.txt together. This page never issues reward links.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";

const rewards = [
  { points: 50, reward: "Free shoe rental", detail: "One pair. One less thing to pay for." },
  { points: 100, reward: "$10 lane credit", detail: "Put your points toward bowling." },
  { points: 200, reward: "$20 lane credit", detail: "A little more on us." },
  { points: 250, reward: "Buy an hour, second hour on us", detail: "Keep the next round rolling." },
  { points: 350, reward: "A full hour of bowling, on us", detail: "Your current top reward." },
];
---
<Base
  title="Bowling Rewards in Plainfield | Twisted Pin"
  description="Earn 50 points when you check in at Twisted Pin in Plainfield. Explore bowling rewards, see how to redeem, and plan your next visit. No app needed."
>
  <div class="rewards-page">
    <header class="rewards-hero rewards-wrap">
      <p class="rewards-eyebrow">Twisted Pin Rewards</p>
      <h1 class="t-display">Regulars get<br />the perks.</h1>
      <p class="rewards-intro">Show up. Check in. Make your next round count.</p>
      <p class="rewards-lead">Earn <strong>50 points per check-in day</strong> at the front-desk kiosk,
        including your first visit. Use your phone number. No app, no card.</p>
      <a class="rewards-jump" href="#your-rewards">See the rewards <span aria-hidden="true">&darr;</span></a>
    </header>

    <div class="rewards-wrap rewards-content">
      <section class="rewards-choices" id="your-rewards" aria-labelledby="rewards-heading">
        <div class="rewards-section-head">
          <p class="rewards-eyebrow">Available now &middot; In-store</p>
          <h2 id="rewards-heading" class="t-display">Spend a little.<br />Or keep stacking.</h2>
          <p>Pick a reward at the kiosk and let staff finish your redemption.
            The points shown come out of your balance.</p>
        </div>
        <dl class="rewards-list">
          {rewards.map(({ points, reward, detail }) => (
            <div class="rewards-row">
              <dt><span>{points}</span> <span class="rewards-points-label">points</span></dt>
              <dd><h3>{reward}</h3><p>{detail}</p></dd>
            </div>
          ))}
        </dl>
        <p class="rewards-note">Current rewards are for walk-in open bowling and shoe rental.
          Events, leagues and the VIP suite are excluded. Check the terms on your chosen reward.</p>
      </section>

      <aside class="rewards-next" aria-labelledby="next-reward-heading">
        <p class="rewards-status">Coming soon</p>
        <p class="rewards-next-cost">350 points</p>
        <h2 id="next-reward-heading"><span class="rewards-amount">$50</span><span>toward your next lane.</span></h2>
        <p>A new top reward, with two ways to use it.</p>
        <ul class="rewards-channels">
          <li><strong>Book online</strong><span>Use a personal reward link for a regular traditional or VIP lane reservation, with shoes included.</span></li>
          <li><strong>Redeem in-store</strong><span>Use your points at the kiosk and have staff apply the reward at the counter.</span></li>
        </ul>
        <p class="rewards-next-footer">This reward isn't available yet. It will replace the 250-point
          and 350-point hour rewards above. Your points stay with you.</p>
      </aside>
    </div>

    <section class="rewards-wrap rewards-help" aria-labelledby="rewards-help-heading">
      <div>
        <p class="rewards-eyebrow">A few things to know</p>
        <h2 id="rewards-help-heading" class="t-display">Your points.<br />Your call.</h2>
      </div>
      <div class="rewards-questions">
        <details>
          <summary>Where can I check my balance?<span aria-hidden="true">+</span></summary>
          <p>Enter your phone number at the front-desk kiosk. You'll see your current points
            and the rewards you can redeem. Prefer to save? Keep your points for another visit.</p>
        </details>
        <details>
          <summary>Does booking online earn points?<span aria-hidden="true">+</span></summary>
          <p>Your kiosk check-in earns the points. Even if you've booked online, check in at
            the kiosk when you arrive. You can earn 50 points once per check-in day.</p>
        </details>
        <details>
          <summary>Do my points expire?<span aria-hidden="true">+</span></summary>
          <p>Your points stay active as long as you visit at least once every 24 months.</p>
        </details>
        <details>
          <summary>What about an offer I already received?<span aria-hidden="true">+</span></summary>
          <p>Follow the terms and expiration date on that offer. Changes to the rewards list
            don't replace the terms of a valid gift you've already received.</p>
        </details>
      </div>
    </section>

    <section class="rewards-wrap rewards-text" aria-labelledby="text-club-heading">
      <div>
        <p class="rewards-eyebrow">Text Club &middot; Optional</p>
        <h2 id="text-club-heading" class="t-display">An inside line.<br />And $10 to start.</h2>
        <p>Get the occasional offer and news on what's happening at Twisted Pin.
          The signup $10 lane credit is separate from the reward you buy with 100 points.</p>
        <p>You can earn and use points without signing up for marketing texts.</p>
        <a class="rewards-button" href="/coupon/">Join the Text Club <span aria-hidden="true">&nearr;</span></a>
        <p class="rewards-disclosure">Message frequency varies. Msg &amp; data rates may apply.
          Reply STOP to opt out or HELP for help.
          <a href="/terms/">Terms</a> &amp; <a href="/privacy/">Privacy</a>.</p>
      </div>
    </section>
  </div>
  <SnapFooter />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Rewards", path: "/rewards/" },
  ]} />
</Base>

<style>
  .rewards-page { background: var(--indigo-deep); color: var(--warm-white); }
  .rewards-wrap { max-width: 1120px; margin-inline: auto; padding-inline: 22px; }
  .rewards-hero { padding-top: calc(var(--header-height) + 52px); padding-bottom: 48px; }
  .rewards-eyebrow { font: 700 12px/1.5 var(--font-ui); letter-spacing: .15em; text-transform: uppercase; color: var(--warm-mid); margin: 0 0 14px; }
  .rewards-hero h1 { font-size: clamp(58px, 15vw, 100px); line-height: .92; margin: 0; }
  .rewards-intro { font: 700 18px/1.5 var(--font-ui); margin: 24px 0 12px; max-width: 36ch; }
  .rewards-lead { max-width: 49ch; margin: 0; }
  .rewards-page p, .rewards-channels span { font-family: var(--font-body); font-size: 16px; line-height: 1.65; color: #ded8e5; }
  .rewards-page .rewards-eyebrow { font: 700 12px/1.5 var(--font-ui); color: var(--warm-mid); }
  .rewards-page .rewards-intro { font: 700 18px/1.5 var(--font-ui); color: var(--warm-white); }
  .rewards-page strong { color: var(--warm-white); }
  .rewards-jump { display: inline-flex; align-items: center; gap: 16px; margin-top: 24px; min-height: 44px; color: var(--glow); font: 700 14px/1.4 var(--font-ui); text-decoration: underline; text-underline-offset: 5px; }
  .rewards-content { display: grid; gap: 32px; padding-bottom: 52px; }
  .rewards-choices { scroll-margin-top: calc(var(--header-height) + 24px); min-width: 0; }
  .rewards-page h2.t-display { font-size: clamp(36px, 9vw, 48px); line-height: 1; margin: 0 0 20px; }
  .rewards-section-head > p:last-child { margin: 0 0 22px; max-width: 47ch; }
  .rewards-list { margin: 0; }
  .rewards-row { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 16px; padding-block: 20px; border-top: 1px solid rgba(244,239,227,.15); }
  .rewards-row dt { font: 700 26px/1.15 var(--font-ui); padding-top: 2px; }
  .rewards-points-label { display: block; font: 600 12px/1.5 var(--font-ui); color: var(--warm-mid); margin-top: 4px; }
  .rewards-row dd { margin: 0; }
  .rewards-row h3 { font: 700 16px/1.45 var(--font-ui); margin: 0; }
  .rewards-row p { margin: 5px 0 0; font-size: 14px; }
  .rewards-page .rewards-note { font-size: 14px; color: var(--warm-mid); margin: 12px 0 0; }
  .rewards-next { background: #181329; border: 1px solid rgba(78,236,196,.35); padding: 26px 24px; border-radius: 8px; align-self: start; }
  .rewards-page .rewards-status { display: inline-block; border: 1px solid rgba(244,239,227,.3); border-radius: 4px; padding: 5px 9px; font: 700 12px/1.5 var(--font-ui); text-transform: uppercase; letter-spacing: .08em; margin: 0 0 30px; color: var(--warm-white); }
  .rewards-page .rewards-next-cost { font: 700 15px/1.4 var(--font-ui); color: var(--glow); margin: 0 0 6px; }
  .rewards-next h2 { margin: 0 0 18px; font: 700 22px/1.25 var(--font-ui); }
  .rewards-next h2 > span { display: block; }
  .rewards-next .rewards-amount { font: 900 110px/.95 var(--font-display); letter-spacing: -.02em; color: var(--glow); margin-bottom: 12px; }
  .rewards-channels { list-style: none; padding: 0; margin: 24px 0; }
  .rewards-channels li { padding: 18px 0; border-top: 1px solid rgba(244,239,227,.15); }
  .rewards-channels strong { display: block; font: 700 16px/1.4 var(--font-ui); margin-bottom: 8px; }
  .rewards-channels span { display: block; font-size: 15px; }
  .rewards-page .rewards-next-footer { font-size: 14px; margin: 0; padding-top: 20px; border-top: 1px solid rgba(244,239,227,.15); }
  .rewards-help { padding-block: 42px 48px; display: grid; gap: 8px; border-top: 1px solid rgba(244,239,227,.15); }
  .rewards-questions { min-width: 0; }
  .rewards-questions details { border-bottom: 1px solid rgba(244,239,227,.15); }
  .rewards-questions summary { display: flex; justify-content: space-between; gap: 20px; list-style: none; cursor: pointer; padding-block: 20px; font: 700 16px/1.5 var(--font-ui); }
  .rewards-questions summary::-webkit-details-marker { display: none; }
  .rewards-questions summary span { color: var(--glow); font-size: 23px; line-height: 1; }
  .rewards-questions details[open] summary span { transform: rotate(45deg); }
  .rewards-questions details p { margin: 0 0 22px; }
  .rewards-text { padding-block: 32px 72px; }
  .rewards-text > div { border-top: 2px solid rgba(244,239,227,.25); padding-top: 32px; max-width: 680px; }
  .rewards-text p { max-width: 57ch; }
  .rewards-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 30px; margin-block: 10px 12px; padding: 15px 20px; background: var(--glow); color: var(--indigo-deep); border-radius: 7px; font: 700 14px/1.4 var(--font-ui); text-decoration: none; min-height: 48px; }
  .rewards-button:hover { background: #88f5d8; }
  .rewards-page .rewards-disclosure { font-size: 13px; color: var(--warm-mid); }
  .rewards-disclosure a { color: var(--warm-white); text-decoration: underline; text-underline-offset: 3px; }
  .rewards-page :is(a, summary):focus-visible { outline: 2px solid var(--glow); outline-offset: 5px; }
  @media (min-width: 760px) {
    .rewards-wrap { padding-inline: 40px; }
    .rewards-hero { padding-top: calc(var(--header-height) + 76px); padding-bottom: 64px; }
    .rewards-hero h1 { font-size: 100px; }
    .rewards-content { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 48px; padding-bottom: 72px; }
    .rewards-next { padding: 30px; }
    .rewards-help { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 56px; padding-block: 56px 64px; }
    .rewards-row { grid-template-columns: 80px minmax(0, 1fr); gap: 20px; }
    .rewards-text { padding-bottom: 96px; }
  }
</style>
