---
/**
 * Birthday entry page: kids book online; adults explore the dedicated
 * /adult-birthday-parties/ page, then use its event-planning CTA.
 * 2026-09-14: neutral introduction and two choices replace the kids-only
 * opening. The #adults anchor remains valid for existing inbound links.
 * Kids' packages and cancellation terms retain their existing source data.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import {
  BUSINESS_URL,
  BUSINESS_ENTITY_ID,
  GOOGLE_RATING,
  GOOGLE_REVIEW_COUNT,
} from "../lib/schema";
import { ICON_PATHS } from "../lib/icons";

import { PLAN_EVENT_URL } from "../lib/links";

// Roller→TPRS cutover Phase 2 (2026-06-15): kids-birthday booking moved to the
// live /reserve/birthdays TPRS flow. Absolute URL keeps JSON-LD Offer.url valid.
const KIDS_BOOKING_URL = "https://www.twistedpin.com/reserve/birthdays/";
const ADULT_BIRTHDAY_URL = "/adult-birthday-parties/";

// JSON-LD: two Product nodes (one per package) wrapped in an ItemList.
// Product + Offer is the right shape for SKU-priced packages — eligible
// for product rich snippets (price + availability in SERP). brand →
// BUSINESS_ENTITY_ID ties each package back to the venue entity graph.
// Source of truth is the live TPRS booking catalog at /reserve/birthdays/ --
// verify against it, not against this page. Extra Suite was stale at $489.90
// here (catalog said $469.90) until 2026-07-18; the display below now reads
// EXTRA_SUITE_BIRTHDAY_PRICE so the card and the schema Offer cannot diverge
// again. SUITE_BIRTHDAY_PRICE stays hardcoded in the card ($419 vs "419.00").
const PAGE_URL = `${BUSINESS_URL}/birthday-parties/`;
const SUITE_BIRTHDAY_PRICE = "419.00";
const EXTRA_SUITE_BIRTHDAY_PRICE = "469.90";
// Offer.validFrom — Google's Merchant-listing validator wants it on every
// Offer (same warning class GSC raised on /summer-pin-pass, 2026-07-12).
// The packages are always-on, so the honest anchor is the day this page
// (and online booking for these packages) launched: 2026-05-11 (0e3d173).
// No validThrough on purpose — these offers don't expire, and a fake end
// date would just become a stale-schema landmine (see schema-dates.ts).
const BIRTHDAY_OFFERS_VALID_FROM = "2026-05-11";
// Venue-wide Google rating, surfaced on both party Products so SERP
// results for /birthday-parties can show stars. Clears GSC
// "Missing field 'aggregateRating'" non-critical warning.
const partyAggregateRating = {
  "@type": "AggregateRating",
  ratingValue: GOOGLE_RATING,
  reviewCount: GOOGLE_REVIEW_COUNT,
  bestRating: 5,
  worstRating: 1,
};
const partyPackagesSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      item: {
        "@type": "Product",
        "@id": `${BUSINESS_URL}/#party-suite-birthday`,
        name: "Suite Birthday Party",
        description:
          "Kids' birthday party package at Twisted Pin: 1 hour of bowling on a reserved lane, 2 hours total party time, shoes and balls, 45-min reserved party space, $10 arcade game card per child, souvenir lunch bag, invitations, and a personal party coordinator. Up to 10 guests.",
        brand: { "@id": BUSINESS_ENTITY_ID },
        url: PAGE_URL,
        aggregateRating: partyAggregateRating,
        offers: {
          "@type": "Offer",
          price: SUITE_BIRTHDAY_PRICE,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          validFrom: BIRTHDAY_OFFERS_VALID_FROM,
          url: KIDS_BOOKING_URL,
          seller: { "@id": BUSINESS_ENTITY_ID },
        },
      },
    },
    {
      "@type": "ListItem",
      position: 2,
      item: {
        "@type": "Product",
        "@id": `${BUSINESS_URL}/#party-extra-suite-birthday`,
        name: "Extra Suite Birthday Party",
        description:
          "Extended kids' birthday party package: 1 hour of bowling on a reserved lane, 2.5 hours total party time, shoes and balls, 1 hour reserved party space, $10 arcade game card per child, souvenir lunch bag, invitations, and a personal party coordinator. Up to 10 guests.",
        brand: { "@id": BUSINESS_ENTITY_ID },
        url: PAGE_URL,
        aggregateRating: partyAggregateRating,
        offers: {
          "@type": "Offer",
          price: EXTRA_SUITE_BIRTHDAY_PRICE,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          validFrom: BIRTHDAY_OFFERS_VALID_FROM,
          url: KIDS_BOOKING_URL,
          seller: { "@id": BUSINESS_ENTITY_ID },
        },
      },
    },
  ],
};

// FAQPage + on-page FAQ (2026-06-17, on-page SEO spec Phase B). Reuses the
// /faq accordion pattern (global t2-faq-* classes) + the Question/Answer
// JSON-LD shape. Search-phrased for the birthday cluster — kids packages,
// capacity, cake/decor, milestone (30/40/50), bachelorette, booking, and
// location. Voice-clean: semi-private, "curated by" Brian, no chef/discount.
interface BdayFaq {
  q: string;
  /** Plain-text answer for JSON-LD (no HTML). */
  schemaA: string;
  /** Rendered HTML answer (may include <a> links). */
  htmlA: string;
}

const birthdayFaqs: BdayFaq[] = [
  {
    q: "Can I host a kids' birthday party at Twisted Pin in Plainfield?",
    schemaA:
      "Yes — kids' birthday parties run on a reserved lane with arcade time, a souvenir bag, invitations, and a personal party coordinator. Two packages: Suite Birthday ($419) and Extra Suite Birthday ($469.90), each up to 10 kids.",
    htmlA: `<p>Yes — kids' birthday parties run on a reserved lane with arcade time, a souvenir bag, invitations, and a personal party coordinator. Two packages — <strong>Suite Birthday ($419)</strong> and <strong>Extra Suite Birthday ($469.90)</strong> — each up to 10 kids.</p><p><a href="${KIDS_BOOKING_URL}" target="_blank" rel="noopener">Book a kids' party →</a></p>`,
  },
  {
    q: "How many kids can come to the party?",
    schemaA:
      "Each package covers up to 10 kids. Add more guests for $30–$40 per child depending on the package, up to a 14-guest max.",
    htmlA: `<p>Each package covers up to <strong>10 kids</strong>. Add more guests for $30–$40 per child depending on the package, up to a <strong>14-guest max</strong>.</p>`,
  },
  {
    q: "Can I bring my own cake, cupcakes, or decorations?",
    schemaA:
      "Outside cake and decor are welcome for booked, catered parties. Confirm the specifics with your party coordinator when you book.",
    htmlA: `<p>Outside cake and decor are welcome for booked, catered parties. Confirm the specifics with your party coordinator when you book.</p>`,
  },
  {
    q: "Do you host adult and 21st birthday parties?",
    schemaA:
      "Yes. Explore our adult birthday page for 21st birthdays and other milestone celebrations, with the semi-private VIP suite, catering and bar options. Select Plan My Birthday there to start planning with our event team.",
    htmlA: `<p>Yes. Explore our <a href="${ADULT_BIRTHDAY_URL}">adult birthday page</a> for 21st birthdays and other milestone celebrations, with the semi-private VIP suite, catering and bar options. Select Plan My Birthday there to start planning with our event team.</p>`,
  },
  {
    q: "Can I have a bachelorette or bachelor party here?",
    schemaA:
      "Absolutely. Take over the semi-private VIP suite for the group — your own lanes, the 28-tap self-serve beer and wine wall, and craft cocktails. Run a tab, hand out drink tickets, or set a per-head cap; the events team sets it up.",
    htmlA: `<p>Absolutely. Take over the <strong>semi-private VIP suite</strong> for the group — your own lanes, the 28-tap self-serve beer &amp; wine wall, and craft cocktails. Run a tab, hand out drink tickets, or set a per-head cap; the events team sets it up.</p><p><a href="${PLAN_EVENT_URL}" target="_blank" rel="noopener">Plan an event →</a></p>`,
  },
  {
    q: "How do I book a birthday party?",
    schemaA:
      "Kids' parties book online and pick a start time directly. Adult and milestone birthdays start on our adult birthday page, then go through the event team for planning and booking. Bachelorette parties also go through the event team.",
    htmlA: `<p>Kids' parties <a href="${KIDS_BOOKING_URL}" target="_blank" rel="noopener">book online</a> and pick a start time directly. Adult and milestone birthdays start on our <a href="${ADULT_BIRTHDAY_URL}">adult birthday page</a>, then go through the event team for planning and booking. Bachelorette parties also go through the event team.</p>`,
  },
  // Cancellation terms. SUPERSEDED 2026-09-05 (owner ruling): kids parties are
  // their OWN rail at 14 DAYS, not the 72-hour lane rule stated here before.
  // The refund at 14+ days is UNCONDITIONAL and the date move is deliberately
  // UNBOUNDED (Jon declined the two-month bound carried by the Roller-era
  // policy and the legacy TPRS confirmation email). "Deposit" and "final
  // payment" are banned on this rail — there is neither — so the catered
  // contrast below names the deposit only because catered IS that rail.
  // ⚠ schemaA feeds the FAQPage JSON-LD emitted further down this file, so the
  // old answer was published as structured data Google can serve in a rich
  // result. Both fields must move together; there is no second literal.
  {
    q: "What if I need to cancel or move the party?",
    schemaA:
      "Kids' parties are paid in full when you book. Cancel 14 or more days before the party and we'll move you to another date or refund you in full, whichever you'd rather. If you want the money back, you get the money back. Within 14 days, payment is final, and a party booked within 14 days is final as soon as you book. Catered adult events follow their own terms: the 50% deposit is refundable in full any time before the final payment.",
    htmlA: `<p>Kids' parties are paid in full when you book. Cancel <strong>14 or more days before the party</strong> and we'll move you to another date or refund you in full, whichever you'd rather. If you want the money back, you get the money back.</p><p>Within 14 days, payment is final, and a party booked within 14 days is final as soon as you book.</p><p>Catered adult events follow their own terms: the 50% deposit is refundable in full any time before the final payment. <a href="/faq/">Details in the FAQ</a>.</p>`,
  },
  {
    q: "Where are you located, and how far is it from Naperville?",
    schemaA:
      "We're in Plainfield at 15610 Joliet Rd — a short drive from Naperville, Joliet, Bolingbrook, Romeoville, Oswego, and Shorewood. Free on-site parking.",
    htmlA: `<p>We're in Plainfield at <strong>15610 Joliet Rd</strong> — a short drive from Naperville, Joliet, Bolingbrook, Romeoville, Oswego, and Shorewood. Free on-site parking.</p>`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: birthdayFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.schemaA },
  })),
};
---
<Base
  title="Kids & Adult Birthday Parties in Plainfield, IL | Twisted Pin"
  description="Birthday parties in Plainfield, IL. Book kids’ bowling and arcade packages online, or explore adult and 21st birthday celebrations with our event team."
  ogImage="/og/og-vip-suite.jpg"
  ogImageAlt="A group celebrating in the VIP suite at Twisted Pin in Plainfield, IL"
  lcpPreloadHref="/snap/vip-lanes-poster.avif"
  lcpPreloadMedia="(max-width: 1024px)"
>

  {/* ============================================================
      HERO — typography-led title section (no image)
      ============================================================ */}
  <section class="birthday-hero" data-hero aria-labelledby="birthday-hero-h1">
    <div class="birthday-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Birthday Parties · Plainfield, IL</p>
      <h1 class="t-display birthday-hero-headline hero-fade" id="birthday-hero-h1" data-delay-ms="120">
        Birthday parties. Your&nbsp;way.
      </h1>
      <p class="birthday-hero-sub hero-fade" data-delay-ms="240">
        Kids’ packages you can book online. Adult celebrations planned
        around your people. Pick your party.
      </p>
      <nav class="birthday-choices" aria-label="Choose your birthday party">
        <a class="birthday-choice" href={KIDS_BOOKING_URL}>
          <h2>Kids’ birthdays</h2>
          <p>Bowling, arcade time and party packages.</p>
          <span class="birthday-choice-action">View packages &amp; book <span aria-hidden="true">→</span></span>
        </a>
        <a class="birthday-choice" id="adults" href={ADULT_BIRTHDAY_URL}>
          <h2>Adult birthdays</h2>
          <p>21st birthdays, milestones and a night with your people.</p>
          <span class="birthday-choice-action">Explore adult parties <span aria-hidden="true">→</span></span>
        </a>
      </nav>
    </div>
  </section>

  {/* ============================================================
      KIDS — image LEFT, copy RIGHT (desktop)
      Photo: birthday-table (DSC00781 — the real table setup shot)
      ============================================================ */}
  <section class="birthday-section" aria-labelledby="birthday-kids-h2">
    <div class="birthday-section-grid">
      <div class="birthday-section-frame">
        {/* Kids Parties video — vip-lanes clip (matches the /vip-suite
            first section, since most kids' parties run in the VIP suite).
            LCP optimization (2026-05-17): direct poster= + preload via
            Base.astro lcpPreloadHref; bounded media queries on sources.
            Same recipe as /events first section. */}
        <video
          class="birthday-section-img"
          data-section-video
          preload="none"
          muted
          loop
          playsinline
          poster="/snap/vip-lanes-poster.avif"
          aria-label="The 6-lane VIP suite at Twisted Pin where kids' birthday parties run"
        >
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-av1-540.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-av1-1080.mp4"  type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="birthday-section-copy">
        <p class="t-eyebrow">Kids' Parties</p>
        <h2 class="t-display birthday-section-title" id="birthday-kids-h2">
          The birthday your kid asks for again.
        </h2>
        <p class="birthday-section-aside">(we do this part really well)</p>

        <p class="birthday-section-body">
          Some places try to do five different kid activities at once —
          trampolines, go-karts, ninja courses, mini-golf, indoor playgrounds.
          We don't. We have bowling. We have an arcade. We have a real
          kitchen. That's the whole pitch. And we're genuinely good at it.
        </p>

        <p class="birthday-section-body">
          The lane is your group's. The arcade is yours. Food, cake,
          presents — we handle the room. A real coordinator walks you
          through it. And while the kids run the place, the parents get
          a craft cocktail program curated by Brian Van Flandern —
          <em>America's Top Mixologist</em>. Both sides win.
        </p>

        <ul class="birthday-section-list">
          <li>A reserved lane</li>
          <li>Arcade time built in</li>
          <li>Real kitchen, not a microwave</li>
          <li>A coordinator who runs the room</li>
          <li>Bar program for the parents</li>
          <li>Souvenir bags + invitations</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============================================================
      PACKAGES — centered card grid, no image
      ============================================================ */}
  <section id="kids" class="birthday-packages" aria-labelledby="birthday-packages-h2">
    <div class="birthday-packages-inner">
      <p class="t-eyebrow t-eyebrow--center">Packages</p>
      <h2 class="t-display birthday-packages-title" id="birthday-packages-h2">
        Kids’ birthday packages.
      </h2>
      <p class="birthday-section-aside birthday-packages-aside">(pick the one that fits your group)</p>

      <div class="birthday-package-grid">
        <article class="birthday-package-card">
          <h3 class="birthday-package-name">Suite Birthday</h3>
          <p class="birthday-package-price">
            <span class="birthday-package-amount">$419</span>
            <span class="birthday-package-base">up to 10 guests</span>
          </p>
          <p class="birthday-package-meta">$30 per additional guest · 14 guest max</p>
          <ul class="birthday-package-list">
            <li>1 hour of bowling</li>
            <li>2 hours of party time total</li>
            <li>Shoes &amp; balls</li>
            <li>45-min reserved party space (food, cake, presents)</li>
            <li>$10 arcade game card per child</li>
            <li>Souvenir lunch bag</li>
            <li>Invitations (pickup at the venue)</li>
            <li>Food &amp; beverage choice</li>
            <li>Thank-you cards</li>
            <li>Personal party coordinator</li>
          </ul>
          <a
            class="btn btn-solid birthday-package-cta"
            href={KIDS_BOOKING_URL}
            target="_blank"
            rel="noopener"
          >Book Suite Birthday</a>
        </article>

        <article class="birthday-package-card birthday-package-card--featured">
          <p class="birthday-package-badge">More time, more space</p>
          <h3 class="birthday-package-name">Extra Suite Birthday</h3>
          <p class="birthday-package-price">
            <span class="birthday-package-amount">${EXTRA_SUITE_BIRTHDAY_PRICE}</span>
            <span class="birthday-package-base">up to 10 guests</span>
          </p>
          <p class="birthday-package-meta">$40 per additional guest · 14 guest max</p>
          <ul class="birthday-package-list">
            <li>1 hour of bowling</li>
            <li>2.5 hours of party time total</li>
            <li>Shoes &amp; balls</li>
            <li>1 hour reserved party space (food, drink, presents)</li>
            <li>$10 arcade game card per child</li>
            <li>Souvenir lunch bag</li>
            <li>Invitations (pickup at the venue)</li>
            <li>Food &amp; beverage choice</li>
            <li>Thank-you cards</li>
            <li>Personal party coordinator</li>
          </ul>
          <a
            class="btn btn-solid birthday-package-cta"
            href={KIDS_BOOKING_URL}
            target="_blank"
            rel="noopener"
          >Book Extra Suite Birthday</a>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================
      CLOSING CTA BAND — kids → online booking, adults → their landing page.
      Sits ABOVE the FAQ (per user 2026-06-26) so the booking buttons
      follow the kids’ packages, and the FAQ closes out the
      page as a quiet reference beat before the footer.
      ============================================================ */}
  <section class="birthday-closing" aria-labelledby="birthday-closing-h2">
    <div class="birthday-closing-inner">
      <h2 class="t-display birthday-closing-title" id="birthday-closing-h2">
        Ready when you are.
      </h2>
      <div class="birthday-closing-ctas">
        <a class="btn btn-solid" href={KIDS_BOOKING_URL} target="_blank" rel="noopener">
          Book a kids' party
        </a>
        <a class="btn btn-outline" href={ADULT_BIRTHDAY_URL}>
          Explore adult parties
        </a>
      </div>
    </div>
  </section>

  {/* ============================================================
      FAQ — search-phrased birthday Q&As. Global .t2-faq* accordion;
      emits FAQPage JSON-LD (birthdayFaqs in frontmatter). Closes out
      the page below the booking CTA as a quiet reference beat.
      ============================================================ */}
  <section class="birthday-faq" aria-labelledby="birthday-faq-h2">
    <div class="birthday-faq-inner">
      <p class="t-eyebrow">Questions</p>
      <h2 class="t-display birthday-faq-title" id="birthday-faq-h2">
        Birthday party FAQs.
      </h2>
      <div class="t2-faq">
        {birthdayFaqs.map((item) => (
          <details class="t2-faq-item">
            <summary class="t2-faq-q">
              <h3 class="t2-faq-q-text">{item.q}</h3>
              <svg
                class="t2-faq-chevron"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICON_PATHS["chevron-down"]}
              />
            </summary>
            <div class="t2-faq-a" set:html={item.htmlA} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(partyPackagesSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Birthday Parties", path: "/birthday-parties/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /birthday-parties — same pattern as /bar, /eat,
     /vip-suite. Rule-of-four triggered; next refactor should hoist
     shared rules to .pillar-* utilities in global.css (see
     Context/media-needs.md tech debt).
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .birthday-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 0;
    padding: calc(var(--header-height) + 28px) 22px 24px;
  }
  @media (min-width: 1025px) {
    .birthday-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .birthday-hero-copy {
    width: 100%;
    max-width: 900px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .birthday-hero-copy {
      text-align: center;
    }
    .birthday-hero-sub {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .birthday-hero-headline {
    color: var(--warm-white);
    font-size: clamp(28px, 8vw, 56px);
    letter-spacing: -0.005em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .birthday-hero-headline { font-size: clamp(48px, 5.2vw, 72px); }
  }

  .birthday-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 32em;
  }
  @media (min-width: 1025px) {
    .birthday-hero-sub { margin-top: 22px; font-size: 19px; max-width: 36em; }
  }


  /* The menu's generic Birthdays link lands on two immediate choices. */
  .birthday-choices {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    margin-top: 24px;
    text-align: left;
  }
  .birthday-choice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
    padding: 18px 20px;
    border: 1px solid rgba(78, 236, 196, 0.35);
    border-radius: var(--radius-surface);
    background: rgba(26, 21, 48, 0.55);
    color: var(--warm-white);
    text-decoration: none;
  }
  .birthday-choice:hover,
  .birthday-choice:focus-visible { border-color: var(--glow); }
  .birthday-choice h2 {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.2;
  }
  .birthday-choice p {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.4;
    color: var(--warm-mid);
  }
  .birthday-choice-action {
    margin-top: auto;
    padding-top: 4px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.4;
    color: var(--glow);
  }
  @media (min-width: 680px) {
    .birthday-choices { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1025px) {
    .birthday-choice { padding: 24px; }
    .birthday-choice h2 { font-size: 23px; }
    .birthday-choice p { font-size: 17px; }
    .birthday-choice-action { font-size: 16px; }
  }

  /* ============================================================
     section pattern (mirrors .vip-section)
     ============================================================ */
  .birthday-section {
    background: transparent;
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
