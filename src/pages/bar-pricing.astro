---
/**
 * /bar-pricing — STAFF bar repricing worksheet (noindex, unlinked).
 *
 * Built 2026-08-11 for the GoTab menu rework: Jon works category by category
 * (Vodka → Gin → Rum → Tequila → Whiskey → Liqueurs/Cordials) building POS
 * buttons, and needs one searchable surface with cost, tier, current price and
 * the recommended pour prices side by side.
 *
 * THE PRICES ARE COMPUTED, NOT TYPED. `src/data/bar-pricing.json` is generated by
 * `Alcohol Pricing/gotab-snapshots/build-page-data.mjs`, which applies the
 * 2026-05-14 shot-neat ladder verbatim:
 *     price = (cost/oz x pour oz x category shrinkage) / tier target, rounded to $1
 * The generator self-tests against two published values from that study (Hennessy
 * VSOP neat $23, Remy VSOP neat $19) and refuses to emit if it can't reproduce
 * them. To refresh: re-run the generator and commit the JSON. Never hand-edit the
 * JSON — a typed price silently detaches from the cost that justifies it.
 *
 * 1.25oz is rendered for Gin and Whiskey only, per Jon's spec.
 *
 * ⚠ "Now shot 1oz" and "Now mixed 1.5oz" are the CURRENT POS prices captured in the
 * 2026-08-09 GoTab snapshot. They are a moving target the moment the rework starts —
 * they are context for the first pass, not a live mirror.
 *
 * ⚠ All pour costs here are SPIRIT-ONLY. No mixer, juice, syrup or garnish exists in
 * any recipe (0 of 77 components), so every percentage is understated — and understated
 * MORE for cocktails than for straight pours, because a straight pour has almost no
 * non-spirit build. Do not compare the cocktail % against the pour % and conclude
 * cocktails carry richer margin.
 *
 * Indexability: noindex,nofollow + robots.txt Disallow + sitemap-excluded
 * (astro.config.mjs) + `isStaffPage` in Base.astro (no GA4/Clarity/Meta/Vercel
 * analytics). Orphan by design — nothing links here.
 */
import Base from "../layouts/Base.astro";
import data from "../data/bar-pricing.json";
import basket from "../data/bar-basket.json";

const CORE = ["Vodka", "Gin", "Rum", "Tequila", "Whiskey", "Liqueurs/Cordials"];
const cats = [...new Set(data.spirits.map((s: any) => s.category))];
const coreCats = CORE.filter((c) => cats.includes(c));
const otherCats = cats.filter((c) => !CORE.includes(c)).sort();
const ordered = [...coreCats, ...otherCats];

const groups = ordered.map((c) => ({
  name: c,
  quarter: /^(Gin|Whiskey)$/.test(c),
  rows: data.spirits.filter((s: any) => s.category === c),
}));

// "NEW" badge + top billing for 60 days after addedOn. The site rebuilds daily off the 4am
// cron, so this ages out on its own — same date-gate pattern the seasonal pages use.
const NEW_DAYS = 60;
const today = new Date();
const isNew = (c: any) =>
  c.addedOn && (today.getTime() - new Date(c.addedOn + "T00:00:00Z").getTime()) / 86400000 <= NEW_DAYS;
for (const c of data.cocktails as any[]) c._new = isNew(c);

// New groups float to the top; everything else keeps its order.
const cocktailGroups = [...new Set(data.cocktails.map((c: any) => c.group))].sort((a, b) => {
  const an = data.cocktails.some((c: any) => c.group === a && c._new) ? 0 : 1;
  const bn = data.cocktails.some((c: any) => c.group === b && c._new) ? 0 : 1;
  return an - bn;
});
const money = (n: number | null) => (n == null ? "—" : `$${n}`);
---

<Base
  title="Bar pricing worksheet — Twisted Pin"
  description="Internal: pour cost and recommended pricing by category."
  hideHeader={true}
  hideStickyCTA={true}
  hidePromo={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="bp">
    <header class="bp-head">
      <p class="bp-eyebrow">Twisted Pin · Internal · generated {data.generated}</p>
      <h1>Bar pricing worksheet</h1>
      <p class="bp-lede">
        Every pourable bottle we carry, priced at <strong>1.5oz</strong> and <strong>2oz</strong>
        — plus <strong>1.25oz</strong> for Gin and Whiskey. Recommended prices are computed from
        live bottle cost through the May 2026 ladder; the small grey number under each price is
        the pour cost it lands at.
      </p>
      <div class="bp-note">
        <strong>Spirit-only costs.</strong> No mixer, juice, syrup or garnish exists in any recipe yet,
        so every percentage on this page is understated — and understated more for cocktails than for
        straight pours. Treat the numbers as directional, not to the decimal.
      </div>
    </header>

    <div class="bp-controls">
      <input id="bp-search" type="search" placeholder="Search a spirit or cocktail…" autocomplete="off" />
      <label class="bp-toggle"><input type="checkbox" id="bp-hide-draining" /> Hide discontinued</label>
      <span class="bp-count" id="bp-count"></span>
    </div>

    <nav class="bp-jump">
      {groups.map((g) => <a href={`#cat-${g.name.replace(/\W+/g, "-")}`}>{g.name}</a>)}
      <a href="#basket">Basket</a>
      <a href="#cocktails">Cocktails</a>
      <a href="#requests">Requests</a>
      <a href="#decisions">Decisions</a>
    </nav>

    {groups.map((g) => (
      <section class="bp-cat" id={`cat-${g.name.replace(/\W+/g, "-")}`}>
        <h2>{g.name} <span class="bp-catn">{g.rows.length}</span></h2>
        <div class="bp-scroll">
          <table>
            <thead>
              <tr>
                <th class="l">Spirit</th>
                <th>Tier</th>
                <th class="r">Cost/btl</th>
                <th class="r">Cost/oz</th>
                <th class="r dim">Now shot</th>
                <th class="r dim">Now mixed</th>
                {g.quarter && <th class="r hi">1.25oz</th>}
                <th class="r hi">1.5oz</th>
                <th class="r hi">2oz</th>
                <th class="r">Mixed</th>
                <th class="l">Move</th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map((r: any) => (
                <tr data-name={r.name.toLowerCase()} data-draining={r.draining ? "1" : "0"}>
                  <td class="l">
                    <span class="bp-name">{r.name}</span>
                    {r.draining && <span class="bp-chip drain">draining</span>}
                    {r.tierDisputed && <span class="bp-chip warn" title="the two classification passes disagreed on this tier — see Decisions">tier?</span>}
                    {r.market && <span class="bp-market">{r.market}</span>}
                  </td>
                  <td><span class={`bp-tier t-${r.tier}`}>{r.tier === "superPremium" ? "super" : r.tier}</span></td>{/* luxury = the 2026-08-11 5th tier, cost/oz > $5 */}
                  <td class="r">${r.cost.toFixed(2)}</td>
                  <td class="r">${r.costOz.toFixed(2)}</td>
                  <td class="r dim">{r.nowShot == null ? "—" : `$${r.nowShot.toFixed(2)}`}</td>
                  <td class="r dim">{r.nowMixed == null ? "—" : `$${r.nowMixed.toFixed(2)}`}</td>
                  {g.quarter && (
                    <td class="r hi">{money(r.p125)}<em>{r.pct125 ? `${r.pct125}%` : ""}</em></td>
                  )}
                  <td class="r hi">{money(r.p150)}<em>{r.pct150}%</em></td>
                  <td class="r hi">
                    {money(r.p200)}<em>{r.pct200}%{r.noNeat ? " · no neat" : ""}</em>
                  </td>
                  <td class="r">{money(r.mixed)}</td>
                  <td class={`l move ${/raise/.test(r.move) ? "up" : /new/.test(r.move) ? "new" : ""}`}>{r.move}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section class="bp-cat" id="cocktails">
      <h2>Cocktails <span class="bp-catn">{data.cocktails.filter((c: any) => c.live).length} live</span></h2>
      <p class="bp-sub">
        Recipe coverage is 100% — every sellable cocktail has a recipe. Aggregate spirit-only
        pour cost across the live menu is <strong>14.4%</strong>.
      </p>
      <div class="bp-note" style="max-width:820px;margin-bottom:14px;background:rgba(200,245,96,0.08);border-color:rgba(200,245,96,0.3);">
        <strong>7 new cocktails</strong> sit at the top, badged NEW for {NEW_DAYS} days from
        2026-08-11 (the badge ages out on its own — the site rebuilds daily).
        <br /><br />
        <strong>These are the first recipes we've ever costed with their non-alcoholic half
        included</strong>, because they arrived with full builds. It matters more than expected:
        mixers add <strong>26% on top of spirit cost</strong> across the seven, but the range is
        +9% (Maple Lanes) to <strong>+66% (Lane Violation)</strong>. Priced spirit-only, Lane
        Violation looks like an 8.9% drink; all-in it's 14.8%. That gap is invisible on every
        other cocktail on this page.
        <br /><br />
        Recommended prices hold the existing $12–16 Original Craft band rather than targeting a
        flat 20% — pricing to 20% would have made several new drinks <em>cheaper</em> than their
        peers, since the current menu runs 14.4% aggregate.
      </div>
      <div class="bp-note" style="max-width:820px;margin-bottom:14px;">
        <strong>Three retiring:</strong> Lane Whisperer · Anchor Man · Bowled Fashioned (the
        bacon Old Fashioned — already toggled off in GoTab). Priced below anyway so the
        numbers are there while they sell through.
        <br /><br />
        <strong>⚠ Watch the pisco.</strong> Anchor Man is the <em>only</em> recipe using
        Pisco Caravedo Quebranta, and the other three piscos already have no recipe at all.
        Pisco has <strong>no pour button either</strong> — so when Anchor Man goes, all four
        bottles (~$116) have nowhere to be sold. Junipero Gin and Basil Hayden also lose their
        only recipe, but both sell by the pour, so they're fine.
        <br /><br />
        The order guide runs a <strong>Pisco substitute group</strong> and will keep
        recommending purchases regardless. Either give pisco a home — a pour button or the
        next new cocktail — or add it to <code>DISCONTINUED_SKUS</code> so the guide stops
        asking.
      </div>
      {cocktailGroups.map((grp) => (
        <div class="bp-scroll">
          <h3 class="bp-h3">{grp}</h3>
          <table>
            <thead>
              <tr>
                <th class="l">Cocktail</th>
                <th class="l">Build (spirits only)</th>
                <th class="r">Cost</th>
                <th class="r">Price</th>
                <th class="r hi">Pour %</th>
              </tr>
            </thead>
            <tbody>
              {data.cocktails.filter((c: any) => c.group === grp).map((c: any) => (
                <tr data-name={c.name.toLowerCase()} data-draining="0">
                  <td class="l">
                    <span class="bp-name">{c.name}</span>
                    {c._new && <span class="bp-chip new">NEW</span>}
                    {c.warn && <span class="bp-chip warn">{c.warn}</span>}
                    {c.estimated && (
                      <span class="bp-market">
                        Spirit ${c.spiritCost.toFixed(2)} + mixers ~${c.otherCost.toFixed(2)}
                        (<strong>+{c.upliftPct}%</strong>). Mixer costs are ESTIMATES until the
                        invoices land — the spirit half is real.
                      </span>
                    )}
                  </td>
                  <td class="l dim">{c.build}</td>
                  <td class="r">{c.cost == null ? "—" : `$${c.cost.toFixed(2)}`}</td>
                  <td class="r">{c.price == null ? "off" : `$${c.price}`}</td>
                  <td class={`r hi ${c.pct >= 22 ? "bad" : c.pct != null && c.pct <= 10 ? "low" : ""}`}>
                    {c.pct == null ? "—" : `${c.pct}%`}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>

    <section class="bp-cat" id="basket">
      <h2>The basket <span class="bp-catn">{basket.days} days · {basket.from} → {basket.to}</span></h2>
      <p class="bp-sub">
        Real GoTab sales, weighted by what actually sold. This is the view that matters — no
        single drink needs to hit a target, the <em>blend</em> does. Wins fund drags.
      </p>

      <div class="bp-kpis">
        <div class="bp-kpi">
          <span class="bp-k-n">{basket.weighted}%</span>
          <span class="bp-k-l">volume-weighted cocktail pour cost</span>
          <span class="bp-k-s">{basket.unweighted}% if you average the drinks instead — the mix
            is working <strong>for</strong> you, because the best sellers are the cheapest builds</span>
        </div>
        <div class="bp-kpi">
          <span class="bp-k-n">${basket.totalHeadroom}</span>
          <span class="bp-k-l">headroom vs a 16% target, {basket.days} days</span>
          <span class="bp-k-s">≈ ${basket.totalHeadroomYear.toLocaleString()}/yr of budget the cocktails
            EARN — money available to spend on pours that can't reach 16%</span>
        </div>
        <div class="bp-kpi">
          <span class="bp-k-n">${basket.luxuryFunded.toLocaleString()}</span>
          <span class="bp-k-l">of 25% luxury pour revenue that surplus funds, per {basket.days} days</span>
          <span class="bp-k-s">at $35–50 a pour that's ~1+ luxury pour a day before the blend
            moves — the top shelf is affordable</span>
        </div>
      </div>

      <div class="bp-note" style="max-width:820px;margin:14px 0;">
        <strong>The drags are not worth chasing.</strong> All three cocktails over 20% —
        Perfect 300 Paloma, Twisted Aperol Spritz, Another League Negroni — cost a combined
        <strong>$42 against a 16% benchmark over {basket.days} days</strong>. That is noise.
        Percentage flags them; dollars say ignore them.
        <br /><br />
        <strong>Seasonals are the margin engine, not a novelty.</strong> They're
        <strong>39% of all cocktail gross profit</strong> — the top three gross-profit drinks are
        all seasonal, all under 12.5%. Rotating them is a pricing lever.
        <br /><br />
        <strong>Pour buttons are costed now too.</strong> They run {basket.pourWeighted}% on
        ${basket.pourRevMatched.toLocaleString()} of matched revenue — close to neutral against a
        16% target, so <em>the cocktails are doing the winning</em>. Only ${basket.pourUnmatchedRev}
        of option revenue couldn't be matched to a bottle.
        <br /><br />
        <strong>The agave premiums are the one real drag, and they're small.</strong> Don Julio,
        Patrón, Herradura and Casamigos pours total ${basket.agaveRev.toLocaleString()} at 21–22%,
        costing <strong>${basket.agaveDrag} against a 16% benchmark over {basket.days} days</strong>.
        Worth pricing deliberately; not worth losing sleep over.
        <br /><br />
        ⚠ <strong>{basket.structureNote}</strong>
      </div>

      <h3 class="bp-h3">Ranked by gross profit dollars, not percentage</h3>
      <div class="bp-scroll">
        <table>
          <thead>
            <tr><th class="l">Drink</th><th class="r">Units</th><th class="r">Revenue</th>
              <th class="r">Pour %</th><th class="r hi">Gross $</th><th class="r">vs a 16% drink</th></tr>
          </thead>
          <tbody>
            {basket.rows.map((r: any) => (
              <tr data-name={r.name.toLowerCase()} data-draining="0">
                <td class="l">
                  <span class="bp-name">{r.name}</span>
                  {r.seasonal && <span class="bp-chip drain">seasonal</span>}
                </td>
                <td class="r">{r.qty}</td>
                <td class="r">${r.rev.toLocaleString()}</td>
                <td class={`r ${r.pct > 20 ? "dim" : ""}`}>{r.pct}%</td>
                <td class="r hi">${r.gross.toLocaleString()}</td>
                <td class={`r ${r.vs16 >= 0 ? "" : "dim"}`}>{r.vs16 >= 0 ? `+$${r.vs16}` : `−$${Math.abs(r.vs16)}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bp-cat" id="requests">
      <h2>Button requests <span class="bp-catn">from staff</span></h2>
      <p class="bp-sub">
        Parked here so they don't get lost while the rework is happening — both are button
        work, not pricing-ladder work.
      </p>
      <ul class="bp-list">
        <li>
          <strong>Grenadine button</strong> — staff report guests adding it to Pepsi.
          <br />There was <strong>no grenadine SKU at all</strong> (same blind spot agave syrup
          and bitters had before they were added), so it was invisible to every count and every
          report. Created 2026-08-11 as a stock-count mixer; <strong>needs a cost and a brand
          on the next invoice.</strong>
          <br />The natural home is the existing <code>Bar Mods</code> group, which already
          carries Purée / Bloody / Ginger Beer / Margarita / Red Bull at a flat +$2.00 —
          though $2 on a fountain soda is worth a second thought.
        </li>
        <li>
          <strong>Shirley Temple pitcher.</strong> The product is
          <code>Hand Crafted Shirley Temple</code>, base $0.00 with a <em>required</em> Size
          group — Small $4.95 / Large $5.95. A pitcher is a third option in that group, and it
          has to be added on <strong>all three live menus</strong> (Drinks, Liquors, Mocktails).
          <br />⚠ <strong>Don't price it off the existing curve.</strong> Small → Large is only
          +$1 for a meaningful volume step; extending that logic to a pitcher would badly
          underprice it. Price the pitcher off pour volume, not off the Large.
          <br />Note this is one of the 29 zero-base products where all the money lives in the
          options — and modifier groups are the part of GoTab the API cannot reach, so this is
          manual keying either way.
        </li>
      </ul>
    </section>

    <section class="bp-cat" id="decisions">
      <h2>Decisions for you</h2>

      <h3 class="bp-h3">Tier calls the two passes disagreed on ({data.disagreements.length})</h3>
      <p class="bp-sub">
        Two independent classification passes ran — one on brand positioning, one on cost bands.
        These are where they differed. The table above uses the positioning call; changing a tier
        here changes every price for that bottle.
      </p>
      <div class="bp-scroll">
        <table>
          <thead>
            <tr><th class="l">Spirit</th><th>Positioning</th><th>Cost band</th><th class="l">Recommendation</th><th class="l">What it's worth</th></tr>
          </thead>
          <tbody>
            {data.disagreements.map((d: any) => (
              <tr data-name={d.sku_name.toLowerCase()} data-draining="0">
                <td class="l"><span class="bp-name">{d.sku_name}</span></td>
                <td><span class="bp-tier">{d.positioning_tier}</span></td>
                <td><span class="bp-tier">{d.costband_tier}</span></td>
                <td class="l">{d.recommendation}</td>
                <td class="l dim">{d.why_it_matters}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {data.uncosted.length > 0 && (
        <>
          <h3 class="bp-h3">Can't be priced — no cost on file</h3>
          <ul class="bp-list">
            {data.uncosted.map((u: any) => (
              <li><strong>{u.name}</strong> ({u.category}, {u.tier}) — needs {u.missing}</li>
            ))}
          </ul>
        </>
      )}

      <h3 class="bp-h3">Open questions</h3>
      <ul class="bp-list">
        {data.openQuestions.map((q: string) => <li>{q}</li>)}
      </ul>
    </section>

    <footer class="bp-foot">
      <p>
        Method: <code>{data.method}</code>
      </p>
      <p>
        Tier targets — well {data.targets.well}% · call {data.targets.call}% ·
        premium {data.targets.premium}% · super-premium {data.targets.superPremium}% ·
        <strong>luxury {data.targets.luxury}%</strong> · flavored {data.targets.flavored}%.
        A lower target means a higher price.
      </p>
      <p>
        <strong>Luxury</strong> is a 2026-08-11 addition to the May ladder, for the four bottles
        above $5/oz. It isn't an arbitrary knob: the next bottle down costs $2.81/oz — a $2.64
        gap — and a 25% target independently reproduces the live market comps to within $10
        across eight price points, where 22% was $52 off.
      </p>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById("bp-search");
      var hide = document.getElementById("bp-hide-draining");
      var count = document.getElementById("bp-count");
      var rows = Array.prototype.slice.call(document.querySelectorAll("tbody tr[data-name]"));

      function apply() {
        var term = (q.value || "").trim().toLowerCase();
        var hideDrain = hide.checked;
        var shown = 0;
        rows.forEach(function (r) {
          var okTerm = !term || r.getAttribute("data-name").indexOf(term) !== -1;
          var okDrain = !hideDrain || r.getAttribute("data-draining") === "0";
          var on = okTerm && okDrain;
          r.style.display = on ? "" : "none";
          if (on) shown++;
        });
        // hide a whole section when its table has nothing left
        document.querySelectorAll(".bp-cat").forEach(function (sec) {
          var any = sec.querySelectorAll("tbody tr[data-name]:not([style*='none'])").length;
          var hasTables = sec.querySelectorAll("tbody tr[data-name]").length > 0;
          sec.style.display = hasTables && any === 0 ? "none" : "";
        });
        count.textContent = term || hideDrain ? shown + " showing" : "";
      }

      q.addEventListener("input", apply);
      hide.addEventListener("change", apply);
    })();
  </script>

  <style>
    .bp {
      --ink: #0e0a1f;
      --paper: #14102a;
      --line: rgba(255, 255, 255, 0.1);
      --text: #f4f1ea;
      --muted: rgba(244, 241, 234, 0.55);
      --glow: #c8f560;
      --warn: #f0b429;
      --bad: #ef7d5a;
      background: var(--ink);
      color: var(--text);
      min-height: 100vh;
      padding: 24px 16px 80px;
      font-family: Montserrat, system-ui, sans-serif;
    }
    .bp-head { max-width: 780px; margin: 0 auto 24px; }
    .bp-eyebrow {
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--muted); margin: 0 0 8px;
    }
    .bp h1 { font-size: clamp(28px, 6vw, 42px); margin: 0 0 12px; line-height: 1.05; }
    .bp-lede { font-size: 15px; line-height: 1.6; color: rgba(244,241,234,0.85); margin: 0 0 14px; }
    .bp-note {
      font-size: 13px; line-height: 1.55; padding: 10px 12px; border-radius: 7px;
      background: rgba(240, 180, 41, 0.08); border: 1px solid rgba(240, 180, 41, 0.28);
    }
    .bp-controls {
      position: sticky; top: 0; z-index: 5; max-width: 1200px; margin: 0 auto 12px;
      display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
      padding: 10px 0; background: var(--ink);
    }
    #bp-search {
      flex: 1 1 260px; min-width: 200px; font-size: 16px; padding: 10px 12px;
      border-radius: 7px; border: 1px solid var(--line); background: var(--paper); color: var(--text);
    }
    #bp-search:focus { outline: 2px solid var(--glow); outline-offset: 1px; }
    .bp-toggle { font-size: 13px; color: var(--muted); display: flex; gap: 6px; align-items: center; }
    .bp-count { font-size: 12px; color: var(--glow); }
    .bp-jump {
      max-width: 1200px; margin: 0 auto 28px; display: flex; gap: 8px; flex-wrap: wrap;
    }
    .bp-jump a {
      font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 6px 10px; border-radius: 7px; border: 1px solid var(--line);
      color: var(--text); text-decoration: none;
    }
    .bp-jump a:hover { border-color: var(--glow); color: var(--glow); }
    .bp-cat { max-width: 1200px; margin: 0 auto 40px; }
    .bp-kpis { display: flex; gap: 12px; flex-wrap: wrap; margin: 14px 0; }
    .bp-kpi {
      flex: 1 1 260px; padding: 14px 16px; border-radius: 9px;
      background: var(--paper); border: 1px solid var(--line);
