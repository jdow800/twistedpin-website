---
/**
 * Corporate planners: team outings, employee appreciation and company parties.
 * 2026-09-14: existing suite video now follows the shorter hero. Paid-search
 * use cases remain in compact cards; regional copy is consolidated by the room.
 * The first AVIF poster is eager/preloaded; the catering video stays deferred.
 * Videos are visual reuses of the canonical /vip-suite and /events entries;
 * do not emit duplicate VideoObject markup here (see src/data/videos.ts).
 * Release and Bing diagnosis: Context/session-handoffs/2026-09-14-corporate-regional-bing.md.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, BUSINESS_ENTITY_ID, PLACE_ID, STREET, LOCALITY } from "../lib/schema";
import { ICON_PATHS } from "../lib/icons";
import { PLAN_EVENT_URL } from "../lib/links";

const PAGE_URL = BUSINESS_URL + "/corporate-events/";
const MAPS_DIR_HREF = "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent(STREET + ", " + LOCALITY) + "&destination_place_id=" + PLACE_ID;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": BUSINESS_URL + "/#corporate-events",
  name: "Corporate Events & Team Outings",
  url: PAGE_URL,
  description:
    "Team outings, staff appreciation, holiday parties and corporate offsites at Twisted Pin in Plainfield, IL. A semi-private 6-lane VIP suite for up to 80, full-venue buyouts for up to 200, in-house catering and craft cocktails. Serving groups from Romeoville, Shorewood, Naperville, Joliet, Bolingbrook and the surrounding area.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  serviceType: "Corporate event & team outing hosting",
  areaServed: [
    "Plainfield, IL", "Romeoville, IL", "Shorewood, IL", "Naperville, IL",
    "Joliet, IL", "Bolingbrook, IL", "Oswego, IL", "Lockport, IL",
  ].map((name) => ({ "@type": "City", name })),
};

const useCases = [
  {
    title: "Team and staff outings, done right.",
    body: "Your own lanes, friendly competition, and time to catch up over food and drinks.",
  },
  {
    title: "Employee appreciation they’ll remember.",
    body: "Give the team a reason to clear the calendar. Bowling, cocktails, and catering take care of the celebration.",
  },
  {
    title: "Team building, minus the cringe.",
    body: "No trust falls. Bring people together over bowling and a little friendly competition.",
  },
  {
    title: "Company holiday parties, handled.",
    body: "Celebrate the year in the suite, or bring everyone for a full-venue buyout.",
    href: "/holiday-parties/", link: "Holiday parties →",
  },
  {
    title: "Meetings and luncheons, with room to play.",
    body: "AV hookups and in-house catering for the presentation and lunch. Add bowling when the meeting wraps.",
  },
  {
    title: "Fundraiser nights that give back.",
    body: "Bring your workplace together for a cause. Explore our bowling fundraiser program.",
    href: "/fundraisers/", link: "Fundraisers →",
  },
];

// Visible HTML and FAQ schema share the same answers. Accordions keep the
// planning details accessible without another long block of mobile copy.
const corpFaqs = [
  {
    q: "How many people can you host for a company event?",
    answer: "Corporate groups generally start around 10. The semi-private 6-lane VIP suite accommodates up to 80, and full-venue buyouts accommodate up to 200. Tell us your headcount and we’ll help match the space to your event.",
  },
  {
    q: "What is the VIP suite like?",
    answer: "The suite has six bowling lanes set apart from the traditional lanes by a wall, couch seating around the lanes, and an LED video wall with AV hookups. In-house catering, craft cocktails and the 28-tap self-serve beer and wine wall are available for your outing.",
  },
  {
    q: "Can we include a meeting or presentation?",
    answer: "Yes. The suite has an LED video wall and AV hookups for presentations, company updates or a highlight reel. Share your presentation and equipment needs when planning so we can confirm the setup before your event.",
  },
  {
    q: "Can you cater a company party or luncheon?",
    answer: "Yes. In-house catering is available for team outings, company parties and luncheons. Ask about menu choices and dietary needs when planning your event so we can confirm the right options for your group.",
  },
  {
    q: "What are the bar options for a corporate group?",
    answer: "Ask about a bar tab or drink tickets for your group. The venue offers a 28-tap self-serve beer and wine wall and a cocktail program curated by Brian Van Flandern, America’s Top Mixologist.",
  },
  {
    q: "How do I plan a team outing or employee-appreciation event?",
    answer: "Start with your preferred date, approximate headcount and the occasion. Our event team will help you plan the space, bowling, catering and drinks for your group.",
  },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: corpFaqs.map((f) => ({
    "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---
<Base
  title="Corporate Events & Team Outings in Plainfield, IL | Twisted Pin"
  description="Corporate events and team outings in Plainfield, IL. Six-lane VIP suite for up to 80, catering, cocktails and full-venue buyouts for up to 200."
  ogImage="/og/og-events.jpg"
  ogImageAlt="A corporate team outing in the 6-lane VIP suite at Twisted Pin in Plainfield, IL"
  lcpPreloadHref="/snap/vip-lanes-poster.avif"
>
  <section class="corp-hero" data-hero aria-labelledby="corp-hero-h1">
    <div class="corp-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Team Outings · Corporate Events</p>
      <h1 class="t-display corp-hero-headline hero-fade" id="corp-hero-h1" data-delay-ms="120">
        Not your average team&nbsp;outing.
      </h1>
      <p class="corp-hero-sub hero-fade" data-delay-ms="320">
        Staff outings, employee appreciation, and holiday parties in
        Plainfield, IL. Bowling, craft cocktails, and catering, all in one place.
      </p>
    </div>
  </section>

  {/* The existing suite video is the first proof after the hero. */}
  <section class="corp-section" aria-labelledby="corp-room-h2">
    <div class="corp-section-grid">
      <div class="corp-section-frame">
        <video class="corp-section-video" data-section-video preload="none"
          muted loop playsinline poster="/snap/vip-lanes-poster.avif"
          aria-label="The 6-lane VIP suite at Twisted Pin, with semi-private bowling lanes and an LED video wall, set up for a group event">
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-av1-540.mp4" type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/vip-lanes-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-av1-1080.mp4" type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/vip-lanes-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="corp-section-copy">
        <p class="t-eyebrow">The Room</p>
        <h2 class="t-display corp-section-title" id="corp-room-h2">Six lanes. One team.</h2>
        <p class="corp-section-body">
          Take over the <a href="/vip-suite/">6-lane VIP suite</a> for your
          next outing. Set apart from the traditional lanes by a wall,
          this semi-private space gives your group room to bowl, watch, and catch up.
        </p>
        <ul class="corp-section-list">
          <li>Up to 80 in the suite; up to 200 for full-venue buyouts</li>
          <li>LED video wall and AV hookups for presentations</li>
          <li>Couch seating around the lanes</li>
        </ul>
        <p class="corp-section-body">
          Planning a company outing from <a href="/why-us/romeoville-il/">Romeoville</a>,
          <a href="/why-us/shorewood-il/">Shorewood</a>,
          <a href="/why-us/naperville-il/">Naperville</a>,
          <a href="/why-us/joliet-il/">Joliet</a>, or
          <a href="/why-us/bolingbrook-il/">Bolingbrook</a>?
          Bring your team together at Twisted Pin in Plainfield.
          Find us at {STREET}, with free on-site parking.
        </p>
        <p class="corp-section-body">
          <a href={MAPS_DIR_HREF} target="_blank" rel="noopener">Get directions to Twisted Pin →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="corp-usecases" aria-labelledby="corp-uc-h2">
    <div class="corp-uc-head">
      <p class="t-eyebrow">What you’re planning</p>
      <h2 class="t-display corp-uc-title" id="corp-uc-h2">Give the team something to look forward to.</h2>
    </div>
    <ul class="corp-uc-grid">
      {useCases.map((item, index) => (
        <li class:list={["corp-uc-card", { "corp-uc-card--lead": index === 0 }]}>
          <h3 class="corp-uc-headline">{item.title}</h3>
          <p class="corp-uc-body">{item.body}</p>
          {item.href && <a class="corp-uc-link" href={item.href}>{item.link}</a>}
        </li>
      ))}
    </ul>
    <p class="corp-uc-more">
      Planning something else? We also host <a href="/showers/">showers</a>,
      <a href="/wedding-receptions/">wedding receptions</a>, and
      <a href="/events/">other group events</a>.
    </p>
  </section>

  {/* Catering footage stays deferred below the suite and use cases. */}
  <section class="corp-section corp-section--reverse" aria-labelledby="corp-food-h2">
    <div class="corp-section-grid">
      <div class="corp-section-frame">
        <video class="corp-section-video" data-section-video preload="none"
          muted loop playsinline data-poster="/snap/buffet-poster.avif"
          aria-label="Catering set out for a group event at Twisted Pin">
          <source media="(max-width: 480px)" data-src="/snap/buffet-mobile-av1-540.mp4" type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(max-width: 480px)" data-src="/snap/buffet-mobile-h264-540.mp4" type="video/mp4" />
          <source media="(min-width: 481px)" data-src="/snap/buffet-mobile-av1-1080.mp4" type="video/mp4; codecs=av01.0.05M.08" />
          <source media="(min-width: 481px)" data-src="/snap/buffet-mobile-h264-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="corp-section-copy">
        <p class="t-eyebrow">The Food &amp; Bar</p>
        <h2 class="t-display corp-section-title" id="corp-food-h2">The kitchen and the bar handle the rest.</h2>
        <p class="corp-section-body">
          <a href="/eat/">In-house catering</a>, scaled to your group.
          Tell us what you’re planning and ask about menu choices and
          dietary needs before the event.
        </p>
        <p class="corp-section-body">
          Add the <a href="/menu/taps/">28-tap self-serve beer &amp; wine wall</a>
          and <a href="/menu/cocktails/">craft cocktails</a> from the program
          curated by Brian Van Flandern, <em>America’s Top Mixologist</em>.
          Ask about a bar tab or drink tickets for your group.
        </p>
      </div>
    </div>
  </section>

  <section class="corp-faq" aria-labelledby="corp-faq-h2">
    <div class="corp-faq-inner">
      <p class="t-eyebrow">Questions</p>
      <h2 class="t-display corp-faq-title" id="corp-faq-h2">Corporate event FAQs.</h2>
      <div class="t2-faq">
        {corpFaqs.map((item) => (
          <details class="t2-faq-item">
            <summary class="t2-faq-q">
              <h3 class="t2-faq-q-text">{item.q}</h3>
              <svg class="t2-faq-chevron" viewBox="0 0 24 24" width="18" height="18"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true" set:html={ICON_PATHS["chevron-down"]} />
            </summary>
            <div class="t2-faq-a"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="corp-cta" aria-labelledby="corp-cta-h2">
    <div class="corp-cta-inner">
      <p class="t-eyebrow">Tell us what you need</p>
      <h2 class="t-display corp-cta-title" id="corp-cta-h2">We’ll set it up.</h2>
      <p class="corp-cta-body">
        Your date, your headcount, your occasion. We’ll help plan the
        space, bowling, catering, and drinks for your team.
      </p>
      <a class="btn btn-solid corp-cta-btn" href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event</a>
    </div>
  </section>
  <SnapFooter />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" }, { name: "Events", path: "/events/" },
    { name: "Corporate Events", path: "/corporate-events/" },
  ]} />
</Base>

<style>
  /* ============================================================
     /corporate-events — same pillar skeleton as /events /vip-suite
     /fundraisers. Class names .corp-* mirror .events-* / .vip-* /
     .fundraiser-* — rule of nine, .pillar-* CSS hoist deeply overdue.
     Numbers match /events.astro byte-for-byte where applicable so
     the family reads cohesive across pages.
     ============================================================ */

  /* ---------- hero (typography-led, no image) ---------- */
  .corp-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 0;
    padding: calc(var(--header-height) + 24px) 22px 28px;
  }
  @media (min-width: 1025px) {
    .corp-hero {
      min-height: clamp(440px, 55vh, 640px);
      padding: calc(var(--header-height) + 64px) 64px 64px;
      justify-content: center;
    }
  }

  .corp-hero-copy {
    max-width: 760px;
    color: var(--warm-white);
  }
  @media (min-width: 1025px) {
    .corp-hero-copy { text-align: center; }
    .corp-hero-sub { margin-left: auto; margin-right: auto; }
  }

  .corp-hero-headline {
    color: var(--warm-white);
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin-top: 12px;
  }
  @media (min-width: 1025px) {
    .corp-hero-headline { font-size: clamp(56px, 6vw, 88px); }
  }

  .corp-hero-sub {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: #ece6d6;
    max-width: 34em;
  }
  @media (min-width: 1025px) {
    .corp-hero-sub { margin-top: 22px; font-size: 19px; max-width: 38em; }
  }

  /* ============================================================
     USE-CASE GRID — compact, descriptive cards matching paid-search intent.
     ============================================================ */
  .corp-usecases {
    background: transparent;
    padding: 24px 22px 8px;
  }
  @media (min-width: 1025px) {
    .corp-usecases { padding: 48px 64px 16px; }
  }

  .corp-uc-head {
    max-width: 1100px;
    margin: 0 auto 24px;
  }
  @media (min-width: 1025px) {
    .corp-uc-head { text-align: center; margin-bottom: 36px; }
  }

  .corp-uc-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 40px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .corp-uc-title { font-size: clamp(38px, 3.8vw, 50px); }
  }

  .corp-uc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 680px) {
    .corp-uc-grid { grid-template-columns: 1fr 1fr; gap: 18px; }
  }
  @media (min-width: 1025px) {
    .corp-uc-grid { grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
  }

  .corp-uc-card {
    position: relative;
    border: 1px solid rgba(244, 239, 227, 0.10);
    border-radius: var(--radius-surface);
    background: rgba(26, 21, 48, 0.45);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
  }

  /* Lead card — team and staff outings. Glow border + faint glow wash.
     rgba is var(--glow) #4EECC4 = rgb(78,236,196) at reduced alpha. */
  .corp-uc-card--lead {
    border-color: rgba(78, 236, 196, 0.55);
    background: rgba(26, 21, 48, 0.62);
  }

  .corp-uc-headline {
    color: var(--warm-white);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(20px, 5.4vw, 24px);
    line-height: 1.02;
    letter-spacing: -0.005em;
    margin-top: 0;
  }
  /* Desktop monitors are mostly 1x DPI, where the Black-condensed (900) display
     font goes soft at this small, sentence-case card size — high-DPI phones mask
     it (that's why it reads fine on mobile, blurry on desktop). On desktop only,
     step the card titles down to Montserrat 700: already loaded (no perf cost)
     and crisp at 1x. Mobile keeps the condensed look; the big section header
     stays display-condensed where the weight earns it. */
  @media (min-width: 1025px) {
    .corp-uc-headline {
      font-family: var(--font-ui);
      font-weight: 700;
      font-size: 23px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
  }

  .corp-uc-body {
    margin-top: 12px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--warm-mid);
  }

  .corp-uc-link {
    margin-top: 14px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--warm-white);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .corp-uc-link:hover { color: var(--glow); }

  .corp-uc-more {
    max-width: 1100px;
    margin: 28px auto 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--warm-mid);
    text-align: center;
  }
  .corp-uc-more a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 200ms ease;
  }
  .corp-uc-more a:hover { text-decoration-color: var(--glow); }

  /* ============================================================
     section pattern (same shape as .events-section etc.)
     ============================================================ */
  .corp-section {
    background: transparent;
    padding: 5px 22px;
  }
  @media (min-width: 1025px) {
    .corp-section { padding: 24px 64px; }
  }

  .corp-section-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
  }
  @media (min-width: 1025px) {
    .corp-section-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 64px;
    }
    .corp-section--reverse .corp-section-grid > .corp-section-frame {
      order: 2;
    }
  }

  .corp-section-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 1025px) {
    .corp-section-frame { aspect-ratio: 3 / 4; max-height: 640px; }
  }

  .corp-section-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .corp-section-copy {
    color: var(--warm-white);
    max-width: 36em;
  }

  .corp-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7.5vw, 42px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .corp-section-title { font-size: clamp(40px, 4.2vw, 56px); }
  }

  .corp-section-aside {
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--warm-dim);
  }
  @media (min-width: 1025px) {
    .corp-section-aside { font-size: 17px; }
  }

  .corp-section-body {
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-mid);
  }
  @media (min-width: 1025px) {
    .corp-section-body { font-size: 17.5px; line-height: 1.65; }
  }

  .corp-section-body strong {
    color: var(--warm-white);
    font-weight: 700;
  }

  .corp-section-body a {
    color: var(--warm-white);
    text-decoration: underline;
    text-decoration-color: rgba(244, 239, 227, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 200ms ease;
  }
  .corp-section-body a:hover {
    text-decoration-color: var(--glow);
  }

  .corp-section-list {
    margin-top: 22px;
    padding-left: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--warm-white);
  }
  .corp-section-list li {
    padding: 8px 0 8px 22px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.08);
    position: relative;
  }
  .corp-section-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--glow);
    opacity: 0.85;
  }

  /* ============================================================
     FAQ — reuses the global .t2-faq* accordion (see global.css);
     only the section wrapper + heading are page-local.
     ============================================================ */
  .corp-faq {
    background: transparent;
    padding: 48px 22px 8px;
  }
  @media (min-width: 1025px) {
    .corp-faq { padding: 72px 64px 24px; }
  }

  .corp-faq-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .corp-faq-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7vw, 40px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin-top: 10px;
  }
  @media (min-width: 1025px) {
    .corp-faq-title { font-size: clamp(36px, 3.6vw, 48px); }
  }

  .corp-faq .t2-faq { margin-top: 20px; }

  /* ============================================================
     CLOSING CTA BAND — matches /events .events-cta numbers.
     ============================================================ */
  .corp-cta {
    background: rgba(26, 21, 48, 0.92);
    border-top: 1px solid rgba(244, 239, 227, 0.06);
    padding: 72px 22px 88px;
    margin-top: 32px;
  }
  @media (min-width: 1025px) {
    .corp-cta { padding: 112px 64px 128px; margin-top: 48px; }
  }

  .corp-cta-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    color: var(--warm-white);
  }

  .corp-cta-title {
    color: var(--warm-white);
    font-size: clamp(36px, 9vw, 56px);
