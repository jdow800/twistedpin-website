---
/**
 * /leagues — Bowling leagues page.
 *
 * Tier-2 utility page. The league schedule changes seasonally (typically
 * 2-4 turns per year). Hardcoded in this page rather than a content
 * collection — leagues run mostly the same lineup year over year, the
 * only thing that turns is dates and times. PR per season is cheaper
 * than a markdown collection for this volume.
 *
 * Voice rules applied (per Context/voice.md):
 *   - "FUN" caps register dropped (shouty)
 *   - "FREE Beer Wall Cards Each Week!" → "Tap wall cards included"
 *     (banned discount/value framing → entitlement framing)
 *   - "Score big" / "fun and competitive leagues" — generic register
 *     dropped in favor of specifics
 *   - "scratch leagues" — venue does NOT run these; removed entirely
 *
 * Service area kept verbatim from live page intro: "Plainfield,
 * Joliet, Romeoville, Naperville, Shorewood, Lockport, Crest Hill
 * and beyond" — this Will County coverage is SEO-relevant per
 * Context/seo.md (Naperville is the #1 paid market, near-zero
 * organic presence to capture).
 *
 * 2026-27 season (Tuesday dates confirmed by Jon 2026-08-06, was TBD;
 * season ends supplied 2026-08-09):
 *   Monday IBT           meeting Aug 31 6:30pm · Sept 14 – Apr 5 2027 · practice 6:15pm
 *   Tuesday Night Mixed  meeting Sept 8 6:30pm · Sept 15 – Apr 6 2027 · practice 6:45pm
 * Both run 30 sessions. The season is only surfaced in structured data
 * (the cards show meeting / start / practice / fee, not the end date).
 *
 * Weekly fee (Jon 2026-08-07): ~$23 per person, both leagues. Deliberately
 * framed as an ESTIMATE — the tilde and the "Estimated" label are load-
 * bearing, because the exact figure is set by the league secretary and
 * varies with team size and USBC sanction timing. Do NOT promote it to an
 * exact price, and do NOT add it to the Service schema as an Offer: a
 * structured-data price is a firm commitment, and Google flags a mismatch
 * between marked-up price and what a bowler is actually told at the desk.
 *
 * TODOs (non-blocking):
 *   - IN-SEASON UPDATE ~Sep 15: once both seasons are underway the
 *     cards' "Organizational meeting / Season starts / Space still
 *     available" lines read as past events — reframe to
 *     mid-season-entry or next-season framing (flagged 2026-08-01).
 *     Both leagues are running by Sept 15, so that is the trigger.
 *
 * League interest form added 2026-08-01 (Jon): name/email + structured
 * solo-vs-team + preferred-night selects + message box, POSTing to
 * /api/league-interest → Resend email to contactus@ (reply-to the
 * submitter). Sits above the Pro Shop so league intent converts before
 * the gear content.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, BUSINESS_ENTITY_ID, eventSchema } from "../lib/schema";

// JSON-LD: Service offered by the venue. Same shape as /fundraisers —
// provider links the program to the canonical entity. No specific
// SportsEvent schema since league dates / formats turn seasonally and
// the program-as-service is what's stable. areaServed names the Will
// County coverage that the body copy claims.
const PAGE_URL = `${BUSINESS_URL}/leagues/`;
const leaguesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${BUSINESS_URL}/#leagues-program`,
  name: "Bowling Leagues",
  url: PAGE_URL,
  description:
    "USBC-sanctioned mixed bowling leagues at Twisted Pin: Monday IBT (5-person) and Tuesday Night Mixed (4-person). Open to bowlers from Plainfield, Joliet, Romeoville, Naperville, Shorewood, Lockport, Crest Hill, and surrounding Will County.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  serviceType: "Bowling league",
  areaServed: {
    "@type": "Place",
    name: "Will County, IL",
  },
};

/**
 * Fall 2026 league Event JSON-LD.
 *
 * Flagged as a want in the 2026-05-08 SEO pass and blocked ever since
 * on "need Tuesday Night Mixed dates + season end". Tuesday's dates
 * landed 2026-08-06, which unblocks the half that matters most right
 * now: the organizational meetings. Those are real, dated, attendable
 * events AND the current conversion action (the homepage promo bar is
 * running "Leagues Now Forming!"), so they are marked up in full.
 *
 * ADDITIVE to the Service schema above, not a replacement. Service
 * describes the standing program — the thing that is stable across
 * seasons, which is why it was chosen originally. These describe this
 * season's dated instances. Both belong on the page.
 *
 * Season end dates supplied by Jon 2026-08-09 as an estimate, but they
 * hold up: each lands on its own league weekday and yields exactly 30
 * sessions, which is a standard league length. If the real last night
 * moves, edit `seasonEnd` — nothing else derives from it.
 *
 * TIMEZONE, the subtle part. Two different mechanisms, on purpose:
 *   - The MEETING and season `startDate` carry an explicit -05:00.
 *     Aug 31 / Sept 8 / Sept 14 2026 all fall inside US DST, and a bare
 *     local time is read as UTC — which would advertise a 6:30pm
 *     meeting as 1:30pm Central.
 *   - The recurring schedule uses a BARE `startTime` plus
 *     `scheduleTimezone`. This season crosses two DST boundaries
 *     (CDT -> CST on Nov 1 2026, back to CDT on Mar 14 2027), so any
 *     fixed offset would misreport league night by an hour for the
 *     whole Nov-Mar stretch. `scheduleTimezone` resolves each
 *     occurrence in local time, which is the entire reason it exists.
 *     Do NOT "fix" that startTime by adding an offset to it.
 */
const FALL_2026_LEAGUES = [
  {
    key: "monday-ibt",
    league: "Monday IBT",
    format: "5-person mixed league, USBC sanctioned",
    meetingStart: "2026-08-31T18:30:00-05:00",
    seasonStart: "2026-09-14",
    seasonEnd: "2027-04-05",
    practiceTime: "18:15",
    byDay: "https://schema.org/Monday",
  },
  {
    key: "tuesday-night-mixed",
    league: "Tuesday Night Mixed",
    format: "4-person teams, USBC sanctioned",
    meetingStart: "2026-09-08T18:30:00-05:00",
    seasonStart: "2026-09-15",
    seasonEnd: "2027-04-06",
    practiceTime: "18:45",
    byDay: "https://schema.org/Tuesday",
  },
];

// Build-time date gate — same mechanic as promos.ts / nav-seasonal.ts,
// and it works for the same reason: the 4am cron rebuilds daily, so a
// meeting drops out of the markup the morning after it happens instead
// of advertising a past event until someone pushes code. ISO strings
// compare lexicographically, so a plain >= is correct here.
const TODAY = new Date().toISOString().slice(0, 10);
const upcomingMeetings = FALL_2026_LEAGUES.filter(
  (l) => l.meetingStart.slice(0, 10) >= TODAY,
);

const leagueEvents: Record<string, unknown>[] = [
  ...upcomingMeetings.map((l) => ({
    ...eventSchema({
      name: `${l.league} Bowling League — Organizational Meeting`,
      start: l.meetingStart,
      url: PAGE_URL,
      description: `Organizational meeting for the ${l.league} bowling league at Twisted Pin — ${l.format}. Bowlers are welcome solo, as a partial team, or as a full team.`,
    }),
    "@id": `${BUSINESS_URL}/#${l.key}-meeting-fall-2026`,
  })),
  // Season events drop out the day after their own last night, same
  // build-time gate as the meetings above.
  ...FALL_2026_LEAGUES.filter((l) => l.seasonEnd >= TODAY).map((l) => ({
    ...eventSchema({
      name: `${l.league} Bowling League — 2026-27 Season`,
      start: `${l.seasonStart}T${l.practiceTime}:00-05:00`,
      end: l.seasonEnd,
      url: PAGE_URL,
      description: `${l.format}. Bowls weekly at Twisted Pin through ${l.seasonEnd}, practice at ${l.practiceTime}.`,
    }),
    "@id": `${BUSINESS_URL}/#${l.key}-season-2026-27`,
    eventSchedule: {
      "@type": "Schedule",
      byDay: l.byDay,
      // Bare local time — resolved by scheduleTimezone below, NOT by an
      // offset. See the timezone note above: this season crosses two
      // DST boundaries.
      startTime: l.practiceTime,
      repeatFrequency: "P1W",
      startDate: l.seasonStart,
      endDate: l.seasonEnd,
      scheduleTimezone: "America/Chicago",
    },
  })),
];

// Null (not an empty ItemList) once every meeting AND both seasons
// have passed — i.e. from 2027-04-07 until someone adds next season's
// dates. An ItemList with zero members is not worth emitting. Mirrors
// the /upcoming-events empty-state handling.
const leagueEventsJsonLd = leagueEvents.length === 0 ? null : {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: leagueEvents.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item,
  })),
};
---
<Base
