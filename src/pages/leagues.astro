---
/**
 * /leagues — Bowling leagues page.
 *
 * Tier-2 utility page. The league schedule changes seasonally (typically
 * 2-4 turns per year). Hardcoded in this page rather than a content
 * collection — leagues run mostly the same lineup year over year, the
 * only thing that turns is dates and times. PR per season is cheaper
 * than a markdown collection for this volume.
 *
 * Voice rules applied (per Context/voice.md):
 *   - "FUN" caps register dropped (shouty)
 *   - "FREE Beer Wall Cards Each Week!" → "Tap wall cards included"
 *     (banned discount/value framing → entitlement framing)
 *   - "Score big" / "fun and competitive leagues" — generic register
 *     dropped in favor of specifics
 *   - "scratch leagues" — venue does NOT run these; removed entirely
 *
 * Service area kept verbatim from live page intro: "Plainfield,
 * Joliet, Romeoville, Naperville, Shorewood, Lockport, Crest Hill
 * and beyond" — this Will County coverage is SEO-relevant per
 * Context/seo.md (Naperville is the #1 paid market, near-zero
 * organic presence to capture).
 *
 * TODOs (non-blocking):
 *   - Tuesday Night Mixed dates are TBD pending ops confirmation —
 *     the Monday IBT season (Aug 31 meeting / Sept 14 start) is real
 *     for Fall 2026. When Tuesday firms up, swap "TBD" lines for
 *     real dates.
 *   - IN-SEASON UPDATE ~Sep 15: the Fall cards' "Organizational
 *     meeting Aug 31 / starts Sept 14 / Space still available" lines
 *     read as past events once the season is underway — reframe to
 *     mid-season-entry or next-season framing (flagged 2026-08-01).
 *
 * League interest form added 2026-08-01 (Jon): name/email + structured
 * solo-vs-team + preferred-night selects + message box, POSTing to
 * /api/league-interest → Resend email to contactus@ (reply-to the
 * submitter). Sits above the Pro Shop so league intent converts before
 * the gear content.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, BUSINESS_ENTITY_ID } from "../lib/schema";

// JSON-LD: Service offered by the venue. Same shape as /fundraisers —
// provider links the program to the canonical entity. No specific
// SportsEvent schema since league dates / formats turn seasonally and
// the program-as-service is what's stable. areaServed names the Will
// County coverage that the body copy claims.
const PAGE_URL = `${BUSINESS_URL}/leagues/`;
const leaguesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${BUSINESS_URL}/#leagues-program`,
  name: "Bowling Leagues",
  url: PAGE_URL,
  description:
    "USBC-sanctioned mixed bowling leagues at Twisted Pin: Monday IBT (5-person) and Tuesday Night Mixed (4-person). Open to bowlers from Plainfield, Joliet, Romeoville, Naperville, Shorewood, Lockport, Crest Hill, and surrounding Will County.",
  provider: { "@id": BUSINESS_ENTITY_ID },
  serviceType: "Bowling league",
  areaServed: {
    "@type": "Place",
    name: "Will County, IL",
  },
};
---
<Base
  title="Bowling Leagues in Plainfield, IL | Twisted Pin"
  description="USBC-sanctioned mixed leagues at Twisted Pin: Monday IBT (5-person) and Tuesday Night Mixed (4-person). Will County league bowlers welcome."
>

  <section class="t2-hero" data-hero aria-labelledby="leagues-h1">
    <div class="t2-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Leagues</p>
      <h1 class="t-display t2-hero-headline hero-fade" id="leagues-h1" data-delay-ms="120">
        Find your league.
      </h1>
      <p class="t2-hero-sub hero-fade" data-delay-ms="320">
        USBC-sanctioned mixed leagues. All skill levels. Will County
        bowlers welcome.
      </p>
    </div>
  </section>

  <section class="t2-section" aria-labelledby="leagues-fall-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">For All Skill Levels</p>
      <h2 class="t-display league-section-title" id="leagues-fall-h2">
        Fall 2026 leagues.
      </h2>
      <p class="t2-section-body">
        Two leagues this fall, both USBC-sanctioned. Tap wall cards
        included on league nights.
      </p>

      <ul class="league-cards" role="list">
        <li class="league-card">
          <h3 class="league-card-eyebrow">Monday IBT</h3>
          <p class="league-card-format">5-person mixed league · USBC sanctioned</p>
          <dl class="league-card-meta">
            <div>
              <dt>Organizational meeting</dt>
              <dd>Aug 31, 6:30pm</dd>
            </div>
            <div>
              <dt>Season starts</dt>
              <dd>Sept 14</dd>
            </div>
            <div>
              <dt>Practice</dt>
              <dd>6:15pm</dd>
            </div>
          </dl>
          <p class="league-card-status">Space still available</p>
        </li>

        <li class="league-card">
          <h3 class="league-card-eyebrow">Tuesday Night Mixed</h3>
          <p class="league-card-format">4-person teams · USBC sanctioned</p>
          <dl class="league-card-meta">
            <div>
              <dt>Organizational meeting</dt>
              <dd>TBD</dd>
            </div>
            <div>
              <dt>Season starts</dt>
              <dd>TBD</dd>
            </div>
            <div>
              <dt>Practice</dt>
              <dd>6:45pm</dd>
            </div>
          </dl>
          <p class="league-card-status">Space still available</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="t2-section" aria-labelledby="leagues-area-h2">
    <div class="t2-section-inner">
      <h2 class="t-eyebrow" id="leagues-area-h2">Service Area</h2>
      <p class="t2-section-body">
        We host league bowlers from across Will County — Plainfield,
        Joliet, Romeoville, Naperville, Shorewood, Lockport, Crest
        Hill, and beyond.
      </p>

      <p class="t2-section-body">
        Want in? <a href="#league-interest">The quick form below</a> gets
        you a callback — or email
        <a href={`mailto:contactus@twistedpin.com?subject=${encodeURIComponent("Bowling League Inquiry")}&body=${encodeURIComponent("Hi,\n\nI'd like to learn more about leagues at Twisted Pin.\n\n")}`}>contactus@twistedpin.com</a>
        or call the front desk.
      </p>

      <p class="t2-section-body">
        Looking for one-time group bookings or fundraisers instead?
        <a href="/events/">See group events →</a>
      </p>
    </div>
  </section>

  {/* ============================================================
      LEAGUE INTEREST FORM — added 2026-08-01 (Jon). Lead capture for
      the league coordinator: who they are, solo-or-team, preferred
      night — enough to route the callback without a phone-tag round.
      Posts to /api/league-interest → Resend email to contactus@
      (Freshdesk triage), reply-to the submitter. Sits ABOVE the Pro
      Shop per Jon's placement call.
      ============================================================ */}
  <section class="t2-section" id="league-interest" aria-labelledby="leagues-form-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">Get In</p>
      <h2 class="t-display league-section-title" id="leagues-form-h2">
        Tell us you're interested.
      </h2>
      <p class="t2-section-body">
        Thirty seconds. We'll get back to you with the details for the
        league that fits.
      </p>

      <form id="lg-form" class="lg-form" novalidate>
        <div class="lg-row">
          <div class="lg-field">
            <label for="lg-name">Name <span class="lg-req">*</span></label>
            <input id="lg-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="lg-field">
            <label for="lg-email">Email <span class="lg-req">*</span></label>
            <input id="lg-email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="lg-row">
          <div class="lg-field">
            <label for="lg-who">Signing up as</label>
            <select id="lg-who" name="signup_as">
              <option value="Just me">Just me</option>
              <option value="A partial team">A partial team — we need a few more</option>
              <option value="A full team">A full team</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </div>
          <div class="lg-field">
            <label for="lg-night">Preferred night</label>
            <select id="lg-night" name="night">
              <option value="Either / flexible">Either / flexible</option>
              <option value="Monday (IBT, 5-person)">Monday — IBT, 5-person</option>
              <option value="Tuesday (mixed, 4-person)">Tuesday — mixed, 4-person</option>
            </select>
          </div>
        </div>

        <div class="lg-field">
          <label for="lg-message">Anything else <span class="lg-opt">(optional)</span></label>
          <textarea
            id="lg-message"
            name="message"
            rows="4"
            placeholder="Team name, how many bowlers you already have, experience level, questions…"
          ></textarea>
        </div>

        {/* Honeypot */}
        <div class="lg-hp" aria-hidden="true">
          <label for="lg-website">Website</label>
          <input id="lg-website" name="website_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p id="lg-error" class="lg-error" role="alert" hidden></p>
        <button type="submit" id="lg-submit" class="btn btn-solid lg-submit">Send it</button>
      </form>

      <div id="lg-success" class="lg-success" hidden>
        <p class="lg-success-title">Got it — you're on the list. 🎳</p>
        <p class="t2-section-body">
          We'll reach back out with league details and next steps. Want a
          faster answer? Call the front desk any afternoon.
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================
      PRO SHOP — added 2026-05-12. Lived at twistedpin.com/bowling/#pro-shop
      on the legacy site. Audience (serious bowlers, league members,
      enthusiasts) overlaps heavily with leagues, so it lives here
      rather than on /bowl (which serves a broader casual audience).
      Anchor id="pro-shop" preserves the legacy anchor pattern.
      ============================================================ */}
  <section class="t2-section" id="pro-shop" aria-labelledby="leagues-pro-shop-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">Pro Shop</p>
      <h2 class="t-display league-section-title" id="leagues-pro-shop-h2">
        Gear, fittings, the works.
      </h2>
      <p class="t2-section-body">
        Need a ball? A fitting? Tape, grip inserts, bags? The Twisted
        Pin Pro Shop is an in-house <strong>Sure Fit Pro Shop</strong>
        satellite, run by <strong>Kevin Sickler</strong> — the guy
        Plainfield, Romeoville, and Naperville bowlers go to when
        they're serious about their gear.
      </p>

      <p class="t2-section-body">
        Text or call: <a href="tel:6307503523">(630) 750-3523</a><br />
        Email: <a href="mailto:surefitproshop@yahoo.com">surefitproshop@yahoo.com</a>
      </p>

      <p class="t2-section-body">
        Walk-in welcome during regular hours; for a fitting, text Kevin
        first to make sure he's in.
      </p>
    </div>
  </section>

  <SnapFooter />

  <script type="application/ld+json" set:html={JSON.stringify(leaguesSchema)} />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Leagues", path: "/leagues/" },
  ]} />
</Base>

{/* League interest form handler — posts to /api/league-interest.
    Named-control access goes through form.elements: form.name is the
    FORM's name attribute on HTMLFormElement, not the "name" input. */}
<script is:inline>
  (function () {
    var form = document.getElementById("lg-form");
    if (!form) return;
    var els = form.elements;
    var errorEl = document.getElementById("lg-error");
    var btn = document.getElementById("lg-submit");
    var successEl = document.getElementById("lg-success");

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      btn.disabled = false;
      btn.textContent = "Send it";
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      var name = els["name"].value.trim();
      var email = els["email"].value.trim();
      if (!name) return showError("Please enter your name.");
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email))
        return showError("Please enter a valid email address.");

      btn.disabled = true;
      btn.textContent = "Sending…";

      fetch("/api/league-interest/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: name,
          email: email,
          signup_as: els["signup_as"].value,
          night: els["night"].value,
          message: els["message"].value.trim(),
          website_url: els["website_url"].value || "",
          page_url: window.location.href,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (r) {
          if (!r || r.ok !== true)
            return showError("That didn't go through — try again, or email contactus@twistedpin.com.");
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: "smooth", block: "center" });
        })
        .catch(function () {
          showError("That didn't go through — try again, or email contactus@twistedpin.com.");
        });
    });
  })();
</script>

<style>
  /* Anchor offset for /leagues/#pro-shop (and any future in-page anchors).
     Persistent SiteHeader covers the top ~64px on desktop; without
     scroll-margin-top, the section title lands hidden behind it. Values
     match the menu-page anchor pattern (cocktails/food categories). */
  #pro-shop {
    scroll-margin-top: 120px;
  }
  @media (min-width: 1025px) {
    #pro-shop { scroll-margin-top: 140px; }
  }

  .league-section-title {
    color: var(--warm-white);
    font-size: clamp(28px, 7vw, 40px);
    line-height: 0.98;
    letter-spacing: -0.005em;
    margin: 6px 0 16px;
  }
  @media (min-width: 1025px) {
    .league-section-title { font-size: clamp(36px, 4vw, 52px); }
  }

  .league-cards {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 760px) {
    .league-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .league-card {
    background: rgba(244, 239, 227, 0.04);
    border: 1px solid rgba(244, 239, 227, 0.10);
    border-radius: var(--radius-surface);
    padding: 22px;
  }
  @media (min-width: 1025px) {
    .league-card { padding: 28px; }
  }

  .league-card-eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(22px, 5.5vw, 28px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    color: var(--warm-white);
  }

  .league-card-format {
    margin: 6px 0 18px;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--warm-mid);
  }

  .league-card-meta {
    margin: 0 0 18px;
    display: grid;
    gap: 10px;
    border-top: 1px solid rgba(244, 239, 227, 0.08);
    padding-top: 14px;
  }
  .league-card-meta > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .league-card-meta dt {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm-dim);
    margin: 0;
  }
  .league-card-meta dd {
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--warm-white);
    margin: 0;
    text-align: right;
  }

  .league-card-status {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--glow);
  }

  /* ============================================================
     League interest form (2026-08-01). Inputs ≥16px — iOS auto-zoom
     rule (type rubric, 2026-06-17). Anchor offset matches #pro-shop.
     ============================================================ */
  #league-interest {
    scroll-margin-top: 120px;
  }
  @media (min-width: 1025px) {
    #league-interest { scroll-margin-top: 140px; }
  }

  .lg-form {
    margin-top: 24px;
    display: grid;
    gap: 16px;
    max-width: 640px;
  }
  .lg-row { display: grid; gap: 16px; }
  @media (min-width: 640px) {
    .lg-row { grid-template-columns: 1fr 1fr; }
  }

  .lg-field { display: grid; gap: 6px; }
  .lg-field label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm-dim);
  }
  .lg-req { color: var(--glow); }
  .lg-opt {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
    color: var(--warm-dim);
  }

  .lg-field input,
  .lg-field select,
  .lg-field textarea {
    font-family: var(--font-body);
    font-size: 16px; /* never below 16px — iOS input-zoom rule */
    color: var(--warm-white);
    background: rgba(244, 239, 227, 0.04);
    border: 1px solid rgba(244, 239, 227, 0.16);
    border-radius: var(--radius-surface);
    padding: 12px 14px;
    width: 100%;
  }
  .lg-field textarea { resize: vertical; }
  .lg-field select option { color: #1a1530; background: #f4efe3; }

  /* Honeypot — visually removed, still in the accessibility-hidden DOM. */
  .lg-hp {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lg-error {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14.5px;
    color: #ff9d9d;
  }

  .lg-submit {
    justify-self: start;
    padding: 14px 28px;
  }

  .lg-success {
    margin-top: 24px;
    max-width: 640px;
    border: 1px solid rgba(78, 236, 196, 0.35);
    border-radius: var(--radius-surface);
    background: rgba(78, 236, 196, 0.06);
    padding: 20px 22px;
  }
  .lg-success-title {
    margin: 0 0 8px;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 15px;
    color: var(--glow);
  }

  /* ============================================================
     DESKTOP TYPE PASS (2026-08-06) — extends the 2026-08-03 batch
     to this page. The global t2-* chrome (hero sub 18px, section
     body 17px, eyebrow 14px) already scaled at 1025; everything
     page-scoped below — the league cards and the interest form —
     was still shipping mobile values on a 1900px screen, which is
     why the page read small. Rubric per 2026-06-17: read-to-decide
     15-16 / secondary 14 / 12 floor, applied at desktop scale.

     Mobile is deliberately untouched — Jon reviewed and CLOSED the
     mobile floor list on 2026-08-03 (the 11px labels here were
     explicitly ruled fine). This is desktop-only by design.

     THIS BLOCK MUST STAY LAST IN THE STYLE BLOCK. Page-scoped
     desktop queries that sit above their base rules silently lose
     on cascade order (same specificity, later wins) — /pricing
     burned three rounds on exactly that.
     ============================================================ */
  @media (min-width: 1025px) {
    /* The card grid breaks out of the 720px prose measure. Two
       problems, one fix:

       (1) ALIGNMENT. At 720px a card is ~340px wide, which can't fit
           "ORGANIZATIONAL MEETING" and "Aug 31, 6:30pm" on one line.
           The label wraps in the Monday card but NOT in the Tuesday
           card (whose value is just "TBD"), so a matched pair ends up
           ~38px out of step — "Season starts" sits at a different
           height in each card. Same for the format line. Give the row
           enough width to stay on one line and every card aligns for
           free, at any content length.
       (2) SCALE. A 720px column of cards on a 2000px monitor was most
           of why this page still read small even after the type bump.

       Prose stays at 720px — 75ch is the right measure for reading.
       A spec grid is not prose, so it gets its own width.

       margin-left:50% + translateX(-50%) re-centers on the viewport
       from inside the narrower parent; the min() clamps to the
       section's 64px gutters so it can never overflow at 1025. */
    .league-cards {
      width: min(940px, calc(100vw - 128px));
      margin-left: 50%;
      transform: translateX(-50%);
    }

    /* Card title — section titles run to 52px here; 28px left the
       cards reading like captions next to them. */
    .league-card-eyebrow { font-size: 32px; }

    /* Format descriptor — matches the 15.5px the pillar-page
       -section-list rows landed on in the 8/03 batch. */
    .league-card-format { font-size: 15.5px; margin-bottom: 20px; }

    /* The dates and times ARE the reason this page exists, so the
       values get read-to-decide size, not the dense-ledger 13.5px
       the cart rails use. */
    .league-card-meta dd { font-size: 16px; }
    /* Tracking eases 0.14 → 0.10em. At 13px the looser value costs
       ~17px of width on "ORGANIZATIONAL MEETING" — enough to force
       the wrap back at viewports just above 1025, where the grid is
       still clamped to the gutters. Keeps the one-line fit honest
       across the whole desktop range, and 0.14em was loose anyway. */
    .league-card-meta dt { font-size: 13px; letter-spacing: 0.1em; }
    .league-card-meta { gap: 12px; padding-top: 16px; margin-bottom: 20px; }

    .league-card-status { font-size: 13px; }

    /* Form: labels off the 11px floor, feedback copy to body scale. */
    .lg-field label { font-size: 13px; }
    .lg-error { font-size: 15.5px; }
    .lg-success-title { font-size: 17px; }
  }
</style>
