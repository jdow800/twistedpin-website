---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, PHONE_DISPLAY, PHONE_TEL, eventSchema } from "../lib/schema";
import { jingleBookingEnabled, jingleBookingHref } from "../config/jingle-booking";
export const prerender = false;

// The public invitation keeps the booking switch and server readiness checks.
// An isolated DEV rehearsal remains a separate, protected transport.
const bookingEnabled = jingleBookingEnabled(process.env.JINGLE_BOOKING_ENABLED ?? import.meta.env.JINGLE_BOOKING_ENABLED)
  || (import.meta.env.DEV && import.meta.env.PUBLIC_TPRS_API_BASE === '/jingle-bowl/rehearsal-api');
const inclusions = [
  { number: "01", title: "90 minutes of bowling", detail: "Time on your lane, with shoe rental included." },
  { number: "02", title: "Pizza + soft drinks", detail: "One large pizza and a pitcher of soft drink per lane." },
  { number: "03", title: "Cocoa + cookies", detail: "A little something for the sweet tooth. Santa understands." },
  { number: "04", title: "A visit with Santa", detail: "Photos with the big guy, coordinated with your bowling time." },
];
const eventEntry = await getEntry("events", "2026-12-06-jingle-bowl");
// Availability belongs to checkout; this invitation does not claim InStock.
const eventJsonLd = eventEntry ? { "@context": "https://schema.org", ...eventSchema({
  name: eventEntry.data.title, start: eventEntry.data.start, end: eventEntry.data.end,
  description: eventEntry.body?.trim(), image: `${BUSINESS_URL}/jingle-bowl/jingle-wide.png`,
  url: `${BUSINESS_URL}/jingle-bowl/`,
}) } : null;
---

<Base
  title="Jingle Bowl 2026: Santa & Bowling | Twisted Pin"
  description="Bowling, pizza and a visit with Santa at Twisted Pin in Plainfield on Sunday, December 6, 2026. Explore Jingle Bowl packages and reservation details."
  ogImage="/jingle-bowl/jingle-wide.png"
  ogImageAlt="Illustrated Santa with a bowling ball, created for the Jingle Bowl campaign"
  lcpPreloadHref="/jingle-bowl/jingle-square.webp"
  hideStickyCTA={true}
  hidePromo={true}
  reservationAction={{ href: "#lane-packages", label: "See packages" }}
>
  <Fragment slot="head">
    {eventJsonLd && <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />}
    <BreadcrumbSchema crumbs={[{ name: "Home", path: "/" }, { name: "Jingle Bowl", path: "/jingle-bowl/" }]} />
  </Fragment>

  <div class="jb-page">
    <section class="jb-hero" aria-labelledby="jb-title">
      <div class="jb-hero-topline">
        <p>Twisted Pin <span aria-hidden="true">/</span> Plainfield, IL</p>
        <p>Sunday, December 6, 2026</p>
      </div>
      <div class="jb-hero-grid">
        <div class="jb-hero-copy">
          <h1 id="jb-title"><span class="jb-event-name">Jingle Bowl!<svg class="jb-candy-cane" viewBox="0 0 70 92" width="46" height="60" aria-hidden="true" focusable="false"><path d="M21 79V26a17 17 0 0 1 34 0v10" fill="none" stroke="#dfc18a" stroke-width="18" stroke-linecap="round"/><path d="M21 79V26a17 17 0 0 1 34 0v10" fill="none" stroke="#fff4df" stroke-width="14" stroke-linecap="round"/><path d="M21 79V26a17 17 0 0 1 34 0v10" fill="none" stroke="#b93545" stroke-width="14" stroke-dasharray="11 12" stroke-linecap="butt"/></svg></span><span class="jb-hero-headline">SANTA’S<br />COMING.<br /><em>LET’S ROLL.</em></span></h1>
          <p class="jb-hero-description">Bowling, pizza &amp; a visit with Santa.</p>
          <a class="jb-button" href="#lane-packages">See the lane packages <span aria-hidden="true">↘</span></a>
          <p class="jb-hero-footnote">One Sunday. All Jingle Bowl.</p>
        </div>
        <div class="jb-hero-art">
          <picture>
            <img src="/jingle-bowl/jingle-square.webp" width="1000" height="1000" fetchpriority="high" decoding="async" alt="Jingle Bowl: a visit with Santa, Sunday, December 6, 2026. Illustrated Santa holding a bowling ball." />
          </picture>
        </div>
      </div>
      <div class="jb-hero-bottom"><span>Jingle Bowl returns</span><span>December 6 <span aria-hidden="true">✦</span> Twisted Pin</span><a href="#the-event" aria-label="Explore Jingle Bowl below">Scroll for the good stuff <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="jb-intro" id="the-event" aria-labelledby="jb-intro-title">
      <div class="jb-inner jb-intro-grid">
        <div><p class="jb-label">The holiday plan</p><h2 id="jb-intro-title">A little less mall.<br />A lot more <em>bowl.</em></h2></div>
        <div class="jb-intro-body"><p>Enjoy 90 minutes of bowling, pizza and holiday fun, plus a visit with Santa for photos on your device. Our team will let you know when it’s your group’s turn.</p><p>Bring your people to Twisted Pin on <strong>Sunday, December 6</strong>. The whole day is reserved for Jingle Bowl, with no regular lane reservations before or afterward.</p><div class="jb-date-line"><span>Save the date</span><time datetime="2026-12-06">12.06.26</time></div></div>
      </div>
    </section>

    <section class="jb-package" aria-labelledby="jb-package-title">
      <div class="jb-inner">
        <div class="jb-section-head"><div><p class="jb-label">The Jingle Bowl experience</p><h2 id="jb-package-title">More than a<br /><em>photo op.</em></h2></div><p class="jb-package-intro">Your lane, your people, and a little Christmas mischief. Here’s what’s included.</p></div>
        <div class="jb-inclusions">{inclusions.map((item) => <article class="jb-inclusion"><span class="jb-number">{item.number}</span><h3>{item.title}</h3><p>{item.detail}</p></article>)}</div>
        <div class="jb-package-aside"><svg class="jb-gift" viewBox="0 0 84 88" width="64" height="67" aria-hidden="true" focusable="false"><path d="M42 28C17 28 16 9 27 11c10 1 15 17 15 17Zm0 0C67 28 68 9 57 11 47 12 42 28 42 28Z" fill="none" stroke="#e8c78b" stroke-width="4" stroke-linejoin="round"/><rect x="14" y="37" width="56" height="40" rx="3" fill="#fff4df"/><path d="m17 50 17 10M52 66l14 8M54 43l13 8" stroke="#e8c78b" stroke-width="2"/><rect x="10" y="28" width="64" height="14" rx="2" fill="#e8c78b"/><path d="M42 29v48" stroke="#ac3041" stroke-width="12"/><path d="M36 28h12" stroke="#fff4df" stroke-width="3"/></svg><p>Bowling, a table full of your people, and Santa on the calendar. That’s the idea.</p></div>
      </div>
    </section>

    <section class="jb-rooms" id="lane-packages" aria-labelledby="jb-rooms-title">
      <div class="jb-inner">
        <div class="jb-section-head"><div><p class="jb-label">Pick your setting</p><h2 id="jb-rooms-title">Same Santa.<br /><em>Your kind of lane.</em></h2></div><p class="jb-room-intro">Traditional lanes or the VIP suite. Two ways to make Jingle Bowl your holiday outing.</p></div>
        <div class="jb-room-grid">
          <article class="jb-room">
            <div class="jb-room-photo"><picture><source srcset="/snap/tile-trad-540.avif" type="image/avif" /><img src="/snap/tile-trad-540.webp" width="540" height="405" loading="lazy" decoding="async" alt="Traditional bowling lanes and tables at Twisted Pin" /></picture><span>01 / Traditional</span></div>
            <div class="jb-room-heading"><h3>Traditional lanes</h3><p class="jb-room-price"><span>Base price / lane</span><strong>$149.95</strong></p></div>
            <div class="jb-room-capacity"><strong>5</strong><span>People total<small>per traditional lane</small></span></div>
            <p class="jb-capacity-note">Everyone coming counts. Bowling or just hanging out.</p>
            <ul class="jb-room-inclusions" aria-label="Included with each Traditional lane"><li>90 minutes of bowling</li><li>Shoe rental included</li><li>One large pizza per lane</li><li>One pitcher of soda per lane</li><li>Access to cookie &amp; cocoa bar</li><li>Photo with Santa on your device</li></ul>
            <p class="jb-room-note">Pitcher refills are not included.</p>
            {bookingEnabled && <a class="jb-button jb-room-cta" href={jingleBookingHref('traditional')}>Book Traditional <span aria-hidden="true">↗</span></a>}
          </article>
          <article class="jb-room">
            <div class="jb-room-photo"><picture><source srcset="/snap/tile-vip-540.avif" type="image/avif" /><img src="/snap/tile-vip-540.webp" width="540" height="405" loading="lazy" decoding="async" alt="Couch seating and bowling lanes in the Twisted Pin VIP suite" /></picture><span>02 / VIP suite</span></div>
            <div class="jb-room-heading"><h3>VIP suite lanes</h3><p class="jb-room-price"><span>Base price / lane</span><strong>$189.95</strong></p></div>
            <div class="jb-room-capacity"><strong>6</strong><span>People total<small>per VIP lane</small></span></div>
            <p class="jb-capacity-note">Everyone coming counts. Bowling or just hanging out.</p>
            <ul class="jb-room-inclusions" aria-label="Included with each VIP lane"><li>90 minutes of bowling</li><li>Shoe rental included</li><li>One large pizza per lane</li><li>One pitcher of soda per lane</li><li>Access to cookie &amp; cocoa bar</li><li>Photo with Santa on your device</li><li class="jb-vip-extra">One basket of fries per lane</li></ul>
            <p class="jb-room-note">Enjoy the suite’s couch seating. Pitcher refills are not included.</p>
            {bookingEnabled && <a class="jb-button jb-room-cta" href={jingleBookingHref('vip')}>Book VIP <span aria-hidden="true">↗</span></a>}
          </article>
        </div>
        <p class="jb-group-note"><strong>9 people coming? You’ll need 2 lanes.</strong> Even if only 5 are bowling. Your reservation covers lane space for your whole group.</p>
        <p class="jb-price-note">Base lane prices are shown above. A 10% Online Booking Fee and applicable tax are added at checkout.</p>
      </div>
    </section>

    <section class="jb-faq" aria-labelledby="jb-faq-title">
      <div class="jb-inner jb-faq-grid">
        <div><p class="jb-label">Before the big guy arrives</p><h2 id="jb-faq-title">Good to<br /><em>know.</em></h2><p>We’ll keep the practical stuff as clear as the holiday plan.</p></div>
        <div class="jb-questions">
          <details open><summary>When is Jingle Bowl?<span aria-hidden="true">+</span></summary><p>Sunday, December 6, 2026, at Twisted Pin in Plainfield. The five 90-minute reservation starts are 1:45pm, 2pm, 2:30pm, 3:30pm and 3:45pm, all Central time. Jingle Bowl activities end at 5:15pm. The venue closes at 5:30pm, and all guests must depart by then.</p></details>
          <details><summary>How many guests fit on each lane?<span aria-hidden="true">+</span></summary><p>For Jingle Bowl, each traditional lane holds up to <strong>5 people total</strong> and each VIP lane holds up to <strong>6 people total</strong>. Everyone coming counts. Bowling or just hanging out.</p></details>
          <details><summary>What if some people aren’t bowling?<span aria-hidden="true">+</span></summary><p>Your reservation covers lane space for your whole group, including anyone who’s just watching. <strong>9 people coming? You’ll need 2 lanes, even if only 5 are bowling.</strong></p></details>
          <details><summary>When should we arrive?<span aria-hidden="true">+</span></summary><p>Arrive on time for your reservation. Bowling starts and ends at your reserved times, even if you arrive late. If you arrive early, your lane may still be in use or being prepared.</p></details>
          <details><summary>Can we stay after our bowling time?<span aria-hidden="true">+</span></summary><p>Please clear your booked lane, seats and belongings at your reserved end time. Afterward, you can enjoy the arcade or an available waiting area until 5:30pm, when the venue closes and all guests must depart.</p></details>
          <details><summary>Can I book a regular lane that day?<span aria-hidden="true">+</span></summary><p>December 6 is Jingle Bowl only through close. Regular lane reservations will not be offered that day, including before or after Jingle Bowl.</p></details>
          <details><summary>How late can we reserve?<span aria-hidden="true">+</span></summary><p>Reservations close 30 minutes before each start, subject to available lanes.</p></details>
          <details><summary>What if our plans change?<span aria-hidden="true">+</span></summary><p>Cancellations must be made at least 72 hours before your reservation to avoid forfeiting payment.</p></details>
          <details><summary>How will the visit with Santa work?<span aria-hidden="true">+</span></summary><p>Our team will let you know when it’s your group’s turn to visit Santa. Enjoy your lane until your group is called, and bring a charged phone or camera for photos.</p></details>
          <details><summary>Where is Twisted Pin?<span aria-hidden="true">+</span></summary><p>Find us at 15610 Joliet Rd, Plainfield, IL 60544. Explore our <a href="/bowl/">bowling lanes</a> or take a look at the <a href="/vip-suite/">VIP suite</a>.</p></details>
        </div>
      </div>
    </section>

    <section class="jb-closing" aria-labelledby="jb-closing-title">
      <div class="jb-inner"><p class="jb-label">Sunday, December 6 · Plainfield, IL</p><h2 id="jb-closing-title">Put a little<br /><em>Twisted</em> in your holiday.</h2><p>Jingle Bowl activities finish at 5:15pm. The venue closes at 5:30pm, with all guests heading home by then.</p><div class="jb-closing-actions"><a class="jb-button" href="#lane-packages">Compare lane packages <span aria-hidden="true">↑</span></a><a class="jb-phone" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a></div></div>
    </section>

    <footer class="jb-footer" id="find-us"><a href="/" aria-label="Twisted Pin home"><img src="/logo/twisted-pin-horizontal-white.webp" width="360" height="154" loading="lazy" alt="Twisted Pin" /></a><p>15610 Joliet Rd<br />Plainfield, IL 60544</p><a href="/">Explore Twisted Pin <span aria-hidden="true">↗</span></a></footer>
  </div>
</Base>

<style>
  /* This normal-scrolling campaign does not need the homepage's paired gutters.
     Removing them here also keeps its fixed mobile header within the viewport. */
  :global(html:has(.jb-page)) { scrollbar-gutter: auto; }
  :global(html:has(.jb-page) .site-header) { --glow: #e8c78b; --indigo-deep: #11372b; background: rgba(7,31,23,.95); }
  .jb-page { --jb-green: #103b2c; --jb-deep: #09291f; --jb-cranberry: #641e2d; --jb-cream: #fff4df; --jb-gold: #e8c78b; --jb-line: rgba(255,244,223,.22); --warm-white: var(--jb-cream); --warm-mid: #e6dac6; --warm-dim: #c9c5b2; --glow: var(--jb-gold); background: var(--jb-deep); color: var(--warm-white); overflow: clip; padding-top: calc(70px + var(--safe-top)); }
  .jb-page h1, .jb-page h2, .jb-page h3 { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; }
  .jb-page h2 { font-size: clamp(48px, 12vw, 78px); line-height: .98; letter-spacing: -.015em; }
  .jb-page h2 em { font-style: normal; color: var(--glow); }
  .jb-page p { line-height: 1.65; }
  .jb-page a { text-underline-offset: 5px; }
  .jb-page :where(section[id]) { scroll-margin-top: 96px; }
  .jb-inner { width: min(1200px, calc(100% - 40px)); margin-inline: auto; }
  .jb-label { font: 700 11px/1.5 var(--font-ui); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 19px; }
  .jb-hero { position: relative; isolation: isolate; width: min(1440px, 100%); margin-inline: auto; padding: 0 20px; }
  .jb-hero::before, .jb-closing::before { content: ""; position: absolute; z-index: -1; inset: 0; background: url('/pattern/pin-tilt-white.png') 30px 35px / 330px auto repeat; opacity: .035; pointer-events: none; }
  .jb-hero-topline { padding: 21px 0 18px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 20px; font: 700 10px/1.5 var(--font-ui); text-transform: uppercase; letter-spacing: .09em; border-bottom: 1px solid var(--jb-line); }
  .jb-hero-topline p:first-child { display: none; }
  .jb-hero-topline span { color: var(--glow); margin: 0 10px; }
  .jb-hero-grid { display: grid; padding-top: 22px; }
  .jb-hero-copy { position: relative; z-index: 1; padding: 28px 0 26px; }
  .jb-hero h1 { margin: 0 0 20px; letter-spacing: -.025em; }
  .jb-event-name { display: flex; align-items: center; justify-content: space-between; gap: 20px; font: 700 12px/1.4 var(--font-ui); letter-spacing: .09em; margin-bottom: 17px; color: var(--jb-gold); }
  .jb-candy-cane { flex: 0 0 auto; width: 42px; height: 55px; transform: rotate(14deg); margin-right: 12px; }
  .jb-hero-headline { display: block; font-size: clamp(48px, 13.3vw, 70px); line-height: .94; }
  .jb-hero-headline em { font-style: normal; color: var(--glow); }
  .jb-hero-description { font-size: 18px; margin: 24px 0; }
  .jb-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 22px; padding: 17px 20px; border: 1px solid #dbb26d; border-radius: 7px; color: var(--jb-cream); background: #a32d40; font: 700 12px/1.4 var(--font-ui); text-decoration: none; transition: background 160ms ease, transform 160ms ease; }
  .jb-button:hover { background: #bd3a4d; transform: translateY(-2px); }
  .jb-page :is(a, summary):focus-visible { outline: 3px solid var(--jb-gold); outline-offset: 5px; }
  .jb-button span { font-size: 22px; line-height: 1; }
  .jb-hero-footnote { font: 600 11px/1.4 var(--font-ui); color: var(--warm-dim); margin-top: 15px; }
  .jb-hero-art { position: relative; order: -1; aspect-ratio: 1; background: #071910; isolation: isolate; border: 1px solid #d3ad6b80; box-shadow: 0 18px 50px #03120d55; }
  .jb-hero-art picture, .jb-hero-art img { display: block; width: 100%; height: 100%; }
  .jb-hero-art img { object-fit: cover; }
  .jb-hero-bottom { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0 22px; border-bottom: 1px solid var(--jb-line); font: 600 10px/1.5 var(--font-ui); text-transform: uppercase; letter-spacing: .08em; }
  .jb-hero-bottom > span:first-child { display: none; }
  .jb-hero-bottom > span span { color: var(--glow); margin-inline: 7px; }
  .jb-hero-bottom a { color: var(--warm-white); text-decoration: none; }
  .jb-intro { position: relative; margin-top: 44px; background: var(--jb-cream); color: var(--jb-green); padding: 60px 0; }
  .jb-intro::before { content: ""; position: absolute; inset: 0 0 auto; height: 7px; background: repeating-linear-gradient(135deg, #a32d40 0 14px, var(--jb-cream) 14px 28px); }
  .jb-intro-grid { display: grid; gap: 30px; }
  .jb-intro h2 em { color: #962b3c; }
  .jb-intro-body { font-size: 15px; }
  .jb-intro-body p + p { margin-top: 16px; }
  .jb-date-line { margin-top: 28px; padding-top: 15px; border-top: 1px solid #103b2c40; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .jb-date-line span { font: 700 10px/1.5 var(--font-ui); letter-spacing: .12em; text-transform: uppercase; }
  .jb-date-line time { font: 900 35px/1 var(--font-display); color: #962b3c; }
  .jb-package, .jb-rooms, .jb-faq { padding: 66px 0; }
  .jb-package { background: var(--jb-cranberry); }
  .jb-section-head { display: grid; gap: 25px; margin-bottom: 36px; }
  .jb-package-intro { font-size: 15px; color: var(--warm-mid); max-width: 380px; }
  .jb-inclusions { border-top: 1px solid var(--jb-line); }
  .jb-inclusion { padding: 22px 0; border-bottom: 1px solid var(--jb-line); display: grid; grid-template-columns: 35px 1fr; column-gap: 12px; }
  .jb-number { color: var(--glow); font: 600 11px/1.6 var(--font-ui); padding-top: 6px; }
  .jb-inclusion h3 { font-size: 27px; line-height: 1.05; margin-bottom: 9px; }
  .jb-inclusion p { grid-column: 2; font-size: 13px; color: var(--warm-mid); max-width: 290px; }
  .jb-package-aside { display: flex; align-items: center; gap: 16px; margin-top: 30px; }
  .jb-gift { flex: 0 0 auto; width: 58px; height: 61px; transform: rotate(-7deg); }
  .jb-package-aside p { font-size: 13px; max-width: 610px; }
  .jb-rooms { background: var(--jb-green); }
  .jb-room-intro { font-size: 15px; max-width: 340px; color: var(--warm-mid); }
  .jb-room-grid { display: grid; gap: 38px; }
  .jb-room { position: relative; }
  .jb-room-cta { margin-top: 22px; }
  .jb-room-cta:hover { transform: none; }
  .jb-room-cta::after { content: ""; position: absolute; inset: 0; }
  .jb-room:has(.jb-room-cta:focus-visible) { outline: 3px solid var(--jb-gold); outline-offset: 8px; }
  .jb-room:has(.jb-room-cta:hover) .jb-room-photo { border-color: var(--jb-gold); }
  .jb-room-photo { position: relative; overflow: hidden; background: var(--jb-deep); border: 1px solid #e8c78b66; }
  .jb-room-photo picture, .jb-room-photo img { display: block; width: 100%; }
  .jb-room-photo img { height: auto; aspect-ratio: 4/3; object-fit: cover; }
  .jb-room-photo > span { position: absolute; left: 12px; bottom: 12px; padding: 8px 10px; background: #641e2df2; font: 700 9px/1.3 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; }
  .jb-room-heading { display: flex; align-items: start; justify-content: space-between; gap: 15px; margin: 21px 0 12px; }
  .jb-room-heading h3 { font-size: 29px; line-height: 1; max-width: 58%; }
  .jb-room-price { flex: 0 0 auto; text-align: right; }
  .jb-room-price span { display: block; font: 600 9px/1.4 var(--font-ui); color: var(--warm-mid); }
  .jb-room-price strong { display: block; font: 900 29px/1.15 var(--font-display); color: var(--glow); }
  .jb-room > p { color: var(--warm-mid); font-size: 13px; max-width: 430px; }
  .jb-room-capacity { display: flex; align-items: center; gap: 16px; padding: 16px 20px; margin-top: 20px; background: var(--jb-gold); color: var(--jb-deep); }
  .jb-room-capacity > strong { flex: 0 0 auto; font: 900 76px/.9 var(--font-display); }
  .jb-room-capacity > span { font: 900 30px/1 var(--font-display); text-transform: uppercase; }
  .jb-room-capacity small { display: block; margin-top: 6px; font: 700 12px/1.5 var(--font-ui); }
  .jb-room > .jb-capacity-note { margin-top: 10px; font: 600 14px/1.5 var(--font-ui); }
  .jb-group-note { margin-top: 32px; padding: 20px; border: 2px solid var(--jb-gold); font: 500 16px/1.6 var(--font-ui); }
  .jb-group-note strong { display: block; margin-bottom: 6px; color: var(--jb-gold); font-weight: 700; }
  .jb-room-inclusions { display: grid; gap: 10px; padding: 17px 0 0; margin: 18px 0 0; list-style: none; border-top: 1px solid var(--jb-line); font: 500 15px/1.5 var(--font-ui); }
  .jb-room-inclusions li { position: relative; padding-left: 20px; }
  .jb-room-inclusions li::before { content: "✓"; position: absolute; left: 0; color: var(--jb-gold); font-weight: 700; }
  .jb-room-inclusions .jb-vip-extra { color: var(--jb-gold); font-weight: 700; }
  .jb-room > .jb-room-note { margin-top: 15px; font-size: 12px; }
  .jb-price-note { border-top: 1px solid var(--jb-line); margin-top: 32px; padding-top: 19px; font-size: 11px; color: var(--warm-mid); max-width: 800px; }
  .jb-faq { --jb-line: #103b2c33; --warm-mid: #365044; background: var(--jb-cream); color: var(--jb-green); }
  .jb-faq h2 em, .jb-faq .jb-questions summary > span { color: #962b3c; }
  .jb-faq :is(a, summary):focus-visible { outline-color: #962b3c; }
  .jb-faq-grid { display: grid; gap: 30px; }
  .jb-faq-grid > div:first-child > p:last-child { margin-top: 22px; max-width: 300px; color: var(--warm-mid); font-size: 14px; }
