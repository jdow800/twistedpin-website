---
import Base from "../../layouts/Base.astro";
import NyePublicCheckout from "../../components/tprs/nye/NyePublicCheckout";
import { NYE_OPENING_DATE_LABEL } from "../../config/nye-opening";
---
<Base
  title="Book New Year's Eve 2026 | Twisted Pin Plainfield"
  description="Book New Year's Eve at Twisted Pin in Plainfield. Choose Traditional or VIP lanes, your party time, pizza and soda."
  ogImage="/og/og-vip-suite.jpg"
  ogImageAlt="The VIP suite lanes at Twisted Pin in Plainfield, IL"
  hideStickyCTA={true}
  hideHeader={true}
  hideNavDrawer={true}
  hidePromo={true}
  lockViewportZoom={true}
>
  <NyePublicCheckout client:only="react">
    <section slot="fallback" class="nye-public-closed" aria-label="New Year's Eve booking">
      <h1>New Year's Eve at Twisted Pin</h1>
      <p>Reservations open {NYE_OPENING_DATE_LABEL}.</p>
      <p>Loading booking…</p>
      <noscript><p>Please enable JavaScript to book online, or call <a href="tel:+18157827790">(815) 782-7790</a>.</p></noscript>
      <a href="/new-years-eve/">About New Year's Eve</a>
    </section>
  </NyePublicCheckout>
</Base>
