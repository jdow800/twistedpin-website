---
/**
 * /reserve/nye — New Year's Eve party-slot bookings, PARKED AT ITS REAL SLUG.
 *
 * Like /reserve/birthdays (and unlike /reserve-preview), this page lives at
 * its final URL from day one: the vercel.json `/reserve{/}?` redirect is
 * EXACT-match, so the nested path never collides.
 *
 * LAUNCH (when ops opens NYE bookings here — independent of the lane cutover):
 *   1. Repoint the /new-years-eve/ lander's booking CTAs (and the
 *      /upcoming-events/ NYE entry's cta) to /reserve/nye/.
 *   2. Remove the noindex meta below + the robots.txt `Disallow: /reserve/nye/`
 *      line + the astro.config.mjs sitemap filter entry.
 *   3. Full launch SEO pass per src/tprs/BOOKING-PAGES-HANDOFF.md (real
 *      title/description are already in, og:image reuses og-vip-suite.jpg —
 *      same shot as the hero band; revisit if a dedicated NYE og crop lands).
 *   No file moves, no redirect changes.
 *
 * Protections until then (parked-preview triad): noindex,nofollow meta +
 * robots.txt Disallow + sitemap filter exclusion + unlinked.
 *
 * Page mechanics come from nyePageConfig: both NYE party products (VIP 124 +
 * Traditional 126) on standard description cards — the included-list copy
 * sells the slot — with the normal lane stepper (capacity copy stays at
 * category level; the rooms hold 6 vs 5), the calendar seeded at 12/31 via
 * defaultDate (the packages are only bookable on NYE), and the NYE Arcade
 * Mega Deal riding along as an optional add-on.
 */
import Base from "../../layouts/Base.astro";
import BookingWizard from "../../components/tprs/BookingWizard.tsx";
import { nyePageConfig } from "../../tprs/pageConfig";

const { uxCopy, heroImage } = nyePageConfig;
---
<Base
  title="Book New Year's Eve Lanes | Twisted Pin Plainfield"
  description="Reserve a New Year's Eve party slot in the VIP suite at Twisted Pin in Plainfield — unlimited bowling, pizza, party favors, and a midnight toast on the 10pm slot."
  ogImage="/og/og-vip-suite.jpg"
  ogImageAlt="The VIP suite lanes at Twisted Pin in Plainfield, IL"
  hideStickyCTA={true}
  lcpPreloadHref={heroImage ? `${heroImage.base}-1080.avif` : undefined}
  lcpPreloadMedia={heroImage ? "(max-width: 1024px)" : undefined}
>
  {/* noindex,nofollow — parked until the NYE-booking launch. */}
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  {heroImage ? (
    <section class="tprs-hero" data-hero aria-labelledby="tprs-h1">
      <picture>
        <source
          type="image/avif"
          media="(max-width: 1024px)"
          srcset={`${heroImage.base}-1080.avif`}
        />
        <source
          type="image/avif"
          media="(min-width: 1025px)"
          srcset={`${heroImage.base}-1600.avif`}
        />
        <source
          type="image/webp"
          media="(max-width: 1024px)"
          srcset={`${heroImage.base}-1080.webp`}
        />
        <img
          class="tprs-hero-img"
          data-tprs-hero-img
          src={`${heroImage.base}-1600.webp`}
          alt={heroImage.alt}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="tprs-hero-scrim" aria-hidden="true"></div>
      <div class="tprs-hero-copy">
        <p class="t-eyebrow">{uxCopy.eyebrow}</p>
        <h1 class="t-display tprs-hero-headline" id="tprs-h1">{uxCopy.headline}</h1>
        <p class="tprs-hero-sub">{uxCopy.sub}</p>
      </div>
    </section>
  ) : (
    <section class="tprs-intro" data-hero aria-labelledby="tprs-h1">
      <p class="t-eyebrow">{uxCopy.eyebrow}</p>
      <h1 class="t-display tprs-intro-headline" id="tprs-h1">{uxCopy.headline}</h1>
      <p class="tprs-intro-sub">{uxCopy.sub}</p>
    </section>
  )}

  <div class="tprs-mount">
    <BookingWizard client:only="react" config={nyePageConfig} />
  </div>
</Base>

<style>
  /* ---------- compact identity hero (image band) ---------- */
  .tprs-hero {
    position: relative;
    height: clamp(300px, 42vh, 440px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  @media (min-width: 1025px) {
    /* Desktop: start the hero BELOW the fixed header instead of behind it —
       same call as /reserve/birthdays (the translucent header scrim muted
       the brightest band of the shot). */
    .tprs-hero {
      margin-top: var(--header-height);
      height: clamp(420px, 52vh, 600px);
    }
    /* Bias the desktop crop UP — the suite shot's energy (crowd, wall art)
       sits in the upper two-thirds; dead-center crops to mostly lane floor. */
    .tprs-hero-img {
      object-position: center 25%;
    }
    .tprs-hero-scrim {
      background: linear-gradient(
        to bottom,
        rgba(14, 10, 31, 0.3) 0%,
        rgba(14, 10, 31, 0.15) 38%,
        rgba(14, 10, 31, 0.62) 72%,
        #0e0a1f 100%
      );
    }
  }
  .tprs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* The wizard swaps this to the chosen product's hero (BookingWizard
       product-hero takeover) — fade between shots. */
    transition: opacity 0.3s ease;
  }
  .tprs-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(14, 10, 31, 0.6) 0%,
      rgba(14, 10, 31, 0.18) 38%,
      rgba(14, 10, 31, 0.62) 72%,
      #0e0a1f 100%
    );
  }
  .tprs-hero-copy {
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 18px 16px;
    text-align: center;
  }
  .tprs-hero-headline {
    font-size: clamp(34px, 9vw, 58px);
    letter-spacing: -0.01em;
    margin: 4px 0 8px;
  }
  .tprs-hero-sub {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--warm-mid);
    margin: 0;
  }

  /* ---------- typography hero (fallback when no image is configured) ------ */
  .tprs-intro {
    max-width: 720px;
    margin: 0 auto;
    padding: calc(var(--header-height) + 28px) 18px 26px;
    text-align: center;
  }
  .tprs-intro-headline {
    font-size: clamp(34px, 10vw, 64px);
    letter-spacing: -0.01em;
    margin: 6px 0 10px;
  }
  .tprs-intro-sub {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--warm-mid);
    margin: 0;
  }
  .tprs-mount {
    min-height: 70vh;
  }
</style>
