---
/**
 * /upcoming-events — public event calendar.
 *
 * Reads from the `events` content collection (src/content/events/*.md).
 * Adding an event = drop a markdown file with frontmatter and push.
 * Daily 4am cron rebuild keeps the page fresh; past events fall off
 * automatically after their end (or start, if no end) is in the past.
 *
 * Two shapes of event:
 *   - one-shot (Paint Night, NYE) — listed at its own date
 *   - recurring (Karaoke Thursdays) — a `recurring` block in the
 *     frontmatter, listed at EVERY date it runs inside the horizon.
 *     Listing each night individually is what lets a dark night explain
 *     itself: October shows the 1st, 8th, 15th and 29th, and the 22nd
 *     is simply absent, so no "skipping Oct 22" caveat is needed. The
 *     schema still ships ONE Event with a `Schedule` + `exceptDate`.
 *     See src/lib/recurrence.ts before touching any of it — the DST
 *     trap documented there is a real one.
 *
 * Layout: typography hero → month pills → one panel per month → bottom
 * hand-off (host-your-own-night + leagues). Every panel is
 * server-rendered and stays in the DOM (crawlers see all of it); JS only
 * swaps which is visible, via the same aria-pressed/aria-hidden pattern
 * as the /pricing day tabs. Empty state replaces the whole calendar when
 * nothing at all is scheduled.
 *
 * Per launch-checklist.md: legacy /event-directory/ also gets a 301
 * to /upcoming-events/ at launch (consolidation).
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { BUSINESS_URL, eventSchema } from "../lib/schema";
import { PLAN_EVENT_URL } from "../lib/links";
// Venue-local date math + weekly recurrence. Lives in its own module so
// the DST behaviour is exercisable: `node scripts/check-recurrence.mjs`.
import {
  VENUE_TZ,
  ctParts,
  ctClock,
  ctDateKey,
  weekdayOf,
  isOneLateNight,
  expandOccurrences,
  monthHorizon,
} from "../lib/recurrence";

// At-build cutoff: an event is "past" when its end (or start, if no
// end) is before now. Cron rebuilds nightly at 9 UTC so this re-runs
// once a day in production — close enough to "live."
//
// Horizon: the month pills ARE the lookahead. Four whole calendar
// months (this one + three) keeps the deliberately short runway the
// page has always had — we don't post six months ahead because the
// calendar shifts — while still letting people look past "what's next."
// December, and with it NYE, comes into view from September 1.
//
// Whole months rather than a rolling day count on purpose: the last
// pill would otherwise show a half-month whose contents changed daily.
const HORIZON_MONTHS = 4;
const now = new Date();
const months = monthHorizon(now, HORIZON_MONTHS);
const horizonEnd = months[months.length - 1].end;

const rawEvents = (await getCollection("events")).filter((e) => !e.data.draft);

// Every calendar-date part below is read in America/Chicago, never via
// Date#getDate()/getMonth()/getFullYear() — those use the *build server's*
// zone, and Vercel builds in UTC. A 6:00–8:30pm CT event ends at 01:30 UTC
// the NEXT day, so the naive form rendered a phantom two-day range
// ("15–16 SEP") in production while a Central-time dev machine showed the
// correct single day. Caught live 2026-08-14 on Paint Night; every evening
// event since the calendar shipped had the same defect. The time range was
// always right because timeFmt below pins timeZone explicitly — do the same
// for date parts.

// Flatten every event into its individual occurrences inside the horizon.
// A recurring night contributes one entry per date it actually runs, which
// is what makes a dark night self-explanatory: it's simply not in the list.
const occurrences = rawEvents
  .flatMap((e) => expandOccurrences(e.data, now, horizonEnd).map((occ) => ({ entry: e, occ })))
  .sort((a, b) => a.occ.start.getTime() - b.occ.start.getTime());

// One panel per horizon month, keyed on the venue's calendar date. A 7pm CT
// event on Dec 31 is Jan 1 UTC — the naive form filed it under the wrong
// month AND year.
const monthLongFmt = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
  timeZone: VENUE_TZ,
});
const monthPillFmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  timeZone: VENUE_TZ,
});
const thisYear = ctParts(now).year;

const panels = months.map((m) => {
  const events = occurrences.filter((o) => {
    const p = ctParts(o.occ.start);
    return `${p.year}-${p.month}` === m.key;
  });
  return {
    key: m.key,
    label: monthLongFmt.format(m.start).toUpperCase(),
    // Pills stay terse — "OCT" — but carry the year once the horizon
    // crosses into the next one, so DEC and JAN can't be confused.
    pill: monthPillFmt.format(m.start).toUpperCase(),
    pillYear: m.key.slice(0, 4) === thisYear ? null : m.key.slice(2, 4),
    events,
  };
});

// Open on the first month that actually has something. Usually the
// current one; late in a quiet month it's the next one, so nobody lands
// on an empty panel when the page isn't empty.
const activeKey = (panels.find((p) => p.events.length > 0) ?? panels[0]).key;
const hasAnyEvents = occurrences.length > 0;

const monthShortFmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  timeZone: VENUE_TZ,
});
const monthShort = (d: Date) => monthShortFmt.format(d).toUpperCase();
// Number() strips the "2-digit" leading zero — the date block reads "5", not "05".
const dayNum = (d: Date) => String(Number(ctParts(d).day));

const weekdayShortFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  timeZone: VENUE_TZ,
});
// Spoken form of the date, for the visually-hidden half of the When line.
const srDateFmt = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  timeZone: VENUE_TZ,
});

// Day block — handles single day, multi-day same-month, multi-day cross-month.
// The weekday rides in the chip rather than the meta line below: "Thursday ·
// 7:00 pm – 11:00 pm CT" wraps at 390px, and the weekday is date information,
// which is what the chip is for. Ranges get no weekday — it spans several.
function dayBlock(start: Date, end?: Date) {
  if (!end || sameDay(start, end) || isOneLateNight(start, end)) {
    return {
      day: dayNum(start),
      month: monthShort(start),
      weekday: weekdayShortFmt.format(start).toUpperCase(),
      range: false,
    };
  }
  const s = ctParts(start);
  const e = ctParts(end);
  const sameMonth = s.month === e.month && s.year === e.year;
  if (sameMonth) {
    return {
      day: `${dayNum(start)}–${dayNum(end)}`,
      month: monthShort(start),
      weekday: null,
      range: true,
    };
  }
  return {
    day: `${dayNum(start)}–${dayNum(end)}`,
    month: `${monthShort(start)}/${monthShort(end)}`,
    weekday: null,
    range: true,
  };
}

function sameDay(a: Date, b: Date) {
  const pa = ctParts(a);
  const pb = ctParts(b);
  return pa.year === pb.year && pa.month === pb.month && pa.day === pb.day;
}

// Time formatting — Plainfield IL is Central Time. Hardcode CT label
// instead of relying on the visitor's locale (which would render in
// their local zone and confuse anyone planning to attend).
const timeFmt = new Intl.DateTimeFormat("en-US", {
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
  timeZone: VENUE_TZ,
});

function timeRange(start: Date, end?: Date) {
  const s = timeFmt.format(start).toLowerCase();
  if (!end) return `${s} CT`;
  const e = timeFmt.format(end).toLowerCase();
  // Drop the opening meridiem when both ends share it — "7:00 – 11:00 pm CT"
  // rather than "7:00 pm – 11:00 pm CT". Saves a wrap at 390px, and it's the
  // conventional form. A night that crosses noon or midnight (Black
  // Wednesday's 9:00 pm – 1:00 am) keeps both, because there it's the
  // load-bearing detail.
  const sm = s.slice(-2);
  return sm === e.slice(-2) ? `${s.slice(0, -3)} – ${e} CT` : `${s} – ${e} CT`;
}

// JSON-LD: ItemList of Events, built from the same occurrences the page
// renders — schema and display can't drift. Skipped when nothing is
// scheduled (calendar's clear → no ItemList to ship). Each Event:
//   - eventStatus: EventScheduled (default; flip via markdown if needed)
//   - eventAttendanceMode: OfflineEventAttendanceMode
//   - location + organizer reference the venue via @id
//   - url prefers the cta.href when it's an internal DETAIL page (lets
//     crawlers follow to e.g. /new-years-eve/), falls back to the
//     upcoming-events page itself.
//
// ONE Event per markdown entry, not per occurrence: a recurring night is
// a single Event carrying an `eventSchedule`, which is the shape Google
// documents for recurrence. Twenty near-identical Karaoke Events — one
// per Thursday the cards happen to show — would be duplicate entities
// competing with each other for the same query.
const schemaEntries = rawEvents
  .map((entry) => ({ entry, first: occurrences.find((o) => o.entry.id === entry.id)?.occ }))
  .filter((x): x is { entry: typeof x.entry; first: NonNullable<typeof x.first> } => !!x.first)
  .sort((a, b) => a.first.start.getTime() - b.first.start.getTime());

const upcomingEventsJsonLd = schemaEntries.length === 0 ? null : {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: schemaEntries.map(({ entry: e, first: occ }, i) => {
    const cta = e.data.cta?.href;
    // Google reads Event.url as "the page describing this event," so it
    // only inherits the CTA when the CTA points at a detail PAGE. The
    // booking wizard is a tool, not a description — a card whose CTA is
    // "Reserve a lane" (walk-in nights with nothing to book) would
    // otherwise name /reserve/ as the karaoke page.
    const ctaIsDetailPage =
      cta && cta.startsWith("/") && !cta.startsWith("/reserve");
    const eventUrl = ctaIsDetailPage
      ? `${BUSINESS_URL}${cta}`
      : `${BUSINESS_URL}/upcoming-events/`;
    // `offers` sourced from the event's `lowPrice` frontmatter when set.
    // AggregateOffer floor pattern — clears GSC "Missing field 'offers'"
    // and keeps each Event eligible for rich results in this ItemList.
    //
    // Free events (low == high == "0") emit a plain Offer at $0 instead.
    // An "AggregateOffer" over a price RANGE of zero width is the wrong
    // shape for a no-cover night, and Google reads a single Offer with
    // price 0 as free — which is the fact we want in the SERP.
    const isFree = e.data.lowPrice === "0" && e.data.highPrice === "0";
    const offers = !e.data.lowPrice
      ? undefined
      : isFree
      ? {
          "@type": "Offer",
          priceCurrency: "USD",
          price: "0",
          availability: "https://schema.org/InStock",
          url: eventUrl,
          ...(e.data.validFrom && { validFrom: e.data.validFrom.toISOString() }),
          validThrough: occ.start.toISOString(),
        }
      : {
          "@type": "AggregateOffer",
          priceCurrency: "USD",
          lowPrice: e.data.lowPrice,
          // highPrice + validFrom added 2026-05-27 to clear GSC
          // "Events structured data — non-critical missing field"
          // warnings. Both optional in the events schema — Events
          // without these fields just emit lowPrice (back to the
          // earlier shape).
          ...(e.data.highPrice && { highPrice: e.data.highPrice }),
          ...(e.data.validFrom && { validFrom: e.data.validFrom.toISOString() }),
          availability: "https://schema.org/InStock",
          url: eventUrl,
          // validThrough = event start: no sales after kickoff.
          validThrough: occ.start.toISOString(),
        };
    const rec = e.data.recurring;
    return {
      "@type": "ListItem",
      position: i + 1,
      item: {
        ...eventSchema({
          name: e.data.title,
          // The next occurrence in view, not the season opener. Keeps the
          // Event from advertising a start date that's already in the past
          // for eight months of a nine-month run; `eventSchedule` below
          // carries the full recurrence.
          start: occ.start,
          end: occ.end,
          description: e.body?.trim(),
          url: eventUrl,
          // Absolute URL — Google's Event validator wants a fully-qualified
          // image. Site-relative path in frontmatter, origin prepended here.
          image: e.data.image ? `${BUSINESS_URL}${e.data.image}` : undefined,
          offers,
        }),
        ...(rec && {
          eventSchedule: {
            "@type": "Schedule",
            byDay: `https://schema.org/${weekdayOf(e.data.start)}`,
            // BARE local times under `scheduleTimezone` — never an offset.
            // This season crosses two DST boundaries; a fixed offset would
            // misreport the night by an hour all winter. Identical
            // reasoning to /leagues.
            startTime: ctClock(e.data.start),
            ...(e.data.end && { endTime: ctClock(e.data.end) }),
            repeatFrequency: "P1W",
            startDate: ctDateKey(e.data.start),
            endDate: rec.until.toISOString().slice(0, 10),
            // Dark nights. This is precisely what exceptDate is for —
            // without it the schema promises karaoke on Thanksgiving.
            ...(rec.skip.length && { exceptDate: rec.skip }),
            scheduleTimezone: "America/Chicago",
          },
        }),
      },
    };
  }),
};
---
<Base
  title="Upcoming Events in Plainfield, IL | Twisted Pin"
  description="Themed nights, seasonal events, and holiday parties at Twisted Pin in Plainfield, IL. The live calendar — see what's coming up, or plan your own night."
>

  <section class="t2-hero" data-hero aria-labelledby="upcoming-h1">
    <div class="t2-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">What's On</p>
      <h1 class="t-display t2-hero-headline hero-fade" id="upcoming-h1" data-delay-ms="120">
        Upcoming events.
      </h1>
      <p class="t2-hero-sub hero-fade" data-delay-ms="320">
        Themed nights, seasonal events, holiday parties.
      </p>
    </div>
  </section>

  {!hasAnyEvents ? (
    <section class="t2-section ev-empty" aria-labelledby="ev-empty-h2">
      <div class="t2-section-inner">
        <h2 id="ev-empty-h2" class="ev-empty-headline">Calendar's clear right now.</h2>
        <p class="t2-section-body">
          New nights drop here as we lock them in — keep an eye out.
        </p>
        <p class="t2-section-body">
          Want to fill it? <a href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event &rarr;</a>
        </p>
      </div>
    </section>
  ) : (
    <section class="ev-list" aria-label="Upcoming events" data-ev-calendar data-active-month={activeKey}>
      {/* Month pills. Every panel is server-rendered and all of them stay
          in the DOM — crawlers (and no-JS readers, via :target) see every
          event; JS only decides which panel is on screen. Months with
          nothing scheduled are rendered disabled rather than hidden, so
          the strip doesn't reflow as events get added and a reader can
          see at a glance that December is empty without tapping it. */}
      <nav class="ev-pills" aria-label="Pick a month">
        {panels.map((p) => (
          <button
            type="button"
            class="ev-pill"
            data-pill-month={p.key}
            aria-pressed={p.key === activeKey ? "true" : "false"}
            disabled={p.events.length === 0}
            aria-label={`${p.label}${p.events.length === 0 ? " — nothing scheduled" : ""}`}
          >
            <span class="ev-pill-label">{p.pill}</span>
            {p.pillYear && <span class="ev-pill-year">&apos;{p.pillYear}</span>}
          </button>
        ))}
      </nav>

      {panels.map((panel) => (
        <div
          class="ev-month"
          data-view-month={panel.key}
          aria-hidden={panel.key === activeKey ? "false" : "true"}
        >
          <h2 class="ev-month-label">{panel.label}</h2>
          {panel.events.length === 0 ? (
            <p class="ev-month-empty">Nothing on the books for {panel.label.split(" ")[0].toLowerCase()} yet.</p>
          ) : (
          <ul class="ev-cards" role="list">
            {panel.events.map(({ entry: e, occ }, i) => {
              const block = dayBlock(occ.start, occ.end);
              // A recurring night lists every date it runs, so within one
              // month the same description would repeat four or five
              // times. Full card on its first appearance; the repeats stay
              // compact — the date and time are the only new information.
              const isRepeat = panel.events.slice(0, i).some((o) => o.entry.id === e.id);
              const desc = isRepeat ? null : e.body?.trim();
              return (
                <li class="ev-card" class:list={[isRepeat && "is-repeat"]}>
                  <div class="ev-date" aria-hidden="true">
                    <div class="ev-date-day" class:list={[block.range && "is-range"]}>
                      {block.day}
                    </div>
                    <div class="ev-date-month">{block.month}</div>
                    {block.weekday && <div class="ev-date-weekday">{block.weekday}</div>}
                  </div>
                  <div class="ev-body">
                    <div class="ev-flags">
                      {e.data.tentative && <span class="ev-flag ev-flag-tentative">Tentative</span>}
                      {e.data.virtual && <span class="ev-flag ev-flag-virtual">Virtual</span>}
                    </div>
                    <h3 class="ev-title">{e.data.title}</h3>
                    <p class="ev-meta ev-meta-time">
                      <span class="ev-meta-glyph" aria-hidden="true">&#9719;</span>
                      {/* The date chip beside this is aria-hidden (it's a
                          graphic), so the spoken version carries the full
                          date — otherwise a screen reader announces a time
                          with no day attached to it. */}
                      <span class="visually-hidden">When: {srDateFmt.format(occ.start)}, </span>
                      {timeRange(occ.start, occ.end)}
                    </p>
                    {e.data.location && !isRepeat && (
                      <p class="ev-meta ev-meta-loc">
                        <span class="ev-meta-glyph" aria-hidden="true">&#9678;</span>
                        <span class="visually-hidden">Where: </span>{e.data.location}
                      </p>
                    )}
                    {desc && <p class="ev-desc">{desc}</p>}
                    {e.data.cta && !isRepeat && (
                      <a
                        class="btn btn-outline ev-cta"
                        href={e.data.cta.href}
                        {...(/^https?:\/\//.test(e.data.cta.href)
                          ? { target: "_blank", rel: "noopener" }
                          : {})}
                      >
                        {e.data.cta.label}
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
          )}
        </div>
      ))}
    </section>
  )}

  {/* SEO body block — substantive content for the calendar page so
      the empty-state version isn't ~30 words around a single Zite link.
      Sets expectation re: lookahead window, names what runs even when
      the calendar is clear, and links out to /bar/, /game/, and the
      Naperville service area. Distinct copy from the other 4 thin
      pages (calendar context, not iframe / credit / hiring). */}
  <section class="t2-section" aria-labelledby="upcoming-info-h2">
    <div class="t2-section-inner">
      <h2 class="t-eyebrow" id="upcoming-info-h2">What Goes On The Calendar</h2>
      <p class="t2-section-body">
        The calendar above tracks the bigger nights: weekly
        programming like karaoke, themed events, holiday parties,
        seasonal pop-ups, and one-off collaborations. Tap a month to
        see what's on it. We run about four months ahead &mdash; not
        six, because the calendar tends to shift that far out and
        stale dates do nobody any favors. New things get added as we
        lock them in.
      </p>
      <p class="t2-section-body">
        Standard programming runs even when the calendar's empty.
        Walk-in bowling all year, cocktails curated by
        <a href="/bar/">America's Top Mixologist</a> every night the
        bar's open, the 28-tap self-serve wall, the kitchen, the
        <a href="/game/">arcade</a>. The calendar is for the bigger
        or one-off nights &mdash; not everyday operations, which run
        on a standard schedule.
      </p>
      <p class="t2-section-body">
        Plainfield, IL is the venue, with most weekend regulars
        driving in from <a href="/why-us/naperville-il/">Naperville</a>,
        Bolingbrook, Joliet, and the rest of Will County. Want to put
        your own night on this calendar? <a href={PLAN_EVENT_URL} target="_blank" rel="noopener">Plan an event &rarr;</a>
        &mdash; group buyouts and corporate offsites are how most
        non-themed nights start.
      </p>
    </div>
  </section>

  <section class="t2-section ev-handoff" aria-labelledby="upcoming-h2">
    <div class="t2-section-inner">
      <h2 class="t-eyebrow" id="upcoming-h2">More Ways In</h2>
      <p class="t2-section-body">
        Want to host your own night? Group events, corporate offsites,
        and birthdays all run through our event team — <a href={PLAN_EVENT_URL} target="_blank" rel="noopener">plan an event &rarr;</a>
      </p>

      <p class="t2-section-body">
        Looking for league nights specifically?
        <a href="/leagues/">See leagues &rarr;</a>
      </p>
    </div>
  </section>

  <SnapFooter />

  {upcomingEventsJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(upcomingEventsJsonLd)} />
  )}
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Upcoming Events", path: "/upcoming-events/" },
  ]} />
</Base>

<script>
  // Month-pill toggle. Same shape as the /pricing day pills: every panel
  // is server-rendered, aria-pressed drives the pill, aria-hidden drives
  // the panel, and JS only swaps attributes.
  //
  // Deep links: /upcoming-events/?month=2026-10 or #2026-10, so a promo
  // or SMS can point straight at a month. Falls back silently to the
  // server-rendered month when the value is missing, malformed, or names
  // a month outside the horizon.
  const root = document.querySelector<HTMLElement>("[data-ev-calendar]");
  if (root) {
    const pills = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-pill-month]"));
    const views = Array.from(root.querySelectorAll<HTMLElement>("[data-view-month]"));

    function activate(month: string, focusPill = false) {
      const pill = pills.find((p) => p.getAttribute("data-pill-month") === month);
      // Refuse unknown months AND empty ones — activating a disabled pill
      // would strand the reader on "nothing on the books" with no visible
      // cue as to which pill they're on.
      if (!pill || pill.disabled) return;
      root!.setAttribute("data-active-month", month);
      pills.forEach((p) =>
        p.setAttribute("aria-pressed", p === pill ? "true" : "false"),
      );
      views.forEach((v) =>
        v.setAttribute(
          "aria-hidden",
          v.getAttribute("data-view-month") === month ? "false" : "true",
        ),
      );
      if (focusPill) pill.focus();
      // Keep the chosen pill in view on phones, where the strip scrolls.
      pill.scrollIntoView({ block: "nearest", inline: "nearest" });
    }

    pills.forEach((p) =>
      p.addEventListener("click", () => activate(p.getAttribute("data-pill-month")!)),
    );

    // Left/right arrows walk the strip, skipping empty months — standard
    // behaviour for a group of toggle buttons.
    root.addEventListener("keydown", (ev) => {
      const key = (ev as KeyboardEvent).key;
      if (key !== "ArrowLeft" && key !== "ArrowRight") return;
      const active = pills.findIndex((p) => p.getAttribute("aria-pressed") === "true");
      if (active < 0) return;
      const step = key === "ArrowRight" ? 1 : -1;
      for (let i = active + step; i >= 0 && i < pills.length; i += step) {
        if (pills[i].disabled) continue;
        ev.preventDefault();
        activate(pills[i].getAttribute("data-pill-month")!, true);
        return;
      }
    });

    const url = new URL(location.href);
    const requested = url.searchParams.get("month") || location.hash.slice(1);
    if (/^\d{4}-\d{2}$/.test(requested)) activate(requested);
  }
</script>

<style>
  /* List wrapper. Same horizontal rhythm as t2-section but with its
     own vertical pacing — month headers and cards stack tighter than
     a typical editorial section. */
  .ev-list {
    padding: 24px 24px 64px;
    max-width: 800px;
    margin: 0 auto;
  }
  @media (min-width: 1025px) {
    .ev-list {
      padding: 32px 64px 96px;
    }
  }

  /* Month pills. Horizontal strip so four months fit at 360px without
     wrapping; overflow-x is the safety valve if the horizon ever grows
     or a year suffix widens a pill. Tap targets are 44px+ tall. */
  .ev-pills {
    display: flex;
    gap: 4px;
    margin: 0 0 28px;
    padding: 4px;
