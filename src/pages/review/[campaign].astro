---
import UpcomingEvents from "../upcoming-events.astro";

// Password-protected by the Jingle review middleware. This route opts
// into one draft; the ordinary calendar never passes the preview prop.
export const prerender = false;
if (Astro.params.campaign !== "jingle-calendar") {
  return new Response("Not found", { status: 404 });
}
---
<UpcomingEvents protectedPreview="jingle" />

<style is:global>
  /* Only this password-protected review route includes these rules. Keep
     long event actions inside their grid column without changing the
     public calendar or hiding clipped content. */
  @media (max-width: 1024px) {
    html:has(#upcoming-h1) { scrollbar-gutter: auto; }
    .ev-body .ev-cta {
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }
  }
</style>
