---
/**
 * /kids-signup-preview — PARKED preview of the native Free Kids Bowling signup.
 *
 * Native online signup that enrolls a parent into the loyalty platform's Free
 * Kids Bowling program. Modeled on /coupon-preview: the form POSTs to a
 * server-side proxy (/api/kids-signup) → n8n intake. Kids enrollment does NOT
 * grant an offer at signup — it's a WINDOWED program: a daily cron mints a
 * fresh redeemable grant every weekday (10:45a–4:10p backend window; advertised
 * 11am–4pm) that expires same-day. Signup ENROLLS (applies program:kids-free-bowl);
 * grant_windowed_today gives an instant grant if a parent signs up mid-window.
 *
 * Details mirror the live (Patch-iframe) form this replaces: 2 free games/day,
 * kids 12 & under, Jun 1–Aug 14 (closed Jul 4 + Jul 27–29), Mon–Fri 11am–4pm,
 * redeem-by-phone-at-kiosk, adults/13+ $6.95/game, Summer Pin Pass upsell.
 * Per Jon: the child-name fields are for FORMALITY only — collected, not sent.
 *
 * ⚠️ BACKEND HALF NOT YET WIRED. n8n WF-Loyalty-Forms-Intake must handle
 * form_slug='kids-free-bowl' → upsert (offer_slug NULL) + apply the program tag
 * (RPC doesn't tag, db/018) + send the kids welcome text + call
 * grant_windowed_today. Until then a submit upserts the customer but won't
 * tag/text. Parked: noindex,nofollow + robots Disallow + sitemap-excluded.
 */
import Base from "../layouts/Base.astro";
import SnapFooter from "../components/snap/SnapFooter.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";

const CONSENT_TEXT =
  "By checking this box, you agree to receive recurring automated marketing " +
  "text messages from Twisted Pin at the number provided. Consent is not a " +
  "condition of purchase. Message & data rates may apply. Reply STOP to " +
  "cancel, HELP for help. See our Terms (twistedpin.com/terms) and Privacy " +
  "Policy (twistedpin.com/privacy).";

// Required acknowledgments — sets expectations so there's no front-desk friction.
const ACKS = [
  "I understand lanes can't be reserved with this program — it's walk-in open bowling.",
  "I understand this covers kids 12 & under; adults and teens 13+ bowl for $6.95 a game.",
  "I understand it doesn't include shoe rental.",
];

const FAQ = [
  {
    q: "How does free kids bowling work?",
    a: "Sign up once with your mobile number. Then bring the kids to Twisted Pin in Plainfield any weekday between 11am and 4pm — show your registered phone number at the front desk kiosk and they get 2 free games each. No coupons, no printing. It runs June 1 through August 14.",
  },
  {
    q: "Who's it for, and what does it cost?",
    a: "Kids 12 & under bowl free — 2 games a day. Adults and teens 13+ can bowl right alongside them for $6.95 a game during program hours. Shoe rental, food, and drinks are separate on a normal tab.",
  },
  {
    q: "What are the hours and dates?",
    a: "Monday–Friday, 11am–4pm, June 1 through August 14. We're closed July 4 and July 27–29, and weekends aren't part of the program.",
  },
  {
    q: "Do I have to sign up every time?",
    a: "No. Sign up once and you're on the list all summer. Just give your phone number at the front desk kiosk each visit and we take care of the rest.",
  },
];
---
<Base
  title="Free Kids Bowling This Summer | Twisted Pin"
  description="Register your kids and they bowl free every weekday this summer at Twisted Pin in Plainfield, IL — 2 free games a day for kids 12 & under, Mon–Fri 11am–4pm, June 1 through August 14."
  ogImage="/og/og-bowl.jpg"
  ogImageAlt="Bowling at Twisted Pin in Plainfield, IL"
>
  {/* PARKED: noindex,nofollow — internal preview, never indexed or crawled. */}
  <Fragment slot="head">
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>

  <section class="t2-hero" data-hero aria-labelledby="kp-h1">
    <div class="t2-hero-copy">
      <p class="t-eyebrow hero-fade" data-delay-ms="0">Summer 2026 · Plainfield, IL</p>
      <h1 class="t-display t2-hero-headline hero-fade" id="kp-h1" data-delay-ms="120">
        Kids bowl free&nbsp;this summer.
      </h1>
      <p class="t2-hero-sub hero-fade" data-delay-ms="320">
        Register your kids once and they bowl free every weekday all summer —
        2 free games a day, no coupons, no printing. While they bowl, the bar
        and kitchen are yours.
      </p>
    </div>
  </section>

  <section class="t2-section kp-section" aria-labelledby="kp-form-h2">
    <div class="t2-section-inner">

      {/* PREVIEW banner — REMOVE when migrating to /free-kids-bowling. */}
      <p class="kp-preview-flag" role="status">
        ⚙ Parked preview (noindex, unlinked). The form posts to the loyalty
        intake, but the kids-enrollment handler (tag + welcome text) is
        <strong>still being wired on the backend</strong> — a submission won't
        fully enroll a member yet. Don't rely on it until that's live.
      </p>

      {/* ---- PROGRAM DETAILS (mirrors the live form) ---- */}
      <div class="kp-details">
        <p class="kp-details-h">The program</p>
        <ul class="kp-details-list">
          <li><strong>2 free games per day</strong> for kids 12 &amp; under</li>
          <li><strong>June 1 – August 14</strong> <span class="kp-muted">(closed July 4 &amp; July 27–29)</span></li>
          <li><strong>Mon–Fri, 11am–4pm</strong></li>
          <li><strong>To redeem:</strong> just give your registered phone number at the front desk kiosk. No coupons, no printing.</li>
        </ul>
        <p class="kp-details-note">
          <strong>Adults &amp; teens (13+):</strong> bowl right alongside the kids for
          <strong>$6.95 a game</strong> during program hours.
        </p>
        <p class="kp-details-fine">
          Can't be combined with other offers. Not valid for groups or reservations.
          Doesn't include shoe rental.
        </p>
      </div>

      {/* ---- SUMMER PIN PASS upsell ---- */}
      <div class="kp-upsell">
        <p class="kp-upsell-h">Want unlimited bowling all summer?</p>
        <p class="kp-upsell-body">
          The <strong>Summer Pin Pass</strong> covers the whole family — weekends,
          evenings, no restrictions.
        </p>
        <a class="kp-upsell-link" href="/summer-pin-pass/">See the Summer Pin Pass →</a>
      </div>

      <h2 class="t-eyebrow" id="kp-form-h2" style="font-size:11px;">Register your kids</h2>

      {/* ---- FORM ---- */}
      <form id="kp-form" class="kp-form" data-consent={CONSENT_TEXT} novalidate>
        <div class="kp-row kp-row-2">
          <div class="kp-field">
            <label for="kp-first">First name — parent/guardian <span class="kp-req">*</span></label>
            <input id="kp-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="kp-field">
            <label for="kp-last">Last name <span class="kp-opt">(optional)</span></label>
            <input id="kp-last" name="last_name" type="text" autocomplete="family-name" />
          </div>
        </div>

        <div class="kp-field">
          <label for="kp-mobile">Mobile number <span class="kp-req">*</span></label>
          <input id="kp-mobile" name="phone" type="tel" inputmode="tel"
                 autocomplete="tel" placeholder="(815) 555-0123" required />
          <p class="kp-hint">The number you'll give at the front desk when you visit.</p>
          <p class="kp-phone-status" id="kp-phone-status" role="status" hidden></p>
        </div>

        <div class="kp-field">
          <label for="kp-email">Email <span class="kp-opt">(optional)</span></label>
          <input id="kp-email" name="email" type="email" autocomplete="email" placeholder="you@email.com" />
        </div>

        {/* Child names — formality only; collected, not transmitted. */}
        <fieldset class="kp-field kp-kids">
          <legend>Your kids <span class="kp-req">*</span> <span class="kp-opt">(at least one — 12 &amp; under as of 6/30/26)</span></legend>
          <input class="kp-kid" name="child1" type="text" autocomplete="off" placeholder="Child's first name" />
          <input class="kp-kid" name="child2" type="text" autocomplete="off" placeholder="Another child (optional)" />
          <input class="kp-kid" name="child3" type="text" autocomplete="off" placeholder="Another child (optional)" />
        </fieldset>

        {/* Honeypot */}
        <div class="kp-hp" aria-hidden="true">
          <label for="kp-website">Website</label>
          <input id="kp-website" name="website_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/* Required acknowledgments */}
        <fieldset class="kp-acks">
          <legend class="kp-acks-legend">Before you sign up</legend>
          {ACKS.map((text, i) => (
            <label class="kp-ack">
              <input class="kp-ack-input" type="checkbox" name={`ack${i + 1}`} required />
              <span>{text}</span>
            </label>
          ))}
        </fieldset>

        <label class="kp-consent">
          <input id="kp-consent" name="consent" type="checkbox" required />
          <span>
            By checking this box, you agree to receive recurring automated
            marketing text messages from Twisted Pin at the number provided.
            Consent is not a condition of purchase. Message &amp; data rates
            may apply. Reply STOP to cancel, HELP for help. See our
            <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy Policy</a>.
          </span>
        </label>

        <p id="kp-error" class="kp-error" role="alert" hidden></p>

        <button type="submit" id="kp-submit" class="kp-submit">Register my kids</button>
      </form>

      {/* ---- SUCCESS PANEL ---- */}
      <div id="kp-success" class="kp-panel kp-success" hidden>
        <p class="kp-panel-eyebrow">You're in 🎳</p>
        <h3 class="kp-panel-title">Check your phone.</h3>
        <p class="kp-panel-body">
          We just texted your details<span id="kp-success-phone"></span>. Bring the
          kids in <strong>Monday–Friday, 11am–4pm</strong> and give your number at
          the front desk — they get <strong>2 free games each</strong>, all summer
          through August 14. While they bowl, the bar and kitchen are yours
          (and you can bowl alongside them for $6.95 a game).
        </p>
      </div>

      {/* ---- ALREADY-ENROLLED PANEL ---- */}
      <div id="kp-already" class="kp-panel kp-already" hidden>
        <p class="kp-panel-eyebrow">You're already in 👋</p>
        <h3 class="kp-panel-title">You're already registered.</h3>
        <p class="kp-panel-body">
          You're already on the list for free kids bowling — no need to sign up
          twice. Just give your number at the front desk any weekday, 11am–4pm.
        </p>
      </div>

    </div>
  </section>

  {/* ============================================================
      SEO body — unique content beneath the form. "Free kids bowling"
      is the program name, not discount framing.
      ============================================================ */}
  <section class="t2-section" aria-labelledby="kp-info-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">How it works</p>
      <h2 class="t-display kp-info-title" id="kp-info-h2">Register once. Bowl all summer.</h2>
      <p class="t2-section-body">
        Sign up with your mobile number, then bring the kids to
        <a href="/bowl/">Twisted Pin in Plainfield</a> any weekday between 11am
        and 4pm. Give your number at the front desk kiosk and each kid 12 &amp;
        under gets 2 free games — June 1 through August 14, no coupons or
        printing. Adults and teens 13+ bowl alongside them for $6.95 a game.
      </p>

      <p class="t-eyebrow" style="margin-top: 36px;">While the kids bowl</p>
      <h2 class="t-display kp-info-title">You don't have to just watch.</h2>
      <p class="t2-section-body">
        The rest of the venue runs in parallel — the
        <a href="/menu/taps/">28-tap self-serve beer &amp; wine wall</a>,
        <a href="/bar/">the bar program</a> curated by Brian Van Flandern,
        America's Top Mixologist, and <a href="/eat/">a from-scratch kitchen</a>.
        Free kids bowling is the reason to come in on a weekday afternoon; the
        rest is why you'll want to stay.
      </p>

      <p class="t-eyebrow" style="margin-top: 36px;">Where</p>
      <h2 class="t-display kp-info-title">Right off Route 59.</h2>
      <p class="t2-section-body">
        Twisted Pin is in Plainfield, IL — an easy drive from Naperville,
        Romeoville, Shorewood, Bolingbrook, Oswego, and Joliet. Free summer
        bowling for kids runs Monday through Friday, 11am to 4pm, June 1 through
        August 14 (closed July 4 and July 27–29). Want unlimited bowling for the
        whole family — weekends and evenings included? Look at the
        <a href="/summer-pin-pass/">Summer Pin Pass</a>.
      </p>
    </div>
  </section>

  {/* ---- FAQ ---- */}
  <section class="t2-section" aria-labelledby="kp-faq-h2">
    <div class="t2-section-inner">
      <p class="t-eyebrow">Good to know</p>
      <h2 class="t-display kp-info-title" id="kp-faq-h2">Questions, answered.</h2>
      <dl class="kp-faq">
        {FAQ.map((item) => (
          <div class="kp-faq-item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <SnapFooter />
  <BreadcrumbSchema crumbs={[
    { name: "Home", path: "/" },
    { name: "Free Kids Bowling", path: "/kids-signup-preview/" },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": FAQ.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  })} />
</Base>

{/* ============================================================
    Form handler. Posts to /api/kids-signup → loyalty intake.
    Child names are collected for formality but NOT sent (per Jon).
    ============================================================ */}
<script is:inline>
  (function () {
    var form = document.getElementById("kp-form");
    if (!form) return;
    var errorEl = document.getElementById("kp-error");
    var submitBtn = document.getElementById("kp-submit");
    var successEl = document.getElementById("kp-success");
    var alreadyEl = document.getElementById("kp-already");
    var mobile = document.getElementById("kp-mobile");
    var phoneStatus = document.getElementById("kp-phone-status");

    var lastVerified = { digits: "", textable: null, lineType: null };
    var verifyTimer = null;

    var submissionId = (window.crypto && window.crypto.randomUUID)
      ? window.crypto.randomUUID()
      : String(Date.now()) + "-" + Math.round(performance.now());

    function setPhoneStatus(msg, kind) {
      if (!msg) { phoneStatus.hidden = true; phoneStatus.textContent = ""; return; }
      phoneStatus.textContent = msg;
      phoneStatus.className = "kp-phone-status" + (kind ? " " + kind : "");
      phoneStatus.hidden = false;
    }

    function shakePhone() {
      mobile.classList.add("kp-input-invalid");
      mobile.classList.remove("kp-shake");
      void mobile.offsetWidth;
      mobile.classList.add("kp-shake");
    }

    function verifyPhone(digits) {
      if (digits.length !== 10 || digits === lastVerified.digits) return;
      setPhoneStatus("Checking your number…", "checking");
      fetch("/api/phone-verify/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: "+1" + digits }),
      })
        .then(function (r) { return r.json(); })
        .then(function (r) {
          lastVerified = { digits: digits, textable: r.textable, lineType: r.line_type || null };
          if (r.textable === false) {
            shakePhone();
            setPhoneStatus("That number can't receive texts — double-check your mobile number.", "bad");
          } else {
            mobile.classList.remove("kp-input-invalid");
            setPhoneStatus("", "");
          }
        })
        .catch(function () {
          lastVerified = { digits: digits, textable: null, lineType: null };
          setPhoneStatus("", "");
        });
    }

    mobile.addEventListener("input", function () {
      var d = mobile.value.replace(/\D/g, "").slice(0, 10);
      var out = d;
      if (d.length > 6) out = "(" + d.slice(0, 3) + ") " + d.slice(3, 6) + "-" + d.slice(6);
      else if (d.length > 3) out = "(" + d.slice(0, 3) + ") " + d.slice(3);
      else if (d.length > 0) out = "(" + d.slice(0, 3);
      mobile.value = out;

      if (d !== lastVerified.digits) {
        mobile.classList.remove("kp-input-invalid");
        setPhoneStatus("", "");
      }
      clearTimeout(verifyTimer);
      if (d.length === 10) verifyTimer = setTimeout(function () { verifyPhone(d); }, 500);
    });

    mobile.addEventListener("blur", function () {
      var d = mobile.value.replace(/\D/g, "").slice(0, 10);
      if (d.length === 10) verifyPhone(d);
    });

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Register my kids";
    }

    function reasonMessage(reason) {
      if (reason === "missing_phone" || reason === "invalid_phone")
        return "Please enter a valid 10-digit mobile number.";
      if (reason === "network_error" || reason === "upstream_error")
        return "Something went wrong on our end — please try again in a moment.";
      return "Sorry, that didn't go through. Please try again.";
    }

    function reveal(panel, phoneText) {
      form.hidden = true;
      var flag = document.querySelector(".kp-preview-flag");
      if (flag) flag.hidden = true;
      var details = document.querySelector(".kp-details");
      if (details) details.hidden = true;
      var upsell = document.querySelector(".kp-upsell");
      if (upsell) upsell.hidden = true;
      if (phoneText) {
        var span = document.getElementById("kp-success-phone");
        if (span) span.textContent = " to " + phoneText;
      }
      panel.hidden = false;
      panel.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      var first = form.first_name.value.trim();
      var phoneDigits = form.phone.value.replace(/\D/g, "");
      var kidsEntered = [form.child1.value, form.child2.value, form.child3.value]
        .map(function (s) { return (s || "").trim(); }).filter(Boolean);
      var consent = form.consent.checked;
      var acks = form.querySelectorAll(".kp-ack-input");
      var allAcked = Array.prototype.every.call(acks, function (a) { return a.checked; });

      if (!first) return showError("Please enter your first name.");
      if (phoneDigits.length !== 10) return showError("Please enter a valid 10-digit mobile number.");
      if (kidsEntered.length === 0) return showError("Please add at least one child's first name.");
      if (!allAcked) return showError("Please check the three boxes so we know you're set on how the program works.");
      if (!consent) return showError("Please agree to receive texts so we can send your details.");

      if (lastVerified.digits === phoneDigits && lastVerified.textable === false) {
        shakePhone();
        return showError("That number can't receive texts — enter a mobile number so we can send your details.");
      }

      // Child names are intentionally NOT included — formality only.
      var payload = {
        first_name: first,
        last_name: form.last_name.value.trim() || null,
        phone: "+1" + phoneDigits,
        email: form.email.value.trim() || null,
        consent_marketing: true,
        phone_type: (lastVerified.digits === phoneDigits) ? lastVerified.lineType : null,
        submission_id: submissionId,
        consent_language: form.getAttribute("data-consent") || "",
        page_url: window.location.href,
        website_url: form.website_url.value || "",
      };

      submitBtn.disabled = true;
      submitBtn.textContent = "Registering…";

      fetch("/api/kids-signup/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (res) { return res.json(); })
        .then(function (r) {
          if (!r || r.ok !== true) {
            if (r && r.reason === "honeypot") {
              submitBtn.disabled = false;
              submitBtn.textContent = "Register my kids";
              return;
            }
            return showError(reasonMessage(r && r.reason));
          }
          if (r.replayed) {
            reveal(alreadyEl);
          } else {
            reveal(successEl, form.phone.value.trim());
          }
        })
        .catch(function () {
          showError("Something went wrong on our end — please try again in a moment.");
        });
    });
  })();
</script>

<style>
  /* ============================================================
     /kids-signup-preview — native loyalty enrollment form + SEO body.
     Mirrors the /coupon-preview recipe; self-contained for lift onto
     /free-kids-bowling at migration.
     ============================================================ */
  .kp-section .t2-section-inner { max-width: 560px; }

  .kp-preview-flag {
    margin: 0 0 20px;
    padding: 10px 14px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--indigo-deep);
    background: var(--glow);
    border-radius: 7px;
    font-weight: 700;
  }
  .kp-preview-flag strong { text-decoration: underline; }

  /* Program details block */
  .kp-details {
    margin: 0 0 16px;
    padding: 18px 20px;
    border: 1px solid rgba(244, 239, 227, 0.16);
    border-radius: var(--radius-surface);
    background: rgba(244, 239, 227, 0.03);
  }
  .kp-details-h {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--glow);
    margin: 0 0 12px;
  }
  .kp-details-list {
    margin: 0;
    padding: 0 0 0 18px;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--warm-mid);
  }
  .kp-details-list li { margin: 0 0 8px; }
  .kp-details-list strong { color: var(--warm-white); }
  .kp-muted { color: var(--warm-dim); }
  .kp-details-note {
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid rgba(244, 239, 227, 0.10);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--warm-mid);
  }
  .kp-details-note strong { color: var(--warm-white); }
  .kp-details-fine {
    margin: 10px 0 0;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--warm-dim);
  }

  /* Summer Pin Pass upsell */
  .kp-upsell {
    margin: 0 0 22px;
    padding: 16px 18px;
    border: 1px solid rgba(216, 139, 92, 0.40);
    border-radius: var(--radius-surface);
    background: rgba(216, 139, 92, 0.07);
  }
  .kp-upsell-h {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    color: var(--warm-white);
    margin: 0 0 4px;
  }
  .kp-upsell-body {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--warm-mid);
    margin: 0 0 8px;
  }
  .kp-upsell-body strong { color: var(--warm-white); }
  .kp-upsell-link {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--copper, #d88b5c);
    text-decoration: none;
  }
  .kp-upsell-link:hover { text-decoration: underline; }

  .kp-form { margin-top: 14px; }

  .kp-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  .kp-field { margin: 0 0 16px; border: 0; padding: 0; min-width: 0; }
  .kp-field label,
  .kp-kids legend {
    display: block;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    color: var(--warm-white);
    margin: 0 0 6px;
    padding: 0;
  }
  .kp-req { color: var(--glow); }
  .kp-opt { color: var(--warm-dim); font-weight: 400; }

  .kp-form input[type="text"],
  .kp-form input[type="tel"],
  .kp-form input[type="email"] {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
